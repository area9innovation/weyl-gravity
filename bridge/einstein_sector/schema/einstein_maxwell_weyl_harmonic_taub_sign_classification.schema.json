      "required": ["theory", "background", "boundaries", "charge_sector", "carrier", "degree", "parity", "ell", "m", "k", "omega"]
    },
    "provenance": {
      "type": "object",
      "required": ["generator_path", "generator_sha256", "inputs"]
    },
    "normalization": {"type": "object"},
    "exact_algebra": {"type": "object"},
    "harmonic_sign_ledger": {
      "type": "object",
      "required": [
        "generic_extra_p_primary",
        "exceptional_extra_ell1",
        "generic_Einstein_q_primary",
        "physical_ell1_standard",
        "homogeneous_generalized_zero",
        "axial_twist_generalized_zero"
      ]
    },
    "finite_sum_theorem": {"type": "object"},
    "charge_fibre_theorem": {"type": "object"},
    "maximal_theorem": {"type": "object"},
    "classification": {
      "type": "object",
      "required": [
        "generic_extra_all_ell_all_k_both_parities_negative",
        "exceptional_extra_ell1_all_k_both_parities_negative",
        "finite_pure_extra_harmonic_sums_negative",
        "opposite_momentum_and_relative_phase_independence",
        "Einstein_q_minus_opposite_sign_all_ell_both_parities",
        "homogeneous_and_twist_solution_cofibers_zero",
        "homogeneous_inertia_and_charge_role_classified",
        "constant_twist_exact_zero_energy_counterexample",
        "variable_magnetic_flux_extension_classified",
        "full_mixed_second_order_cone_classified",
        "causal_or_quantum_claim"
      ],
      "additionalProperties": {"type": "boolean"}
