    "schema_sha256",
    "result_id",
    "result_state",
    "lifecycle_state",
    "dependency_tags",
    "generality_level",
    "scope",
    "provenance",
    "normalization",
    "exact_algebra",
    "harmonic_sign_ledger",
    "finite_sum_theorem",
    "charge_fibre_theorem",
    "maximal_theorem",
