    "provenance": {"type": "object"},
    "domain": {"type": "string"},
    "harmonic_reduction": {"type": "object"},
    "master_matching": {"type": "object"},
    "ell1_quotient": {"type": "object"},
    "covariant_and_bundle_statement": {"type": "object"},
    "classification": {"type": "object"},
    "interpretation": {"type": "string"},
    "next_gate": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "verification_commands": {"type": "array"}
  }
}
