{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "einstein-maxwell-second-order-inclusion-v1",
  "title": "Second-order Einstein-Maxwell inclusion tests at the product background",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_path",
    "schema_sha256",
    "result_id",
    "result_state",
    "lifecycle_state",
    "dependency_tags",
    "provenance",
    "perturbative_convention",
    "adjoint_cokernel_reduction",
    "certified_constant_radion",
    "maxwell_duality_tangent",
    "null_radiative_tangent",
    "classification",
    "interpretation",
    "next_gate",
    "claim_flags",
    "claim_boundary",
    "verification_commands"
  ],
  "properties": {
    "schema": {"const": "einstein-maxwell-second-order-inclusion-v1"},
    "schema_path": {"const": "bridge/einstein_sector/schema/einstein_maxwell_second_order_inclusion.schema.json"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_id": {"const": "EINSTEIN_MAXWELL_SECOND_ORDER_INCLUSION_TEST"},
    "result_state": {"const": "TANGENT_AND_CHARGE_SECTOR_DEPENDENT_SECOND_ORDER_EXTENSION_CLASSIFIED"},
    "lifecycle_state": {"const": "CLASSIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "provenance": {"type": "object"},
    "perturbative_convention": {"type": "object"},
    "adjoint_cokernel_reduction": {"type": "object"},
    "certified_constant_radion": {"type": "object"},
    "maxwell_duality_tangent": {"type": "object"},
    "null_radiative_tangent": {"type": "object"},
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constant_radion_compact_fixed_flux_extension_exists",
        "constant_radion_compact_fixed_flux_adjoint_obstruction_certified",
        "constant_radion_charge_relaxed_extension_constructed",
        "maxwell_duality_compact_fixed_flux_extension_exists",
        "maxwell_duality_compact_fixed_flux_adjoint_obstruction_certified",
        "maxwell_duality_charge_relaxed_exact_extension_constructed",
        "nonzero_chevreton_radiative_fixture_extension_constructed",
        "nonzero_chevreton_defect_is_by_itself_an_obstruction",
        "general_nonlinear_einstein_sector_closure_certified",
        "general_second_order_no_go_certified"
      ]
    },
    "interpretation": {"type": "object"},
    "next_gate": {"type": "object"},
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "local_algebraic_second_order_classification",
        "reduced_mode_fixed_flux_obstruction",
        "general_nonlinear_closure_claim",
        "general_second_order_no_go_claim",
        "lorentzian_causal_claim",
        "observable_embedding_claim",
        "scattering_claim",
        "quantum_claim"
      ]
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
