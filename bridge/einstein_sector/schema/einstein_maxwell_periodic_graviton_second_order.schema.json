{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Einstein-Maxwell periodic gravitational-mode second-order certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "schema_path", "schema_sha256", "result_id", "result_state",
    "lifecycle_state", "dependency_tags", "provenance", "domain",
    "first_order_mode", "chevreton_second_order_time_zero",
    "quadratic_weyl_maxwell_source_time_zero", "adjoint_cokernel_witness",
    "classification", "interpretation", "next_gate", "claim_boundary",
    "verification_commands"
  ],
  "properties": {
    "schema": {"const": "einstein-maxwell-periodic-graviton-second-order-v1"},
    "schema_path": {"type": "string"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_id": {"const": "EINSTEIN_MAXWELL_PERIODIC_GRAVITON_SECOND_ORDER"},
    "result_state": {"const": "PERIODIC_L2_GRAVITATIONAL_MODE_FIXED_CHARGE_OBSTRUCTED"},
    "lifecycle_state": {"const": "CLASSIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "provenance": {"type": "object"},
    "domain": {"type": "object"},
    "first_order_mode": {"type": "object"},
    "chevreton_second_order_time_zero": {"type": "object"},
    "quadratic_weyl_maxwell_source_time_zero": {"type": "object"},
    "adjoint_cokernel_witness": {"type": "object"},
    "classification": {"type": "object"},
    "interpretation": {"type": "string"},
    "next_gate": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "verification_commands": {"type": "array", "items": {"type": "string"}}
  }
}
