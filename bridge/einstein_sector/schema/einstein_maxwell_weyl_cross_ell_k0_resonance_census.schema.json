{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact bounded cross-ell k=0 Weyl-Maxwell resonance census",
  "type": "object",
  "required": [
    "schema", "schema_path", "schema_sha256", "result_id", "result_state",
    "lifecycle_state", "dependency_tags", "generality_level", "domain",
    "provenance", "census", "classification", "interpretation", "next_gate",
    "claim_boundary", "verification_receipt", "verification_commands"
  ],
  "properties": {
    "schema": {"const": "einstein-maxwell-weyl-cross-ell-k0-resonance-census-v1"},
    "lifecycle_state": {"const": "CLASSIFIED"},
    "dependency_tags": {
      "type": "array",
      "contains": {"enum": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]}
    },
    "census": {"type": "object"},
    "classification": {"type": "object"},
    "verification_receipt": {"type": "object"},
    "verification_commands": {"type": "array", "minItems": 3}
  },
  "additionalProperties": true
}
