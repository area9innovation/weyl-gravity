{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/einstein-weyl-exceptional-ell1-nonzero-k-solution-cofiber-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "lifecycle_status", "dependency_tags", "scope", "map_lifecycle", "theorem", "classification", "interpretation", "next_gate", "claim_boundary", "dependency_refs", "source_manifest", "verification_receipt", "verification_commands"],
  "properties": {
    "schema": {"const": "einstein-weyl-exceptional-ell1-nonzero-k-solution-cofiber-v1"},
    "result_id": {"const": "EINSTEIN_WEYL_EXCEPTIONAL_ELL1_NONZERO_K_SOLUTION_COFIBER_V1"},
    "result_state": {"const": "NONZERO_K_EXCEPTIONAL_SOLUTION_COFIBER_AND_ACTION_PAIRING_CERTIFIED"},
    "lifecycle_status": {"const": "CLASSIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "scope": {
