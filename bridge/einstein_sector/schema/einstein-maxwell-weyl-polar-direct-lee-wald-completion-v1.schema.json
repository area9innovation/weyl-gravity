{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "einstein-maxwell-weyl-polar-direct-lee-wald-completion-v1",
  "type": "object",
  "required": [
    "schema", "schema_path", "schema_sha256", "result_id", "result_state",
    "lifecycle_state", "dependency_tags", "provenance", "domain",
    "direct_current", "delta_nabla_C", "reduced_gate_comparison",
    "shell_pullback", "parity_comparison", "controls", "mutations",
    "classification", "claim_boundary", "next_gate", "verification_commands"
  ],
  "properties": {
    "schema": {"const": "einstein-maxwell-weyl-polar-direct-lee-wald-completion-v1"},
    "schema_path": {"const": "bridge/einstein_sector/schema/einstein-maxwell-weyl-polar-direct-lee-wald-completion-v1.schema.json"},
    "schema_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_id": {"const": "EINSTEIN_MAXWELL_WEYL_POLAR_DIRECT_LEE_WALD_COMPLETION_V1"},
    "result_state": {"const": "GENERIC_POLAR_DIRECT_4D_LEE_WALD_COMPLETION_CERTIFIED"},
    "lifecycle_state": {"const": "CLASSIFIED"},
    "dependency_tags": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "LOCAL-ALGEBRAIC"}},
        {"contains": {"const": "REDUCED-MODE"}}
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["generator_path", "generator_sha256", "inputs"],
      "properties": {
        "generator_path": {"type": "string"},
        "generator_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inputs": {
          "type": "object",
          "required": ["polar_full_tensor", "polar_physical_completion", "polar_reduced_gate_comparator", "axial_direct_completion"],
          "properties": {
            "polar_full_tensor": {"$ref": "#/$defs/input"},
            "polar_physical_completion": {"$ref": "#/$defs/input"},
            "polar_reduced_gate_comparator": {"$ref": "#/$defs/input"},
            "axial_direct_completion": {"$ref": "#/$defs/input"}
          },
          "additionalProperties": false
        }
      }
    },
    "domain": {"type": "string"},
    "direct_current": {
      "type": "object",
      "required": ["producer", "field_order", "curvature_momentum", "potential", "generic_direct_current_per_scalar_harmonic_norm", "samples", "spectral_promotion"],
      "properties": {
        "producer": {"type": "string"},
        "field_order": {"const": ["A_t", "B", "C_t", "U"]},
        "curvature_momentum": {"type": "string"},
        "potential": {"type": "string"},
        "generic_direct_current_per_scalar_harmonic_norm": {"type": "array", "minItems": 4, "maxItems": 4},
        "samples": {"type": "array", "minItems": 3, "maxItems": 3},
        "spectral_promotion": {
          "type": "object",
          "required": ["maximum_degree", "degree_bound", "nodes", "no_denominators_or_square_roots", "SO3_equivariance_removes_m_dependence"],
          "properties": {
            "maximum_degree": {"type": "integer", "maximum": 2},
            "degree_bound": {"const": 2},
            "nodes": {"const": [6, 12, 20]},
            "no_denominators_or_square_roots": {"const": true},
            "SO3_equivariance_removes_m_dependence": {"const": true}
          }
        }
      }
    },
    "delta_nabla_C": {
      "type": "object",
      "required": ["sample", "nabla_delta_C_contribution", "delta_connection_on_background_C_contribution", "complete_delta_nabla_C_contribution", "full_direct_entry", "nonzero_evaluation_at_k_1", "omission_mutation_remainder_at_k_1", "retained"],
      "properties": {
        "sample": {"type": "string"},
        "nabla_delta_C_contribution": {"type": "string"},
        "delta_connection_on_background_C_contribution": {"type": "string"},
        "complete_delta_nabla_C_contribution": {"type": "string"},
        "full_direct_entry": {"type": "string"},
        "nonzero_evaluation_at_k_1": {"type": "string"},
        "omission_mutation_remainder_at_k_1": {"type": "string"},
        "retained": {"const": true}
      }
    },
    "reduced_gate_comparison": {
      "type": "object",
      "required": ["role", "remainder"],
      "properties": {
        "role": {"type": "string"},
        "remainder": {"type": "array", "minItems": 4, "maxItems": 4}
      }
    },
    "shell_pullback": {
      "type": "object",
      "required": ["p_shell", "q_shell_in_mu", "extra_representatives_At_B_Ct_U", "Einstein_representative_At_B_Ct_U", "extra_basis_independence_minor", "extra_Hermitian_Gram", "extra_Gram_determinant", "Einstein_extra_cross_block_remainder", "extra_inertia", "Einstein_inertia", "complete_polar_inertia", "radical_dimension_extra", "normalization", "exceptional_collision_locus_formal", "physical_collision_locus"],
      "properties": {
        "p_shell": {"type": "string"},
        "q_shell_in_mu": {"type": "string"},
        "extra_representatives_At_B_Ct_U": {"type": "array"},
        "Einstein_representative_At_B_Ct_U": {"type": "array"},
        "extra_basis_independence_minor": {"type": "string"},
        "extra_Hermitian_Gram": {"type": "array", "minItems": 2, "maxItems": 2},
        "extra_Gram_determinant": {"type": "string"},
        "Einstein_extra_cross_block_remainder": {"const": ["0", "0"]},
        "extra_inertia": {"const": [2, 0]},
        "Einstein_inertia": {"const": [1, 1]},
        "complete_polar_inertia": {"const": [3, 1]},
        "radical_dimension_extra": {"const": 0},
        "normalization": {"type": "string"},
        "exceptional_collision_locus_formal": {"type": "array", "minItems": 6},
        "physical_collision_locus": {"type": "string"}
      }
    },
    "parity_comparison": {"type": "object"},
    "controls": {"type": "object"},
    "mutations": {"type": "object"},
    "classification": {
      "type": "object",
      "required": ["direct_four_dimensional_current_is_producer", "reduced_gate_used_only_as_comparator", "complete_delta_nabla_C_retained", "all_physical_ell_at_least_2", "all_allowed_compact_momenta_including_zero", "extra_polar_block_nonradical", "extra_polar_inertia_2_0", "complete_polar_inertia_3_1", "final_residual_descent_certified", "causal_or_particle_claim", "quantum_positivity_or_unitarity_claim"],
      "properties": {
        "direct_four_dimensional_current_is_producer": {"const": true},
        "reduced_gate_used_only_as_comparator": {"const": true},
        "complete_delta_nabla_C_retained": {"const": true},
        "all_physical_ell_at_least_2": {"const": true},
        "all_allowed_compact_momenta_including_zero": {"const": true},
        "extra_polar_block_nonradical": {"const": true},
        "extra_polar_inertia_2_0": {"const": true},
        "complete_polar_inertia_3_1": {"const": true},
        "final_residual_descent_certified": {"const": false},
        "causal_or_particle_claim": {"const": false},
        "quantum_positivity_or_unitarity_claim": {"const": false}
      }
    },
    "claim_boundary": {"type": "string"},
    "next_gate": {"type": "string"},
    "verification_commands": {"type": "array", "minItems": 4}
  },
  "$defs": {
    "input": {
      "type": "object",
      "required": ["path", "result_id", "sha256", "role"],
      "properties": {
        "path": {"type": "string"},
        "result_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "role": {"enum": ["import", "comparator_only"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
