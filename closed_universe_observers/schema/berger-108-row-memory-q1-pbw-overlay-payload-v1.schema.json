{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-108-row-memory-q1-pbw-overlay-payload-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "blocks", "block_count", "scalar_matrix_shape", "nonzero_matrix_position_count", "serialized_term_count", "entries_canonical_sha256", "row_support", "column_support"],
  "properties": {
    "schema": {"const": "closed-universe-berger-108-row-memory-q1-pbw-overlay-payload-v1"},
    "result_id": {"const": "BERGER_108_ROW_MEMORY_Q1_PBW_OVERLAY_PAYLOAD"},
    "blocks": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "entries"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "entries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["output_row", "input_row", "terms"],
              "properties": {
                "output_row": {"type": "integer", "minimum": 1, "maximum": 108},
                "input_row": {"type": "integer", "minimum": 1, "maximum": 108},
                "terms": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["coefficient", "coefficient_factors", "input_pbw_multiindex"],
                    "properties": {
                      "coefficient": {"type": "object"},
                      "coefficient_factors": {"type": "array"},
                      "input_pbw_multiindex": {
                        "type": "array",
                        "prefixItems": [
                          {"type": "integer", "minimum": 0},
                          {"type": "integer", "minimum": 0},
                          {"type": "integer", "minimum": 0},
                          {"type": "integer", "minimum": 0}
                        ],
                        "items": false,
                        "minItems": 4,
                        "maxItems": 4
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "block_count": {"const": 16},
    "scalar_matrix_shape": {"const": [108, 108]},
    "nonzero_matrix_position_count": {"const": 20},
    "serialized_term_count": {"const": 618},
    "entries_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row_support": {"const": [59, 60, 61, 62, 80, 81, 82, 83]},
    "column_support": {"const": [55, 56, 57, 58, 70, 71, 72, 73]}
  }
}
