{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "berger-correlated-central-scalar-evaluator-v1.schema.json",
  "type": "object",
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "identity", "coverage", "sentinel_audits", "mutation_results", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-berger-correlated-central-scalar-evaluator-v1"},
    "result_id": {"const": "BERGER_CORRELATED_CENTRAL_SCALAR_EVALUATOR"},
    "setting_id": {"type": "string"},
    "claim_status": {"const": "VALIDATED_CORRELATED_CENTRAL_EVEN_P0_SCALAR_EVALUATOR_THROUGH_TWO_J2048_EXPORTED_GENERALIZATION_OPEN"},
    "atlas_status": {"const": "CERTIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 5},
    "identity": {"type": "object"},
    "coverage": {"type": "object", "required": ["evaluated_even_mode_count", "low_rail_overlap_count", "low_rail_overlap_defect_count", "canonical_all_even_modes_sha256"]},
    "sentinel_audits": {"type": "array", "minItems": 6, "maxItems": 6},
    "mutation_results": {"type": "array", "minItems": 1},
    "flags": {
      "type": "object",
      "required": ["EXACT_CENTRAL_LEGENDRE_REDUCTION_EXPORTED", "ALL_CENTRAL_EVEN_P0_OVERLAPS_THROUGH_TWO_J138_PASSED", "TWO_J256_WIDTH_BELOW_ONE_E_MINUS_THREE", "CENTRAL_EVEN_P0_RAIL_THROUGH_TWO_J2048_EXPORTED", "ALL_DIAGONALS_AND_CLOCK_POWERS_EVALUATED", "VALIDATED_INFINITE_MODE_TAIL_UPPER_BOUND_EXPORTED", "FULL_ADVANCED_MAXWELL_GREEN_IMAGE_EVALUATED", "QUANTUM_CLAIM"],
      "properties": {
        "EXACT_CENTRAL_LEGENDRE_REDUCTION_EXPORTED": {"const": true},
        "ALL_CENTRAL_EVEN_P0_OVERLAPS_THROUGH_TWO_J138_PASSED": {"const": true},
        "TWO_J256_WIDTH_BELOW_ONE_E_MINUS_THREE": {"const": true},
        "CENTRAL_EVEN_P0_RAIL_THROUGH_TWO_J2048_EXPORTED": {"const": true},
        "ALL_DIAGONALS_AND_CLOCK_POWERS_EVALUATED": {"const": false},
        "VALIDATED_INFINITE_MODE_TAIL_UPPER_BOUND_EXPORTED": {"const": false},
        "FULL_ADVANCED_MAXWELL_GREEN_IMAGE_EVALUATED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      },
      "additionalProperties": false
    },
    "next_gate": {"const": "GENERALIZE_THE_STABLE_JACOBI_RECURRENCE_TO_ALL_DIAGONALS_AND_CLOCK_POWERS_P0_TO_P28"},
    "claim_boundary": {"type": "string"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
