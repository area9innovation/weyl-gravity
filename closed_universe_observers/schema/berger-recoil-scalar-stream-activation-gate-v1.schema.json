{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "readiness", "sequencing_decision", "mutation_results", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-berger-recoil-scalar-stream-activation-gate-v1"},
    "result_id": {"const": "BERGER_RECOIL_SCALAR_STREAM_ACTIVATION_GATE"},
    "setting_id": {"type": "string"},
    "claim_status": {"type": "string"},
    "atlas_status": {"const": "OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 10, "maxProperties": 10},
    "readiness": {"type": "object", "required": ["internal_rows", "external_rows", "internal_modewise_stream_ready", "numerical_specialization_ready", "four_scalar_stream_active"]},
    "sequencing_decision": {"type": "object"},
    "mutation_results": {"type": "array", "minItems": 2},
    "flags": {"type": "object"},
    "next_gate": {"const": "DECLARE_NUMERICAL_POSITIVE_MASSES_NONZERO_COUPLINGS_AND_INTERVAL_NONZERO_OR_SIGN_STOPPING_GOAL"},
    "claim_boundary": {"type": "string"},
    "provenance": {"type": "object"}
  }
}
