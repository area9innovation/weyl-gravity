{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atlas_status": {"const": "NO_CERTIFIED_MAP"},
    "claim_boundary": {"type": "string"},
    "claim_status": {"const": "NOT_ACTIVATED_AT_REGRADED_RECEIVER_CHAIN_COCHAIN_INCLUSION"},
    "classical_dispositions": {"type": "object"},
    "dependency_refs": {"additionalProperties": {"$ref": "#/$defs/ref"}, "minProperties": 5, "type": "object"},
    "dependency_tags": {"contains": {"const": "LOCAL-ALGEBRAIC"}, "items": {"enum": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]}, "type": "array", "uniqueItems": true},
    "downstream_disposition": {"type": "object"},
    "first_failed_map": {"type": "object"},
    "frequency_ratio_result": {"type": "object"},
    "next_gate": {"type": "string"},
    "payload_ref": {"$ref": "#/$defs/ref"},
    "provenance": {"additionalProperties": false, "properties": {"generator_command": {"type": "string"}, "independent_verifier_command": {"type": "string"}, "source_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["generator_command", "independent_verifier_command", "source_sha256"], "type": "object"},
    "result_id": {"const": "POSITIVE_BERGER_REGRADED_RECEIVER_PHYSICAL_DESCENT_FREQUENCY_RATIO_NOT_ACTIVATED_V1"},
    "schema": {"const": "positive-berger-regraded-receiver-physical-descent-frequency-ratio-not-activated-v1"},
    "setting_id": {"type": "string"}
  },
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "payload_ref", "first_failed_map", "frequency_ratio_result", "classical_dispositions", "downstream_disposition", "next_gate", "claim_boundary", "provenance"],
  "type": "object",
  "$defs": {"ref": {"additionalProperties": false, "properties": {"path": {"type": "string"}, "result_id": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}}, "required": ["path", "result_id", "sha256"], "type": "object"}}
}
