    "preparation_rows": {"type": "array", "minItems": 2, "maxItems": 2},
    "mutation_results": {"type": "array", "minItems": 2},
    "flags": {"type": "object"},
    "next_gate": {"const": "SERIALIZE_COMPLETE_PER_SHELL_PREPARATION_AND_RECOIL_CONTRACTION_FOR_FIXED_TILDE_U_B_WITH_SYMBOLIC_POSITIVE_MASSES"},
    "claim_boundary": {"type": "string"},
    "provenance": {"type": "object"}
  }
}
