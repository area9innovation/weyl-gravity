    "q2_backreaction_row_ledger": {
      "type": "object",
      "required": ["existing_targets", "new_action_third_derivative_orbits", "common_action_cyclicity_audit", "scope"],
      "properties": {
        "existing_targets": {"type": "object"},
        "new_action_third_derivative_orbits": {"type": "array"},
        "common_action_cyclicity_audit": {
          "type": "object",
          "required": ["cyclicity_defect_count"],
