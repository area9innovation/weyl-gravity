      "properties": {
        "EMITTER_FREE_STRESS_TENSOR_EXPORTED": {"const": true},
        "EMITTER_INTERACTION_STRESS_TENSOR_EXPORTED": {"const": true},
        "CLOCK_SWITCH_RECIPROCAL_SOURCE_EXPORTED": {"const": true},
        "EMITTER_STRESS_AND_CLOCK_SWITCH_Q2_BACKREACTION_INCLUDED": {"const": true},
        "EMITTER_ADDED_Q2_COMMON_ACTION_CYCLICITY_CERTIFIED": {"const": true},
        "REDUCED_CLOCK_ENERGY_EXCHANGE_IDENTITY_CERTIFIED": {"const": true},
        "COMPLETE_108_ROW_Q1_Q2_IDENTITY_CERTIFIED": {"const": false},
        "FULL_NONLINEAR_EMITTER_BACKREACTION_INCLUDED": {"const": false},
        "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED": {"const": false},
        "BACKREACTED_GRAVITY_CLOCK_SOLUTION_CONSTRUCTED": {"const": false},
        "FINITE_PARAMETER_108_ROW_GREEN_HYPERBOLICITY_CERTIFIED": {"const": false},
        "FULL_APPARATUS_DIRAC_BRACKET_CERTIFIED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gate": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "provenance": {"type": "object"}
