        "absolute_g2_detector_term": {"const": "0"},
        "first_recoil_order": {"type": "string"},
        "numerical_recoil_coefficient_evaluated": {"const": false},
        "reason": {"type": "string"}
      }
    },
    "mutation_results": {"type": "array", "minItems": 3},
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "EMITTER_FREE_STRESS_TENSOR_EXPORTED",
        "EMITTER_INTERACTION_STRESS_TENSOR_EXPORTED",
        "CLOCK_SWITCH_RECIPROCAL_SOURCE_EXPORTED",
        "EMITTER_STRESS_AND_CLOCK_SWITCH_Q2_BACKREACTION_INCLUDED",
        "EMITTER_ADDED_Q2_COMMON_ACTION_CYCLICITY_CERTIFIED",
        "REDUCED_CLOCK_ENERGY_EXCHANGE_IDENTITY_CERTIFIED",
        "COMPLETE_108_ROW_Q1_Q2_IDENTITY_CERTIFIED",
        "FULL_NONLINEAR_EMITTER_BACKREACTION_INCLUDED",
        "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED",
        "BACKREACTED_GRAVITY_CLOCK_SOLUTION_CONSTRUCTED",
        "FINITE_PARAMETER_108_ROW_GREEN_HYPERBOLICITY_CERTIFIED",
        "FULL_APPARATUS_DIRAC_BRACKET_CERTIFIED",
        "QUANTUM_CLAIM"
