      "properties": {
        "definitions": {"type": "string"},
        "free_emitter_stress": {"type": "string"},
        "interaction_stress": {"type": "string"},
        "clock_phase_source": {"type": "string"},
        "weyl_completion": {"type": "string"},
        "diffeomorphism_completion": {"type": "string"}
      }
