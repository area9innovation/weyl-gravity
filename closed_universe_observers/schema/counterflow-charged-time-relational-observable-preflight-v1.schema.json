{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/counterflow-charged-time-relational-observable-preflight-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "dependency_tags", "dependency_refs", "unrestricted_global_algebra", "local_gauge_rows", "event_map_contract", "clock_monotonicity", "phase_origin_condition", "physical_instantiation_gate", "strict_receiver_contract", "mutation_results", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-counterflow-charged-time-relational-observable-preflight-v1"},
    "result_id": {"const": "COUNTERFLOW_CHARGED_TIME_RELATIONAL_OBSERVABLE_PREFLIGHT_V1"},
    "setting_id": {"const": "unrestricted_two_phase_counterflow_berger_a1_c2_9_over_40"},
    "claim_status": {"const": "CERTIFIED_GAUGE_CLOSED_COVARIANT_EVENT_MAP_CONTRACT_PHYSICAL_INSTANTIATION_OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 6},
    "unrestricted_global_algebra": {"type": "object", "required": ["bracket_psi_Q", "bracket_psi_H_D", "R_label_covariance_defect", "D_label_covariance_defect"], "properties": {"bracket_psi_Q": {"const": "1"}, "bracket_psi_H_D": {"const": "3/4"}, "R_label_covariance_defect": {"const": "0"}, "D_label_covariance_defect": {"const": "0"}}},
    "local_gauge_rows": {"type": "object", "required": ["Diff", "Weyl", "diagonal_U1", "global_not_gauge"]},
    "event_map_contract": {"type": "object", "required": ["formula", "receiver_type", "BV_closure", "representative_independence", "global_covariance", "K_disposition"]},
    "clock_monotonicity": {"type": "object", "required": ["selected_monotone", "monotonicity_condition", "lifted_interval"], "properties": {"selected_monotone": {"const": true}}},
    "phase_origin_condition": {"type": "object", "required": ["exact_condition", "origin_defect", "origin_independent"], "properties": {"origin_defect": {"const": "0"}, "origin_independent": {"const": true}}},
    "physical_instantiation_gate": {"type": "object", "required": ["status", "first_missing_map", "also_open"], "properties": {"status": {"const": "NO_CERTIFIED_MAP"}}},
    "strict_receiver_contract": {"type": "object", "required": ["accepts", "rejects", "output_if_gate_lands"]},
    "mutation_results": {"type": "array", "minItems": 5, "items": {"type": "object", "required": ["name", "detected"], "properties": {"detected": {"const": true}}}},
    "flags": {
      "type": "object", "additionalProperties": false,
      "required": ["CHARGED_TIME_EVENT_MAP_CONTRACT_CERTIFIED", "LOCAL_GAUGE_CLOSURE_AND_REPRESENTATIVE_INDEPENDENCE_CERTIFIED", "GLOBAL_R_D_COVARIANCE_CERTIFIED", "PHASE_ORIGIN_INDEPENDENCE_CONDITION_CERTIFIED", "PHYSICAL_NONTRIVIAL_OBSERVABLE_CERTIFIED", "PHYSICAL_REDSHIFT_CERTIFIED", "ACTION_DERIVED_APPARATUS_CERTIFIED", "DETECTOR_RANK_CERTIFIED", "PARTICLE_OR_PHENOMENOLOGY_CLAIM", "QUANTUM_CLAIM"],
      "properties": {
        "CHARGED_TIME_EVENT_MAP_CONTRACT_CERTIFIED": {"const": true}, "LOCAL_GAUGE_CLOSURE_AND_REPRESENTATIVE_INDEPENDENCE_CERTIFIED": {"const": true}, "GLOBAL_R_D_COVARIANCE_CERTIFIED": {"const": true}, "PHASE_ORIGIN_INDEPENDENCE_CONDITION_CERTIFIED": {"const": true},
        "PHYSICAL_NONTRIVIAL_OBSERVABLE_CERTIFIED": {"const": false}, "PHYSICAL_REDSHIFT_CERTIFIED": {"const": false}, "ACTION_DERIVED_APPARATUS_CERTIFIED": {"const": false}, "DETECTOR_RANK_CERTIFIED": {"const": false}, "PARTICLE_OR_PHENOMENOLOGY_CLAIM": {"const": false}, "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gate": {"type": "string"}, "claim_boundary": {"type": "string"}, "provenance": {"type": "object"}
  }
}
