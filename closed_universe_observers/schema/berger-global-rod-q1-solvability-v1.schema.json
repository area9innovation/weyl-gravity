    "flags": {"type": "object", "additionalProperties": false, "required": ["GLOBAL_ROD_SOURCE_Q1_CLOSED", "GLOBAL_ROD_SOURCE_COKERNEL_PROJECTION_ZERO", "GLOBAL_ROD_SECOND_ORDER_PRIMITIVES_EXPORTED", "ACTION_EULER_HALF_STRESS_NORMALIZATION_CERTIFIED", "GLOBAL_ROD_BACKREACTION_SOLVABLE_THROUGH_ORDER_EPSILON_R_SQUARED", "FULL_NONLINEAR_BACKREACTED_ROD_BRANCH_CERTIFIED", "84_ROW_INTERACTING_COMPLEX_CERTIFIED", "84_ROW_CAUSAL_GREEN_HOMOTOPY_CERTIFIED", "APPARATUS_RECOIL_INCLUDED", "QUANTUM_CLAIM"], "properties": {
      "GLOBAL_ROD_SOURCE_Q1_CLOSED": {"const": true}, "GLOBAL_ROD_SOURCE_COKERNEL_PROJECTION_ZERO": {"const": true}, "GLOBAL_ROD_SECOND_ORDER_PRIMITIVES_EXPORTED": {"const": true}, "ACTION_EULER_HALF_STRESS_NORMALIZATION_CERTIFIED": {"const": true}, "GLOBAL_ROD_BACKREACTION_SOLVABLE_THROUGH_ORDER_EPSILON_R_SQUARED": {"const": true},
      "FULL_NONLINEAR_BACKREACTED_ROD_BRANCH_CERTIFIED": {"const": false}, "84_ROW_INTERACTING_COMPLEX_CERTIFIED": {"const": false}, "84_ROW_CAUSAL_GREEN_HOMOTOPY_CERTIFIED": {"const": false}, "APPARATUS_RECOIL_INCLUDED": {"const": false}, "QUANTUM_CLAIM": {"const": false}
    }},
