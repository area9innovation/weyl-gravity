      "spatial_basis": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/text"}}, "spatial_harmonics": {"const": ["j=0", "j=1"]}, "temporal_frequencies": {"const": ["0", "+sqrt(58)/3", "-sqrt(58)/3"]},
      "phase_span_argument": {"$ref": "#/$defs/text"}, "negative_frequency_argument": {"$ref": "#/$defs/text"}, "two_detector_argument": {"$ref": "#/$defs/text"}
    }},
