    "claim_boundary": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "result_id"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}, "result_id": {"$ref": "#/$defs/text"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "block": {"type": "object", "additionalProperties": false, "required": ["frequency", "operator_shape", "source_basis_shape", "phase_polynomial_basis", "operator_rank", "augmented_ranks", "operator_pivot_columns", "noether_defect_nonzero_count", "source_nonzero_counts", "primitive_nonzero_counts", "canonical_primitives_sparse", "primitive_residual_nonzero_count", "full_stress_mutation_residual_nonzero_count"], "properties": {
      "frequency": {"enum": ["0", "sqrt(58)/3"]}, "operator_shape": {"const": [100, 100]}, "source_basis_shape": {"const": [100, 3]}, "phase_polynomial_basis": {"const": ["cos(z)^2", "sin(z)^2", "cos(z)*sin(z)"]},
      "operator_rank": {"enum": [68, 70]}, "augmented_ranks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": [68, 70]}}, "operator_pivot_columns": {"type": "array", "minItems": 68, "maxItems": 70, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 99}},
      "noether_defect_nonzero_count": {"const": 0}, "source_nonzero_counts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}}, "primitive_nonzero_counts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}},
      "canonical_primitives_sparse": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "array", "minItems": 1, "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 99}, {"$ref": "#/$defs/text"}], "items": false, "minItems": 2, "maxItems": 2}}},
      "primitive_residual_nonzero_count": {"const": 0}, "full_stress_mutation_residual_nonzero_count": {"type": "integer", "minimum": 1}
    }}
