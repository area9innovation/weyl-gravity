      "additionalProperties": false,
      "required": ["EXACT_DETECTOR_CLOCK_PROFILES_SERIALIZED", "EXACT_DETECTOR_RADIAL_PROFILE_FAMILY_SERIALIZED", "DETECTOR_PROFILE_CLOCK_AND_ROD_NORMALIZATION_EXACT", "ADVANCED_DETECTOR_TO_EMITTER_COVECTOR_OPERATOR_EXPORTED", "NUMERICAL_LOCAL_ROD_CHART_RADIUS_EXPORTED", "ADVANCED_MAXWELL_GREEN_IMAGE_EVALUATED", "ADVANCED_MASSIVE_EMITTER_GREEN_IMAGE_EVALUATED", "COORDINATE_LEVEL_EMITTER_CAUCHY_PROFILES_SERIALIZED", "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED", "QUANTUM_CLAIM"],
