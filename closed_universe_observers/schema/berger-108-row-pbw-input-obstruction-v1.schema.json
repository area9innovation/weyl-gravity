        "emitter_switch": {"type": "object", "properties": {"unit_integral_centre_value_ratio_B_over_A": {"const": "2"}, "emitter_q2_clock_and_interaction_coefficients_differ": {"const": true}}, "required": ["unit_integral_centre_value_ratio_B_over_A", "emitter_q2_clock_and_interaction_coefficients_differ"]}
      }
    },
    "later_inputs_not_in_certified_dependency_closure": {"type": "object", "required": ["detector_smearings", "emitter_switches"]},
    "minimal_activation_contract": {"type": "object"},
    "mutation_results": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "properties": {"detected": {"const": true}}, "required": ["name", "detected"]}},
    "flags": {
      "type": "object",
      "required": ["PINNED_64_ROW_PBW_PAYLOAD_VERIFIED", "COVARIANT_108_ROW_Q1_Q2_IDENTITY_PRESERVED", "DEPENDENCY_CLOSURE_PBW_NONUNIQUENESS_CERTIFIED", "SUPPORT_LOCAL_108_ROW_PBW_Q2_PAYLOAD_EXPORTED", "COMPONENT_COEFFICIENT_108_ROW_PBW_REPLAY_CERTIFIED", "FULL_NONLINEAR_EMITTER_BACKREACTION_INCLUDED", "QUANTUM_CLAIM"],
      "properties": {
        "PINNED_64_ROW_PBW_PAYLOAD_VERIFIED": {"const": true},
        "COVARIANT_108_ROW_Q1_Q2_IDENTITY_PRESERVED": {"const": true},
        "DEPENDENCY_CLOSURE_PBW_NONUNIQUENESS_CERTIFIED": {"const": true},
        "SUPPORT_LOCAL_108_ROW_PBW_Q2_PAYLOAD_EXPORTED": {"const": false},
        "COMPONENT_COEFFICIENT_108_ROW_PBW_REPLAY_CERTIFIED": {"const": false},
        "FULL_NONLINEAR_EMITTER_BACKREACTION_INCLUDED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "atlas_status": {"const": "NO_CERTIFIED_MAP"},
    "next_gate": {"const": "DECLARE_108_ROW_COMPONENT_AND_DIFFERENTIAL_COEFFICIENT_JET_CONTRACT_THEN_EXPORT_Q1_AND_Q2_PBW_PAYLOADS"},
