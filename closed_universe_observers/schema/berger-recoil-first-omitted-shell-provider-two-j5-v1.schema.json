{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "mode_scope", "carrier_crosswalk", "support_audit", "detector_provider_extension", "kernel_provider_extension", "mutation_results", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
