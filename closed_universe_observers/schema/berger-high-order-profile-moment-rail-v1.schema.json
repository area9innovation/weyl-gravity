{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "closed-universe-berger-high-order-profile-moment-rail-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "dependency_tags", "dependency_refs", "rail", "normalized_radial_moments", "normalized_clock_secant_moments", "clock_monotonicity_audit", "low_order_compatibility_audit", "mutation_results", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-berger-high-order-profile-moment-rail-v1"},
    "result_id": {"const": "BERGER_HIGH_ORDER_PROFILE_MOMENT_RAIL"},
    "setting_id": {"type": "string", "minLength": 1},
    "claim_status": {"const": "VALIDATED_RADIAL_AND_CLOCK_SECANT_MOMENTS_THROUGH_K50_EXPORTED_SCALAR_STREAM_OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 3, "maxProperties": 3},
    "rail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maximum_k", "maximum_radial_power", "subdivisions", "output_dyadic_bits", "intended_scalar_two_j_maximum"],
      "properties": {
        "maximum_k": {"const": 50},
        "maximum_radial_power": {"const": 102},
        "subdivisions": {"const": 4096},
        "output_dyadic_bits": {"const": 160},
        "intended_scalar_two_j_maximum": {"const": 139}
      }
    },
    "normalized_radial_moments": {"$ref": "#/$defs/momentRows"},
    "normalized_clock_secant_moments": {"$ref": "#/$defs/secantRows"},
    "clock_monotonicity_audit": {"type": "object"},
    "low_order_compatibility_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audited_k", "radial_containment_defect_count", "clock_containment_defect_count"],
      "properties": {
        "audited_k": {"const": [0, 1, 2, 3, 4, 5, 6]},
        "radial_containment_defect_count": {"const": 0},
        "clock_containment_defect_count": {"const": 0}
      }
    },
    "mutation_results": {"type": "array", "minItems": 1, "maxItems": 1},
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["VALIDATED_RADIAL_MOMENTS_K0_TO_50_EXPORTED", "VALIDATED_CLOCK_SECANT_MOMENTS_K0_TO_50_EXPORTED", "LOW_ORDER_CERTIFICATE_COMPATIBILITY_PASSED", "HIGH_MODE_SCALAR_COEFFICIENT_VALUES_EVALUATED", "GREEN_WEIGHTED_OPERATOR_NORM_TAIL_EXPORTED", "FULL_ADVANCED_MAXWELL_GREEN_IMAGE_EVALUATED", "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED", "BERGER_PHYSICAL_BRANCH_TO_DETECTOR_MAP_CERTIFIED", "QUANTUM_CLAIM"],
      "properties": {
        "VALIDATED_RADIAL_MOMENTS_K0_TO_50_EXPORTED": {"const": true},
        "VALIDATED_CLOCK_SECANT_MOMENTS_K0_TO_50_EXPORTED": {"const": true},
        "LOW_ORDER_CERTIFICATE_COMPATIBILITY_PASSED": {"const": true},
        "HIGH_MODE_SCALAR_COEFFICIENT_VALUES_EVALUATED": {"const": false},
        "GREEN_WEIGHTED_OPERATOR_NORM_TAIL_EXPORTED": {"const": false},
        "FULL_ADVANCED_MAXWELL_GREEN_IMAGE_EVALUATED": {"const": false},
        "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED": {"const": false},
        "BERGER_PHYSICAL_BRANCH_TO_DETECTOR_MAP_CERTIFIED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gate": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"}
  },
  "$defs": {
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "width"],
      "properties": {"lower": {"type": "string"}, "upper": {"type": "string"}, "width": {"type": "string"}}
    },
    "momentRows": {
      "type": "array", "minItems": 51, "maxItems": 51,
      "items": {"type": "object", "additionalProperties": false, "required": ["k", "normalized_even_moment"], "properties": {"k": {"type": "integer", "minimum": 0, "maximum": 50}, "normalized_even_moment": {"$ref": "#/$defs/interval"}}}
    },
    "secantRows": {
      "type": "array", "minItems": 51, "maxItems": 51,
      "items": {"type": "object", "additionalProperties": false, "required": ["k", "normalized_expectation"], "properties": {"k": {"type": "integer", "minimum": 0, "maximum": 50}, "normalized_expectation": {"$ref": "#/$defs/interval"}}}
    }
  }
}
