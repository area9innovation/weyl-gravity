      "type": "object", "additionalProperties": false,
      "required": ["hypothesis", "determinant_constant_term", "conclusion", "actual_interacting_deformation_constructed"],
      "properties": {
        "hypothesis": {"$ref": "#/$defs/text"}, "determinant_constant_term": {"const": "C_00*C_11>0"},
        "conclusion": {"$ref": "#/$defs/text"}, "actual_interacting_deformation_constructed": {"const": false}
      }
