      "properties": {
        "rows": {"const": 64}, "scope": {"$ref": "#/$defs/text"}, "repair": {"$ref": "#/$defs/text"},
        "q1_q2_defect_term_counts": {"type": "array", "minItems": 64, "maxItems": 64, "items": {"const": 0}},
        "cyclicity_defect_count": {"const": 0}, "maxwell_stress_backreaction_vertex": {"$ref": "#/$defs/text"},
        "k_berger_arity_two_equivariant": {"const": true}
