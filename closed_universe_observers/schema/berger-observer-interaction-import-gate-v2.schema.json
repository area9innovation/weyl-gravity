  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "dependency_tags", "dependency_refs", "imported_interaction_complex", "probe_baseline", "apparatus_interface_contract", "action_arity_analysis", "formal_rank_stability_lemma", "gauge_and_team_boundary", "mutation_results", "flags", "not_established", "provenance", "claim_boundary"],
  "properties": {
    "schema": {"const": "closed-universe-berger-observer-interaction-import-gate-v2"},
    "result_id": {"const": "BERGER_OBSERVER_APPARATUS_INTERACTION_IMPORT_GATE"},
    "setting_id": {"const": "compact_positive_berger_clock_observer_apparatus_extension"},
