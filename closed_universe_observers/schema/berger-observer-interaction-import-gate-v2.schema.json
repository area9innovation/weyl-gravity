    "apparatus_interface_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "required_blocks", "missing_or_unverified_block_count", "first_typed_obstruction"],
      "properties": {
        "model": {"$ref": "#/$defs/apparatus_model"},
        "required_blocks": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/block"}},
        "missing_or_unverified_block_count": {"const": 15}, "first_typed_obstruction": {"$ref": "#/$defs/text"}
      }
    },
    "action_arity_analysis": {
      "type": "object", "additionalProperties": false,
      "required": ["convention", "ledger", "generic_smooth_profile_scope", "q3_trigger", "q2_only_extension_sufficient_for_generic_smooth_profile"],
      "properties": {
        "convention": {"const": "q_n has n inputs and is paired with the (n+1)-st action derivative"},
        "ledger": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/action_row"}},
        "generic_smooth_profile_scope": {"$ref": "#/$defs/text"}, "q3_trigger": {"$ref": "#/$defs/text"},
        "q2_only_extension_sufficient_for_generic_smooth_profile": {"const": false}
      }
    },
