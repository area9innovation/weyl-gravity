      "type": "object", "additionalProperties": false,
      "required": ["transfer_matrix", "rank", "persistent_records_distinguishable", "status", "extended_q1_exported", "extended_retarded_green_exported"],
      "properties": {
        "transfer_matrix": {"const": [["C_00", "0"], ["0", "C_11"]]}, "rank": {"const": 2},
        "persistent_records_distinguishable": {"const": true}, "status": {"const": "IMPORTED_PROBE_LIMIT_BASELINE_NOT_AN_EXTENDED_LINEAR_THEOREM"},
        "extended_q1_exported": {"const": false}, "extended_retarded_green_exported": {"const": false}
      }
