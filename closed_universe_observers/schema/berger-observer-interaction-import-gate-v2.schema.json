        "REPAIRED_64_ROW_Q2_IMPORTED_EXACTLY": {"const": true}, "PROBE_LIMIT_RANK_TWO_BASELINE_IMPORTED": {"const": true},
        "FORMAL_RANK_TWO_STABILITY_CONDITIONAL_LEMMA": {"const": true}, "COMPOSITE_DETECTOR_POLARIZATION_DECLARED": {"const": true},
        "EXTERNAL_Q_CLOSED_SOURCE_BOUNDARY_DECLARED": {"const": true}, "EXTENDED_APPARATUS_Q1_CERTIFIED": {"const": false},
        "EXTENDED_RETARDED_GREEN_CERTIFIED": {"const": false}, "EXTENDED_LINEAR_RANK_TWO_TRANSFER_CERTIFIED": {"const": false},
        "EXTENDED_Q1_Q2_IDENTITY_CERTIFIED": {"const": false}, "EXTENDED_CYCLICITY_CERTIFIED": {"const": false},
        "K_BERGER_EQUIVARIANCE_WITH_APPARATUS_CERTIFIED": {"const": false}, "RAW_D_DESCENT_WITH_APPARATUS_CERTIFIED": {"const": false},
        "INTERACTING_OBSERVER_DEFORMATION_CONSTRUCTED": {"const": false}, "CLASSICAL_OBSERVER_MAP_CERTIFIED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "not_established": {"type": "array", "minItems": 7, "items": {"$ref": "#/$defs/text"}},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["declared_input_sha256", "source_manifest"],
      "properties": {"declared_input_sha256": {"$ref": "#/$defs/sha256"}, "source_manifest": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/source"}}}
    },
    "claim_boundary": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["path", "result_id", "snapshot_commit", "sha256", "claim_boundary", "live_required_flags"], "properties": {"path": {"$ref": "#/$defs/text"}, "result_id": {"$ref": "#/$defs/text"}, "snapshot_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"$ref": "#/$defs/sha256"}, "claim_boundary": {"$ref": "#/$defs/text"}, "live_required_flags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}}},
    "apparatus_model": {"type": "object", "additionalProperties": false, "required": ["rod_fields", "polarization", "memory_fields", "source_role", "dynamical_emitter_deferred"], "properties": {"rod_fields": {"const": "THREE_DYNAMICAL_RELATIONAL_SCALARS_WITH_BV_PARTNERS_REQUIRED"}, "polarization": {"const": "COMPOSITE_P_A_EQUALS_DTHETA_WEDGE_DRA_NO_INDEPENDENT_POLARIZATION_ROWS"}, "memory_fields": {"const": "DYNAMICAL_PAIRS_MA_PA_WITH_BV_PARTNERS_REQUIRED"}, "source_role": {"const": "EXTERNAL_Q_CLOSED_CONSERVED_SOURCE_AT_THIS_GATE"}, "dynamical_emitter_deferred": {"const": true}}},
    "block": {"type": "object", "additionalProperties": false, "required": ["id", "arity", "owner", "status"], "properties": {"id": {"$ref": "#/$defs/text"}, "arity": {"type": "integer", "minimum": 0, "maximum": 3}, "owner": {"enum": ["NONLINEAR_CLASSICAL_TEAM", "CLOSED_UNIVERSE_TEAM"]}, "status": {"enum": ["NOT_EXPORTED", "NOT_VERIFIED", "NOT_COMPUTED", "CONDITIONAL_LEMMA_ONLY"]}}},
    "action_row": {"type": "object", "additionalProperties": false, "required": ["id", "action_monomial", "action_degree", "induced_operation", "input_arity"], "properties": {"id": {"enum": ["fixed_probe_readout", "linear_relational_readout", "quadratic_relational_readout"]}, "action_monomial": {"$ref": "#/$defs/text"}, "action_degree": {"type": "integer", "minimum": 2, "maximum": 4}, "induced_operation": {"enum": ["q1", "q2", "q3"]}, "input_arity": {"type": "integer", "minimum": 1, "maximum": 3}}},
    "mutation_result": {"type": "object", "additionalProperties": false, "required": ["name", "expected_failed_requirement", "observed_requirement_value", "expected_failure_passed"], "properties": {"name": {"$ref": "#/$defs/text"}, "expected_failed_requirement": {"$ref": "#/$defs/text"}, "observed_requirement_value": {"const": false}, "expected_failure_passed": {"const": true}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
