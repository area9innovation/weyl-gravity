{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-108-row-shifted-q2-phi2-pbw-overlay-payload-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "scalar_matrix_shape", "active_base_shape", "factorial_convention", "coefficient_field", "term_decoder", "Phi2_component_order", "rows", "raw_contraction_count", "normalized_term_count", "nonzero_matrix_position_count", "row_support", "column_support", "derivative_order_histogram", "rows_canonical_sha256"],
  "properties": {
    "schema": {"const": "closed-universe-berger-108-row-shifted-q2-phi2-pbw-overlay-payload-v1"},
    "result_id": {"const": "BERGER_108_ROW_SHIFTED_Q2_PHI2_PBW_OVERLAY_PAYLOAD"},
    "scalar_matrix_shape": {"const": [108, 108]},
    "active_base_shape": {"const": [64, 64]},
    "factorial_convention": {"const": "suspended-graded-symmetric-factorial-v1"},
    "coefficient_field": {"type": "string"},
    "term_decoder": {"type": "string"},
    "Phi2_component_order": {"const": ["00", "01", "02", "03", "11", "12", "13", "22", "23", "33"]},
    "rows": {
      "type": "array", "minItems": 64, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["output", "terms"],
        "properties": {
          "output": {"type": "integer", "minimum": 0, "maximum": 63},
          "terms": {"type": "array", "items": {"$ref": "#/$defs/term"}}
        }
      }
    },
    "raw_contraction_count": {"const": 185930},
    "normalized_term_count": {"const": 92965},
    "nonzero_matrix_position_count": {"const": 310},
    "row_support": {"type": "array"},
    "column_support": {"type": "array"},
    "derivative_order_histogram": {"type": "array"},
    "rows_canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "exactRational": {"oneOf": [{"type": "integer"}, {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "not": {"const": 0}}}}]},
    "quadraticNumber": {"type": "object", "additionalProperties": false, "required": ["rational", "sqrt10"], "properties": {"rational": {"$ref": "#/$defs/exactRational"}, "sqrt10": {"$ref": "#/$defs/exactRational"}}},
    "multiindex": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
    "term": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 63},
        {"$ref": "#/$defs/multiindex"},
        {"type": "integer", "minimum": 0, "maximum": 9},
        {"$ref": "#/$defs/multiindex"},
        {"$ref": "#/$defs/quadraticNumber"}
      ]
    }
  }
}
