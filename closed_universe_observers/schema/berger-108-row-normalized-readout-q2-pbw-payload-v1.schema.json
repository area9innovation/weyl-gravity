{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "shape", "coefficient_field", "pbw_basis", "factorial_convention", "source_action", "J_vertical_coordinate_order", "first_variation_source_counts", "block_hashes", "rows", "nonzero_output_rows", "operator_key_count", "serialized_term_count", "canonical_sha256"],
  "properties": {
    "schema": {"const": "closed-universe-berger-108-row-normalized-readout-q2-pbw-payload-v1"},
    "result_id": {"const": "BERGER_108_ROW_NORMALIZED_READOUT_Q2_PBW_PAYLOAD"},
    "shape": {"const": [108, 108, 108]},
    "coefficient_field": {"type": "string"},
    "pbw_basis": {"type": "string"},
    "factorial_convention": {"const": "suspended-graded-symmetric-factorial-v1"},
    "source_action": {"type": "string"},
    "J_vertical_coordinate_order": {"type": "array", "minItems": 26, "maxItems": 26, "uniqueItems": true},
    "first_variation_source_counts": {"type": "object", "required": ["D0", "D1"]},
    "block_hashes": {"type": "object", "minProperties": 6, "maxProperties": 6},
    "rows": {"type": "array", "minItems": 1},
    "nonzero_output_rows": {"type": "array", "minItems": 1, "uniqueItems": true},
    "operator_key_count": {"type": "integer", "minimum": 1},
    "serialized_term_count": {"type": "integer", "minimum": 1},
    "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
