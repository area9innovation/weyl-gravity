{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "result_id",
    "setting_id",
    "claim_status",
    "atlas_status",
    "dependency_tags",
    "dependency_refs",
    "payload_ref",
    "gate_results",
    "ansatz_result",
    "first_obstruction",
    "next_gate",
    "claim_boundary",
    "provenance"
  ],
  "properties": {
    "schema": {"const": "closed-universe-berger-replacement112-132-defect-minimal-nilpotent-repair-no-go-v1"},
    "result_id": {"const": "BERGER_REPLACEMENT112_132_DEFECT_MINIMAL_NILPOTENT_REPAIR_NO_GO"},
    "claim_status": {"const": "OBSTRUCTED_COMPLETE_LOCAL_ACTION_HESSIAN_ANSATZ_HAS_NO_NILPOTENT_REPAIR"},
    "atlas_status": {"const": "OBSTRUCTED"},
    "dependency_tags": {
      "type": "array",
      "contains": {"const": "LOCAL-ALGEBRAIC"}
    },
    "dependency_refs": {"type": "object", "minProperties": 8},
    "payload_ref": {
      "type": "object",
      "required": ["path", "result_id", "sha256", "canonical_sha256"]
    },
    "gate_results": {"type": "object"},
    "ansatz_result": {
      "type": "object",
      "required": [
        "raw_dimension",
        "integrability_rank",
        "action_orbit_dimension",
        "background_preserving_dimension",
        "nilpotency_coefficient_rank",
        "nilpotency_augmented_rank"
      ]
    },
    "first_obstruction": {
      "type": "object",
      "required": [
        "output_index",
        "output_row_id",
        "input_index",
        "input_row_id",
        "input_pbw_word",
        "time_mode",
        "basis_monomial",
        "correction_coefficient",
        "right_hand_side"
      ]
    },
    "claim_boundary": {"type": "string", "minLength": 1000},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
