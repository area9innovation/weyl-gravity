    "factor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "vertical_multiindex", "spacetime_multiindex"],
      "properties": {
        "kind": {"enum": ["parameter", "profile", "background"]},
        "name": {"type": "string", "minLength": 1},
        "vertical_multiindex": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0}
        },
        "spacetime_multiindex": {"$ref": "#/$defs/multiindex4"}
      }
    },
    "term": {
