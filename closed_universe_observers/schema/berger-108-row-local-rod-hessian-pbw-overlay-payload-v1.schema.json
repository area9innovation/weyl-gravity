          "type": "array",
          "items": {"$ref": "#/$defs/factor"}
        },
        "input_pbw_multiindex": {"$ref": "#/$defs/multiindex4"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_row", "input_row", "terms"],
      "properties": {
        "output_row": {"type": "integer", "minimum": 0, "maximum": 107},
        "input_row": {"type": "integer", "minimum": 0, "maximum": 107},
        "terms": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/term"}
        }
      }
    }
