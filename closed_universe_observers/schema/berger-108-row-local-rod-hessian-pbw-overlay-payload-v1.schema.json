      "properties": {
        "rational": {"$ref": "#/$defs/rational"},
        "sqrt10": {"$ref": "#/$defs/rational"}
      }
    },
    "multiindex4": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "items": false,
      "minItems": 4
