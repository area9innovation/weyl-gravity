{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "atlas_status": {"const": "OBSTRUCTED"},
    "claim_boundary": {"type": "string"},
    "claim_status": {"const": "OBSTRUCTED_BY_CERTIFIED_GRADING_AND_PAIRING_DEGREE_MISMATCH"},
    "dependency_refs": {
      "additionalProperties": {"$ref": "#/$defs/ref"},
      "minProperties": 6,
      "type": "object"
    },
    "dependency_tags": {
      "contains": {"const": "LOCAL-ALGEBRAIC"},
      "items": {"enum": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]},
      "type": "array",
      "uniqueItems": true
    },
    "downstream_disposition": {"type": "object"},
    "input_gate": {"type": "object"},
    "next_gate": {"type": "string"},
    "obstruction": {"type": "object"},
    "payload_ref": {"$ref": "#/$defs/ref"},
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "generator_command": {"type": "string"},
        "independent_verifier_command": {"type": "string"},
        "source_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["generator_command", "independent_verifier_command", "source_sha256"],
      "type": "object"
    },
    "result_id": {"const": "POSITIVE_BERGER_RECEIVER_BV_COCYCLE_INTEGRATION_GRADING_OBSTRUCTION_V1"},
    "schema": {"const": "positive-berger-receiver-bv-cocycle-integration-grading-obstruction-v1"},
    "setting_id": {"type": "string"}
  },
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "payload_ref", "input_gate", "obstruction", "downstream_disposition", "next_gate", "claim_boundary", "provenance"],
  "type": "object",
  "$defs": {
    "ref": {
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "result_id": {"type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "result_id", "sha256"],
      "type": "object"
    }
  }
}
