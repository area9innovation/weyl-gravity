        "DELETED_SCALAR_COMPANION_MUTATION_REJECTED": {"const": true},
        "THIRTY_THREE_ON_SUPPORT_FORM_COMPANIONS_EVALUATED": {"const": false},
        "SELECTED_INPUT_RAIL_CHARGE_BLOCK_CLOSED": {"const": false},
        "TEMPORAL_FUNCTIONAL_CALCULUS_APPLIED": {"const": false},
        "VALIDATED_INFINITE_MODE_TAIL_UPPER_BOUND_EXPORTED": {"const": false},
        "GREEN_IMAGES_EVALUATED": {"const": false},
        "DETECTOR_RESPONSE_EVALUATED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
