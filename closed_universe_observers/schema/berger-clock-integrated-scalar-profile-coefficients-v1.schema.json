{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/closed-universe/berger-clock-integrated-scalar-profile-coefficients-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "dependency_tags", "dependency_refs", "clock_reduction", "clock_secant_moment_enclosures", "audited_clock_integrated_coefficients", "mutation_results", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-berger-clock-integrated-scalar-profile-coefficients-v1"},
    "result_id": {"const": "BERGER_CLOCK_INTEGRATED_SCALAR_PROFILE_COEFFICIENTS"},
    "setting_id": {"type": "string", "minLength": 1},
    "claim_status": {"const": "VALIDATED_CLOCK_INTEGRATED_SCALAR_COEFFICIENTS_THROUGH_TWO_J4_EXPORTED_FORM_AND_TAIL_OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 3, "maxProperties": 3},
    "clock_reduction": {"type": "object", "required": ["lambda_squared", "subdivisions", "interval_precision", "output_dyadic_bits"], "properties": {"lambda_squared": {"const": "29/41472"}, "subdivisions": {"const": 32768}, "interval_precision": {"const": 50}, "output_dyadic_bits": {"const": 160}}},
    "clock_secant_moment_enclosures": {"type": "array", "minItems": 7, "maxItems": 7},
    "audited_clock_integrated_coefficients": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["two_j", "dimension", "off_diagonal_nonzero_enclosure_count", "diagonal"],
        "properties": {
          "two_j": {"type": "integer", "minimum": 0, "maximum": 4},
          "dimension": {"type": "integer", "minimum": 1, "maximum": 5},
          "off_diagonal_nonzero_enclosure_count": {"const": 0},
          "diagonal": {"type": "array", "minItems": 1, "maxItems": 5}
        }
      }
    },
    "mutation_results": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"type": "object", "required": ["name", "detected", "correct_lambda_squared", "mutated_lambda_squared"], "properties": {"name": {"const": "treat_clock_phase_as_physical_time"}, "detected": {"const": true}, "correct_lambda_squared": {"const": "29/41472"}, "mutated_lambda_squared": {"const": "29/73728"}}}},
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CLOCK_RATE_CONVERSION_APPLIED", "VALIDATED_CLOCK_SECANT_MOMENTS_EXPORTED", "CLOCK_INTEGRATED_SCALAR_COEFFICIENTS_TWO_J0_TO_4_EXPORTED", "FULL_FORM_VALUED_SOURCE_COEFFICIENTS_EVALUATED", "MODES_ABOVE_TWO_J4_EVALUATED", "EVALUATED_SOBOLEV_NORM_EXPORTED", "VALIDATED_INFINITE_MODE_TAIL_BOUND_EXPORTED", "ADVANCED_GREEN_IMAGES_EVALUATED", "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED", "QUANTUM_CLAIM"],
      "properties": {
        "CLOCK_RATE_CONVERSION_APPLIED": {"const": true},
        "VALIDATED_CLOCK_SECANT_MOMENTS_EXPORTED": {"const": true},
        "CLOCK_INTEGRATED_SCALAR_COEFFICIENTS_TWO_J0_TO_4_EXPORTED": {"const": true},
        "FULL_FORM_VALUED_SOURCE_COEFFICIENTS_EVALUATED": {"const": false},
        "MODES_ABOVE_TWO_J4_EVALUATED": {"const": false},
        "EVALUATED_SOBOLEV_NORM_EXPORTED": {"const": false},
        "VALIDATED_INFINITE_MODE_TAIL_BOUND_EXPORTED": {"const": false},
        "ADVANCED_GREEN_IMAGES_EVALUATED": {"const": false},
        "DETECTOR_RECOIL_NUMERICAL_COEFFICIENT_EVALUATED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gate": {"type": "string", "minLength": 1},
    "claim_boundary": {"type": "string", "minLength": 1},
    "provenance": {"type": "object"}
  }
}
