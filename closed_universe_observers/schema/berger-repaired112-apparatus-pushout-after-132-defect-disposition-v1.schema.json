  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "payload_ref", "gate_results", "exact_nonactivation_separator", "minimal_escape_signature", "next_gate", "claim_boundary", "provenance"],
  "properties": {
