{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "claim_status", "dependency_tags", "dependency_refs", "legacy_source_refs",
    "maximal_candidate_definition", "maximal_candidate_replay", "nonmaximal_disposition", "operational_ratio_theorem",
    "conditional_map_disposition", "coordinate_control", "producer_request", "mutation_results", "flags",
    "next_gate", "claim_boundary", "provenance"
  ],
  "properties": {
    "schema": {"const": "closed-universe-berger-legacy-receiver-operational-frequency-ratio-nonactivation-v1"},
    "result_id": {"const": "BERGER_LEGACY_RECEIVER_OPERATIONAL_FREQUENCY_RATIO_NONACTIVATION_V1"},
    "claim_status": {"const": "CERTIFIED_OPERATIONAL_FREQUENCY_RATIO_NONACTIVATION_ON_LEGACY_CENSUS"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 2, "maxProperties": 2},
    "legacy_source_refs": {"type": "object", "minProperties": 7, "maxProperties": 7},
    "maximal_candidate_definition": {"type": "string"},
    "maximal_candidate_replay": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidate_id", "component_keys", "response_rank", "retarded_dependence", "first_missing_condition", "independent_witness", "ratio_status"],
        "properties": {
          "candidate_id": {"type": "string"},
          "component_keys": {"type": "array", "minItems": 2, "uniqueItems": true},
          "response_rank": {"const": 2},
          "retarded_dependence": {"const": "CERTIFIED_PREQUOTIENT"},
          "first_missing_condition": {"type": "string"},
          "independent_witness": {"type": "string"},
          "ratio_status": {"const": "UNDEFINED_NO_PHYSICAL_RECEIVER"}
        }
      }
    },
    "nonmaximal_disposition": {"type": "object", "minProperties": 4},
    "operational_ratio_theorem": {
      "type": "object",
      "required": ["definition", "domain_conditions", "domain_on_legacy_census", "result", "not_zero_ratio", "not_nonexistence_theorem"],
      "properties": {
        "domain_on_legacy_census": {"const": "EMPTY"},
        "result": {"const": "UNDEFINED_NO_PHYSICAL_RECEIVER"},
        "not_zero_ratio": {"const": true},
        "not_nonexistence_theorem": {"const": true}
      }
    },
    "conditional_map_disposition": {"type": "object"},
    "coordinate_control": {
      "type": "object",
      "required": ["carrier", "frequencies", "exact_ratio", "status"],
      "properties": {
        "exact_ratio": {"const": "1"},
        "status": {"const": "COORDINATE_CONTROL_ONLY_NOT_OPERATIONAL_REDSHIFT"}
      }
    },
    "producer_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "path", "id", "sha256", "smallest_common_missing_datum"],
      "properties": {
        "count": {"const": 1},
        "path": {"type": "string"},
        "id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "smallest_common_missing_datum": {"type": "string"}
      }
    },
    "mutation_results": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "required": ["name", "detected", "classification"],
        "properties": {"detected": {"const": true}}
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "EVERY_MAXIMAL_LINEAR_CANDIDATE_REPLAYED", "EXACTLY_ONE_TYPED_PRODUCER_REQUEST_EMITTED",
        "OPERATIONAL_FREQUENCY_RATIO_DEFINED", "COORDINATE_RATIO_PROMOTED_AS_REDSHIFT",
        "ADVANCED_MAP_PROMOTED_AS_SIGNAL", "PHYSICAL_RECEIVER_PROMOTED", "NONLINEAR_MEMORY_CLAIM",
        "PARTICLE_CLAIM", "QUANTUM_CLAIM"
      ],
      "properties": {
        "EVERY_MAXIMAL_LINEAR_CANDIDATE_REPLAYED": {"const": true},
        "EXACTLY_ONE_TYPED_PRODUCER_REQUEST_EMITTED": {"const": true},
        "OPERATIONAL_FREQUENCY_RATIO_DEFINED": {"const": false},
        "COORDINATE_RATIO_PROMOTED_AS_REDSHIFT": {"const": false},
        "ADVANCED_MAP_PROMOTED_AS_SIGNAL": {"const": false},
        "PHYSICAL_RECEIVER_PROMOTED": {"const": false},
        "NONLINEAR_MEMORY_CLAIM": {"const": false},
        "PARTICLE_CLAIM": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gate": {"type": "string"},
    "claim_boundary": {"type": "string"},
    "provenance": {"type": "object"}
  }
}
