{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/closed-universe/berger-localized-detector-records-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "dependency_tags", "dependency_refs", "rod_solution_contract", "causal_geometry", "detector_smearings", "smearing_independence", "probe_memory_registers", "next_transfer_gate", "gauge_and_quotient_tests", "mutation_results", "flags", "assumptions", "not_established", "provenance", "claim_boundary"],
  "properties": {
    "schema": {"const": "closed-universe-berger-localized-detector-records-v2"},
    "result_id": {"const": "BERGER_LOCALIZED_CLOCK_DETECTOR_RECORDS"},
    "setting_id": {"const": "compact_positive_berger_clock_fixed_coupling_probe_apparatus"},
    "claim_status": {"const": "CERTIFIED_LOCAL_ROD_SMEARING_AND_MEMORY_PREFLIGHT_RETARDED_TRANSFER_OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": {"$ref": "#/$defs/dependency"}},
    "rod_solution_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "cauchy_data", "local_existence", "jacobians", "jacobian_determinants", "compact_window_rule", "probe_limit"],
      "properties": {
        "action": {"$ref": "#/$defs/text"}, "cauchy_data": {"$ref": "#/$defs/text"},
        "local_existence": {"$ref": "#/$defs/text"},
        "jacobians": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/matrix"}},
        "jacobian_determinants": {"const": ["1", "1"]},
        "compact_window_rule": {"$ref": "#/$defs/text"}, "probe_limit": {"$ref": "#/$defs/text"}
      }
    },
    "causal_geometry": {
      "type": "object", "additionalProperties": false,
      "required": ["emitter_clock_label", "emitter_hopf_arclength", "clock_rate", "detector_travel_distances", "central_null_incidence_residuals", "half_fibre_length", "certified_half_fibre_lower_bound", "unique_no_wrap_centers", "boundary"],
      "properties": {
        "emitter_clock_label": {"const": "0"}, "emitter_hopf_arclength": {"const": "0"}, "clock_rate": {"const": "3/4"},
        "detector_travel_distances": {"const": ["1/4", "1/2"]}, "central_null_incidence_residuals": {"const": ["0", "0"]},
        "half_fibre_length": {"const": "3*sqrt(10)*pi/10"}, "certified_half_fibre_lower_bound": {"const": "9/4"},
        "unique_no_wrap_centers": {"const": true}, "boundary": {"$ref": "#/$defs/text"}
      }
    },
    "detector_smearings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/detector"}},
    "smearing_independence": {
      "type": "object", "additionalProperties": false,
      "required": ["construction", "evaluation_matrix", "rank", "not_input_labels"],
      "properties": {
        "construction": {"$ref": "#/$defs/text"}, "evaluation_matrix": {"const": [["1", "0"], ["0", "1"]]},
        "rank": {"const": 2}, "not_input_labels": {"const": true}
      }
    },
    "probe_memory_registers": {
      "type": "object", "additionalProperties": false,
      "required": ["action", "equations", "probe_branch", "final_record", "persistence", "backreaction"],
      "properties": {
        "action": {"$ref": "#/$defs/text"}, "equations": {"const": ["d_Theta m_a=q_a(Theta;F)", "d_Theta p_a=0"]},
        "probe_branch": {"const": "p_a=0"}, "final_record": {"$ref": "#/$defs/text"},
        "persistence": {"$ref": "#/$defs/text"}, "backreaction": {"$ref": "#/$defs/text"}
      }
    },
    "next_transfer_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "matrix", "required_witnesses", "status"],
      "properties": {
        "name": {"const": "BERGER_SMEARED_RETARDED_TWO_SOURCE_TWO_DETECTOR_TRANSFER"},
        "matrix": {"const": "M_ab=Q_a[d G_ret J_b]"},
        "required_witnesses": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/text"}},
        "status": {"const": "OPEN"}
      }
    },
    "gauge_and_quotient_tests": {
      "type": "object", "additionalProperties": false,
      "required": ["Diff", "Weyl", "Maxwell_gauge", "raw_D", "K_Berger"],
      "properties": {
        "Diff": {"const": "PASS_FOR_LOCAL_RELATIONAL_PROBE_FUNCTIONALS"},
        "Weyl": {"const": "PASS_FOR_LOCAL_RELATIONAL_PROBE_FUNCTIONALS"}, "Maxwell_gauge": {"const": "PASS"},
        "raw_D": {"const": "OPEN_WITH_ROD_MEMORY_SECTOR_NOT_IN_IMPORTED_PHASE_SPACE"},
        "K_Berger": {"const": "OPEN_WITH_ROD_MEMORY_SECTOR_NOT_IN_IMPORTED_INTERACTING_COMPLEX"}
      }
    },
    "mutation_results": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/mutation"}},
    "flags": {
      "type": "object", "additionalProperties": false,
      "required": ["LOCAL_STANDARD_SIGN_ROD_SOLUTIONS", "ROD_JACOBIANS_NONDEGENERATE_ON_SOME_LOCAL_WINDOWS", "TWO_LOCALIZED_CLOCK_LABELLED_DETECTOR_SMEARINGS", "DETECTOR_SMEARING_FUNCTIONALS_INDEPENDENT", "CENTRAL_HOPF_NULL_INTERSECTIONS_NO_WRAP", "PERSISTENT_PROBE_MEMORY_REGISTERS", "SMEARED_RETARDED_TRANSFER_MATRIX_RANK_TWO", "TWO_NONZERO_RETARDED_MEMORY_RECORDS", "ROD_BACKREACTION_AND_APPARATUS_RECOIL_INCLUDED", "D_DESCENT_WITH_RODS_CERTIFIED", "CLASSICAL_OBSERVER_MAP_CERTIFIED", "QUANTUM_CLAIM"],
      "properties": {
        "LOCAL_STANDARD_SIGN_ROD_SOLUTIONS": {"const": true},
        "ROD_JACOBIANS_NONDEGENERATE_ON_SOME_LOCAL_WINDOWS": {"const": true},
        "TWO_LOCALIZED_CLOCK_LABELLED_DETECTOR_SMEARINGS": {"const": true},
        "DETECTOR_SMEARING_FUNCTIONALS_INDEPENDENT": {"const": true},
        "CENTRAL_HOPF_NULL_INTERSECTIONS_NO_WRAP": {"const": true},
        "PERSISTENT_PROBE_MEMORY_REGISTERS": {"const": true},
        "SMEARED_RETARDED_TRANSFER_MATRIX_RANK_TWO": {"const": false},
        "TWO_NONZERO_RETARDED_MEMORY_RECORDS": {"const": false},
        "ROD_BACKREACTION_AND_APPARATUS_RECOIL_INCLUDED": {"const": false},
        "D_DESCENT_WITH_RODS_CERTIFIED": {"const": false},
        "CLASSICAL_OBSERVER_MAP_CERTIFIED": {"const": false}, "QUANTUM_CLAIM": {"const": false}
      }
    },
    "assumptions": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/text"}},
    "not_established": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/text"}},
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["declared_input_sha256", "source_manifest"],
      "properties": {
        "declared_input_sha256": {"$ref": "#/$defs/sha256"},
        "source_manifest": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "claim_boundary": {"$ref": "#/$defs/text"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "result_id", "snapshot_commit", "sha256", "claim_boundary", "live_required_flags"],
      "properties": {
        "path": {"$ref": "#/$defs/text"}, "result_id": {"$ref": "#/$defs/text"},
        "snapshot_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"$ref": "#/$defs/sha256"},
        "claim_boundary": {"$ref": "#/$defs/text"},
        "live_required_flags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      }
    },
    "detector": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "clock_label", "hopf_arclength", "rod_center", "rod_radius", "polarization", "smearing", "normalized_dual_probe"],
      "properties": {
        "id": {"enum": ["D0", "D1"]}, "clock_label": {"type": "string"}, "hopf_arclength": {"type": "string"},
        "rod_center": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "rod_radius": {"type": "string"}, "polarization": {"type": "string"},
        "smearing": {"$ref": "#/$defs/text"}, "normalized_dual_probe": {"$ref": "#/$defs/text"}
      }
    },
    "mutation": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "expected_failed_requirement", "observed_requirement_value", "observed_record_rank", "expected_failure_passed"],
      "properties": {
        "name": {"$ref": "#/$defs/text"},
        "expected_failed_requirement": {"enum": ["rod_solutions_nondegenerate", "clock_labels_distinct", "central_null_incidence_exact", "central_rays_unique_no_wrap", "record_functionals_independent"]},
        "observed_requirement_value": {"const": false}, "observed_record_rank": {"type": "integer", "minimum": 1, "maximum": 2},
        "expected_failure_passed": {"const": true}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"],
      "properties": {"role": {"$ref": "#/$defs/text"}, "path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
