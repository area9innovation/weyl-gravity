{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "result_id",
    "setting_id",
    "claim_status",
    "atlas_status",
    "dependency_tags",
    "dependency_refs",
    "payload_ref",
    "gate_results",
    "next_gate",
    "claim_boundary",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "closed-universe-berger-replacement-112-positive-mixed-action-v1"
    },
    "result_id": {
      "const": "BERGER_REPLACEMENT_112_POSITIVE_MIXED_ACTION_UNARY"
    },
    "atlas_status": {"const": "CERTIFIED"},
    "dependency_tags": {
      "type": "array",
      "allOf": [
        {"contains": {"const": "LOCAL-ALGEBRAIC"}},
        {"contains": {"const": "LORENTZIAN-CAUSAL"}}
      ]
    },
    "dependency_refs": {"type": "object", "minProperties": 8},
    "payload_ref": {
      "type": "object",
      "required": ["path", "result_id", "sha256", "canonical_sha256"]
    },
    "gate_results": {
      "type": "object",
      "properties": {
        "positive_mixed_action": {"const": "CERTIFIED"},
        "background_stress_and_Phi2": {"const": "CERTIFIED"},
        "complete_112_unary": {"const": "CERTIFIED"}
      },
      "required": [
        "positive_mixed_action",
        "background_stress_and_Phi2",
        "complete_112_unary"
      ]
    },
    "claim_boundary": {"type": "string", "minLength": 1400},
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
