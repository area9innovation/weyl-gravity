{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "berger-correlated-axial-oscillatory-evaluator-v1.schema.json",
  "type": "object",
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "quadrature", "low_rail_audits", "high_axial_sentinel_audits", "canonical_high_sentinel_sha256", "resolution_mutation", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-berger-correlated-axial-oscillatory-evaluator-v1"},
    "result_id": {"const": "BERGER_CORRELATED_AXIAL_OSCILLATORY_EVALUATOR"},
    "setting_id": {"type": "string"},
