    "atlas_status": {"const": "CERTIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {"type": "object", "minProperties": 4},
    "quadrature": {"type": "object"},
    "low_rail_audits": {"type": "array", "minItems": 5, "maxItems": 5},
    "high_axial_sentinel_audits": {"type": "array", "minItems": 2, "maxItems": 2},
    "canonical_high_sentinel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "resolution_mutation": {"type": "object"},
    "flags": {
      "type": "object",
      "required": ["CORRELATED_EXTREME_AXIAL_P0_EVALUATOR_EXPORTED", "LOW_R0_TWO_J0_TO_4_OVERLAPS_PASSED", "TWO_J975_AND_2047_AXIAL_WIDTHS_BELOW_ONE_TENTH", "COARSE_GRID_RESOLUTION_MUTATION_REJECTED", "COMPLETE_AXIAL_RAIL_EXPORTED", "ALL_DIAGONALS_AND_CLOCK_POWERS_STABLY_EVALUATED", "VALIDATED_INFINITE_MODE_TAIL_UPPER_BOUND_EXPORTED", "DETECTOR_RESPONSE_EVALUATED", "QUANTUM_CLAIM"],
      "properties": {
        "CORRELATED_EXTREME_AXIAL_P0_EVALUATOR_EXPORTED": {"const": true},
        "LOW_R0_TWO_J0_TO_4_OVERLAPS_PASSED": {"const": true},
        "TWO_J975_AND_2047_AXIAL_WIDTHS_BELOW_ONE_TENTH": {"const": true},
        "COARSE_GRID_RESOLUTION_MUTATION_REJECTED": {"const": true},
        "COMPLETE_AXIAL_RAIL_EXPORTED": {"const": false},
        "ALL_DIAGONALS_AND_CLOCK_POWERS_STABLY_EVALUATED": {"const": false},
        "VALIDATED_INFINITE_MODE_TAIL_UPPER_BOUND_EXPORTED": {"const": false},
        "DETECTOR_RESPONSE_EVALUATED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      },
      "additionalProperties": false
    },
    "next_gate": {"const": "STREAM_THE_CORRELATED_AXIAL_EVALUATOR_AND_EXTEND_IT_ACROSS_INTERMEDIATE_JACOBI_DIAGONALS"},
    "claim_boundary": {"type": "string"},
    "provenance": {"type": "object"}
  },
  "additionalProperties": false
}
