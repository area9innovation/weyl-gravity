      "type": "object", "additionalProperties": false,
      "required": ["basis_index", "reflected_basis_index", "m", "clock_integrated_local_amplitude"],
      "properties": {
        "basis_index": {"type": "integer", "minimum": 0, "maximum": 69},
        "reflected_basis_index": {"type": "integer", "minimum": 0, "maximum": 139},
        "m": {"type": "string"},
