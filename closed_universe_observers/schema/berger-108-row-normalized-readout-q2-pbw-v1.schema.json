{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "setting_id", "claim_status", "atlas_status", "dependency_tags", "dependency_refs", "payload_ref", "first_jet_and_cyclicity_audit", "mutation_results", "activation_disposition", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "closed-universe-berger-108-row-normalized-readout-q2-pbw-v1"},
    "result_id": {"const": "BERGER_108_ROW_NORMALIZED_READOUT_Q2_PBW"},
    "setting_id": {"type": "string"},
    "claim_status": {"const": "CERTIFIED_COMPLETE_NORMALIZED_READOUT_Q2_PBW_SUBBLOCK"},
    "atlas_status": {"const": "CERTIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "dependency_refs": {"type": "object", "minProperties": 5, "maxProperties": 5},
    "payload_ref": {"type": "object"},
    "first_jet_and_cyclicity_audit": {"type": "object", "properties": {"direct_symbolic_defect_count": {"const": 0}, "component_replay_defect_count": {"const": 0}, "graded_symmetry_defect_count": {"const": 0}}},
    "mutation_results": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "properties": {"detected": {"const": true}}}},
    "activation_disposition": {"type": "object", "properties": {"normalized_readout_q2_subblock_exported": {"const": true}, "complete_apparatus_q2_exported": {"const": true}, "complete_emitter_q2_exported": {"const": false}, "complete_scalar_q2_exported": {"const": false}, "scalar_q3_exported": {"const": false}, "arity_replay_certified": {"const": false}, "detector_response_on_second_order_cone_authorized": {"const": false}, "physical_branch_bridge_activated": {"const": false}}},
    "flags": {"type": "object"},
    "next_gate": {"const": "EXPORT_DYNAMICAL_EMITTER_Q2_PBW_BLOCK"},
    "claim_boundary": {"type": "string", "minLength": 1400},
    "provenance": {"type": "object"}
  }
}
