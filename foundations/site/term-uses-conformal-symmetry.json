f570e5c3a2bbe7e7af9bd0c6692171bf","foundations/editorial/vocabularies/PHYSH-LICENSE.md":"015e5415032b965420f043e85a919865b305ace21a18a2b0fdf8c00653f8573b"},"passages":[{"id":2451,"source":"foundations/editorial/reading-content.json","location":"/topics/introduction/versions/physics/1/paragraphs/0","scope":"reading","text":"Separate physical postulates, the carrier used to realize them, logic and existence assumptions, operational identifications, and empirical protocols. Locality or conformal symmetry is a physical premise; a Hilbert completion or an operator domain is mathematical structure; a detector functional and a noise model add different operational information.","normalized":false,"start":163,"end":181,"rendered_html":"<p>Separate physical postulates, the carrier used to realize them, logic and existence assumptions, operational identifications, and empirical protocols. Locality or <mark>conformal symmetry</mark> is a physical premise; a Hilbert completion or an operator domain is mathematical structure; a detector functional and a noise model add different operational information.</p>","reading_url":"term-source-e7c108316a738f13.html#passage-2451"},{"id":3096,"source":"foundations/editorial/dictionary.json","location":"physical-postulate/definitions/physics","scope":"dictionary","text":"Physical postulates specify modeled properties such as locality, covariance or conformal symmetry. Their encoding in a carrier is another input, alongside the logical principles used in proofs.","normalized":false,"start":79,"end":97,"rendered_html":"<p>Physical postulates specify modeled properties such as locality, covariance or <mark>conformal symmetry</mark>. Their encoding in a carrier is another input, alongside the logical principles used in proofs.</p>","reading_url":"term-source-08fd4ad20e8af37b.html#passage-3096"},{"id":3468,"source":"foundations/editorial/dictionary.json","location":"curvature-and-weyl-tensor/explanations/physics/0","scope":"dictionary","text":"Index placement affects conformal transformation formulas, and the four-dimensional action has its specific scaling property. Gauge reduction, boundary conditions and quantum interpretation remain additional requirements.","normalized":false,"start":24,"end":48,"rendered_html":"<p>Index placement affects <mark>conformal transformation</mark> formulas, and the four-dimensional action has its specific scaling property. Gauge reduction, boundary conditions and quantum interpretation remain additional requirements.</p>","reading_url":"term-source-08fd4ad20e8af37b.html#passage-3468"},{"id":21907,"source":"paper/19-what-conformal-gravity-must-assume.tex","location":"line:359","scope":"papers","text":"Branch (B2) divides by a single question: does the field that breaks the conformal symmetry also generate particle masses?","normalized":true,"raw_start":17068,"raw_end":17199,"start":73,"end":91,"rendered_html":"<p>Branch (B2) divides by a single question: does the field that breaks the <mark>conformal symmetry</mark> also generate particle masses?</p>","reading_url":"term-source-1c09c0356e32dc28.html#passage-21907"},{"id":21940,"source":"paper/19-what-conformal-gravity-must-assume.tex","location":"line:422","scope":"papers","text":"is not the weak point---but ``eikonalization in a theory with local conformal symmetry leads to trajectories that are only globally conformally symmetric''. A frame argument that moves trajectories by an","normalized":true,"raw_start":20893,"raw_end":21106,"start":68,"end":86,"rendered_html":"<p>is not the weak point---but ``eikonalization in a theory with local <mark>conformal symmetry</mark> leads to trajectories that are only globally conformally symmetric&#x27;&#x27;. A frame argument that moves trajectories by an</p>","reading_url":"term-source-1c09c0356e32dc28.html#passage-21940"},{"id":21941,"source":"paper/19-what-conformal-gravity-must-assume.tex","location":"line:425","scope":"papers","text":"-dependent rescaling is a local conformal transformation, and on that reading it is the locality of the rescaling, not the point-particle idealisation, that is in question. We report this because it relocates the assumption once more.","normalized":true,"raw_start":21111,"raw_end":21353,"start":32,"end":56,"rendered_html":"<p>-dependent rescaling is a local <mark>conformal transformation</mark>, and on that reading it is the locality of the rescaling, not the point-particle idealisation, that is in question. We report this because it relocates the assumption once more.</p>","reading_url":"term-source-1c09c0356e32dc28.html#passage-21941"},{"id":25363,"source":"paper/video-background-guide.md","location":"line:178","scope":"papers","text":"- [Hamada: *BRST Conformal Symmetry as A Background-Free Nature of Quantum Gravity*","normalized":true,"raw_start":8084,"raw_end":8167,"start":17,"end":35,"rendered_html":"<ul>\n<li>[Hamada: <em>BRST <mark>Conformal Symmetry</mark> as A Background-Free Nature of Quantum Gravity</em></li>\n</ul>","reading_url":"term-source-020c935ff48d3285.html#passage-25363"}]}
