      }
    },
    "status_vocabulary": {"type": "array", "minItems": 9, "maxItems": 9},
    "stages": {"type": "array", "minItems": 11, "maxItems": 11},
    "branches": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["id", "name", "relation_to_target", "scope", "stages", "first_unclosed_gate", "next_decisive_object"],
        "properties": {"stages": {"type": "array", "minItems": 11, "maxItems": 11}}
