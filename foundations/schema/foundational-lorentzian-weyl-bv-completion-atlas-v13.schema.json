    "dependency_tags": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true},
    "question": {"type": "string", "minLength": 120},
    "answer": {"type": "string", "minLength": 1400},
    "predecessor": {
      "type": "object",
