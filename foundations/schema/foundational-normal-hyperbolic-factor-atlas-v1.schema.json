{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "result_id", "result_kind", "lifecycle", "dependency_tags", "dependency_chain", "framework_findings", "bounded_search", "cell_actions", "evidence_overlays", "provenance", "independent_checker", "claim_flags", "does_not_establish"],
  "properties": {
    "schema_version": {"const": "foundational-normal-hyperbolic-factor-atlas-v1"},
    "result_id": {"const": "FOUNDATIONAL_NORMAL_HYPERBOLIC_FACTOR_ATLAS_V1"},
    "dependency_tags": {"type": "array", "allOf": [{"contains": {"const": "LOCAL-ALGEBRAIC"}}, {"contains": {"const": "LORENTZIAN-CAUSAL"}}]},
    "dependency_chain": {"type": "array", "minItems": 9, "maxItems": 9},
    "framework_findings": {"type": "array", "minItems": 6, "maxItems": 6},
    "cell_actions": {"type": "array", "minItems": 9, "maxItems": 9},
    "evidence_overlays": {"type": "array", "minItems": 5, "maxItems": 5},
    "does_not_establish": {"type": "array", "minItems": 1}
  }
}
