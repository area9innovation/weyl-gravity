    "route_selection": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"type": "object", "required": ["rank", "route", "branch", "scientific_leverage", "tractability", "dependency_depth", "recommendation"], "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 9}, "recommendation": {"type": "string", "minLength": 100}}}},
    "research_queue": {"type": "array", "minItems": 9, "maxItems": 9},
