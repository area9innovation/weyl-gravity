{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundational-lorentzian-weyl-bv-completion-atlas-v18.schema.json",
  "title": "Foundational Lorentzian Weyl BV completion atlas v18",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "result_kind",
    "lifecycle",
    "created",
    "repository_base_commit",
    "dependency_tags",
    "question",
    "answer",
    "predecessor",
    "status_vocabulary",
    "stages",
    "branches",
    "frontier_summary",
    "route_selection",
    "research_queue",
    "provenance",
    "claim_flags",
    "does_not_establish",
    "strict_q2_green_composition_preflight",
    "independent_checker",
    "human_report"
  ],
  "properties": {
    "schema_version": {"const": "foundational-lorentzian-weyl-bv-completion-atlas-v18"},
    "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V18"},
    "result_kind": {"type": "string"},
    "lifecycle": {"const": "CLASSIFIED"},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependency_tags": {"type": "array", "contains": {"const": "LORENTZIAN-CAUSAL"}},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "predecessor": {
      "type": "object",
      "required": ["result_id", "path", "sha256", "preserved"],
      "properties": {
        "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V17"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "preserved": {"const": true}
      },
      "additionalProperties": false
    },
    "status_vocabulary": {"type": "array", "minItems": 1},
    "stages": {"type": "array", "minItems": 11, "maxItems": 11},
    "branches": {"type": "array", "minItems": 7, "maxItems": 7},
    "frontier_summary": {"type": "object"},
    "route_selection": {"type": "array", "minItems": 9, "maxItems": 9},
    "research_queue": {"type": "array", "minItems": 9, "maxItems": 9},
    "provenance": {"type": "object"},
    "claim_flags": {"type": "object"},
    "does_not_establish": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "strict_q2_green_composition_preflight": {
      "type": "object",
      "required": [
        "result_id",
        "status",
        "carrier_rows",
        "basis_match",
        "pairing_match",
        "graph_q1_match",
        "causal_orientations_composed",
        "per_input_derivative_order_bound",
        "total_derivative_order_bound",
        "response_identity_defects",
        "causal_difference_identity_defects",
        "plus_response_name_sha256",
        "minus_response_name_sha256",
        "causal_difference_name_sha256",
        "foundational_classification",
        "finite_exact_layer",
        "completed_infinite_spaces_required",
        "new_choice_beyond_green_theorem",
        "weakest_complete_foundational_base",
        "candidate_only",
        "authoritative_q2_green_compatibility",
        "recursive_nonlinear_green_trees",
        "next_gate"
      ],
      "properties": {
        "result_id": {"const": "STRICT_386_STABILIZED_Q2_GREEN_COMPOSITION_PREFLIGHT_V1"},
        "status": {"const": "CANDIDATE_Q2_GREEN_RESPONSE_CERTIFIED_AUTHORITATIVE_AND_RECURSIVE_COMPLETION_OPEN"},
        "carrier_rows": {"const": 386},
        "basis_match": {"const": true},
        "pairing_match": {"const": true},
        "graph_q1_match": {"const": true},
        "causal_orientations_composed": {"const": 2},
        "per_input_derivative_order_bound": {"const": 10},
        "total_derivative_order_bound": {"const": 13},
        "response_identity_defects": {"const": 0},
        "causal_difference_identity_defects": {"const": 0},
        "plus_response_name_sha256": {"$ref": "#/$defs/sha256"},
        "minus_response_name_sha256": {"$ref": "#/$defs/sha256"},
        "causal_difference_name_sha256": {"$ref": "#/$defs/sha256"},
        "foundational_classification": {"const": "STRATIFIED_FINITE_EXACT_PLUS_CLASSICAL_INFINITE_ANALYSIS"},
        "finite_exact_layer": {"type": "string"},
        "completed_infinite_spaces_required": {"const": true},
        "new_choice_beyond_green_theorem": {"const": false},
        "weakest_complete_foundational_base": {"const": "NOT_ESTABLISHED"},
        "candidate_only": {"const": true},
        "authoritative_q2_green_compatibility": {"const": false},
        "recursive_nonlinear_green_trees": {"const": false},
        "next_gate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "independent_checker": {"type": "object"},
    "human_report": {"type": "string"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
