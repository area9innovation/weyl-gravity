{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","result_id","result_kind","lifecycle","dependency_tags","repository_base_commit","purpose","cartesian_product_warning","axes","cell_statuses","cells","missing_faces","provenance","independent_checker","claim_flags","does_not_establish","human_report"],
