{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "result_kind", "lifecycle", "dependency_tags", "created", "repository_base_commit", "method", "provenance", "cell_additions", "canonical_digest", "claim_flags", "does_not_establish", "human_report"],
  "properties": {
    "schema_version": {"const": "foundational-intersection-cube-expansion-v1"},
    "result_id": {"const": "FOUNDATIONAL_INTERSECTION_CUBE_EXPANSION_V1"},
    "result_kind": {"const": "REVIEWED_CUBE_CELL_CROSSWALK"},
    "lifecycle": {"const": "LITERATURE_SCOPED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "method": {"type": "object", "required": ["target", "qualification_rule", "selection_rule", "base_assessed_cells", "added_cells", "resulting_assessed_cells", "status_counts"]},
    "provenance": {"type": "object", "required": ["base_cube_digest", "inputs"]},
    "cell_additions": {"type": "array", "minItems": 103, "maxItems": 103, "items": {"type": "object", "additionalProperties": false, "required": ["foundation", "carrier", "obligation", "status", "evidence", "summary", "boundary"], "properties": {"foundation": {"type": "string"}, "carrier": {"type": "string"}, "obligation": {"type": "string"}, "status": {"enum": ["LOCAL_RESULT", "LITERATURE_RESULT", "PIECES_ONLY", "PRIORITY_GAP"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "summary": {"type": "string", "minLength": 1}, "boundary": {"type": "string", "minLength": 1}}}},
    "canonical_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_flags": {"type": "object"},
    "does_not_establish": {"type": "array", "minItems": 8, "items": {"type": "string", "minLength": 1}},
    "human_report": {"const": "foundations/reports/cube-expansion-literature-analysis.md"}
  }
}
