{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundational-lorentzian-weyl-bv-completion-atlas-v20.schema.json",
  "title": "Foundational Lorentzian Weyl BV completion atlas v20",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "result_kind",
    "lifecycle",
    "created",
    "repository_base_commit",
    "dependency_tags",
    "question",
    "answer",
    "predecessor",
    "status_vocabulary",
    "stages",
    "branches",
    "frontier_summary",
    "route_selection",
    "research_queue",
    "provenance",
    "claim_flags",
    "does_not_establish",
    "strict_recursive_causal_tree_domains",
    "strict_polarized_formal_coefficients",
    "independent_checker",
    "human_report"
  ],
  "properties": {
    "schema_version": {"const": "foundational-lorentzian-weyl-bv-completion-atlas-v20"},
    "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V20"},
    "result_kind": {"type": "string"},
    "lifecycle": {"const": "CLASSIFIED"},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "minLength": 8, "maxLength": 40, "pattern": "^[0-9a-f]+$"},
    "dependency_tags": {"type": "array", "contains": {"const": "LORENTZIAN-CAUSAL"}},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "predecessor": {
      "type": "object",
      "required": ["result_id", "path", "sha256", "preserved"],
      "properties": {
        "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V19"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "preserved": {"const": true}
      },
      "additionalProperties": false
    },
    "status_vocabulary": {"type": "array", "minItems": 1},
    "stages": {"type": "array", "minItems": 11, "maxItems": 11},
    "branches": {"type": "array", "minItems": 7, "maxItems": 7},
    "frontier_summary": {"type": "object"},
    "route_selection": {"type": "array", "minItems": 12, "maxItems": 12},
    "research_queue": {"type": "array", "minItems": 12, "maxItems": 12},
    "provenance": {"type": "object"},
    "claim_flags": {"type": "object"},
    "does_not_establish": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "strict_recursive_causal_tree_domains": {"type": "object"},
    "strict_polarized_formal_coefficients": {
      "type": "object",
      "required": [
        "result_id", "status", "orientations", "checked_through_leaves", "largest_checked_tree_count",
        "coefficientwise_fixed_point", "catalan_formula", "formal_inverse", "lambda_adic_stabilization",
        "analytic_convergence", "nonperturbative_inverse", "order_lambda_bv_residual_zero",
        "order_lambda_squared_bv_residual", "order_lambda_squared_bv_residual_zero_certified",
        "weyl_bv_maurer_cartan_series", "authoritative_weyl_bv_moller_map",
        "typed_field_equation_green_inverse", "q3_or_higher_imported", "foundational_classification",
        "weakest_complete_foundational_base", "next_gate"
      ],
      "properties": {
        "result_id": {"const": "STRICT_386_POLARIZED_FORMAL_MOLLER_COEFFICIENTS_V1"},
        "status": {"const": "FORMAL_FIXED_POINT_COEFFICIENTS_CERTIFIED_MOLLER_AND_MAURER_CARTAN_PROMOTION_OPEN"},
        "orientations": {"const": 2},
        "checked_through_leaves": {"const": 9},
        "largest_checked_tree_count": {"const": 1430},
        "coefficientwise_fixed_point": {"const": true},
        "catalan_formula": {"const": true},
        "formal_inverse": {"const": true},
        "lambda_adic_stabilization": {"const": true},
        "analytic_convergence": {"const": false},
        "nonperturbative_inverse": {"const": false},
        "order_lambda_bv_residual_zero": {"const": true},
        "order_lambda_squared_bv_residual": {"type": "string", "minLength": 1},
        "order_lambda_squared_bv_residual_zero_certified": {"const": false},
        "weyl_bv_maurer_cartan_series": {"const": false},
        "authoritative_weyl_bv_moller_map": {"const": false},
        "typed_field_equation_green_inverse": {"const": false},
        "q3_or_higher_imported": {"const": false},
        "foundational_classification": {"const": "UNIFORM_PRIMITIVE_RECURSIVE_FORMAL_COEFFICIENT_SCHEMA_OVER_IMPORTED_CLASSICAL_GREEN_ANALYSIS"},
        "weakest_complete_foundational_base": {"const": "NOT_ESTABLISHED"},
        "next_gate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "independent_checker": {"type": "object"},
    "human_report": {"type": "string"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
