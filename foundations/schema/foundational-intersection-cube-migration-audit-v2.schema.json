{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result_id", "result_kind", "lifecycle", "created", "repository_base_commit", "dependency_tags", "purpose", "method", "summary", "evidence_batches", "decisions", "provenance", "independent_checker", "claim_flags", "does_not_establish", "human_report"],
  "properties": {
    "schema_version": {"const": "foundational-intersection-cube-migration-audit-v2"},
    "result_id": {"const": "FOUNDATIONAL_INTERSECTION_CUBE_MIGRATION_AUDIT_V2"},
    "result_kind": {"const": "EXPLICIT_MIGRATION_DECISION_LEDGER"},
    "lifecycle": {"const": "SEPARATED"},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]},
    "purpose": {"type": "string", "minLength": 1},
    "method": {
      "type": "object",
      "required": ["coverage_and_migration_are_separate", "evidence_batch_count", "review_rule", "empty_gap_rule"],
      "properties": {
        "coverage_and_migration_are_separate": {"const": true},
        "evidence_batch_count": {"const": 18},
        "review_rule": {"type": "string", "minLength": 1},
        "empty_gap_rule": {"type": "string", "minLength": 1}
      }
    },
    "summary": {
      "type": "object",
      "required": ["v1_pending", "decisions", "decision_counts", "priority_counts", "evidence_batch_counts", "pending_after_audit"],
      "properties": {
        "v1_pending": {"const": 112},
        "decisions": {"const": 112},
        "decision_counts": {"type": "object"},
        "priority_counts": {"type": "object"},
        "evidence_batch_counts": {"type": "object"},
        "pending_after_audit": {"const": 0}
      }
    },
    "evidence_batches": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "evidence", "reviewed_scope", "cell_count", "decision"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "reviewed_scope": {"type": "string", "minLength": 1},
          "cell_count": {"type": "integer", "minimum": 1},
          "decision": {"const": "NO_TRANSFER_TO_LISTED_UNRESOLVED_CHILDREN"}
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 112,
      "maxItems": 112,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["coordinate", "foundation", "carrier", "obligation", "parent_obligation", "v0_parent_status", "parent_evidence", "review_batch", "review_priority", "decision", "resulting_coverage_status", "rationale", "boundary"],
        "properties": {
          "coordinate": {"type": "string", "pattern": "^[^|]+\\|[^|]+\\|[^|]+$"},
          "foundation": {"type": "string", "minLength": 1},
          "carrier": {"type": "string", "minLength": 1},
          "obligation": {"type": "string", "minLength": 1},
          "parent_obligation": {"type": "string", "minLength": 1},
          "v0_parent_status": {"enum": ["LOCAL_RESULT", "LITERATURE_RESULT", "PIECES_ONLY", "PRIORITY_GAP"]},
          "parent_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "review_batch": {"type": "string", "minLength": 1},
          "review_priority": {"enum": ["RESULT_DESCENDANT_FIRST", "PIECES_DESCENDANT_BATCH", "EMPTY_PARENT_GAP_DECOMPOSITION"]},
          "decision": {"enum": ["REVIEWED_NO_TRANSFER", "REVIEWED_CHILD_GAP"]},
          "resulting_coverage_status": {"enum": ["NOT_MAPPED", "PRIORITY_GAP"]},
          "rationale": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "provenance": {"type": "object", "required": ["inputs"]},
    "independent_checker": {"type": "object", "required": ["path", "checks", "expected_digest"], "properties": {"expected_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "claim_flags": {"type": "object"},
    "does_not_establish": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}},
    "human_report": {"const": "foundations/reports/intersection-cube-migration-audit-v2.md"}
  }
}
