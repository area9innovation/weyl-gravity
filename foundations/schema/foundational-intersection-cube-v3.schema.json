{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "result_id", "result_kind", "dependency_tags", "compatibility", "axes", "dimensions", "cells", "provenance", "independent_checker", "claim_flags", "does_not_establish"],
  "properties": {
    "schema_version": {"const": "foundational-intersection-cube-v3"},
    "result_id": {"const": "FOUNDATIONAL_INTERSECTION_CUBE_V3"},
    "axes": {"type": "array", "minItems": 3, "maxItems": 3},
    "cells": {"type": "array", "minItems": 452, "maxItems": 452},
    "dimensions": {"type": "object", "required": ["cartesian_total", "emitted_cells", "coverage_classified_cells", "migration_pending_cells", "research_status_changes", "research_evidence_overlays"]},
    "does_not_establish": {"type": "array", "minItems": 1}
  }
}
