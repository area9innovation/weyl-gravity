{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "control_id", "created", "kind", "label", "scope", "dependency_tags", "rail_summary", "records", "benchmark_coverage", "claim_flags", "does_not_establish"],
  "properties": {
    "schema_version": {"const": "standard-gr-observational-control-v1"},
    "control_id": {"const": "STANDARD_GENERAL_RELATIVITY_DOMAIN_CONTROL"},
    "created": {"type": "string", "format": "date"},
    "kind": {"const": "EXTERNAL_POSITIVE_CONTROL"},
    "label": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "dependency_tags": {"const": ["LORENTZIAN-CAUSAL"]},
    "rail_summary": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "basis"],
        "properties": {
          "id": {"enum": ["PREDICTION_DERIVATION", "OBSERVABLE_IDENTIFICATION", "EMPIRICAL_COMPARISON", "ROBUSTNESS_OUT_OF_SAMPLE"]},
          "status": {"enum": ["REGISTERED_IN_DOMAINS", "SUPPORTED_IN_DOMAINS", "MULTI_DOMAIN_SUPPORT"]},
          "basis": {"type": "string", "minLength": 1}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "benchmark", "citation", "stable_url", "artifact", "observable_map", "dataset", "prediction", "comparison_method", "uncertainty", "parameter_fit_scope", "out_of_sample_status", "finding", "boundary"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "benchmark": {"enum": ["LOCAL_GRAVITY", "SOLAR_SYSTEM", "COMPACT_BINARIES", "GRAVITATIONAL_WAVES", "GALACTIC_LENSING_DYNAMICS", "COSMOLOGY"]},
          "citation": {"type": "string", "minLength": 1},
          "stable_url": {"type": "string", "format": "uri"},
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "locator", "sha256"],
            "properties": {
              "status": {"enum": ["CONTENT_PINNED", "METADATA_ONLY"]},
              "locator": {"type": "string", "format": "uri"},
              "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
            }
          },
          "observable_map": {"type": "string", "minLength": 1},
          "dataset": {"type": "string", "minLength": 1},
          "prediction": {"type": "string", "minLength": 1},
          "comparison_method": {"type": "string", "minLength": 1},
          "uncertainty": {"type": "string", "minLength": 1},
          "parameter_fit_scope": {"type": "string", "minLength": 1},
          "out_of_sample_status": {"type": "string", "minLength": 1},
          "finding": {"type": "string", "minLength": 1},
          "boundary": {"type": "string", "minLength": 1}
        }
      }
    },
    "benchmark_coverage": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["benchmark", "status", "record_ids"],
        "properties": {
          "benchmark": {"enum": ["LOCAL_GRAVITY", "SOLAR_SYSTEM", "COMPACT_BINARIES", "GRAVITATIONAL_WAVES", "GALACTIC_LENSING_DYNAMICS", "COSMOLOGY"]},
          "status": {"enum": ["SUPPORTED_CONTROL", "NOT_REGISTERED"]},
          "record_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "claim_flags": {
      "type": "object",
      "required": ["positive_control_registered", "prediction_records_registered", "empirical_comparisons_registered", "three_benchmark_families_supported", "selected_from_foundations_cube", "all_benchmark_families_supported", "complete_theory_established", "evidence_for_weyl_gravity"]
    },
    "does_not_establish": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
  }
}
