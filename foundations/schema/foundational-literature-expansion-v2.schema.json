{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "created", "repository_base_commit", "method", "entries", "unresolved"],
  "properties": {
    "schema_version": {"const": "foundational-literature-expansion-v2"},
    "ledger_id": {"const": "FOUNDATIONAL_LITERATURE_EXPANSION_V2"},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "method": {"type": "object", "additionalProperties": false, "required": ["scope", "selection", "pinning", "verification_boundary"], "properties": {"scope": {"type": "string", "minLength": 1}, "selection": {"type": "string", "minLength": 1}, "pinning": {"type": "string", "minLength": 1}, "verification_boundary": {"type": "string", "minLength": 1}}},
    "entries": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/entry"}},
    "unresolved": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "entry": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_kind", "citation", "year", "stable_url", "artifact", "bears_on", "supported_statements", "boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "source_kind": {"const": "PRIMARY_RESEARCH"},
        "citation": {"type": "string", "minLength": 1},
        "year": {"type": "integer", "minimum": 1900, "maximum": 2100},
        "stable_url": {"type": "string", "format": "uri"},
        "artifact": {"type": "object", "additionalProperties": false, "required": ["status", "locator", "sha256"], "properties": {"status": {"enum": ["CONTENT_PINNED", "METADATA_ONLY"]}, "locator": {"type": "string", "minLength": 1}, "sha256": {"oneOf": [{"type": "string", "pattern": "^[0-9a-f]{64}$"}, {"type": "null"}]}}},
        "bears_on": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LOGIC", "SET_EXISTENCE", "INFINITY", "CARRIER_GEOMETRY", "PHYSICAL_POSTULATES", "TARGET_CLAIMS"]}},
        "supported_statements": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
