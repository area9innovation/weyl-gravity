{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundational-support-indexed-test-space-comparison-v1.schema.json",
  "type": "object",
  "required": ["schema_version", "result_id", "result_kind", "lifecycle", "created", "repository_base_commit", "dependency_tags", "theorem", "support_exhaustion", "represented_union", "name_comparison", "h2_embedding", "topology_comparison", "formal_proof", "fixtures", "inclusion_checks", "literature_context", "provenance", "independent_checker", "claim_flags", "does_not_establish", "next_gate", "human_report"],
  "properties": {
    "schema_version": {"const": "foundational-support-indexed-test-space-comparison-v1"},
    "result_id": {"const": "FOUNDATIONAL_SUPPORT_INDEXED_TEST_SPACE_COMPARISON_V1"},
    "result_kind": {"const": "SUPPORT_INDEXED_REPRESENTED_UNION_COMPARISON_WITH_LF_BOUNDARY"},
    "lifecycle": {"const": "CERTIFIED"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "theorem": {"type": "string", "minLength": 180},
    "support_exhaustion": {"type": "object", "required": ["ambient", "stage_formula", "nesting", "coverage", "index_is_discrete_advice"], "properties": {"index_is_discrete_advice": {"const": true}}},
    "represented_union": {"type": "object", "required": ["name", "equivalence", "inclusion", "status"]},
    "name_comparison": {"type": "object", "required": ["conventional_to_tagged", "tagged_to_conventional", "first_composite", "second_composite", "choice_use", "status"]},
    "h2_embedding": {"type": "object", "required": ["stage_map", "target", "inclusion_compatibility", "weak_residual", "surjectivity_onto_h2_completion", "status"], "properties": {"surjectivity_onto_h2_completion": {"const": false}}},
    "topology_comparison": {"type": "object", "required": ["classical_object", "represented_object", "point_name_equivalence", "full_lf_topology_identification", "single_h2_metric_completion_identification", "reason"], "properties": {"full_lf_topology_identification": {"const": "NOT_ESTABLISHED"}, "single_h2_metric_completion_identification": {"const": "EXCLUDED"}}},
    "formal_proof": {"type": "array", "minItems": 6, "maxItems": 6},
    "fixtures": {"type": "array", "minItems": 6, "maxItems": 6},
    "inclusion_checks": {"type": "array", "minItems": 15, "maxItems": 15},
    "literature_context": {"type": "array", "minItems": 1},
    "provenance": {"type": "object", "required": ["inputs"]},
    "independent_checker": {"type": "object", "required": ["path", "checks", "expected_digest"]},
    "claim_flags": {"type": "object", "required": ["support_indexed_represented_union_constructed", "conventional_and_tagged_names_equivalent", "stage_inclusion_compatibility_proved", "every_represented_smooth_test_embedded_in_h2", "weak_identity_assembled_over_named_tests", "choice_principle_used", "uniform_support_bound_selected_from_bare_function", "h2_embedding_surjective", "full_lf_locally_convex_topology_identified", "single_metric_completion_of_test_space_constructed", "weyl_or_metric_bv_result_proved"]},
    "does_not_establish": {"type": "array", "minItems": 6},
    "next_gate": {"type": "string", "minLength": 120},
    "human_report": {"const": "foundations/reports/support-indexed-test-space-comparison-v1.md"}
  }
}
