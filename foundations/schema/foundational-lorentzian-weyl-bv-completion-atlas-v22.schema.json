{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundational-lorentzian-weyl-bv-completion-atlas-v22.schema.json",
  "title": "Foundational Lorentzian Weyl BV completion atlas v22",
  "type": "object",
  "required": ["schema_version", "result_id", "result_kind", "lifecycle", "created", "repository_base_commit", "dependency_tags", "question", "answer", "predecessor", "status_vocabulary", "stages", "branches", "frontier_summary", "route_selection", "research_queue", "provenance", "claim_flags", "does_not_establish", "strict_field_equation_green_quotient_inverse", "strict_quadratic_truncation_lambda2_source_obstruction", "independent_checker", "human_report"],
  "properties": {
    "schema_version": {"const": "foundational-lorentzian-weyl-bv-completion-atlas-v22"},
    "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V22"},
    "result_kind": {"type": "string"},
    "lifecycle": {"const": "CLASSIFIED"},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "minLength": 8, "maxLength": 40, "pattern": "^[0-9a-f]+$"},
    "dependency_tags": {"type": "array", "contains": {"const": "LORENTZIAN-CAUSAL"}},
    "predecessor": {
      "type": "object",
