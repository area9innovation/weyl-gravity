{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "foundational-lorentzian-weyl-bv-completion-atlas-v19.schema.json",
  "title": "Foundational Lorentzian Weyl BV completion atlas v19",
  "type": "object",
  "required": [
    "schema_version",
    "result_id",
    "result_kind",
    "lifecycle",
    "created",
    "repository_base_commit",
    "dependency_tags",
    "question",
    "answer",
    "predecessor",
    "status_vocabulary",
    "stages",
    "branches",
    "frontier_summary",
    "route_selection",
    "research_queue",
    "provenance",
    "claim_flags",
    "does_not_establish",
    "strict_q2_green_composition_preflight",
    "strict_recursive_causal_tree_domains",
    "independent_checker",
    "human_report"
  ],
  "properties": {
    "schema_version": {"const": "foundational-lorentzian-weyl-bv-completion-atlas-v19"},
    "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V19"},
    "result_kind": {"type": "string"},
    "lifecycle": {"const": "CLASSIFIED"},
    "created": {"type": "string", "format": "date"},
    "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "dependency_tags": {"type": "array", "contains": {"const": "LORENTZIAN-CAUSAL"}},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "predecessor": {
      "type": "object",
      "required": ["result_id", "path", "sha256", "preserved"],
      "properties": {
        "result_id": {"const": "FOUNDATIONAL_LORENTZIAN_WEYL_BV_COMPLETION_ATLAS_V18"},
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "preserved": {"const": true}
      },
      "additionalProperties": false
    },
    "status_vocabulary": {"type": "array", "minItems": 1},
    "stages": {"type": "array", "minItems": 11, "maxItems": 11},
    "branches": {"type": "array", "minItems": 7, "maxItems": 7},
    "frontier_summary": {"type": "object"},
    "route_selection": {"type": "array", "minItems": 11, "maxItems": 11},
    "research_queue": {"type": "array", "minItems": 11, "maxItems": 11},
    "provenance": {"type": "object"},
    "claim_flags": {"type": "object"},
    "does_not_establish": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "strict_q2_green_composition_preflight": {"type": "object"},
    "strict_recursive_causal_tree_domains": {
      "type": "object",
      "required": [
        "result_id",
        "status",
        "retarded_all_finite_trees",
        "advanced_all_finite_trees",
        "support_domain_defects",
        "nodewise_homotopy_domain_defects",
        "continuity_scope",
        "first_mixed_failure_leaves",
        "first_mixed_failure_topology",
        "four_leaf_all_sign_decorations",
        "four_leaf_admissible",
        "four_leaf_not_uniformly_defined",
        "all_comb_sign_decorations_admissible",
        "unrestricted_mixed_sign_trees",
        "arbitrary_causal_difference_trees",
        "infinite_tree_series_convergence",
        "q3_or_higher_trees",
        "authoritative_q2",
        "foundational_classification",
        "weakest_complete_foundational_base",
        "next_gate"
      ],
      "properties": {
        "result_id": {"const": "STRICT_386_RECURSIVE_CAUSAL_TREE_DOMAINS_V1"},
        "status": {"const": "POLARIZED_FINITE_TREES_CERTIFIED_UNRESTRICTED_MIXED_AND_INFINITE_SERIES_OPEN"},
        "retarded_all_finite_trees": {"const": true},
        "advanced_all_finite_trees": {"const": true},
        "support_domain_defects": {"const": 0},
        "nodewise_homotopy_domain_defects": {"const": 0},
        "continuity_scope": {"type": "string"},
        "first_mixed_failure_leaves": {"const": 4},
        "first_mixed_failure_topology": {"const": "balanced four-leaf tree"},
        "four_leaf_all_sign_decorations": {"const": 40},
        "four_leaf_admissible": {"const": 38},
        "four_leaf_not_uniformly_defined": {"const": 2},
        "all_comb_sign_decorations_admissible": {"const": true},
        "unrestricted_mixed_sign_trees": {"const": false},
        "arbitrary_causal_difference_trees": {"const": false},
        "infinite_tree_series_convergence": {"const": false},
        "q3_or_higher_trees": {"const": false},
        "authoritative_q2": {"const": false},
        "foundational_classification": {"const": "FINITE_EXACT_TREE_GRAMMAR_OVER_CLASSICAL_SUPPORT_SPACE_ANALYSIS"},
        "weakest_complete_foundational_base": {"const": "NOT_ESTABLISHED"},
        "next_gate": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "independent_checker": {"type": "object"},
    "human_report": {"type": "string"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
