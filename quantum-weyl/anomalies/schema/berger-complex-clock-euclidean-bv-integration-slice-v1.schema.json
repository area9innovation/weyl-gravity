{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-berger-complex-clock-euclidean-bv-integration-slice-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "theory",
    "background",
    "source_pins",
    "euclidean_continuation",
    "integration_variables",
    "hessian_blocks",
    "brst_intertwining",
    "ellipticity",
    "determinant_berezinian_map",
    "measure",
    "zero_modes",
    "contours",
    "regulator",
    "ward_carriers",
    "independent_verifier",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "quantum-weyl-berger-complex-clock-euclidean-bv-integration-slice-v1"},
    "result_id": {"const": "POSITIVE_BERGER_COMPLEX_CLOCK_EUCLIDEAN_BV_INTEGRATION_SLICE_V1"},
    "theory": {"const": "positive Berger gravity plus two-real-scalar complex clock"},
    "background": {"type": "string", "minLength": 50},
    "source_pins": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/pin"}},
    "euclidean_continuation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifold", "metric", "period", "orientation", "domains", "boundary_conditions"],
      "properties": {
        "manifold": {"type": "string", "minLength": 5},
        "metric": {"type": "string", "minLength": 20},
        "period": {"type": "string", "minLength": 1},
        "orientation": {"type": "string", "minLength": 5},
        "domains": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "boundary_conditions": {"type": "array", "minItems": 1, "items": {"type": "object"}}
      }
    },
    "integration_variables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "statistics", "reality", "bundle"],
        "properties": {
          "id": {"type": "string"},
          "statistics": {"enum": ["BOSONIC", "FERMIONIC"]},
          "reality": {"type": "string"},
          "bundle": {"type": "string"}
        }
      }
    },
    "hessian_blocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "domain", "codomain", "order", "operator", "principal_symbol", "formal_adjoint"],
        "properties": {
          "id": {"type": "string"},
          "domain": {"type": "string"},
          "codomain": {"type": "string"},
          "order": {"type": "integer", "minimum": 0},
          "operator": {"type": "object"},
          "principal_symbol": {"type": "object"},
          "formal_adjoint": {"type": "object"}
        }
      }
    },
    "brst_intertwining": {"type": "object", "required": ["status", "identities"], "properties": {"status": {"const": "VERIFIED"}, "identities": {"type": "array", "minItems": 1}}},
    "ellipticity": {"type": "object", "required": ["status", "symbol_sequence", "proof"], "properties": {"status": {"const": "VERIFIED"}, "symbol_sequence": {"type": "array", "minItems": 1}, "proof": {"type": "object"}}},
    "determinant_berezinian_map": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["integration_variable", "operator_block", "exponent", "statistics"],
        "properties": {
          "integration_variable": {"type": "string"},
          "operator_block": {"type": "string"},
          "exponent": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
          "statistics": {"enum": ["BOSONIC", "FERMIONIC"]}
        }
      }
    },
    "measure": {"type": "object", "required": ["density", "jacobians", "nonminimal_cancellation"], "properties": {"density": {"type": "string", "minLength": 10}, "jacobians": {"type": "array"}, "nonminimal_cancellation": {"type": "object"}}},
    "zero_modes": {"type": "object", "required": ["projectors", "stabilizers", "collective_coordinates", "primed_domains"], "properties": {"projectors": {"type": "array"}, "stabilizers": {"type": "array"}, "collective_coordinates": {"type": "array"}, "primed_domains": {"type": "array", "minItems": 1}}},
    "contours": {"type": "object", "required": ["real_structure", "negative_directions", "spectral_cuts"], "properties": {"real_structure": {"type": "string"}, "negative_directions": {"type": "array"}, "spectral_cuts": {"type": "array", "minItems": 1}}},
    "regulator": {"type": "object", "required": ["id", "regularization", "subtraction", "parity_policy", "scheme_parameters", "brst_compatibility"], "properties": {"id": {"type": "string"}, "regularization": {"type": "string"}, "subtraction": {"type": "string"}, "parity_policy": {"type": "string"}, "scheme_parameters": {"type": "object"}, "brst_compatibility": {"type": "object"}}},
    "ward_carriers": {"type": "object", "required": ["phase_shift_current", "K_Berger", "raw_D"], "properties": {"phase_shift_current": {"type": "object"}, "K_Berger": {"type": "object"}, "raw_D": {"const": "AFFINE_NOT_LINEAR_ON_FIXED_BACKGROUND"}}},
    "independent_verifier": {"type": "object", "required": ["path", "method", "source_hash"], "properties": {"path": {"type": "string"}, "method": {"type": "string", "minLength": 40}, "source_hash": {"$ref": "#/$defs/hash"}}},
    "claim_boundary": {"type": "string", "minLength": 300}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "source_commit", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 20},
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
