{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-regulated-slavnov-breaking-export-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "dependency_tags", "classical_commit", "analytic_route", "classical_snapshot_compatibility", "normalization", "operator_and_measure", "coefficient_basis", "coefficients", "insertion_decomposition", "consistency", "classification", "qme_disposition", "claim_boundary"],
  "properties": {
    "schema": {"const": "quantum-weyl-regulated-slavnov-breaking-export-v2"},
    "result_id": {"const": "REGULATED_REPOSITORY_BV_SLAVNOV_BREAKING"},
    "dependency_tags": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "contains": {"const": "LOCAL-ALGEBRAIC"},
      "items": {"enum": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL", "LORENTZIAN-CAUSAL"]}
    },
    "classical_commit": {"$ref": "#/$defs/commit"},
    "analytic_route": {"enum": ["EUCLIDEAN_ELLIPTIC", "LORENTZIAN_CAUSAL"]},
    "classical_snapshot_compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_BV_commit", "analytic_operator_commit", "status", "proof_artifact"],
      "properties": {
        "local_BV_commit": {"$ref": "#/$defs/commit"},
        "analytic_operator_commit": {"$ref": "#/$defs/commit"},
        "status": {"enum": ["IDENTICAL_COMMIT", "CONTENT_HASH_COMPATIBLE"]},
        "proof_artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "IDENTICAL_COMMIT"}}, "required": ["status"]},
        "then": {"properties": {"proof_artifact": {"type": "null"}}},
        "else": {"properties": {"proof_artifact": {"$ref": "#/$defs/artifact"}}}
      }]
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "alpha_C", "signature", "gauge", "regularization", "scheme", "boundary_conditions"],
      "properties": {
        "action": {"type": "string", "minLength": 1},
        "alpha_C": {"type": "string", "minLength": 1},
        "signature": {"type": "string", "minLength": 1},
        "gauge": {"type": "string", "minLength": 1},
        "regularization": {"type": "string", "minLength": 1},
        "scheme": {"type": "string", "minLength": 1},
        "boundary_conditions": {"type": "string", "minLength": 1}
      }
    },
    "operator_and_measure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formulation", "complete_complex_status", "complete_complex_artifact", "multiplicity_status", "multiplicity_artifact", "auxiliary_fourth_order_match_status", "auxiliary_fourth_order_match_artifact", "zero_mode_ledger_status", "zero_mode_ledger_artifact", "measure_contour_status", "measure_contour_artifact"],
      "properties": {
        "formulation": {"enum": ["FOURTH_ORDER_METRIC", "SECOND_ORDER_AUXILIARY"]},
        "complete_complex_status": {"const": "VERIFIED"},
        "complete_complex_artifact": {"$ref": "#/$defs/artifact"},
        "multiplicity_status": {"const": "VERIFIED"},
        "multiplicity_artifact": {"$ref": "#/$defs/artifact"},
        "auxiliary_fourth_order_match_status": {"enum": ["VERIFIED", "NOT_APPLICABLE_FOURTH_ORDER_METRIC"]},
        "auxiliary_fourth_order_match_artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "zero_mode_ledger_status": {"const": "VERIFIED"},
        "zero_mode_ledger_artifact": {"$ref": "#/$defs/artifact"},
        "measure_contour_status": {"const": "VERIFIED"},
        "measure_contour_artifact": {"$ref": "#/$defs/artifact"}
      },
      "allOf": [{
        "if": {"properties": {"formulation": {"const": "FOURTH_ORDER_METRIC"}}, "required": ["formulation"]},
        "then": {"properties": {"auxiliary_fourth_order_match_status": {"const": "NOT_APPLICABLE_FOURTH_ORDER_METRIC"}, "auxiliary_fourth_order_match_artifact": {"type": "null"}}},
        "else": {"properties": {"auxiliary_fourth_order_match_status": {"const": "VERIFIED"}, "auxiliary_fourth_order_match_artifact": {"$ref": "#/$defs/artifact"}}}
      }]
    },
    "coefficient_basis": {"const": ["ANOM_OMEGA_C2", "ANOM_OMEGA_E4", "ANOM_OMEGA_C_DUAL_C", "ANOM_OMEGA_BOX_R"]},
    "coefficients": {"$ref": "#/$defs/coefficients"},
    "insertion_decomposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regulated_slavnov_action_status", "regulated_slavnov_action_artifact", "cohomology_reduction_status", "total_derivative_status", "total_derivative_artifact", "gauge_parameter_dependence_status", "gauge_parameter_dependence_artifact", "regularization_dependence_status", "regularization_dependence_artifact", "antifield_completion_status", "antifield_completion_artifact"],
      "properties": {
        "regulated_slavnov_action_status": {"const": "COMPUTED"},
        "regulated_slavnov_action_artifact": {"$ref": "#/$defs/artifact"},
        "cohomology_reduction_status": {"const": "VERIFIED_AGAINST_COMPLETE_GAUGE_FIXED_H14"},
        "total_derivative_status": {"const": "EXPLICIT_INCLUDING_ZERO"},
        "total_derivative_artifact": {"$ref": "#/$defs/artifact"},
        "gauge_parameter_dependence_status": {"enum": ["INDEPENDENT_VERIFIED", "DEPENDENT_DECOMPOSED"]},
        "gauge_parameter_dependence_artifact": {"$ref": "#/$defs/artifact"},
        "regularization_dependence_status": {"enum": ["INDEPENDENT_VERIFIED", "DEPENDENT_DECOMPOSED"]},
        "regularization_dependence_artifact": {"$ref": "#/$defs/artifact"},
        "antifield_completion_status": {"const": "COMPLETE_INCLUDING_ZERO"},
        "antifield_completion_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wess_zumino_status", "wess_zumino_proof", "parity_status", "parity_proof"],
      "properties": {
        "wess_zumino_status": {"const": "VERIFIED"},
        "wess_zumino_proof": {"$ref": "#/$defs/artifact"},
        "parity_status": {"enum": ["COEFFICIENT_COMPUTED", "WARD_VERIFIED_ZERO"]},
        "parity_proof": {"$ref": "#/$defs/artifact"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exact_counterterm"],
      "properties": {
        "status": {"enum": ["NONTRIVIAL", "TRIVIAL_OR_ZERO"]},
        "exact_counterterm": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      }
    },
    "qme_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "proof_artifact"],
      "properties": {
        "status": {"enum": ["OBSTRUCTED_STRICT_FIELD_CONTENT", "RESTORABLE_BY_LOCAL_COUNTERTERM"]},
        "proof_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "coefficients": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ANOM_OMEGA_C2", "ANOM_OMEGA_E4", "ANOM_OMEGA_C_DUAL_C", "ANOM_OMEGA_BOX_R"],
      "properties": {
        "ANOM_OMEGA_C2": {"$ref": "#/$defs/rational"},
        "ANOM_OMEGA_E4": {"$ref": "#/$defs/rational"},
        "ANOM_OMEGA_C_DUAL_C": {"$ref": "#/$defs/rational"},
        "ANOM_OMEGA_BOX_R": {"$ref": "#/$defs/rational"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": {"enum": ["JSON_DATA", "JSON_PROOF", "TEXT_PROOF"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
