{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-repository-euclidean-elliptic-complex-input-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "dependency_tags", "classical_commit", "analytic_route", "background", "formulation", "cotangent_orbit_reduction", "principal_symbol_exactness", "gauge_fixed_kinetic_blocks", "coverage", "proof_artifacts", "claim_flags", "proof_sha256", "claim_boundary"],
  "properties": {
    "schema": {"const": "quantum-weyl-repository-euclidean-elliptic-complex-input-v1"},
    "result_id": {"const": "REPOSITORY_EUCLIDEAN_ELLIPTIC_COMPLEX"},
    "result_state": {"const": "COMPLETE_GAUGE_FIXED_BV_PRINCIPAL_SYMBOL_SEQUENCE_EXACT_AND_ELLIPTIC"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "classical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "analytic_route": {"const": "EUCLIDEAN_ELLIPTIC"},
    "background": {"type": "object", "additionalProperties": false, "required": ["geometry", "dimension", "signature", "boundary_policy"], "properties": {"geometry": {"type": "string", "minLength": 10}, "dimension": {"const": 4}, "signature": {"const": "EUCLIDEAN"}, "boundary_policy": {"enum": ["CLOSED_NO_BOUNDARY", "LOCAL_COMPACT_SUPPORT"]}}},
    "formulation": {"enum": ["FOURTH_ORDER_METRIC", "SECOND_ORDER_AUXILIARY"]},
    "cotangent_orbit_reduction": {"type": "object", "additionalProperties": false, "required": ["representative", "group", "all_nonzero_covectors_covered"], "properties": {"representative": {"type": "string", "minLength": 5}, "group": {"const": "SO(4)"}, "all_nonzero_covectors_covered": {"const": true}}},
    "principal_symbol_exactness": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/symbolCheck"}},
    "gauge_fixed_kinetic_blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/kineticBlock"}},
    "coverage": {"const": {"all_minimal_nonminimal_and_auxiliary_rows_accounted": true, "all_symbol_sectors_covered": true, "formal_adjoint_complex_verified": true, "gauge_fixed_operator_elliptic": true}},
    "proof_artifacts": {"type": "object", "additionalProperties": false, "required": ["field_dictionary", "multiplicity", "snapshot_compatibility", "action_normalization", "gauge_fixing", "formal_adjoint"], "properties": {"field_dictionary": {"$ref": "#/$defs/artifact"}, "multiplicity": {"$ref": "#/$defs/artifact"}, "snapshot_compatibility": {"$ref": "#/$defs/artifact"}, "action_normalization": {"$ref": "#/$defs/artifact"}, "gauge_fixing": {"$ref": "#/$defs/artifact"}, "formal_adjoint": {"$ref": "#/$defs/artifact"}}},
    "claim_flags": {"const": {"REPOSITORY_EUCLIDEAN_ELLIPTIC_COMPLEX_CERTIFIED": true, "FULL_BV_SYMBOL_EXACTNESS_CERTIFIED": true, "REGULATED_SLAVNOV_BREAKING_COMPUTED": false, "QME_DISPOSITION": false, "LORENTZIAN_CERTIFIED": false}},
    "proof_sha256": {"$ref": "#/$defs/hash"},
    "claim_boundary": {"type": "string", "minLength": 120}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["format", "path", "sha256"], "properties": {"format": {"enum": ["JSON_PROOF", "JSON_DATA"]}, "path": {"type": "string", "minLength": 10}, "sha256": {"$ref": "#/$defs/hash"}}},
    "sparseEntry": {"type": "object", "additionalProperties": false, "required": ["row", "column", "coefficient"], "properties": {"row": {"type": "integer", "minimum": 0}, "column": {"type": "integer", "minimum": 0}, "coefficient": {"$ref": "#/$defs/rational"}}},
    "sparseMatrix": {"type": "object", "additionalProperties": false, "required": ["shape", "entries"], "properties": {"shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}}, "entries": {"type": "array", "items": {"$ref": "#/$defs/sparseEntry"}}}},
    "symbolCheck": {"type": "object", "additionalProperties": false, "required": ["sector_id", "domain_dimension", "middle_dimension", "codomain_dimension", "incoming_symbol", "outgoing_symbol", "incoming_rank", "outgoing_rank", "kernel_outgoing_dimension", "exact_at_middle"], "properties": {"sector_id": {"type": "string", "minLength": 3}, "domain_dimension": {"type": "integer", "minimum": 1}, "middle_dimension": {"type": "integer", "minimum": 1}, "codomain_dimension": {"type": "integer", "minimum": 1}, "incoming_symbol": {"$ref": "#/$defs/sparseMatrix"}, "outgoing_symbol": {"$ref": "#/$defs/sparseMatrix"}, "incoming_rank": {"type": "integer", "minimum": 0}, "outgoing_rank": {"type": "integer", "minimum": 0}, "kernel_outgoing_dimension": {"type": "integer", "minimum": 0}, "exact_at_middle": {"const": true}}},
    "kineticBlock": {"type": "object", "additionalProperties": false, "required": ["block_id", "bundle_rank", "differential_order", "principal_scalar", "elliptic"], "properties": {"block_id": {"type": "string", "minLength": 3}, "bundle_rank": {"type": "integer", "minimum": 1}, "differential_order": {"type": "integer", "minimum": 1}, "principal_scalar": {"$ref": "#/$defs/rational"}, "elliptic": {"const": true}}}
  }
}
