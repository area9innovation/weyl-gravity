{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/quantum-weyl/generic-background-ghost-n1-n2-hodge-resolvent-reduction-v1.schema.json",
  "title": "Generic-background ghost n=1/n=2 Hodge-resolvent reduction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "result_state", "lifecycle_state",
    "dependency_tags", "classical_commit", "scope", "Hodge_intertwining",
    "proper_time_to_resolvent", "log_determinant_expansion",
    "cubic_order_requirements", "exact_fixture", "coefficient_disposition",
    "claim_flags", "dependencies", "next_gate", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "quantum-weyl-generic-background-ghost-n1-n2-hodge-resolvent-reduction-v1"},
    "result_id": {"const": "GENERIC_BACKGROUND_GHOST_N1_N2_HODGE_RESOLVENT_REDUCTION"},
    "result_state": {"const": "CURVED_ENDO_N1_N2_REDUCED_EXACTLY_TO_FIVE_MINIMAL_VECTOR_SCALAR_RESOLVENT_CARRIERS"},
    "lifecycle_state": {"const": "N1_N2_NONMINIMAL_ARCHITECTURE_CLOSED_FIVE_MINIMAL_CARRIERS_UNEVALUATED"},
    "dependency_tags": {
      "type": "array", "prefixItems": [{"const": "LOCAL-ALGEBRAIC"}, {"const": "EUCLIDEAN-SPECTRAL"}], "items": false
    },
    "classical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["dimension", "signature", "mode_domain", "curvature_order", "operator_scope"],
      "properties": {
        "dimension": {"const": 4}, "signature": {"const": "Euclidean"},
        "mode_domain": {"type": "string"}, "curvature_order": {"type": "string"},
        "operator_scope": {"type": "string"}
      }
    },
    "Hodge_intertwining": {
      "type": "object", "additionalProperties": false,
      "required": ["identities", "exact_form_eigenvalue", "coexact_form_eigenvalue", "zero_modes_primed"],
      "properties": {
        "identities": {"type": "array", "prefixItems": [{"const": "F d=d Delta_0"}, {"const": "delta F=Delta_0 delta"}], "items": false},
        "exact_form_eigenvalue": {"$ref": "#/$defs/rational"},
        "coexact_form_eigenvalue": {"$ref": "#/$defs/rational"},
        "zero_modes_primed": {"const": true}
      }
    },
    "proper_time_to_resolvent": {
      "type": "object", "additionalProperties": false,
      "required": ["heat_kernel_identity", "Fubini_domain", "Fubini_weight", "scalar_moment", "resolvent_identity", "longitudinal_operator", "flat_inverse"],
      "properties": {
        "heat_kernel_identity": {"type": "string"},
        "Fubini_domain": {"const": "for fixed s>0, 2s/3<=t<=s"},
        "Fubini_weight": {"const": "s/3"},
        "scalar_moment": {"const": "integral_0^infinity ds s K_Delta0(s)=Delta_0^-2"},
        "resolvent_identity": {"const": "G_H0=G_F-(1/3)d Delta_0^-2 delta"},
        "longitudinal_operator": {"const": "L=d Delta_0^-2 delta"},
        "flat_inverse": {"const": "G_H0=p^-2(Pi_T+(2/3)Pi_L)"}
      }
    },
    "log_determinant_expansion": {
      "type": "object", "additionalProperties": false,
      "required": ["formula", "W", "n1_carriers", "n2_carriers", "carrier_count", "cyclic_trace_used_to_merge_mixed_n2_orderings"],
      "properties": {
        "formula": {"type": "string"},
        "W": {"const": "-2 Ric"},
        "n1_carriers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/carrier"}},
        "n2_carriers": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/carrier"}},
        "carrier_count": {"const": 5},
        "cyclic_trace_used_to_merge_mixed_n2_orderings": {"const": true}
      }
    },
    "cubic_order_requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["N1", "N2", "N3", "measure_and_parallel_transport", "flat_metric_vertex_substitution_is_sufficient"],
      "properties": {
        "N1": {"type": "string"}, "N2": {"type": "string"}, "N3": {"type": "string"},
        "measure_and_parallel_transport": {"type": "string"},
        "flat_metric_vertex_substitution_is_sufficient": {"const": false}
      }
    },
    "exact_fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["lambda", "symmetric_noncommuting_W", "H0_times_GH0_is_identity", "n1_direct_and_reduced", "n2_direct_and_reduced", "n3_direct_and_reduced", "n3_cyclic_longitudinal_coefficients"],
      "properties": {
        "lambda": {"$ref": "#/$defs/rational"},
        "symmetric_noncommuting_W": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/rational"}}},
        "H0_times_GH0_is_identity": {"const": true},
        "n1_direct_and_reduced": {"$ref": "#/$defs/rational"},
        "n2_direct_and_reduced": {"$ref": "#/$defs/rational"},
        "n3_direct_and_reduced": {"$ref": "#/$defs/rational"},
        "n3_cyclic_longitudinal_coefficients": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/rational"}}
      }
    },
    "coefficient_disposition": {"$ref": "#/$defs/stringMap"},
    "claim_flags": {
      "type": "object", "additionalProperties": false,
      "required": [
        "GENERIC_GHOST_N1_N2_HODGE_RESOLVENT_REDUCTION_COMPUTED",
        "GENERIC_GHOST_N1_N2_NONMINIMAL_ARCHITECTURE_CLOSED",
        "GENERIC_GHOST_N1_INSERTION_TRACE_COMPUTED",
        "GENERIC_GHOST_N2_INSERTION_TRACE_COMPUTED",
        "GENERIC_NONMINIMAL_GHOST_CPT_DETERMINANT_COMPUTED",
        "REPOSITORY_CUBIC_FORM_FACTOR_FUNCTIONS_COMPUTED",
        "PHYSICAL_FOURTH_ORDER_HESSIAN_KERNEL_COMPUTED",
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED",
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED",
        "RESIDUAL_TRANSFER_AUTHORIZED", "LORENTZIAN_CERTIFIED"
      ],
      "properties": {
        "GENERIC_GHOST_N1_N2_HODGE_RESOLVENT_REDUCTION_COMPUTED": {"const": true},
        "GENERIC_GHOST_N1_N2_NONMINIMAL_ARCHITECTURE_CLOSED": {"const": true},
        "GENERIC_GHOST_N1_INSERTION_TRACE_COMPUTED": {"const": false},
        "GENERIC_GHOST_N2_INSERTION_TRACE_COMPUTED": {"const": false},
        "GENERIC_NONMINIMAL_GHOST_CPT_DETERMINANT_COMPUTED": {"const": false},
        "REPOSITORY_CUBIC_FORM_FACTOR_FUNCTIONS_COMPUTED": {"const": false},
        "PHYSICAL_FOURTH_ORDER_HESSIAN_KERNEL_COMPUTED": {"const": false},
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED": {"const": false},
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED": {"const": false},
        "RESIDUAL_TRANSFER_AUTHORIZED": {"const": false},
        "LORENTZIAN_CERTIFIED": {"const": false}
      }
    },
    "dependencies": {
      "type": "object", "additionalProperties": false,
      "required": ["Endo_Duhamel_reduction", "n3_five_carrier_projection"],
      "properties": {
        "Endo_Duhamel_reduction": {"$ref": "#/$defs/reference"},
        "n3_five_carrier_projection": {"$ref": "#/$defs/reference"}
      }
    },
    "next_gate": {"const": "EVALUATE_FIVE_MINIMAL_VECTOR_SCALAR_N1_N2_RESOLVENT_CARRIERS_AND_GENERIC_PHYSICAL_FOURTH_ORDER_HESSIAN_KERNEL"},
    "claim_boundary": {"type": "string", "minLength": 300}
  },
  "$defs": {
    "rational": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "stringMap": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "carrier": {
      "type": "object", "additionalProperties": false,
      "required": ["carrier_id", "coefficient", "trace", "cubic_extraction"],
      "properties": {
        "carrier_id": {"type": "string"}, "coefficient": {"$ref": "#/$defs/rational"},
        "trace": {"type": "string"}, "cubic_extraction": {"type": "string"}
      }
    },
    "reference": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "result_id", "sha256"],
      "properties": {
        "path": {"type": "string"}, "result_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
