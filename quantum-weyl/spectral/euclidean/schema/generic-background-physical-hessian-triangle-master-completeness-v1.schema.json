    "exact_rank_fixtures": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/fixtureRow"}},
    "formula_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "claim_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["M14_SINGLET_REQUIRED", "STANDARD_S3_MASTER_PAIR_REQUIRED", "ALL_ELEVEN_PHYSICAL_ROWS_IN_SIX_MASTER_SPAN", "GENERIC_MASTER_SPAN_RANK_52", "RENORMALIZED_SIX_MASTER_VALUES_COMPUTED", "PHYSICAL_N3_TRIANGLE_INTEGRATED", "REPOSITORY_CUBIC_FORM_FACTOR_FUNCTIONS_COMPUTED", "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED", "COMPLETE_RENORMALIZED_Q1_SUPPLIED", "QME_RESTORED", "LORENTZIAN_CERTIFIED", "RESIDUAL_TRANSFER_AUTHORIZED"],
      "properties": {
        "M14_SINGLET_REQUIRED": {"const": true}, "STANDARD_S3_MASTER_PAIR_REQUIRED": {"const": true}, "ALL_ELEVEN_PHYSICAL_ROWS_IN_SIX_MASTER_SPAN": {"const": true}, "GENERIC_MASTER_SPAN_RANK_52": {"const": true},
        "RENORMALIZED_SIX_MASTER_VALUES_COMPUTED": {"const": false}, "PHYSICAL_N3_TRIANGLE_INTEGRATED": {"const": false}, "REPOSITORY_CUBIC_FORM_FACTOR_FUNCTIONS_COMPUTED": {"const": false}, "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED": {"const": false}, "COMPLETE_RENORMALIZED_Q1_SUPPLIED": {"const": false}, "QME_RESTORED": {"const": false}, "LORENTZIAN_CERTIFIED": {"const": false}, "RESIDUAL_TRANSFER_AUTHORIZED": {"const": false}
      }
    },
    "verification_policy": {"type": "object", "additionalProperties": false, "required": ["exhaustive_rail", "fast_rail"], "properties": {"exhaustive_rail": {"type": "string", "minLength": 1}, "fast_rail": {"type": "string", "minLength": 1}}},
    "next_gate": {"const": "EVALUATE_RENORMALIZED_SINGLET_AND_STANDARD_S3_MASTER_VALUES_AND_ASSEMBLE_PHYSICAL_THIRD_CURVATURE_FORM_FACTORS"},
