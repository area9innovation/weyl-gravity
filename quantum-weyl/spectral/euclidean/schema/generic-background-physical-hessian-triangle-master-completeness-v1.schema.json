  "$defs": {
    "dependency": {"type": "object", "additionalProperties": false, "required": ["path", "result_id", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "result_id": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "rankRow": {"type": "object", "additionalProperties": false, "required": ["added_master_id", "generic_rank"], "properties": {"added_master_id": {"enum": ["J_triangle", "M_x1", "M_x2", "M14_singlet", "M15_standard_u", "M16_standard_v"]}, "generic_rank": {"type": "integer", "minimum": 47, "maximum": 52}}},
    "actionRow": {"type": "object", "additionalProperties": false, "required": ["alpha_permutation", "standard_pair_action_columns", "determinant", "trace"], "properties": {"alpha_permutation": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"enum": ["alpha0", "alpha1", "alpha2"]}}, "standard_pair_action_columns": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}}}, "determinant": {"enum": [-1, 1]}, "trace": {"enum": [-1, 0, 2]}}},
    "orbitGenerator": {"type": "object", "additionalProperties": false, "required": ["generator_id", "channel_map"], "properties": {"generator_id": {"enum": ["swap_alpha0_alpha2", "swap_alpha1_alpha2"]}, "channel_map": {"type": "array", "minItems": 11, "maxItems": 11, "items": {"$ref": "#/$defs/orbitMap"}}}},
    "orbitMap": {"type": "object", "additionalProperties": false, "required": ["source_channel_id", "target_channel_id"], "properties": {"source_channel_id": {"type": "string", "pattern": "^I(10|24|25|28|29)_[123]{3}$"}, "target_channel_id": {"type": "string", "pattern": "^I(10|24|25|28|29)_[123]{3}$"}}},
    "channelRow": {"type": "object", "additionalProperties": false, "required": ["channel_id", "numerator_box_degree", "generic_augmented_rank", "membership_status"], "properties": {"channel_id": {"type": "string", "pattern": "^I(10|24|25|28|29)_[123]{3}$"}, "numerator_box_degree": {"type": "integer", "minimum": 3, "maximum": 6}, "generic_augmented_rank": {"const": 52}, "membership_status": {"const": "IN_SIX_MASTER_RELATIVE_IBP_SPAN"}}},
    "fixtureRow": {"type": "object", "additionalProperties": false, "required": ["boxes", "six_master_rank", "six_master_plus_all_physical_rows_rank"], "properties": {"boxes": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1}}, "six_master_rank": {"const": 52}, "six_master_plus_all_physical_rows_rank": {"const": 52}}}
  }
