    "new_master_numerators": {"const": {"M14_singlet": "alpha0*alpha1*alpha2", "M15_standard_u": "alpha0*alpha1*alpha2*(alpha1-alpha2)", "M16_standard_v": "alpha0*alpha1*alpha2*(alpha2-alpha0)"}},
