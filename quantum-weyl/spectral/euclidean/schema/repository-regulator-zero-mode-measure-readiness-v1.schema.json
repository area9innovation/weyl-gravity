    "receiver_mechanics": {"type": "object", "additionalProperties": false, "required": ["synthetic_receipt", "mutation_receipts"], "properties": {"synthetic_receipt": {"type": "object", "required": ["status", "factor_count", "zero_mode_dimension"], "properties": {"status": {"const": "SEMANTIC_RECEIVER_ACCEPTED"}, "factor_count": {"const": 2}, "zero_mode_dimension": {"const": 3}}}, "mutation_receipts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object", "additionalProperties": false, "required": ["mutation", "rejected"], "properties": {"mutation": {"enum": ["weighted_rank", "zero_mode_total", "priming", "proof_digest"]}, "rejected": {"const": true}}}}}},
