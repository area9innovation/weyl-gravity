{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.example/schemas/generic-background-physical-hessian-linear-curvature-v1.schema.json",
  "title": "Generic-background physical Hessian through linear curvature",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "lifecycle_state",
    "dependency_tags",
    "classical_commit",
    "scope",
    "source_provenance",
    "gauge_crosswalk",
    "traceless_projector",
    "source_operator",
    "repository_normalization",
    "scalar_flat_restriction",
    "round_S4_linear_crosscheck",
    "third_curvature_applicability",
    "negative_controls",
    "claim_flags",
    "dependencies",
    "next_gate",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "quantum-weyl-generic-background-physical-hessian-linear-curvature-v1"},
    "result_id": {"const": "GENERIC_BACKGROUND_PHYSICAL_HESSIAN_LINEAR_CURVATURE"},
    "result_state": {"const": "SAME_GAUGE_TRACELESS_PHYSICAL_HESSIAN_LINEAR_CURVATURE_IMPORTED_N3_THREE_LINEAR_VERTEX_READY"},
    "lifecycle_state": {"const": "COEFFICIENT_INPUT_IMPORTED_FULL_HESSIAN_OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "classical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "signature", "background", "field_bundle", "curvature_order", "operator_order", "domain"],
      "properties": {
        "dimension": {"const": 4},
        "signature": {"const": "Euclidean"},
        "background": {"type": "string", "minLength": 20},
        "field_bundle": {"type": "string", "minLength": 20},
        "curvature_order": {"const": "complete through first order only"},
        "operator_order": {"const": 4},
        "domain": {"type": "string", "minLength": 20}
      }
    },
    "source_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "authors", "arxiv", "doi", "source_url", "source_archive_url", "source_archive_sha256", "decompressed_tex_sha256", "equation_labels", "source_scope_statement", "transcription_policy"],
      "properties": {
        "title": {"const": "On the local term in the anomaly-induced action of Weyl quantum gravity"},
        "authors": {"type": "string", "minLength": 10},
        "arxiv": {"const": "2308.05251v2"},
        "doi": {"const": "10.1103/PhysRevD.108.086018"},
        "source_url": {"const": "https://arxiv.org/abs/2308.05251"},
        "source_archive_url": {"const": "https://export.arxiv.org/e-print/2308.05251v2"},
        "source_archive_sha256": {"$ref": "#/$defs/hash"},
        "decompressed_tex_sha256": {"$ref": "#/$defs/hash"},
        "equation_labels": {"const": ["gf-gen", "gauge-min", "Hmingen", "traceless", "Vrhosi", "Nrho", "U"]},
        "source_scope_statement": {"type": "string", "minLength": 80},
        "transcription_policy": {"type": "string", "minLength": 80}
      }
    },
    "gauge_crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_vector_gauge", "source_parameters", "source_Weyl_gauge", "repository_vector_gauge", "repository_Weyl_gauge", "same_gauge", "generic_ghost_crosswalk"],
      "properties": {
        "source_vector_gauge": {"type": "string"},
        "source_parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["gamma1", "gamma2", "tau"],
          "properties": {
            "gamma1": {"$ref": "#/$defs/rational"},
            "gamma2": {"$ref": "#/$defs/rational"},
            "tau": {"$ref": "#/$defs/rational"}
          }
        },
        "source_Weyl_gauge": {"const": "h=0"},
        "repository_vector_gauge": {"const": "F_mu=nabla^nu h_mu_nu-(1/4)nabla_mu h"},
        "repository_Weyl_gauge": {"const": "F_W=h"},
        "same_gauge": {"const": true},
        "generic_ghost_crosswalk": {"type": "string", "minLength": 50}
      }
    },
    "traceless_projector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "ambient_symmetric_rank", "projected_traceless_rank", "idempotent", "matrix_in_symmetric_component_basis"],
      "properties": {
        "formula": {"type": "string"},
        "ambient_symmetric_rank": {"const": 10},
        "projected_traceless_rank": {"const": 9},
        "idempotent": {"const": true},
        "matrix_in_symmetric_component_basis": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "array",
            "minItems": 10,
            "maxItems": 10,
            "items": {"$ref": "#/$defs/rational"}
          }
        }
      }
    },
    "source_operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quadratic_form", "monic_operator", "symmetrization", "coefficient_rows", "formula_digest"],
      "properties": {
        "quadratic_form": {"type": "string"},
        "monic_operator": {"type": "string"},
        "symmetrization": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}},
        "coefficient_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V_rho_sigma", "N_lambda", "U"],
          "properties": {
            "V_rho_sigma": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/term"}},
            "N_lambda": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/term"}},
            "U": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/term"}}
          }
        },
        "formula_digest": {"$ref": "#/$defs/hash"}
      }
    },
    "repository_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_action", "source_quadratic_prefactor", "repository_functional_Hessian", "repository_leading_symbol", "flat_TT_leading_coefficient", "trace_log_linear_vertex_scale_invariant", "constant_overall_determinant_normalization"],
      "properties": {
        "repository_action": {"type": "string"},
        "source_quadratic_prefactor": {"$ref": "#/$defs/rational"},
        "repository_functional_Hessian": {"const": "H_repository=(1/2)H_source"},
        "repository_leading_symbol": {"const": "(1/2)1hat Box^2"},
        "flat_TT_leading_coefficient": {"$ref": "#/$defs/rational"},
        "trace_log_linear_vertex_scale_invariant": {"type": "string"},
        "constant_overall_determinant_normalization": {"type": "string", "minLength": 60}
      }
    },
    "scalar_flat_restriction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conditions", "surviving_term_counts", "surviving_term_ids", "complete_first_curvature_insertion_on_scalar_flat_domain"],
      "properties": {
        "conditions": {"const": ["R=0", "nabla R=0", "nabla nabla R=0", "Box R=0"]},
        "surviving_term_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V_rho_sigma", "N_lambda", "U"],
          "properties": {"V_rho_sigma": {"const": 7}, "N_lambda": {"const": 6}, "U": {"const": 3}}
        },
        "surviving_term_ids": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V_rho_sigma", "N_lambda", "U"],
          "properties": {
            "V_rho_sigma": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"type": "string"}},
            "N_lambda": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "string"}},
            "U": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}
          }
        },
        "complete_first_curvature_insertion_on_scalar_flat_domain": {"const": true}
      }
    },
    "round_S4_linear_crosscheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sectional_curvature_symbol", "TT_and_linear_curvature_policy", "direct_K_Box_rows", "source_linear_operator", "repository_linear_functional_Hessian", "repository_full_round_S4_Hessian", "missing_curvature_squared_fixture", "interpretation"],
      "properties": {
        "sectional_curvature_symbol": {"const": "K"},
        "TT_and_linear_curvature_policy": {"type": "string", "minLength": 40},
        "direct_K_Box_rows": {
          "type": "object",
          "additionalProperties": false,
          "required": ["V01_scalar_curvature", "V08_Riemann_on_traceless_tensor", "V09_Ricci_derivative_metric"],
          "properties": {
            "V01_scalar_curvature": {"$ref": "#/$defs/rational"},
            "V08_Riemann_on_traceless_tensor": {"$ref": "#/$defs/rational"},
            "V09_Ricci_derivative_metric": {"$ref": "#/$defs/rational"}
          }
        },
        "source_linear_operator": {"const": "A^2+6 K A with A=-Box"},
        "repository_linear_functional_Hessian": {"const": "(1/2)A^2+3 K A"},
        "repository_full_round_S4_Hessian": {"const": "(1/2)(A+2K)(A+4K)=(1/2)A^2+3KA+4K^2; unit S4 has K=1"},
        "missing_curvature_squared_fixture": {"type": "string"},
        "interpretation": {"type": "string", "minLength": 60}
      }
    },
    "third_curvature_applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flat_base", "linear_insertion", "closed_trace_row", "status", "not_closed"],
      "properties": {
        "flat_base": {"const": "H0=1hat Box^2"},
        "linear_insertion": {"const": "H1=V nabla nabla+N nabla+U"},
        "closed_trace_row": {"type": "string"},
        "status": {"const": "PHYSICAL_N3_THREE_LINEAR_INSERTION_VERTEX_READY"},
        "not_closed": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string", "minLength": 30}}
      }
    },
    "negative_controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gauge_tau_mutation", "V01_coefficient_mutation", "full_Hessian_promotion"],
      "properties": {
        "gauge_tau_mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutated_tau", "same_gauge", "rejected"],
          "properties": {"mutated_tau": {"$ref": "#/$defs/rational"}, "same_gauge": {"const": false}, "rejected": {"const": true}}
        },
        "V01_coefficient_mutation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mutated", "formula_digest_matches", "rejected"],
          "properties": {"mutated": {"$ref": "#/$defs/rational"}, "formula_digest_matches": {"const": false}, "rejected": {"const": true}}
        },
        "full_Hessian_promotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attempted", "rejected", "reason"],
          "properties": {"attempted": {"const": true}, "rejected": {"const": true}, "reason": {"type": "string", "minLength": 60}}
        }
      }
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SAME_GAUGE_CROSSWALK_CERTIFIED",
        "TRACELESS_PROJECTOR_CERTIFIED",
        "LINEAR_CURVATURE_V_N_U_IMPORTED",
        "REPOSITORY_FUNCTIONAL_HESSIAN_NORMALIZED",
        "SCALAR_FLAT_FIRST_CURVATURE_INSERTION_COMPLETE",
        "ROUND_S4_LINEAR_LAYER_CROSSCHECKED",
        "PHYSICAL_N3_THREE_LINEAR_INSERTION_VERTEX_READY",
        "FULL_GENERIC_PHYSICAL_HESSIAN_SUPPLIED",
        "CURVATURE_SQUARED_ZERO_ORDER_LAYER_SUPPLIED",
        "PHYSICAL_MIXED_N1_N2_THIRD_CURVATURE_ROWS_COMPUTED",
        "PHYSICAL_N3_TRIANGLE_INTEGRATED",
        "REPOSITORY_FIVE_FORM_FACTORS_COMPUTED",
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED",
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED",
        "RESIDUAL_TRANSFER_AUTHORIZED",
        "LORENTZIAN_CERTIFIED"
      ],
      "properties": {
        "SAME_GAUGE_CROSSWALK_CERTIFIED": {"const": true},
        "TRACELESS_PROJECTOR_CERTIFIED": {"const": true},
        "LINEAR_CURVATURE_V_N_U_IMPORTED": {"const": true},
        "REPOSITORY_FUNCTIONAL_HESSIAN_NORMALIZED": {"const": true},
        "SCALAR_FLAT_FIRST_CURVATURE_INSERTION_COMPLETE": {"const": true},
        "ROUND_S4_LINEAR_LAYER_CROSSCHECKED": {"const": true},
        "PHYSICAL_N3_THREE_LINEAR_INSERTION_VERTEX_READY": {"const": true},
        "FULL_GENERIC_PHYSICAL_HESSIAN_SUPPLIED": {"const": false},
        "CURVATURE_SQUARED_ZERO_ORDER_LAYER_SUPPLIED": {"const": false},
        "PHYSICAL_MIXED_N1_N2_THIRD_CURVATURE_ROWS_COMPUTED": {"const": false},
        "PHYSICAL_N3_TRIANGLE_INTEGRATED": {"const": false},
        "REPOSITORY_FIVE_FORM_FACTORS_COMPUTED": {"const": false},
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED": {"const": false},
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED": {"const": false},
        "RESIDUAL_TRANSFER_AUTHORIZED": {"const": false},
        "LORENTZIAN_CERTIFIED": {"const": false}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classical_snapshot_compatibility", "round_S4_TT_hessian", "generic_Diff_Weyl_ghost", "universal_CPT_kernels"],
      "properties": {
        "classical_snapshot_compatibility": {"$ref": "#/$defs/reference"},
        "round_S4_TT_hessian": {"$ref": "#/$defs/reference"},
        "generic_Diff_Weyl_ghost": {"$ref": "#/$defs/reference"},
        "universal_CPT_kernels": {"$ref": "#/$defs/reference"}
      }
    },
    "next_gate": {"const": "COMPUTE_PHYSICAL_N3_THREE_LINEAR_TRIANGLE_AND_IMPORT_CURVATURE_SQUARED_HESSIAN_LAYER"},
    "claim_boundary": {"type": "string", "minLength": 500}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term_id", "coefficient", "seed", "curvature_atom", "background_derivatives", "operator_derivatives", "total_engineering_order", "scalar_flat_survives"],
      "properties": {
        "term_id": {"type": "string", "pattern": "^[VNU][0-9]{2}$"},
        "coefficient": {"$ref": "#/$defs/rational"},
        "seed": {"type": "string", "minLength": 8},
        "curvature_atom": {"enum": ["R", "Ric", "Riem"]},
        "background_derivatives": {"type": "integer", "minimum": 0, "maximum": 2},
        "operator_derivatives": {"type": "integer", "minimum": 0, "maximum": 2},
        "total_engineering_order": {"const": 4},
        "scalar_flat_survives": {"type": "boolean"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "result_id", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "result_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
