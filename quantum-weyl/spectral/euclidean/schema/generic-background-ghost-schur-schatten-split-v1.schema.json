{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "quantum-weyl-generic-background-ghost-schur-schatten-split-v1.schema.json",
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "result_id", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "result_id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "nonemptyStrings": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "lifecycle_state",
    "dependency_tags",
    "classical_commit",
    "scope",
    "operator_identity",
    "sharp_ideal_classification",
    "canonical_modified_determinant",
    "curvature_expansion_through_W3",
    "critical_local_residue",
    "exact_modified_determinant_fixture",
    "analytic_disposition",
    "claim_flags",
    "dependencies",
    "references",
    "next_gate",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "quantum-weyl-generic-background-ghost-schur-schatten-split-v1"},
    "result_id": {"const": "GENERIC_BACKGROUND_GHOST_SCHUR_SCHATTEN_SPLIT"},
    "result_state": {"const": "SCHUR_CORRECTION_IN_S3_WITH_CANONICAL_DET3_TAIL_AND_EXACT_CRITICAL_K2_RESIDUE"},
    "lifecycle_state": {"const": "REGULARIZATION_SPLIT_COMPUTED_FULL_SCHUR_DETERMINANT_UNEVALUATED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "classical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "signature", "manifold", "mode_domain", "operator_scope"],
      "properties": {
        "dimension": {"const": 4},
        "signature": {"const": "Euclidean"},
        "manifold": {"type": "string", "minLength": 1},
        "mode_domain": {"type": "string", "minLength": 1},
        "operator_scope": {"type": "string", "minLength": 1}
      }
    },
    "operator_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["S_L", "K", "K_series", "principal_symbol_K", "W_specialization"],
      "properties": {
        "S_L": {"const": "(2/3)I+(1/3)delta(F+W)^-1 d"},
        "K": {"type": "string", "minLength": 1},
        "K_series": {"type": "string", "minLength": 1},
        "principal_symbol_K": {"const": "sigma_-2(K)=-(1/3)<xi,W xi>/|xi|^4"},
        "W_specialization": {"const": "W=-2 Ric"}
      }
    },
    "sharp_ideal_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["singular_value_decay", "Schatten_membership", "ordinary_trace_class", "K_squared", "K_cubed", "minimal_modified_determinant_order"],
      "properties": {
        "singular_value_decay": {"const": "s_j(K)=O(j^-1/2)"},
        "Schatten_membership": {"const": "K in S_p for every p>2; in particular K in S_3"},
        "ordinary_trace_class": {"const": "NOT_PROVED_AND_NOT_GENERIC_FROM_ORDER_MINUS_TWO"},
        "K_squared": {"type": "string", "minLength": 1},
        "K_cubed": {"type": "string", "minLength": 1},
        "minimal_modified_determinant_order": {"const": 3}
      }
    },
    "canonical_modified_determinant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "trace_class_remainder", "small_norm_series", "renormalized_split", "regulator_dependence"],
      "properties": {
        "definition": {"const": "det_3(I+K)=det[(I+K) exp(-K+K^2/2)]"},
        "trace_class_remainder": {"type": "string", "minLength": 1},
        "small_norm_series": {"const": "log det_3(I+K)=sum_(m>=3)(-1)^(m+1)Tr(K^m)/m"},
        "renormalized_split": {"type": "string", "minLength": 1},
        "regulator_dependence": {"type": "string", "minLength": 1}
      }
    },
    "curvature_expansion_through_W3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["K_components", "W1", "W2", "W3", "canonical_cubic_tail", "remaining_regularized_cubic_rows"],
      "properties": {
        "K_components": {"$ref": "#/$defs/nonemptyStrings"},
        "W1": {"$ref": "#/$defs/nonemptyStrings"},
        "W2": {"$ref": "#/$defs/nonemptyStrings"},
        "W3": {"$ref": "#/$defs/nonemptyStrings"},
        "canonical_cubic_tail": {"const": "-(1/81)Tr(B1^3)"},
        "remaining_regularized_cubic_rows": {"const": ["R(B3)", "R(B1 B2)"]}
      }
    },
    "critical_local_residue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "sigma_minus_4_K2", "W_basis", "Ricci_basis", "scalar_flat_basis", "conversion_boundary", "sphere_moment_replay"],
      "properties": {
        "definition": {"type": "string", "minLength": 1},
        "sigma_minus_4_K2": {"const": "(1/9)<xi,W xi>^2/|xi|^8"},
        "W_basis": {"const": "Wres(K^2)=(4 pi)^-2 integral[(tr W)^2+2 tr(W^2)]/108"},
        "Ricci_basis": {"const": "Wres(K^2)=(4 pi)^-2 integral[R^2+2 Ric_mn Ric^mn]/27"},
        "scalar_flat_basis": {"const": "Wres(K^2)=(4 pi)^-2 integral[2 Ric_mn Ric^mn]/27 when R=0"},
        "conversion_boundary": {"type": "string", "minLength": 1},
        "sphere_moment_replay": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimension", "unit_sphere_volume", "normalized_fourth_moment", "contraction", "symbolic_residual"],
          "properties": {
            "dimension": {"const": 4},
            "unit_sphere_volume": {"const": "2 pi^2"},
            "normalized_fourth_moment": {"type": "string", "minLength": 1},
            "contraction": {"type": "string", "minLength": 1},
            "symbolic_residual": {"const": {"numerator": 0, "denominator": 1}}
          }
        }
      }
    },
    "exact_modified_determinant_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "det_I_plus_K", "Tr_K", "one_half_Tr_K2", "det3_exponential_counterterm", "det3_representation", "log_det3_coefficients_power_3_to_6"],
      "properties": {
        "dimension": {"const": 3},
        "det_I_plus_K": {"$ref": "#/$defs/rational"},
        "Tr_K": {"$ref": "#/$defs/rational"},
        "one_half_Tr_K2": {"$ref": "#/$defs/rational"},
        "det3_exponential_counterterm": {"$ref": "#/$defs/rational"},
        "det3_representation": {"type": "string", "minLength": 1},
        "log_det3_coefficients_power_3_to_6": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["power", "coefficient"],
            "properties": {
              "power": {"type": "integer", "minimum": 3, "maximum": 6},
              "coefficient": {"$ref": "#/$defs/rational"}
            }
          }
        }
      }
    },
    "analytic_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_nonlocal_tail", "renormalized_rows_still_required", "computed_local_row", "uncomputed_local_rows", "physical_kernel"],
      "properties": {
        "canonical_nonlocal_tail": {"const": "det_3(I+K)"},
        "renormalized_rows_still_required": {"$ref": "#/$defs/nonemptyStrings"},
        "computed_local_row": {"const": "Wres(K^2)"},
        "uncomputed_local_rows": {"$ref": "#/$defs/nonemptyStrings"},
        "physical_kernel": {"type": "string", "minLength": 1}
      }
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SCHUR_CORRECTION_S3_CLASS_PROVED",
        "CANONICAL_DET3_TAIL_DEFINED",
        "CRITICAL_K2_WODZICKI_RESIDUE_COMPUTED",
        "ORDINARY_TRACE_CLASS_PROVED",
        "FULL_SCHUR_REGULARIZED_DETERMINANT_COMPUTED",
        "WODZICKI_RESIDUE_K_COMPUTED",
        "ZETA_MULTIPLICATIVE_ANOMALY_COMPUTED",
        "SCHUR_COVARIANT_FORM_FACTORS_COMPUTED",
        "PHYSICAL_FOURTH_ORDER_HESSIAN_KERNEL_COMPUTED",
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED",
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED",
        "RESIDUAL_TRANSFER_AUTHORIZED",
        "LORENTZIAN_CERTIFIED"
      ],
      "properties": {
        "SCHUR_CORRECTION_S3_CLASS_PROVED": {"const": true},
        "CANONICAL_DET3_TAIL_DEFINED": {"const": true},
        "CRITICAL_K2_WODZICKI_RESIDUE_COMPUTED": {"const": true},
        "ORDINARY_TRACE_CLASS_PROVED": {"const": false},
        "FULL_SCHUR_REGULARIZED_DETERMINANT_COMPUTED": {"const": false},
        "WODZICKI_RESIDUE_K_COMPUTED": {"const": false},
        "ZETA_MULTIPLICATIVE_ANOMALY_COMPUTED": {"const": false},
        "SCHUR_COVARIANT_FORM_FACTORS_COMPUTED": {"const": false},
        "PHYSICAL_FOURTH_ORDER_HESSIAN_KERNEL_COMPUTED": {"const": false},
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED": {"const": false},
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED": {"const": false},
        "RESIDUAL_TRANSFER_AUTHORIZED": {"const": false},
        "LORENTZIAN_CERTIFIED": {"const": false}
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Schur_resummation"],
      "properties": {"Schur_resummation": {"$ref": "#/$defs/dependency"}}
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "authors", "arxiv", "role"],
        "properties": {
          "title": {"type": "string", "minLength": 1},
          "authors": {"type": "string", "minLength": 1},
          "arxiv": {"type": "string", "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"},
          "role": {"type": "string", "minLength": 1}
        }
      }
    },
    "next_gate": {"const": "COMPUTE_RENORMALIZED_R_K_AND_FINITE_R_K2_THEN_COMBINE_WITH_GENERIC_PHYSICAL_FOURTH_ORDER_HESSIAN"},
    "claim_boundary": {"type": "string", "minLength": 300}
  }
}
