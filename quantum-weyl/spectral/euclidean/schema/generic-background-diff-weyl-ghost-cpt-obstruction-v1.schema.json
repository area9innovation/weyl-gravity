        "ALGEBRAIC_WEYL_GHOST_ELIMINATED",
        "EFFECTIVE_VECTOR_OPERATOR_BETA_INDEPENDENT",
        "GENERIC_GHOST_PRINCIPAL_SYMBOL_NONMINIMAL",
        "GENERIC_GHOST_HODGE_SPLIT_OBSTRUCTED",
