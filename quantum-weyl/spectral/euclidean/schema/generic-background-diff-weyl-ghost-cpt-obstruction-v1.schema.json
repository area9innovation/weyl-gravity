      "properties": {
        "GENERIC_DIFF_WEYL_FP_ROWS_DERIVED": {"const": true},
        "ALGEBRAIC_WEYL_GHOST_ELIMINATED": {"const": true},
        "EFFECTIVE_VECTOR_OPERATOR_BETA_INDEPENDENT": {"const": true},
        "GENERIC_GHOST_PRINCIPAL_SYMBOL_NONMINIMAL": {"const": true},
        "GENERIC_GHOST_HODGE_SPLIT_OBSTRUCTED": {"const": true},
        "EINSTEIN_SCALAR_GHOST_FACTOR_REPRODUCED": {"const": true},
        "GENERIC_NONMINIMAL_GHOST_CPT_DETERMINANT_COMPUTED": {"const": false},
        "REPOSITORY_GENERIC_BACKGROUND_TRACE_SUBSTITUTION_SUPPLIED": {"const": false},
        "REPOSITORY_CUBIC_FORM_FACTOR_FUNCTIONS_COMPUTED": {"const": false},
        "REPOSITORY_CUBIC_COEFFICIENTS_COMPUTED": {"const": false},
        "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED": {"const": false},
        "COMPLETE_RENORMALIZED_Q1_SUPPLIED": {"const": false},
        "RESIDUAL_TRANSFER_AUTHORIZED": {"const": false},
        "LORENTZIAN_CERTIFIED": {"const": false}
