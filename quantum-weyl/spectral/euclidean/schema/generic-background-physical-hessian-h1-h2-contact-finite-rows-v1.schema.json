{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/quantum-weyl/generic-background-physical-hessian-h1-h2-contact-finite-rows-v1.schema.json",
  "title": "Generic physical H1-H2 minimally-subtracted finite contact rows",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "lifecycle_state", "dependency_tags", "classical_commit", "scope", "finite_contact_theorem", "interpolation", "projection_rows", "equal_box_regression", "fixture_ledger", "dependencies", "claim_flags", "next_gate", "claim_boundary"],
  "properties": {
    "schema": {"const": "quantum-weyl-generic-background-physical-hessian-h1-h2-contact-finite-rows-v1"},
    "result_id": {"const": "GENERIC_BACKGROUND_PHYSICAL_HESSIAN_H1_H2_CONTACT_FINITE_ROWS"},
    "result_state": {"const": "GENERIC_H1_H2_CONTACT_MINIMAL_SUBTRACTION_FINITE_ROWS_COMPUTED"},
    "lifecycle_state": {"const": "COEFFICIENT_COMPUTED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "classical_commit": {"type": "string", "minLength": 7},
    "scope": {"type": "object", "additionalProperties": {"type": ["string", "integer"]}},
    "finite_contact_theorem": {"type": "object", "additionalProperties": false, "required": ["quadratic_decomposition", "coefficient_reconstruction", "density", "minimal_subtraction_finite_row", "endpoint_finite_constant", "mellin_endpoint_check", "contact_count", "raw_channel_count_per_contact", "quotient_dimension"], "properties": {"quadratic_decomposition": {"type": "string"}, "coefficient_reconstruction": {"type": "string"}, "density": {"type": "string"}, "minimal_subtraction_finite_row": {"type": "string"}, "endpoint_finite_constant": {"type": "string"}, "mellin_endpoint_check": {"$ref": "#/$defs/rational"}, "contact_count": {"const": 3}, "raw_channel_count_per_contact": {"const": 11}, "quotient_dimension": {"const": 10}}},
    "interpolation": {"type": "object", "required": ["training_fixture_count", "unseen_fixture_count", "common_box_denominator_exponents", "numerator_degree_rule", "unisolvence_prime", "row_count", "formula_digest", "unseen_ledger"]},
    "projection_rows": {"type": "array", "minItems": 33, "maxItems": 33, "items": {"$ref": "#/$defs/row"}},
    "equal_box_regression": {"type": "object"},
    "fixture_ledger": {"$ref": "#/$defs/reference"},
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["contact_residue_projection", "contact_residue_fixture"], "properties": {"contact_residue_projection": {"$ref": "#/$defs/reference"}, "contact_residue_fixture": {"$ref": "#/$defs/reference"}}},
    "claim_flags": {"type": "object", "additionalProperties": false, "required": ["GENERIC_CONTACT_MINIMAL_SUBTRACTION_FINITE_ROWS_COMPUTED", "ALL_THREE_CONTACT_FINITE_ROWS_PROJECTED", "QUADRATIC_CONTACT_RECONSTRUCTION_VERIFIED", "GENERIC_I28_QUOTIENT_RELATION_PRESERVED", "FINITE_COUNTERTERM_NORMALIZATION_FIXED", "RENORMALIZED_PHYSICAL_TRIANGLE_BULK_REDUCED", "PHYSICAL_THIRD_CURVATURE_FORM_FACTORS_COMPLETE", "QME_OR_ANOMALY_STATUS_CHANGED", "LORENTZIAN_CERTIFIED"], "properties": {"GENERIC_CONTACT_MINIMAL_SUBTRACTION_FINITE_ROWS_COMPUTED": {"const": true}, "ALL_THREE_CONTACT_FINITE_ROWS_PROJECTED": {"const": true}, "QUADRATIC_CONTACT_RECONSTRUCTION_VERIFIED": {"const": true}, "GENERIC_I28_QUOTIENT_RELATION_PRESERVED": {"const": true}, "FINITE_COUNTERTERM_NORMALIZATION_FIXED": {"const": false}, "RENORMALIZED_PHYSICAL_TRIANGLE_BULK_REDUCED": {"const": false}, "PHYSICAL_THIRD_CURVATURE_FORM_FACTORS_COMPLETE": {"const": false}, "QME_OR_ANOMALY_STATUS_CHANGED": {"const": false}, "LORENTZIAN_CERTIFIED": {"const": false}}},
    "next_gate": {"const": "REDUCE_RENORMALIZED_PHYSICAL_TRIANGLE_BULK_AND_ASSEMBLE_THIRD_CURVATURE_FORM_FACTORS"},
    "claim_boundary": {"type": "string", "minLength": 100}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "reference": {"type": "object", "additionalProperties": false, "required": ["path", "result_id", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "result_id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "term": {"type": "object", "additionalProperties": false, "required": ["box_exponents", "coefficient"], "properties": {"box_exponents": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0}}, "coefficient": {"$ref": "#/$defs/rational"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["contact_id", "singled_H1_leg", "carrier_id", "label_order", "explicit_derivative_order", "box_denominator_exponents", "numerator_box_degree", "finite_term_count", "minimal_subtraction_finite_terms"], "properties": {"contact_id": {"type": "string", "minLength": 1}, "singled_H1_leg": {"type": "integer", "minimum": 1, "maximum": 3}, "carrier_id": {"enum": ["I10", "I24", "I25", "I28", "I29"]}, "label_order": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 1, "maximum": 3}}, "explicit_derivative_order": {"enum": [0, 2, 4, 6]}, "box_denominator_exponents": {"const": [2, 2, 2]}, "numerator_box_degree": {"type": "integer", "minimum": 2, "maximum": 5}, "finite_term_count": {"type": "integer", "minimum": 0}, "minimal_subtraction_finite_terms": {"type": "array", "items": {"$ref": "#/$defs/term"}}}}
  }
}
