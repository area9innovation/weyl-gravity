{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quantum-weyl/product-s2-s2-ghost-schur-det3-enclosure-v1.schema.json",
  "title": "Product S2 x S2 ghost Schur det3 enclosure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "lifecycle_state", "dependency_tags", "classical_commit", "scope", "det3_enclosure", "tail_proof", "claim_flags", "dependencies", "next_gate", "claim_boundary"],
  "properties": {
    "schema": {"const": "quantum-weyl-product-s2-s2-ghost-schur-det3-enclosure-v1"},
    "result_id": {"const": "PRODUCT_S2_S2_GHOST_SCHUR_DET3_ENCLOSURE"},
    "result_state": {"const": "PRODUCT_S2_S2_REGULAR_SCHUR_DET3_RIGOROUSLY_ENCLOSED"},
    "lifecycle_state": {"const": "BACKGROUND_SPECIFIC_DET3_COMPUTED_WEIGHTED_FINITE_ROWS_OPEN"},
    "dependency_tags": {"const": ["EUCLIDEAN-SPECTRAL"]},
    "classical_commit": {"type": "string", "minLength": 7},
    "scope": {"$ref": "#/$defs/stringMap"},
    "det3_enclosure": {"type": "object"},
    "tail_proof": {"$ref": "#/$defs/stringMap"},
    "claim_flags": {
      "type": "object",
      "additionalProperties": {"type": "boolean"},
      "required": ["PRODUCT_REGULAR_COMPLEMENT_DET3_VALUE_COMPUTED", "MATCHED_EXCEPTIONAL_CORRECTION_RETAINED", "PRODUCT_WEIGHTED_R_K_COMPUTED", "PRODUCT_FINITE_PART_R_K2_COMPUTED", "FULL_COUPLED_VECTOR_SCHUR_DETERMINANT_COMPUTED", "GENERIC_BACKGROUND_SCHUR_DETERMINANT_COMPUTED", "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED", "COMPLETE_RENORMALIZED_Q1_SUPPLIED", "LORENTZIAN_CERTIFIED"]
    },
    "dependencies": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/reference"}
    },
    "next_gate": {"type": "string", "minLength": 20},
    "claim_boundary": {"type": "string", "minLength": 200}
  },
  "$defs": {
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "result_id", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "result_id": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
