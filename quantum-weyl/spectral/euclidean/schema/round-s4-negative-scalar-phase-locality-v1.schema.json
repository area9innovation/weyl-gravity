  "properties": {
    "schema": {"const": "quantum-weyl-round-s4-negative-scalar-phase-locality-v1"}, "result_id": {"const": "ROUND_S4_NEGATIVE_SCALAR_PHASE_LOCALITY"}, "result_state": {"const": "SPECTRAL_CUT_PHASE_EXPLICIT_LOCAL_B4_AND_LOCAL_SLAVNOV_INDEPENDENT_GLOBAL_BRANCH_OPEN"}, "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
