    "phase": {"type": "object", "additionalProperties": false, "required": ["negative_mode_count", "Gamma_logdet_exponent", "upper_cut_log_phase_in_units_of_i_pi", "lower_cut_log_phase_in_units_of_i_pi", "upper_cut_Gamma_phase_in_units_of_i_pi", "lower_cut_Gamma_phase_in_units_of_i_pi", "phase_jump_in_units_of_i_pi"], "properties": {"negative_mode_count": {"const": 1}, "Gamma_logdet_exponent": {"const": {"numerator": -1, "denominator": 2}}, "upper_cut_log_phase_in_units_of_i_pi": {"const": 1}, "lower_cut_log_phase_in_units_of_i_pi": {"const": -1}, "upper_cut_Gamma_phase_in_units_of_i_pi": {"const": {"numerator": -1, "denominator": 2}}, "lower_cut_Gamma_phase_in_units_of_i_pi": {"const": {"numerator": 1, "denominator": 2}}, "phase_jump_in_units_of_i_pi": {"const": {"numerator": -1, "denominator": 1}}}},
    "locality": {"const": {"spectral_cut_phase_constant_on_negative_eigenvalue_chamber": true, "BRST_or_Weyl_variation_of_phase_on_chamber": "ZERO", "finite_rank_phase_changes_local_symbol_b4_density": false, "finite_rank_magnitude_and_phase_remain_global_determinant_data": true, "eigenvalue_crossing_requires_separate_treatment": true}},
    "negative_control": {"type": "object", "required": ["mutation", "mutated_phase", "rejected"], "properties": {"mutation": {"const": "double the level-zero degeneracy"}, "rejected": {"const": true}}},
    "claim_flags": {"const": {"NEGATIVE_SCALAR_PHASE_EXPLICIT": true, "PHASE_IRRELEVANT_TO_LOCAL_B4_DENSITY": true, "PHASE_IRRELEVANT_TO_LOCAL_SLAVNOV_BREAKING_ON_FIXED_SIGN_CHAMBER": true, "GLOBAL_DETERMINANT_BRANCH_SELECTED": false, "REPOSITORY_REGULATOR_ZERO_MODE_MEASURE_LEDGER_CERTIFIED": false, "QME_DISPOSITION": false}},
    "proof_sha256": {"$ref": "#/$defs/hash"}, "next_gate": {"const": "BIND_PHASE_LOCALITY_TO_REPOSITORY_REGULATOR_ZERO_MODE_MEASURE_LEDGER"}, "claim_boundary": {"type": "string", "minLength": 400},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_sha256"], "properties": {"source_sha256": {"type": "object", "minProperties": 5, "maxProperties": 5, "additionalProperties": {"$ref": "#/$defs/hash"}}}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
