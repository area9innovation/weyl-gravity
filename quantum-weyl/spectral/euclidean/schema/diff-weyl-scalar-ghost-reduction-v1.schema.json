{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-diff-weyl-scalar-ghost-reduction-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "dependency_tags", "classical_commit", "dependency_hashes", "background", "gauge_conventions", "exact_variation", "scalar_matrix_identity", "gauge_parameter_control", "target_match", "negative_control", "claim_flags", "minimal_missing_carrier", "proof_sha256", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "quantum-weyl-diff-weyl-scalar-ghost-reduction-v1"},
    "result_id": {"const": "DIFF_WEYL_SCALAR_GHOST_REDUCTION"},
    "result_state": {"const": "SCALAR_FP_RANK_TWO_TO_ONE_DIFFERENTIAL_FACTOR_VERIFIED_FULL_BV_MEASURE_MAP_OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "classical_commit": {"$ref": "#/$defs/commit"},
    "dependency_hashes": {"type": "object", "additionalProperties": false, "required": ["standard_spin2_factorization", "classical_minimal_BV_import"], "properties": {"standard_spin2_factorization": {"$ref": "#/$defs/hash"}, "classical_minimal_BV_import": {"$ref": "#/$defs/hash"}}},
    "background": {"type": "object", "additionalProperties": false, "required": ["dimension", "signature", "geometry", "ricci_identity", "laplacian_convention"], "properties": {"dimension": {"const": 4}, "signature": {"const": "EUCLIDEAN"}, "geometry": {"const": "Einstein"}, "ricci_identity": {"const": "Ric_mu_nu=(R/4)g_mu_nu"}, "laplacian_convention": {"const": "Delta_0=-nabla^2"}}},
    "gauge_conventions": {"type": "object", "additionalProperties": false, "required": ["metric_BRST_row", "vector_gauge", "trace_gauge", "ghost_inputs", "scalar_outputs"], "properties": {"metric_BRST_row": {"type": "string"}, "vector_gauge": {"const": "F_mu=nabla^nu h_mu_nu-(1/4)nabla_mu h"}, "trace_gauge": {"const": "F_W=h"}, "ghost_inputs": {"const": ["xi_longitudinal_scalar", "omega"]}, "scalar_outputs": {"const": ["longitudinal_part_of_F_mu", "F_W"]}}},
    "exact_variation": {"type": "object", "additionalProperties": false, "required": ["vector_gauge_general_beta", "gradient_commutator", "canonical_longitudinal_row", "canonical_trace_row", "weyl_decoupling_from_vector_gauge"], "properties": {"vector_gauge_general_beta": {"type": "string"}, "gradient_commutator": {"type": "string"}, "canonical_longitudinal_row": {"const": "-(3/2)nabla_mu(Delta_0-R/3)c"}, "canonical_trace_row": {"const": "-2 Delta_0 c+8 omega"}, "weyl_decoupling_from_vector_gauge": {"const": true}}},
    "scalar_matrix_identity": {"$ref": "#/$defs/identity"},
    "gauge_parameter_control": {"type": "object", "additionalProperties": false, "required": ["beta_zero_matrix", "determinant_independent_of_beta", "canonical_beta_selected_for_triangularity"], "properties": {"beta_zero_matrix": {"$ref": "#/$defs/identity"}, "determinant_independent_of_beta": {"const": true}, "canonical_beta_selected_for_triangularity": {"const": "1/4"}}},
    "target_match": {"type": "object", "additionalProperties": false, "required": ["standard_factor_id", "standard_spin", "standard_M_squared_at_R_12", "repository_scalar_operator", "unit_curvature_specialization", "differential_input_rank", "differential_output_factor_rank", "remaining_factor", "status"], "properties": {"standard_factor_id": {"const": "ghost_depth_0"}, "standard_spin": {"const": 0}, "standard_M_squared_at_R_12": {"const": -4}, "repository_scalar_operator": {"const": "Delta_0-R/3"}, "unit_curvature_specialization": {"const": "R=12 gives Delta_0-4"}, "differential_input_rank": {"const": 2}, "differential_output_factor_rank": {"const": 1}, "remaining_factor": {"const": "operator-independent algebraic constant -12; functional-measure normalization open"}, "status": {"const": "EXACT_OPERATOR_AND_RANK_MATCH"}}},
    "negative_control": {"type": "object", "additionalProperties": false, "required": ["mutation", "mutated_ricci_coefficient", "mutated_identity", "rejected"], "properties": {"mutation": {"type": "string"}, "mutated_ricci_coefficient": {"const": "R/4"}, "mutated_identity": {"$ref": "#/$defs/identity"}, "rejected": {"const": true}}},
    "claim_flags": {"type": "object", "additionalProperties": false, "required": ["DIFF_WEYL_SCALAR_FP_MATRIX_DERIVED", "SCALAR_GHOST_DIFFERENTIAL_RANK_TWO_TO_ONE", "STANDARD_SCALAR_GHOST_OPERATOR_MATCHED", "SCALAR_BLOCK_GAUGE_PARAMETER_DETERMINANT_INVARIANCE", "YORK_HODGE_MEASURE_MATCHED", "NONMINIMAL_BEREZINIAN_MATCHED", "FULL_REPOSITORY_HESSIAN_MATCHED", "REPOSITORY_FULL_BV_MULTIPLICITY_LEDGER_ACCEPTED", "REGULATED_SLAVNOV_BREAKING_COMPUTED", "QME_DISPOSITION"], "properties": {"DIFF_WEYL_SCALAR_FP_MATRIX_DERIVED": {"const": true}, "SCALAR_GHOST_DIFFERENTIAL_RANK_TWO_TO_ONE": {"const": true}, "STANDARD_SCALAR_GHOST_OPERATOR_MATCHED": {"const": true}, "SCALAR_BLOCK_GAUGE_PARAMETER_DETERMINANT_INVARIANCE": {"const": true}, "YORK_HODGE_MEASURE_MATCHED": {"const": false}, "NONMINIMAL_BEREZINIAN_MATCHED": {"const": false}, "FULL_REPOSITORY_HESSIAN_MATCHED": {"const": false}, "REPOSITORY_FULL_BV_MULTIPLICITY_LEDGER_ACCEPTED": {"const": false}, "REGULATED_SLAVNOV_BREAKING_COMPUTED": {"const": false}, "QME_DISPOSITION": {"const": false}}},
    "minimal_missing_carrier": {"type": "object", "additionalProperties": false, "required": ["closed_gap", "remaining_gap", "next_required_artifact"], "properties": {"closed_gap": {"type": "string", "minLength": 20}, "remaining_gap": {"type": "string", "minLength": 20}, "next_required_artifact": {"const": "REPOSITORY_FULL_BV_MULTIPLICITY_LEDGER"}}},
    "proof_sha256": {"$ref": "#/$defs/hash"},
    "next_gate": {"const": "MATCH_YORK_HODGE_MEASURE_NONMINIMAL_BEREZINIAN_AND_REPOSITORY_HESSIAN_ROWS"},
    "claim_boundary": {"type": "string", "minLength": 300},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_sha256"], "properties": {"source_sha256": {"type": "object", "minProperties": 5, "additionalProperties": {"$ref": "#/$defs/hash"}}}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "rational": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "term": {"type": "object", "additionalProperties": false, "required": ["lambda_degree", "R_degree", "numerator", "denominator"], "properties": {"lambda_degree": {"type": "integer", "minimum": 0}, "R_degree": {"type": "integer", "minimum": 0}, "numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "polynomial": {"type": "array", "items": {"$ref": "#/$defs/term"}},
    "matrix": {"type": "object", "additionalProperties": false, "required": ["longitudinal_gauge_from_xi_scalar", "longitudinal_gauge_from_weyl_ghost", "trace_gauge_from_xi_scalar", "trace_gauge_from_weyl_ghost"], "properties": {"longitudinal_gauge_from_xi_scalar": {"$ref": "#/$defs/polynomial"}, "longitudinal_gauge_from_weyl_ghost": {"$ref": "#/$defs/polynomial"}, "trace_gauge_from_xi_scalar": {"$ref": "#/$defs/polynomial"}, "trace_gauge_from_weyl_ghost": {"$ref": "#/$defs/polynomial"}}},
    "identity": {"type": "object", "additionalProperties": false, "required": ["beta", "matrix", "determinant", "target_scalar_operator", "proportionality_constant", "target_residual", "triangular", "verified"], "properties": {"beta": {"$ref": "#/$defs/rational"}, "matrix": {"$ref": "#/$defs/matrix"}, "determinant": {"$ref": "#/$defs/polynomial"}, "target_scalar_operator": {"$ref": "#/$defs/polynomial"}, "proportionality_constant": {"const": -12}, "target_residual": {"$ref": "#/$defs/polynomial"}, "triangular": {"type": "boolean"}, "verified": {"type": "boolean"}}}
  }
}
