            "represented_action_test_dual_check_coordinates": {"const": 4080},
            "finite_verification_core_coordinates": {"const": 8160},
            "excluded_formal_comparison_coordinates": {"const": 820},
            "residual_primal_coordinates": {"const": 470},
            "residual_action_dual_coordinates": {"const": 470},
            "action_residual_coordinates": {"const": 940},
            "action_residual_pairing_rank": {"const": 940},
            "all_identity_defects": {"const": 0}
          },
          "required": ["energy_blocks", "represented_primal_coordinates", "represented_action_test_dual_check_coordinates", "finite_verification_core_coordinates", "excluded_formal_comparison_coordinates", "residual_primal_coordinates", "residual_action_dual_coordinates", "action_residual_coordinates", "action_residual_pairing_rank", "all_identity_defects"]
        },
