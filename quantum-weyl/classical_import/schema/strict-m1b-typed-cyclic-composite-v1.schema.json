    },
    "legacy_comparison_boundary": {"type": "object", "properties": {"formal_comparison_source_coordinates": {"const": 8980}, "current_verification_core_coordinates": {"const": 8160}, "deleted_test_doublet_cotangent_coordinates": {"const": 820}, "same_action_residual_coordinates": {"const": true}, "same_action_residual_pairing_rank": {"const": true}, "legacy_all_identity_defects": {"const": 0}, "formal_8980_source_promoted": {"const": false}}, "required": ["formal_comparison_source_coordinates", "current_verification_core_coordinates", "deleted_test_doublet_cotangent_coordinates", "same_action_residual_coordinates", "same_action_residual_pairing_rank", "legacy_all_identity_defects", "formal_8980_source_promoted"]},
    "provenance": {"type": "object", "properties": {"inputs": {"type": "array", "minItems": 5, "maxItems": 5}}, "required": ["inputs"]},
    "claim_flags": {
      "type": "object",
      "properties": {
        "M1B_PRIMAL_COMPOSITE_CONTRACTION_COMPLETE": {"const": true},
        "M1B_ACTION_DUAL_LIFT_COMPLETE": {"const": true},
        "M1B_TYPED_CYCLIC_REPLAY_COMPLETE": {"const": true},
        "M1B_REPRESENTED_COMPOSITE_CONTRACTION_COMPLETE": {"const": true},
        "ACTION_RESIDUAL_PAIRING_RANK_940": {"const": true},
        "ALL_THIRTEEN_TYPED_CYCLIC_IDENTITIES_REPLAYED": {"const": true},
        "FINITE_8160_CHECK_CORE_IS_AUTHORITATIVE_FULL_BV_SOURCE": {"const": false},
