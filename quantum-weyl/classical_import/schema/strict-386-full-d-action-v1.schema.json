{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/strict-386-full-d-action-v1.schema.json",
  "title": "Strict 386-row full cylinder D action v1",
  "type": "object",
  "required": [
    "$schema", "schema", "schema_path", "result_id", "result_kind", "result_state",
