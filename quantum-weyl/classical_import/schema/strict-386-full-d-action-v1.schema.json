      "properties": {
        "kind": {"const": "STRICT_386_UNARY_CAUSAL_D_SCOPED_SNAPSHOT"},
        "accepted_object_hashes": {"const": 14},
        "receiver_status": {"const": "ACCEPTED_SCOPED_D_EXTENSION"},
        "parent_unary_causal_snapshot_sha256": {"$ref": "#/$defs/sha256"},
        "D_action_sha256": {"$ref": "#/$defs/sha256"},
        "graph_q1_sha256": {"$ref": "#/$defs/sha256"},
        "basis_sha256": {"$ref": "#/$defs/sha256"},
        "pairing_sha256": {"$ref": "#/$defs/sha256"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
