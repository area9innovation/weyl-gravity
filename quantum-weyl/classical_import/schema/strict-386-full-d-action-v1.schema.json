      "properties": {
        "operator_id": {"const": "T_CYLINDER_REAL_LOCAL_ACTION"},
        "geometric_generator": {"type": "string"},
        "hermitian_mode_convention": {"type": "string"},
        "coordinate_frame": {"type": "string"},
        "component_formula": {"type": "string"},
        "shape": {"const": [386, 386]},
        "degree": {"const": 0},
        "differential_order": {"const": 1},
        "orientation": {"const": "entry[target_global_index,source_global_index]"},
        "temporal_multiindex": {"const": [1, 0, 0, 0]},
        "coefficient_field": {"const": "Q"},
        "nonzero_coefficients": {"const": 386},
        "entries": {
          "type": "array", "minItems": 386, "maxItems": 386,
          "items": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "prefixItems": [
              {"type": "integer", "minimum": 0, "maximum": 385},
              {"type": "integer", "minimum": 0, "maximum": 385},
              {"const": "1"}
