        "LORENTZIAN_QUANTUM_THEORY"
      ],
      "properties": {
        "STRICT_386_FULL_LOCAL_D_ACTION_CERTIFIED": {"const": true},
        "STRICT_386_D_Q1_COMMUTATOR_REPLAYED": {"const": true},
        "STRICT_386_D_FORMAL_SKEW_ADJOINT_REPLAYED": {"const": true},
        "STRICT_386_UNARY_CAUSAL_D_SCOPED_SNAPSHOT_ACCEPTED": {"const": true},
        "STRICT_386_FULL_Q2_D_COMMON_SNAPSHOT": {"const": false},
        "STRICT_386_D_Q2_DERIVATION_REPLAYED": {"const": false},
        "STRICT_386_D_CARTAN_HOMOTOPY_CONSTRUCTED": {"const": false},
        "D_PROPER_GAUGE_OR_CHARGED_DECIDED": {"const": false},
        "CLASSICAL_IMPORT_GATE_PASSED": {"const": false},
        "HADAMARD_STATE_CONSTRUCTED": {"const": false},
        "RENORMALIZED_LORENTZIAN_PRODUCTS": {"const": false},
        "QME_RESTORED": {"const": false},
        "RESIDUAL_TRANSFERRED": {"const": false},
        "LORENTZIAN_QUANTUM_THEORY": {"const": false}
      },
      "additionalProperties": false
    },
    "does_not_establish": {"type": "array", "minItems": 7, "items": {"type": "string", "minLength": 20}},
    "next_gate": {"type": "string", "minLength": 160},
    "canonical_hashes": {"type": "object", "minProperties": 6, "maxProperties": 6, "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "provenance": {
      "type": "object",
      "required": ["inputs"],
      "properties": {"inputs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/provenance"}}},
      "additionalProperties": false
    }
