        "M2_D_q2_derivation_status", "top_level_gate_a_hashes_accepted_by_this_result",
        "classical_import_gate_a_status", "reason"
      ],
      "properties": {
        "M2_D_action_status": {"const": "RECEIVER_VERIFIED_SCOPED"},
        "M2_D_q1_status": {"const": "RECEIVER_VERIFIED_SCOPED"},
        "M2_full_carrier_q2_status": {"const": "OPEN"},
        "M2_D_q2_derivation_status": {"const": "OPEN"},
