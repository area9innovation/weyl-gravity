    "provenance": {
      "type": "object",
      "required": ["path", "result_or_schema_id", "sha256", "role"],
      "properties": {
        "path": {"type": "string", "minLength": 3},
        "result_or_schema_id": {"type": "string", "minLength": 3},
        "sha256": {"$ref": "#/$defs/sha256"},
        "role": {"type": "string", "minLength": 10}
