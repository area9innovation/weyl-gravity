  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {
      "type": "object",
      "required": ["index", "row_id", "block", "degree", "action"],
      "properties": {
        "index": {"type": "integer", "minimum": 0, "maximum": 385},
        "row_id": {"type": "string", "minLength": 1},
        "block": {"type": "string", "minLength": 2},
        "degree": {"type": "integer", "minimum": -2, "maximum": 3},
        "action": {"const": "Lie_partial_t"}
      },
      "additionalProperties": false
