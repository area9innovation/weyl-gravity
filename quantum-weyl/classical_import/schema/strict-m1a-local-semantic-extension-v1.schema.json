{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strict-m1a-local-semantic-extension-v1.schema.json",
  "type": "object",
  "required": [
    "schema", "result_id", "result_kind", "result_state", "lifecycle",
    "dependency_tags", "counts", "auxiliary_dimension_derivation",
    "mapping_cone_dimension_functor", "cotton_nonlinear_weyl_non_eigen_witness",
    "scalar_weyl_weight_applicability",
    "local_extension_rows", "claim_flags", "does_not_establish",
    "independent_checker"
  ],
  "properties": {
    "schema": {"const": "strict-m1a-local-semantic-extension-v1"},
    "result_id": {"const": "STRICT_M1A_LOCAL_SEMANTIC_EXTENSION_V1"},
    "result_kind": {"const": "M1A2_LOCAL_AUXILIARY_AND_MAPPING_CONE_SEMANTIC_EXTENSION"},
    "result_state": {"const": "ALL_356_NAMESPACED_FIXED_BACKGROUND_CONE_SCALAR_WEYL_WEIGHT_NOT_APPLICABLE"},
    "lifecycle": {"const": "CLASSIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "counts": {
