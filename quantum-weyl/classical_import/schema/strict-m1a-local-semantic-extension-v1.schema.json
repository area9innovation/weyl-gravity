    "scalar_weyl_weight_applicability": {
      "type": "object",
      "required": ["affected_rows", "classification", "not_unknown", "reason", "future_nonlinear_upgrade_test"],
      "properties": {"affected_rows": {"const": 320}, "classification": {"const": "NOT_APPLICABLE"}, "not_unknown": {"const": true}}
    },
    "local_extension_rows": {
      "type": "array",
      "minItems": 356,
      "maxItems": 356,
      "items": {
        "type": "object",
        "required": [
          "index", "row_id", "block", "role", "tensor_type",
          "bv_ghost_number", "chain_degree", "antifield_number", "form_degree",
          "Grassmann_parity", "mass_dimension", "Weyl_weight",
          "conformal_compact_weight", "ce_ghost_number",
          "intrinsic_jet_order_bound", "semantic_state", "authority"
        ]
      }
    },
    "claim_flags": {
      "type": "object",
      "required": [
        "M1A2_AUXILIARY_36_FULLY_NAMESPACED",
        "M1A2_MAPPING_CONE_320_FULLY_NAMESPACED",
        "M1A2_SCALAR_WEYL_WEIGHT_APPLICABILITY_CLASSIFIED",
        "LOCAL_386_FULLY_TYPED", "M1A_FULL_TYPED_CARRIER_LEDGER_COMPLETE",
        "CLASSICAL_IMPORT_GATE_PASSED", "FULL_COMPLEX_HADAMARD_STATE_CONSTRUCTED",
        "QME_RESTORED"
      ],
      "properties": {
        "M1A2_AUXILIARY_36_FULLY_NAMESPACED": {"const": true},
        "M1A2_MAPPING_CONE_320_FULLY_NAMESPACED": {"const": true},
        "M1A2_SCALAR_WEYL_WEIGHT_APPLICABILITY_CLASSIFIED": {"const": true},
        "LOCAL_386_FULLY_TYPED": {"const": true},
        "M1A_FULL_TYPED_CARRIER_LEDGER_COMPLETE": {"const": false},
        "CLASSICAL_IMPORT_GATE_PASSED": {"const": false},
        "FULL_COMPLEX_HADAMARD_STATE_CONSTRUCTED": {"const": false},
        "QME_RESTORED": {"const": false}
      }
    },
    "does_not_establish": {"type": "array", "minItems": 5},
    "independent_checker": {
      "type": "object",
      "required": ["path", "method", "expected_digest"],
      "properties": {"expected_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    }
  }
}
