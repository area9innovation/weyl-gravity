    "independent_checker": {"type": "object", "required": ["path", "expected_digest"], "properties": {"path": {"const": "quantum-weyl/classical_import/check_strict_386_full_q1_component_jet_table.py"}, "expected_digest": {"$ref": "#/$defs/hash"}}},
