        "RANK_46_GRAPH_SDR_INDEPENDENTLY_REPLAYED": {"const": true},
        "RANK_46_SUPPORT_LOCAL_PROJECTOR_CONSTRUCTED": {"const": false},
        "ELL3_BRANCH_MIXING_AUTHORIZED": {"const": false},
        "Q2_Q3_LIFT_MATERIALIZED_ON_RANK_46": {"const": false},
