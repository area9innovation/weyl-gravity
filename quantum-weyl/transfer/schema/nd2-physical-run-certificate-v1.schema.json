{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "nd2-physical-run-certificate-v1.schema.json",
  "title": "ND2 physical arity-two run contract certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "result_state",
    "lifecycle_layer",
    "dependency_tags",
    "setting_verdict",
    "contract",
    "registered_evaluators",
    "registered_operator_backends",
    "registered_assembly_adapters",
    "prerequisite_gate",
    "engine_self_test",
    "input_gate",
    "established",
    "not_established",
    "next_gate",
    "provenance"
  ],
  "properties": {
    "result_id": {"const": "ND2_PHYSICAL_RUN_CONTRACT"},
    "result_state": {"const": "CONTRACT_READY_PHYSICAL_INPUT_BLOCKED"},
    "lifecycle_layer": {"const": "INTERACTING"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "setting_verdict": {"const": "INPUT_GATE_BLOCKED"},
    "contract": {"type": "object"},
    "registered_evaluators": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "registered_operator_backends": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/operatorBackend"}
    },
    "registered_assembly_adapters": {"type": "array", "items": {"type": "object"}},
    "prerequisite_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classical_contraction_artifact_satisfied", "classical_contraction_path",
        "classical_contraction_sha256", "support_local_q1_q2_D_satisfied",
        "admissibility_policy_satisfied",
        "compatible_cartan_coefficient_domain_satisfied",
        "physical_execution_authorized"
      ],
      "properties": {
        "classical_contraction_artifact_satisfied": {"const": true},
        "classical_contraction_path": {"const": "quantum-weyl/transfer/certificates/BERGER_MINIMAL_34_CONTRACTION_IMPORT.json"},
        "classical_contraction_sha256": {"$ref": "#/$defs/hash"},
        "support_local_q1_q2_D_satisfied": {"const": false},
        "admissibility_policy_satisfied": {"const": false},
        "compatible_cartan_coefficient_domain_satisfied": {"const": false},
        "physical_execution_authorized": {"const": false}
      }
    },
    "engine_self_test": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "all_checks_pass", "correction_retained", "physical_coefficient_claim"],
      "properties": {
        "classification": {"const": "EXACT_CORRECTION"},
        "all_checks_pass": {"const": true},
        "correction_retained": {"const": true},
        "physical_coefficient_claim": {"const": false}
      }
    },
    "input_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "manifest_path", "manifest_sha256", "reason"],
      "properties": {
        "status": {"enum": ["INPUT_NOT_AVAILABLE", "INPUT_REJECTED", "INPUT_VERIFIED_ASSEMBLY_ADAPTER_PENDING"]},
        "manifest_path": {"type": "string", "minLength": 1},
        "manifest_sha256": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "established": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "not_established": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest", "source_manifest_sha256", "schema"],
      "properties": {
        "source_manifest": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "source_manifest_sha256": {"$ref": "#/$defs/hash"},
        "schema": {"const": "quantum-weyl/transfer/schema/nd2-physical-run-certificate-v1.schema.json"}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "operatorBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend_id", "expression_schema_version", "coefficient_domain",
        "supported_arities", "capabilities", "implementation_manifest",
        "implementation_manifest_sha256", "assembly_mode",
        "nd2_physical_assembly_authorized"
      ],
      "properties": {
        "backend_id": {"const": "berger-invariant-pbw-linear-v1"},
        "expression_schema_version": {"const": "quantum-weyl-berger-retained-minimal-q1-import-v1"},
        "coefficient_domain": {"const": "Q[alpha_B,u,v] tensor U(e_Berger) in ordered PBW normal form"},
        "supported_arities": {"const": [1]},
        "capabilities": {"const": ["exact_polynomial_coefficient_parse", "formal_adjoint", "matrix_composition", "noncommutative_pbw_reduction", "support_local_order_audit"]},
        "implementation_manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quantum-weyl/transfer/berger_pbw_backend.py",
            "quantum-weyl/transfer/berger_retained_q1_import.py",
            "quantum-weyl/transfer/berger_retained_q1_import_certificate.py",
            "quantum-weyl/transfer/operator_backend_registry.py"
          ],
          "properties": {
            "quantum-weyl/transfer/berger_pbw_backend.py": {"$ref": "#/$defs/hash"},
            "quantum-weyl/transfer/berger_retained_q1_import.py": {"$ref": "#/$defs/hash"},
            "quantum-weyl/transfer/berger_retained_q1_import_certificate.py": {"$ref": "#/$defs/hash"},
            "quantum-weyl/transfer/operator_backend_registry.py": {"$ref": "#/$defs/hash"}
          }
        },
        "implementation_manifest_sha256": {"$ref": "#/$defs/hash"},
        "assembly_mode": {"const": "OPERATOR_VALIDATION_ONLY"},
        "nd2_physical_assembly_authorized": {"const": false}
      }
    }
  }
}
