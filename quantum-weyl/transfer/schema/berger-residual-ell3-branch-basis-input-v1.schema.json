{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-residual-ell3-branch-basis-input-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "classical_commit", "setting_id", "dependency_tags", "accepted_ell3", "declared_scope", "artifacts", "claim_boundary"],
  "properties": {
    "schema": {"const": "quantum-weyl-berger-residual-ell3-branch-basis-input-v1"},
    "result_id": {"const": "BERGER_RETAINED_36_RESIDUAL_BRANCH_BASIS_V1"},
    "classical_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "setting_id": {"const": "compact_positive_berger_clock_fixed_coupling"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "accepted_ell3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "sha256"],
      "properties": {
        "result_id": {"const": "BERGER_RETAINED_MIXED_ELL3_INDEPENDENT_ACCEPTANCE"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "declared_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambient_retained_rank", "coefficient_field", "factorial_convention", "dynamical_gravity_branch_ids", "deformation_vertex_basis_ids", "Maxwell_branch_ids", "branch_list_exhaustive_for_declared_sector", "kinetic_health_claim"],
      "properties": {
        "ambient_retained_rank": {"const": 36},
        "coefficient_field": {"const": "Q(sqrt(10))"},
        "factorial_convention": {"const": "suspended-graded-symmetric-factorial-v1"},
        "dynamical_gravity_branch_ids": {"const": ["Einstein_like", "extra_Weyl"]},
        "deformation_vertex_basis_ids": {"const": ["e_C2_dynamical", "o_C_dual_C_topological"]},
        "Maxwell_branch_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "branch_list_exhaustive_for_declared_sector": {"const": true},
        "kinetic_health_claim": {"const": "NOT_PART_OF_ELL3_BRANCH_PROJECTION"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retained_q1", "dynamical_branch_ledger", "dynamical_branch_inclusion", "dynamical_branch_projection", "dynamical_branch_pairing_gram", "parity_operator", "real_structure", "K_Berger_weight_operator", "deformation_vertex_basis", "deformation_Euler_Lagrange_map", "topological_transgression_witness"],
      "properties": {
        "retained_q1": {"$ref": "#/$defs/artifact"},
        "dynamical_branch_ledger": {"$ref": "#/$defs/artifact"},
        "dynamical_branch_inclusion": {"$ref": "#/$defs/artifact"},
        "dynamical_branch_projection": {"$ref": "#/$defs/artifact"},
        "dynamical_branch_pairing_gram": {"$ref": "#/$defs/artifact"},
        "parity_operator": {"$ref": "#/$defs/artifact"},
        "real_structure": {"$ref": "#/$defs/artifact"},
        "K_Berger_weight_operator": {"$ref": "#/$defs/artifact"},
        "deformation_vertex_basis": {"$ref": "#/$defs/artifact"},
        "deformation_Euler_Lagrange_map": {"$ref": "#/$defs/artifact"},
        "topological_transgression_witness": {"$ref": "#/$defs/artifact"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 300}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256", "canonical_sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "canonical_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
