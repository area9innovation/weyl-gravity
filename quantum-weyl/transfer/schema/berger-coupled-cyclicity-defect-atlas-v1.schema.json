      "properties": {
        "EXACT_RETAINED_CYCLICITY_DEFECT_ATLAS": {"const": true}, "EVERY_DEFECT_HAS_EXACTLY_TWO_MAXWELL_LEGS": {"const": true},
        "PHYSICAL_HAA_FACTOR_TWO_SEAM": {"const": true}, "PAIRING_SIGN_ONLY_REPAIR_FOUND": {"const": false},
        "UNIFORM_MAXWELL_OUTPUT_X2_PRESERVES_Q1Q2": {"const": true}, "UNIFORM_MAXWELL_OUTPUT_X2_COMPLETE_REPAIR": {"const": false},
        "COMPLETE_ADMISSIBLE_CYCLIC_REPAIR_FOUND": {"const": false}, "MIXED_Q3_TRANSFERRED": {"const": false}, "QUANTUM_CLAIM": {"const": false}
      }
