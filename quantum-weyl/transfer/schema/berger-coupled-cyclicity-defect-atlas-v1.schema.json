      "properties": {
        "path": {"const": "quantum-weyl/transfer/certificates/BERGER_COUPLED_36_TRANSFER_INDEPENDENT_REPLAY.json"},
        "result_id": {"const": "BERGER_COUPLED_36_TRANSFER_INDEPENDENT_REPLAY"}, "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "defect_payload": {
      "type": "object", "additionalProperties": false, "required": ["path", "entry_count", "canonical_sha256", "file_sha256"],
      "properties": {
        "path": {"const": "quantum-weyl/transfer/certificates/BERGER_COUPLED_RETAINED_CYCLICITY_DEFECT_PAYLOAD.json"},
        "entry_count": {"const": 953}, "canonical_sha256": {"$ref": "#/$defs/hash"}, "file_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "retained_atlas": {
      "type": "object", "additionalProperties": false,
      "required": ["total_defect_coefficients", "Maxwell_slot_counts", "jet_order_counts", "field_category_counts", "degree_triple_counts", "coefficient_field_counts", "distinct_coefficients", "top_row_triples"],
      "properties": {
        "total_defect_coefficients": {"const": 953},
        "Maxwell_slot_counts": {"const": [{"Maxwell_slots": 2, "count": 953}]},
        "jet_order_counts": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/countRow"}},
        "field_category_counts": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/categoryRow"}},
        "degree_triple_counts": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/degreeRow"}},
        "coefficient_field_counts": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/kindRow"}},
        "distinct_coefficients": {"const": 36},
        "top_row_triples": {"type": "array", "minItems": 20, "maxItems": 20, "items": {"$ref": "#/$defs/categoryRow"}}
      }
    },
    "minimal_hAA_fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["rows", "raw_q2_coefficients", "lowered_cubic_orbit", "normalized_defect_witnesses", "factor_two_diagnosis"],
      "properties": {
        "rows": {"const": {"h_hat_00": 3, "A_1": 28, "h_hat_star_00": 13, "A_plus_1": 32}},
        "raw_q2_coefficients": {"type": "object", "minProperties": 3, "maxProperties": 3},
        "lowered_cubic_orbit": {"type": "array", "minItems": 3, "maxItems": 3},
        "normalized_defect_witnesses": {"type": "array", "minItems": 2, "maxItems": 2},
        "factor_two_diagnosis": {"type": "string", "minLength": 180}
      }
    },
    "convention_sweep": {
      "type": "object", "additionalProperties": false, "required": ["pairing_sign_cases", "output_scaling_cases", "verdict"],
      "properties": {
