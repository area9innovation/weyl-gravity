  "properties": {
    "schema": {"const": "quantum-weyl-berger-coupled-cyclicity-defect-atlas-v1"},
    "result_id": {"const": "BERGER_COUPLED_CYCLICITY_DEFECT_ATLAS"},
    "result_state": {"const": "EXACT_DEFECT_LOCALIZED_FACTOR_TWO_PARTIAL_REPAIR_IDENTIFIED"},
    "lifecycle_layer": {"const": "CLASSICAL_BV_IMPORT_DIAGNOSTIC"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "dependency_ref": {
