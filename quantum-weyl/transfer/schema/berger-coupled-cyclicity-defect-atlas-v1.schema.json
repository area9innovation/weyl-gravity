    "next_gate": {"const": "REPAIR_REMAINING_15_GHOST_DENSITY_DEFECTS_WITH_Q1Q2_PRESERVED"},
    "claim_boundary": {"type": "string", "minLength": 700},
    "consumer_provenance": {
      "type": "object", "additionalProperties": false, "required": ["source_manifest", "source_manifest_sha256"],
      "properties": {
        "source_manifest": {"type": "object", "minProperties": 7, "maxProperties": 7, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "source_manifest_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "verification_receipts": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/receipt"}},
    "higher_tiers_not_run": {
      "type": "object", "additionalProperties": false, "required": ["tier_2", "tier_3"],
      "properties": {"tier_2": {"type": "string", "minLength": 150}, "tier_3": {"type": "string", "minLength": 120}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "countRow": {"type": "object", "additionalProperties": false, "required": ["total_jet_order", "count"], "properties": {"total_jet_order": {"type": "integer", "minimum": 0}, "count": {"type": "integer", "minimum": 1}}},
    "categoryRow": {"type": "object", "additionalProperties": false, "required": ["first", "second", "third", "count"], "properties": {"first": {"type": "string"}, "second": {"type": "string"}, "third": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}},
    "degreeRow": {"type": "object", "additionalProperties": false, "required": ["first_degree", "second_degree", "third_degree", "count"], "properties": {"first_degree": {"type": "integer"}, "second_degree": {"type": "integer"}, "third_degree": {"type": "integer"}, "count": {"type": "integer", "minimum": 1}}},
    "kindRow": {"type": "object", "additionalProperties": false, "required": ["kind", "count"], "properties": {"kind": {"enum": ["rational_only", "sqrt10_bearing"]}, "count": {"type": "integer", "minimum": 1}}},
    "sweepRow": {"type": "object", "additionalProperties": false, "required": ["convention", "retained_cyclicity_defect_count"], "properties": {"convention": {"type": "string"}, "retained_cyclicity_defect_count": {"type": "integer", "minimum": 0}}},
    "scalingRow": {"type": "object", "additionalProperties": false, "required": ["convention", "retained_cyclicity_defect_count", "retained_q1_q2_defect_count"], "properties": {"convention": {"type": "string"}, "retained_cyclicity_defect_count": {"type": "integer", "minimum": 0}, "retained_q1_q2_defect_count": {"type": "integer", "minimum": 0}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["test_tier", "command", "elapsed_seconds", "status"], "properties": {"test_tier": {"const": 1}, "command": {"type": "string", "minLength": 80}, "elapsed_seconds": {"type": "number", "minimum": 0}, "status": {"const": "PASS"}}}
  }
}
