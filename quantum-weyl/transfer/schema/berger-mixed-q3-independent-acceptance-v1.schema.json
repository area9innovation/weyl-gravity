  "properties": {
    "schema": {"const": "quantum-weyl-berger-mixed-q3-independent-acceptance-v1"},
    "result_id": {"const": "BERGER_MIXED_Q3_INDEPENDENT_ACCEPTANCE"},
    "result_state": {"const": "TYPED_MIXED_Q3_INDEPENDENTLY_ACCEPTED_RETAINED_ELL3_TRANSFER_OPEN"},
