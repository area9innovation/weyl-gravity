        "mixed_arity_three_defect_rows": {"const": 0},
        "localized_mutation_must_be_rejected": {"const": true},
        "verdict": {"const": "ACCEPTED_TYPED_MIXED_Q3_LOCAL_ALGEBRAIC"}
      }
    },
    "claim_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["TYPED_MIXED_Q3_PORTABLE_IMPORT_ACCEPTED", "TYPED_MIXED_Q3_GRADED_SYMMETRY_INDEPENDENTLY_REPLAYED", "MIXED_ARITY_THREE_IDENTITY_INDEPENDENTLY_REPLAYED", "K_BERGER_Q3_DERIVATION_INDEPENDENTLY_REPLAYED", "LOCALIZED_Q3_MUTATION_REJECTED", "RETAINED_MIXED_ELL3_TRANSFER", "REPOSITORY_BV_QME_RESTORED", "QUANTUM_CLAIM"],
      "properties": {
        "TYPED_MIXED_Q3_PORTABLE_IMPORT_ACCEPTED": {"const": true},
        "TYPED_MIXED_Q3_GRADED_SYMMETRY_INDEPENDENTLY_REPLAYED": {"const": true},
        "MIXED_ARITY_THREE_IDENTITY_INDEPENDENTLY_REPLAYED": {"const": true},
        "K_BERGER_Q3_DERIVATION_INDEPENDENTLY_REPLAYED": {"const": true},
        "LOCALIZED_Q3_MUTATION_REJECTED": {"const": true},
        "RETAINED_MIXED_ELL3_TRANSFER": {"const": false},
        "REPOSITORY_BV_QME_RESTORED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gate": {"const": "BERGER_RETAINED_MIXED_ELL3_TRANSFER_AND_EXCHANGE"},
    "claim_boundary": {"type": "string", "minLength": 700},
