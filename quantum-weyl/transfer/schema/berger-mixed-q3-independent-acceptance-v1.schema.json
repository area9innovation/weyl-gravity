        "result_id": {"const": "BERGER_SUPPORT_LOCAL_COUPLED_MAXWELL_Q3"},
        "claim_status": {"const": "CERTIFIED_TYPED_SUPPORT_LOCAL_MIXED_GRAVITY_MAXWELL_Q3"},
        "input_hashes": {"$ref": "#/$defs/inputHashes"}
