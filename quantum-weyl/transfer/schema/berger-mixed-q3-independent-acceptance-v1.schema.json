        "backend": {"const": "independent-two-rational-component-Q(sqrt(10))-mixed-q3-v1"},
        "classical_commit": {"const": "ba51c3853cbb51ef38083b40ceb7e9dda023efa7"},
        "input_hashes": {"$ref": "#/$defs/inputHashes"},
        "diagnostics": {"$ref": "#/$defs/diagnostics"},
