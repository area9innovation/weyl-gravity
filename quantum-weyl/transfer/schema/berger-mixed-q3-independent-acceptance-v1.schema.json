    "classical_commit": {"const": "ba51c3853cbb51ef38083b40ceb7e9dda023efa7"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "producer_import": {
      "type": "object", "additionalProperties": false,
