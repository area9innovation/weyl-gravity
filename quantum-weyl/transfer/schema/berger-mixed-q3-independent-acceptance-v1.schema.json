    "higher_tiers_not_run": {
      "type": "object", "additionalProperties": false, "required": ["tier_3"],
      "properties": {"tier_3": {"type": "string", "minLength": 100}}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "inputHashes": {
      "type": "object", "additionalProperties": false,
      "required": ["producer_certificate", "typed_q2_payload", "mixed_q3_manifest", "gravity_q2_payload", "portable_unary_carrier"],
