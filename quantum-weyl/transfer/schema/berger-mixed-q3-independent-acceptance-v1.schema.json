      "type": "object", "additionalProperties": false,
      "required": ["q1_PBW_coefficient_count", "gravity_q2_coefficient_count", "typed_mixed_q2_coefficient_count", "mixed_q3_coefficient_count", "mixed_q3_nonzero_rows", "typed_q2_graded_symmetry_defect_count", "typed_q3_graded_symmetry_defect_count", "mixed_arity_three_defect_count", "mixed_arity_three_defect_rows", "localized_mutation_row", "localized_mutation_defect_count", "K_Berger_derivation_term_count", "K_Berger_derivation_reason"],
      "properties": {
        "q1_PBW_coefficient_count": {"const": 1848},
        "gravity_q2_coefficient_count": {"const": 150305},
        "typed_mixed_q2_coefficient_count": {"const": 1890},
        "mixed_q3_coefficient_count": {"const": 59598},
        "mixed_q3_nonzero_rows": {"const": 21},
        "typed_q2_graded_symmetry_defect_count": {"const": 0},
        "typed_q3_graded_symmetry_defect_count": {"const": 0},
        "mixed_arity_three_defect_count": {"const": 0},
        "mixed_arity_three_defect_rows": {"const": 0},
        "localized_mutation_row": {"const": 27},
        "localized_mutation_defect_count": {"const": 2},
        "K_Berger_derivation_term_count": {"const": 59598},
        "K_Berger_derivation_reason": {"const": "K_Berger is e0 on the frozen stationary rows; coefficients are constant and [e0,e_a]=0"}
      }
    },
    "receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["test_tier", "command", "status", "elapsed_seconds"],
      "properties": {
        "test_tier": {"enum": [1, 2]},
        "command": {"type": "string", "minLength": 70},
        "status": {"const": "PASS"},
        "elapsed_seconds": {"type": "number", "minimum": 0}
      }
    }
  }
}
