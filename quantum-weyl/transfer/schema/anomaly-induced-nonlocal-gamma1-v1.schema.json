        "weyl_variation": {"type": "string"}, "BoxR_coordinate": {"$ref": "#/$defs/rational"}, "R2_role": {"type": "string"},
        "parity_odd_coordinate": {"$ref": "#/$defs/rational"}, "status": {"const": "COEFFICIENT_BEARING_ANOMALY_INDUCED_REPRESENTATIVE"}
