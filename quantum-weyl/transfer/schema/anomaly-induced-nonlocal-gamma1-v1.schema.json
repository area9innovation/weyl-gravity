      "properties": {"anomaly_induced_nonlocal_Gamma1": {"const": "CERTIFIED_CONDITIONAL_EUCLIDEAN_REPRESENTATIVE"}, "complete_finite_nonlocal_Gamma1": {"const": "NO_CERTIFIED_FUNCTIONAL"}, "complete_Q1": {"const": "NO_CERTIFIED_OPERATOR"}, "residual_transfer": {"const": "FORBIDDEN"}, "Bridge_4": {"const": "NO_CERTIFIED_MAP"}, "Bridge_5": {"const": "NO_CERTIFIED_MAP_BRIDGE_2_ABSENT"}}
    },
    "claim_flags": {
      "type": "object", "additionalProperties": false,
      "required": ["ANOMALY_VECTOR_REPRODUCED", "BOX_R_ZERO_SCHEME_REPRODUCED", "ANOMALY_INDUCED_REPRESENTATIVE_SUPPLIED", "WEYL_INVARIANT_REMAINDER_SUPPLIED", "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED", "COMPLETE_RENORMALIZED_Q1_SUPPLIED", "RESIDUAL_TRANSFER_AUTHORIZED"],
      "properties": {"ANOMALY_VECTOR_REPRODUCED": {"const": true}, "BOX_R_ZERO_SCHEME_REPRODUCED": {"const": true}, "ANOMALY_INDUCED_REPRESENTATIVE_SUPPLIED": {"const": true}, "WEYL_INVARIANT_REMAINDER_SUPPLIED": {"const": false}, "COMPLETE_RENORMALIZED_GAMMA1_SUPPLIED": {"const": false}, "COMPLETE_RENORMALIZED_Q1_SUPPLIED": {"const": false}, "RESIDUAL_TRANSFER_AUTHORIZED": {"const": false}}
    },
    "dependencies": {"type": "object", "additionalProperties": false, "required": ["regulated_breaking", "WZ_primitive", "Q1_disposition"], "properties": {"regulated_breaking": {"$ref": "#/$defs/artifact"}, "WZ_primitive": {"$ref": "#/$defs/artifact"}, "Q1_disposition": {"$ref": "#/$defs/artifact"}}},
    "next_gate": {"const": "WEYL_INVARIANT_FINITE_GAMMA1_NORMALIZATION_AND_EXTENDED_CLASSICAL_CONTRACTION"},
