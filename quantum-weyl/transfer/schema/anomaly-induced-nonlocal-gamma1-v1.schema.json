      "properties": {"decomposition": {"type": "string"}, "Weyl_invariant_nonlocal_functional": {"const": "NOT_COMPUTED"}, "finite_C2_and_R2_normalizations": {"const": "NOT_FIXED"}, "green_kernel_boundary_and_global_data": {"const": "NOT_FIXED_GLOBALLY"}, "renormalized_BV_laplacian_or_time_ordered_product": {"const": "NOT_SUPPLIED"}, "extended_classical_residual_contraction": {"const": "NOT_SUPPLIED"}}
