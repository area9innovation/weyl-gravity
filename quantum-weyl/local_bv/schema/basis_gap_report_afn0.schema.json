{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-basis-gap-afn0-v1.json",
  "title": "AFN0 dimension-four basis-gap report",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "result_state", "classical_commit", "dependency_tags", "scope_label", "resolution_vocabulary", "slices", "diff_top_form_ledgers", "graph_artifact_bundle", "lower_form_carrier_inventory", "ambient_lower_form_signature_inventory", "total_complex_gates", "claim_boundary", "report_hash", "canonical_hashes", "certificate_hash"],
  "properties": {
    "result_id": {"const": "BASIS_GAP_REPORT_AFN0"},
    "result_state": {"const": "TOP_FORM_BASIS_GAPS_RESOLVED_TOTAL_COMPLEX_OPEN"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "resolution_vocabulary": {
      "const": ["GENERATED_NONZERO", "IDENTICALLY_ZERO_BY_SYMMETRY", "IMPOSSIBLE_INDEX_CONTRACTION", "TOTAL_DERIVATIVE_ONLY", "WRONG_AFTER_REFINED_GRADING", "GENERATOR_BUG"]
    },
    "slices": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice", "ghost_number", "form_degree", "parity", "coarse_grading_signature_count", "refined_grading_signature_count", "raw_contraction_signature_count", "tensor_realizable_signature_count", "canonical_nonzero_signature_count", "terminal_resolution_count", "pending_resolution_count", "top_form_signature_resolution_status", "forward_reverse_span_agreement", "records"],
        "properties": {
          "slice": {"type": "string", "minLength": 1},
          "ghost_number": {"enum": [0, 1]},
          "form_degree": {"const": 4},
          "parity": {"enum": ["even", "odd"]},
          "coarse_grading_signature_count": {"type": "integer", "minimum": 0},
          "refined_grading_signature_count": {"type": "integer", "minimum": 0},
          "raw_contraction_signature_count": {"type": "integer", "minimum": 0},
          "tensor_realizable_signature_count": {"type": "integer", "minimum": 0},
          "canonical_nonzero_signature_count": {"type": "integer", "minimum": 0},
          "terminal_resolution_count": {"type": "integer", "minimum": 0},
          "pending_resolution_count": {"type": "integer", "minimum": 0},
          "top_form_signature_resolution_status": {"enum": ["COMPLETE", "IN_PROGRESS"]},
          "forward_reverse_span_agreement": {"enum": ["NOT_COMPUTED", "VERIFIED"]},
          "records": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["slice", "signature", "grading_status", "refined_grading_status", "raw_contraction_status", "tensor_realizability", "canonical_status", "generated_raw_count", "symmetry_canonical_orbit_count", "canonical_nonzero_count", "expected_index_balance", "candidate_ids", "resolution", "resolution_reason", "terminal_witness", "raw_graph_manifest_hash", "graph_enumeration_status", "graph_artifact_hash", "graphwise_divergence_status", "graphwise_current_manifest_hash", "proof_hash"],
              "properties": {
                "slice": {"type": "string"},
                "signature": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["curvature_count", "tensor_derivative_count", "ghost_factor_count", "ghost_derivative_order", "ghost_species", "epsilon_count", "tensor_index_slots", "ghost_index_slots", "total_index_slots", "form_degree", "generalized_connection_degree"],
                  "properties": {
                    "curvature_count": {"type": "integer", "minimum": 0},
                    "tensor_derivative_count": {"type": "integer", "minimum": 0},
                    "ghost_factor_count": {"enum": [0, 1]},
                    "ghost_derivative_order": {"type": "integer", "minimum": 0},
                    "ghost_species": {"enum": ["NONE", "WEYL"]},
                    "epsilon_count": {"enum": [0, 1]},
                    "tensor_index_slots": {"type": "integer", "minimum": 0},
                    "ghost_index_slots": {"type": "integer", "minimum": 0},
                    "total_index_slots": {"type": "integer", "minimum": 0},
                    "form_degree": {"const": 4},
                    "generalized_connection_degree": {"const": 0}
                  }
                },
                "grading_status": {"const": "GRADING_ADMISSIBLE"},
                "refined_grading_status": {"enum": ["REFINED_ADMISSIBLE", "REJECTED_BY_REFINED_GRADING"]},
                "raw_contraction_status": {"enum": ["RAW_CONTRACTION_EXISTS", "NOT_APPLICABLE"]},
                "tensor_realizability": {"enum": ["TENSOR_REALIZABLE_BY_GENERATED_REPRESENTATIVE", "TENSOR_REALIZABLE_CANONICALLY_ZERO", "UNDECIDED_PENDING_BIANCHI_AND_DIMENSION_IDENTITIES", "NOT_REALIZABLE_AFTER_REFINED_GRADING"]},
                "canonical_status": {"enum": ["CANONICALLY_NONZERO", "CANONICALLY_ZERO", "UNDECIDED", "NOT_APPLICABLE"]},
                "generated_raw_count": {"type": "integer", "minimum": 0},
                "symmetry_canonical_orbit_count": {"type": "integer", "minimum": 0},
                "canonical_nonzero_count": {"type": "integer", "minimum": 0},
                "expected_index_balance": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["total_index_slots", "epsilon_absorbed_slots", "metric_pair_count", "lorentz_scalar_condition"],
                  "properties": {
                    "total_index_slots": {"type": "integer", "minimum": 0},
                    "epsilon_absorbed_slots": {"enum": [0, 4]},
                    "metric_pair_count": {"type": "integer", "minimum": 0},
                    "lorentz_scalar_condition": {"const": "ALL_INDEX_SLOTS_CONTRACTED"}
                  }
                },
                "candidate_ids": {"type": "array", "items": {"type": "string"}},
                "resolution": {"enum": ["GENERATED_NONZERO", "IDENTICALLY_ZERO_BY_SYMMETRY", "IMPOSSIBLE_INDEX_CONTRACTION", "TOTAL_DERIVATIVE_ONLY", "WRONG_AFTER_REFINED_GRADING", "GENERATOR_BUG", "PENDING"]},
                "resolution_reason": {"type": "string", "minLength": 1},
                "terminal_witness": {"type": ["object", "null"]},
                "raw_graph_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "graph_enumeration_status": {"enum": ["SYMMETRY_CANONICALIZED_BIANCHI_PENDING", "CANONICAL_QUOTIENT_COMPLETE", "NOT_APPLICABLE"]},
                "graph_artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "graphwise_divergence_status": {"enum": ["VERIFIED_EVERY_RAW_GRAPH", "NOT_APPLICABLE"]},
                "graphwise_current_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "proof_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    },
    "diff_top_form_ledgers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "graph_artifact_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_hash", "artifact_count", "path"],
      "properties": {
        "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "artifact_count": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "pattern": "^basis_graph_manifests/[0-9a-f]{64}\\.json$"}
      }
    },
    "lower_form_carrier_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "analysis_sha256", "counts", "coverage", "ambient_local_form_basis"],
      "properties": {
        "result_id": {"const": "AFN0_LOWER_FORM_CARRIER_PRECERTIFICATE"},
        "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "counts": {"type": "object"},
        "coverage": {"const": "FORWARD_AND_REVERSE_COMPLETE_FOR_DECLARED_CARRIER_ALGEBRA"},
        "ambient_local_form_basis": {"const": "IN_PROGRESS"}
      }
    },
    "ambient_lower_form_signature_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "analysis_sha256", "totals", "integer_grading_status", "tensor_graph_realizability", "tensor_graph_result_id", "tensor_graph_analysis_sha256", "factor_profile_bundle_sha256", "factor_profile_count", "total_raw_graph_count"],
      "properties": {
        "result_id": {"const": "AFN0_AMBIENT_LOWER_FORM_SIGNATURE_CERTIFICATE"},
        "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "totals": {"type": "object"},
        "integer_grading_status": {"const": "EXHAUSTIVE_UNDER_DECLARED_GENERATOR_ALGEBRA"},
        "tensor_graph_realizability": {"const": "COMPLETE_FACTORED"},
        "tensor_graph_result_id": {"const": "AFN0_AMBIENT_TENSOR_GRAPH_REALIZATION_CERTIFICATE"},
        "tensor_graph_analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "factor_profile_bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "factor_profile_count": {"const": 1224},
        "total_raw_graph_count": {"const": 2860932903}
      }
    },
    "total_complex_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["TOP_FORM_BASIS_EXHAUSTIVE", "LOWER_FORM_COCYCLE_BASIS_EXHAUSTIVE", "LOWER_FORM_BOUNDARY_BASIS_EXHAUSTIVE", "TOTAL_COMPLEX_EXHAUSTIVE", "FORWARD_REVERSE_SPAN_AGREEMENT"],
      "properties": {
        "TOP_FORM_BASIS_EXHAUSTIVE": {"const": "VERIFIED_AFN0_WEYL_SECTORS"},
        "LOWER_FORM_COCYCLE_BASIS_EXHAUSTIVE": {"const": "IN_PROGRESS_GRADING_EXHAUSTIVE_CANDIDATE_CARRIERS_COMPLETE"},
        "LOWER_FORM_BOUNDARY_BASIS_EXHAUSTIVE": {"const": "IN_PROGRESS_GRADING_EXHAUSTIVE_EXACT_BOUNDARY_CARRIERS_COMPLETE"},
        "TOTAL_COMPLEX_EXHAUSTIVE": {"const": "NOT_COMPUTED"},
        "FORWARD_REVERSE_SPAN_AGREEMENT": {"const": "NOT_COMPUTED"}
      }
    },
    "claim_boundary": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest_sha256", "report_payload_sha256"],
      "properties": {
        "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "report_payload_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "certificate_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
