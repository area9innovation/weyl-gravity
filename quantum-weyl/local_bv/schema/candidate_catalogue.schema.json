{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-candidate-catalogue-v1.json",
  "title": "Pure-Weyl dimension-four candidate catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "classical_commit", "dependency_tags", "status", "sector", "scope", "candidate_count", "candidates", "proof_certificate", "not_computed"],
  "properties": {
    "result_id": {"type": "string", "minLength": 1},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "status": {"const": "CANDIDATES_GENERATED_NOT_COHOMOLOGY"},
    "sector": {"enum": ["ghost_number_0", "ghost_number_1"]},
    "scope": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "const": 4},
    "candidates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "representative", "representative_sha256", "ghost_number", "antifield_number", "form_degree", "mass_dimension", "parity", "diff_descent_length", "diff_descent_status", "intrinsic_weyl_descent_status", "intrinsic_weyl_descent_certificate", "descent_certificate", "topological_status", "local_triviality", "integrated_triviality", "closure_status", "class_status", "cohomology_status", "trivialization", "proof_status", "proof_certificate", "residual_restriction_status", "notes"],
        "properties": {
          "class_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "representative": {"type": "object"},
          "representative_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "ghost_number": {"type": "integer"},
          "antifield_number": {"type": "integer", "const": 0},
          "form_degree": {"type": "integer", "const": 4},
          "mass_dimension": {"type": "integer", "const": 4},
          "parity": {"enum": ["even", "odd"]},
          "diff_descent_length": {},
          "diff_descent_status": {"enum": ["NONZERO_DIFF_TOWER", "NOT_COMPUTED", "IN_PROGRESS", "FAILED_CERTIFICATE"]},
          "intrinsic_weyl_descent_status": {"enum": ["STRICTLY_WEYL_INVARIANT", "TRIVIAL", "TRIVIAL_WITH_PRIMITIVE", "NONTRIVIAL_COMPLETE", "NOT_COMPUTED", "IN_PROGRESS", "CLOSED", "EXACT", "UNDECIDED", "FAILED_CERTIFICATE"]},
          "intrinsic_weyl_descent_certificate": {"type": "string", "minLength": 1},
          "descent_certificate": {"type": "string", "minLength": 1},
          "topological_status": {"type": "string", "minLength": 1},
          "local_triviality": {"type": "string", "minLength": 1},
          "integrated_triviality": {"type": "string", "minLength": 1},
          "closure_status": {"type": "string", "minLength": 1},
          "class_status": {"enum": ["CLOSED", "EXACT", "NONTRIVIAL", "UNDECIDED"]},
          "cohomology_status": {"enum": ["CLOSED", "EXACT", "NONTRIVIAL", "UNDECIDED"]},
          "trivialization": {"oneOf": [{"const": "NOT_COMPUTED"}, {"type": "object"}]},
          "proof_status": {"type": "string", "minLength": 1},
          "proof_certificate": {"type": "string", "minLength": 1},
          "residual_restriction_status": {"const": "NOT_COMPUTED"},
          "notes": {"type": "string"}
        }
      }
    },
    "proof_certificate": {"type": "string", "minLength": 1},
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
