        "H04": {"$ref": "#/$defs/hash"},
        "Berger_unfixed_nonminimal_specialization": {"$ref": "#/$defs/hash"},
        "Berger_gauge_fixed_specialization": {"$ref": "#/$defs/hash"}
      }
    },
    "scope": {
      "type": "object",
