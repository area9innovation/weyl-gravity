  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "atom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["atom_id", "canonical_order", "Grassmann_parity", "ghost_number_in_suspended_complex", "direction", "role"],
