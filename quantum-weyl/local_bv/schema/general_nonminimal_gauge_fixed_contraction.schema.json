        "H04_minimal_nonminimal_gauge_fixed_comparison": {"const": "CHAIN_ISOMORPHISM"},
        "H14_minimal_nonminimal_gauge_fixed_comparison": {"const": "CHAIN_ISOMORPHISM"},
        "full_local_BV_G2": {"const": "COMPLETE_ON_REGULAR_BACH_LOCUS"}
      }
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GENERAL_NONMINIMAL_DOUBLETS_CONTRACTED", "LOCAL_CANONICAL_GAUGE_FIXING_INVARIANCE_PROVED", "H04_GAUGE_FIXED_BV_COMPLETE", "H14_GAUGE_FIXED_BV_COMPLETE", "FULL_BV_G2_COMPLETE", "ANOMALY_COEFFICIENTS_COMPUTED_HERE", "REGULATED_SLAVNOV_BREAKING_COMPUTED", "QME_RESTORED", "LORENTZIAN_QUANTUM_THEORY"],
