        "pairs": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/pair"}},
        "identity": {"const": "Q h + h Q = 1 - inclusion projection ON_POSITIVE_NONMINIMAL_DEGREE"},
