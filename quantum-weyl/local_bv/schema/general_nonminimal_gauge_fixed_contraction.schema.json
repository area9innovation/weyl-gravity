  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "classical_commit", "dependency_tags", "dependency_hashes", "scope", "field_dictionary", "direct_sum_contraction", "canonical_gauge_fixing_transport", "classical_specialization_replay", "gauge_fixed_cohomology", "checks", "claim_flags", "proof_sha256", "result_artifacts", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "quantum-weyl-general-nonminimal-gauge-fixed-contraction-v1"},
    "result_id": {"const": "GENERAL_NONMINIMAL_GAUGE_FIXED_CONTRACTION"},
    "result_state": {"const": "FULL_LOCAL_BV_G2_COMPLETE_ON_REGULAR_BACH_LOCUS_ANALYTIC_QME_OPEN"},
    "classical_commit": {"$ref": "#/$defs/commit"},
