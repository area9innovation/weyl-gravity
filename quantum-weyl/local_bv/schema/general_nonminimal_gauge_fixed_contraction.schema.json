            "quantum-weyl/local_bv/schema/gauge_fixed_bv_cohomology_result.schema.json": {"$ref": "#/$defs/hash"},
            "quantum-weyl/local_bv/tests/test_nonminimal_gauge_fixed_contraction.py": {"$ref": "#/$defs/hash"},
