      "properties": {
        "ten_nonminimal_pairs_enumerated": {"const": "VERIFIED"},
        "Q_squared_zero_on_every_nonminimal_atom": {"const": "VERIFIED"},
        "graded_contraction_regressions": {"const": "VERIFIED_25080"},
