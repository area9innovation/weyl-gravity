{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-lower-form-carriers-v1.json",
  "title": "AFN0 lower-form candidate-carrier precertificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "result_state", "classical_commit", "dependency_tags", "scope_label", "declared_carrier_algebra", "source_artifacts", "counts", "bidegree_inventory", "carriers", "structural_zeros", "checks", "total_complex_gates", "claim_boundary", "analysis_sha256", "canonical_hashes", "certificate_sha256"],
  "properties": {
    "result_id": {"const": "AFN0_LOWER_FORM_CARRIER_PRECERTIFICATE"},
    "result_state": {"const": "CANDIDATE_AND_EXACT_BOUNDARY_CARRIERS_COMPLETE_AMBIENT_BASIS_OPEN"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "declared_carrier_algebra": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generators", "coverage", "ambient_local_form_basis"],
      "properties": {
        "generators": {"type": "array", "minItems": 4, "items": {"type": "string"}},
        "coverage": {"const": "FORWARD_AND_REVERSE_COMPLETE_FOR_DECLARED_CARRIER_ALGEBRA"},
        "ambient_local_form_basis": {"const": "IN_PROGRESS"}
      }
    },
    "source_artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "result_id", "sha256", "canonical_sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "result_id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universal_candidate_carriers", "intrinsic_euler_carriers", "exact_boundary_carriers", "all_carriers", "strict_lower_form_carriers", "structurally_zero_euler_components"],
      "properties": {
        "universal_candidate_carriers": {"const": 40},
        "intrinsic_euler_carriers": {"const": 11},
        "exact_boundary_carriers": {"const": 13},
        "all_carriers": {"const": 64},
        "strict_lower_form_carriers": {"const": 55},
        "structurally_zero_euler_components": {"const": 2}
      }
    },
    "bidegree_inventory": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sector", "parity", "ghost_number", "form_degree", "total_degree", "carrier_count"],
        "properties": {
          "sector": {"enum": ["COCYCLE", "BOUNDARY"]},
          "parity": {"enum": ["even", "odd"]},
          "ghost_number": {"type": "integer", "minimum": 0},
          "form_degree": {"type": "integer", "minimum": 0, "maximum": 4},
          "total_degree": {"type": "integer", "minimum": 0},
          "carrier_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    "carriers": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["carrier_id", "sector", "source_id", "source_kind", "source_component", "source_sha256", "ghost_number", "form_degree", "total_degree", "parity", "contraction_order", "coefficient", "verification_status", "carrier_sha256"],
        "properties": {
          "carrier_id": {"type": "string", "minLength": 1},
          "sector": {"enum": ["COCYCLE", "BOUNDARY"]},
          "source_id": {"type": "string", "minLength": 1},
          "source_kind": {"enum": ["TOP_REPRESENTATIVE", "INTRINSIC_EULER_COMPONENT", "EXACT_CURRENT", "BRST_PRIMITIVE"]},
          "source_component": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "ghost_number": {"type": "integer", "minimum": 0},
          "form_degree": {"type": "integer", "minimum": 0, "maximum": 4},
          "total_degree": {"type": "integer", "minimum": 0},
          "parity": {"enum": ["even", "odd"]},
          "contraction_order": {"type": "integer", "minimum": 0, "maximum": 4},
          "coefficient": {"$ref": "#/$defs/fraction"},
          "verification_status": {"const": "HASH_BOUND_SOURCE_AND_BIDEGREE_VERIFIED"},
          "carrier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "structural_zeros": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "ghost_number", "form_degree", "reason", "verification_status", "zero_sha256"],
        "properties": {
          "source_id": {"const": "ANOM_OMEGA_E4"},
          "ghost_number": {"enum": [4, 5]},
          "form_degree": {"enum": [0, 1]},
          "reason": {"const": "STRUCTURALLY_ZERO_BY_R_LE_N_OVER_2"},
          "verification_status": {"const": "STRUCTURALLY_ZERO_VERIFIED"},
          "zero_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descent_database_candidate_set_agreement", "universal_diff_coefficients_and_bidegrees", "intrinsic_euler_component_coverage", "intrinsic_euler_universal_diff_completion", "exact_BoxR_boundary_carriers", "carrier_ids_unique", "forward_reverse_declared_carrier_span_agreement"],
      "properties": {
        "descent_database_candidate_set_agreement": {"const": "VERIFIED"},
        "universal_diff_coefficients_and_bidegrees": {"const": "VERIFIED"},
        "intrinsic_euler_component_coverage": {"const": "VERIFIED"},
        "intrinsic_euler_universal_diff_completion": {"const": "VERIFIED"},
        "exact_BoxR_boundary_carriers": {"const": "VERIFIED"},
        "carrier_ids_unique": {"const": "VERIFIED"},
        "forward_reverse_declared_carrier_span_agreement": {"const": "VERIFIED"}
      }
    },
    "total_complex_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["LOWER_FORM_CANDIDATE_CARRIER_COVERAGE", "LOWER_FORM_EXACT_BOUNDARY_CARRIER_COVERAGE", "LOWER_FORM_AMBIENT_COCYCLE_BASIS_EXHAUSTIVE", "LOWER_FORM_AMBIENT_BOUNDARY_BASIS_EXHAUSTIVE", "PRODUCTION_Q_DH_MATRICES", "TOTAL_COMPLEX_EXHAUSTIVE"],
      "properties": {
        "LOWER_FORM_CANDIDATE_CARRIER_COVERAGE": {"const": "COMPLETE"},
        "LOWER_FORM_EXACT_BOUNDARY_CARRIER_COVERAGE": {"const": "COMPLETE"},
        "LOWER_FORM_AMBIENT_COCYCLE_BASIS_EXHAUSTIVE": {"const": "IN_PROGRESS"},
        "LOWER_FORM_AMBIENT_BOUNDARY_BASIS_EXHAUSTIVE": {"const": "IN_PROGRESS"},
        "PRODUCTION_Q_DH_MATRICES": {"const": "NOT_COMPUTED"},
        "TOTAL_COMPLEX_EXHAUSTIVE": {"const": "NOT_COMPUTED"}
      }
    },
    "claim_boundary": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest_sha256", "analysis_sha256"],
      "properties": {
        "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "analysis_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    }
  }
}
