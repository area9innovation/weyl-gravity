{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-ambient-factor-orbit-bundle-v1.json",
  "title": "AFN0 ambient signed factor-orbit bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "dependency_tags", "ambient_analysis_sha256", "profile_reduction_count", "profile_reductions", "bundle_sha256"],
  "properties": {
    "result_id": {"const": "AFN0_AMBIENT_FACTOR_ORBIT_BUNDLE_DEGREES_THREE_FOUR"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "ambient_analysis_sha256": {"$ref": "#/$defs/hash"},
    "profile_reduction_count": {"const": 192},
    "profile_reductions": {
      "type": "array", "minItems": 192, "maxItems": 192,
      "items": {"$ref": "#/$defs/reduction"}
    },
    "bundle_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reduction": {
      "type": "object", "additionalProperties": false,
      "required": ["profile_sha256", "signature_sha256", "factor_action_order", "factor_action_manifest_sha256", "raw_graph_count", "signed_orbit_count", "surviving_orbit_count", "Grassmann_zero_orbit_count", "Grassmann_zero_raw_graph_count", "orbit_size_histogram", "surviving_representative_manifest_sha256", "Grassmann_zero_representative_manifest_sha256", "coverage_status", "identity_seams", "reduction_sha256"],
      "properties": {
        "profile_sha256": {"$ref": "#/$defs/hash"},
        "signature_sha256": {"$ref": "#/$defs/hash"},
        "factor_action_order": {"type": "integer", "minimum": 1},
        "factor_action_manifest_sha256": {"$ref": "#/$defs/hash"},
        "raw_graph_count": {"type": "integer", "minimum": 1},
        "signed_orbit_count": {"type": "integer", "minimum": 1},
        "surviving_orbit_count": {"type": "integer", "minimum": 0},
        "Grassmann_zero_orbit_count": {"type": "integer", "minimum": 0},
        "Grassmann_zero_raw_graph_count": {"type": "integer", "minimum": 0},
        "orbit_size_histogram": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["orbit_size", "orbit_count"],
            "properties": {
              "orbit_size": {"type": "integer", "minimum": 1},
              "orbit_count": {"type": "integer", "minimum": 1}
            }
          }
        },
        "surviving_representative_manifest_sha256": {"$ref": "#/$defs/hash"},
        "Grassmann_zero_representative_manifest_sha256": {"$ref": "#/$defs/hash"},
        "coverage_status": {"const": "EXACT_RAW_GRAPH_PARTITION_VERIFIED"},
        "identity_seams": {
          "type": "object", "additionalProperties": false,
          "required": ["intrinsic_Riemann_symmetries", "algebraic_and_differential_Bianchi", "covariant_jet_commutators", "horizontal_form_antisymmetry", "integration_by_parts", "four_dimensional_antisymmetrization"],
          "properties": {
            "intrinsic_Riemann_symmetries": {"const": "NOT_COMPUTED"},
            "algebraic_and_differential_Bianchi": {"const": "NOT_COMPUTED"},
            "covariant_jet_commutators": {"const": "NOT_COMPUTED"},
            "horizontal_form_antisymmetry": {"const": "NOT_COMPUTED"},
            "integration_by_parts": {"const": "NOT_COMPUTED"},
            "four_dimensional_antisymmetrization": {"const": "NOT_COMPUTED"}
          }
        },
        "reduction_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
