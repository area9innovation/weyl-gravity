      "properties": {
        "cubic_pairing_exhaustion": {"const": "VERIFIED"},
        "cubic_algebraic_bianchi_quotient": {"const": "VERIFIED"},
        "second_derivative_bridge_exhaustion": {"const": "VERIFIED"},
        "outer_differential_bianchi": {"const": "VERIFIED"},
        "integration_by_parts_relations": {"const": "VERIFIED"},
        "contracted_commutator_relations": {"const": "VERIFIED"},
        "commutator_collision_regression": {"const": "VERIFIED"},
        "local_order_six_normal_form": {"const": "VERIFIED"},
        "integrated_six_derivative_quotient": {"const": "VERIFIED"},
        "four_dimensional_schouten_quotient": {"const": "NOT_COMPUTED"},
        "weyl_tracefree_specialization": {"const": "NOT_COMPUTED"},
        "local_cohomology_H_s_mod_d": {"const": "NOT_COMPUTED"}
