    },
    "independent_crosscheck": {
      "const": {
        "reference": "https://arxiv.org/abs/0805.1595",
        "reference_basis": "dimension-independent FKWC rank-zero order-six basis",
        "local_dimension_including_omitted_degree_one_sector": 17,
        "integrated_dimension_modulo_total_divergences": 10,
        "status": "MATCH",
        "role": "INDEPENDENT_CROSSCHECK_NOT_PROOF_INPUT"
      }
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "required": [
        "combined_basis_sha256", "combined_rref_sha256", "source_manifest_sha256",
        "R3_bianchi_sha256", "nablaR_nablaR_bianchi_sha256",
        "R_nabla2R_bianchi_sha256", "integration_by_parts_sha256",
        "covariant_commutators_sha256"
      ]
    },
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
