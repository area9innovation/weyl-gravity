    "cubic_R3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_pairing_count", "signed_orbit_count", "symmetry_vanishing_orbit_count",
        "symmetry_nonzero_orbit_count", "generated_nonzero_bianchi_relation_count",
        "bianchi_relation_rank", "quotient_dimension"
      ],
      "properties": {
        "raw_pairing_count": {"const": 10395},
        "signed_orbit_count": {"const": 33},
        "symmetry_vanishing_orbit_count": {"const": 20},
        "symmetry_nonzero_orbit_count": {"const": 13},
        "generated_nonzero_bianchi_relation_count": {"const": 10},
        "bianchi_relation_rank": {"const": 5},
        "quotient_dimension": {"const": 8}
      }
    },
    "second_derivative_bridge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_pairing_count", "symmetry_canonical_monomial_count",
