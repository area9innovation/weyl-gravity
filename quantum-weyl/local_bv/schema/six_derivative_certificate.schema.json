      ],
      "properties": {
        "raw_pairing_count": {"const": 945},
        "symmetry_canonical_monomial_count": {"const": 14},
        "algebraic_bianchi_relation_count": {"const": 6},
        "algebraic_bianchi_rank": {"const": 3},
        "differential_bianchi_relation_count": {"const": 16},
        "differential_bianchi_rank": {"const": 8},
        "combined_relation_rank": {"const": 8},
        "quotient_dimension": {"const": 6}
      }
    },
    "combined": {
      "type": "object",
