{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-local-six-derivative-v1.json",
  "title": "Pure-Weyl six-derivative curvature quotient certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
