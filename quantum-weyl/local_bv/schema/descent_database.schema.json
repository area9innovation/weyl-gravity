{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-split-descent-database-v3.json",
  "title": "Pure-Weyl universal Diff and intrinsic Weyl descent database",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "classical_commit", "dependency_tags", "result_state", "scope", "entry_count", "entries", "proof_certificate", "not_computed"],
  "properties": {
    "result_id": {"const": "DESCENT_DATABASE_DIMENSION_FOUR"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "result_state": {"const": "PARTIAL_DESCENT_DATABASE"},
    "scope": {"type": "string", "minLength": 1},
    "entry_count": {"type": "integer", "const": 8},
    "entries": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representative_id", "ghost_number", "form_degree", "antifield_number", "engineering_dimension", "parity", "diff_descent_status", "intrinsic_weyl_descent_status", "relative_cohomology_status", "diff_tower_id", "diff_tower", "intrinsic_tower", "closure_certificate", "exactness_certificate", "basis_manifest_hash", "classical_snapshot_hash", "notes"],
        "properties": {
          "representative_id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
          "ghost_number": {"type": "integer"},
          "form_degree": {"type": "integer", "const": 4},
          "antifield_number": {"type": "integer", "const": 0},
          "engineering_dimension": {"type": "integer", "const": 4},
          "parity": {"enum": ["even", "odd"]},
          "diff_descent_status": {"enum": ["NONZERO_DIFF_TOWER", "NOT_COMPUTED", "IN_PROGRESS", "FAILED_CERTIFICATE"]},
          "intrinsic_weyl_descent_status": {"enum": ["STRICTLY_WEYL_INVARIANT", "TRIVIAL", "TRIVIAL_WITH_PRIMITIVE", "NONTRIVIAL_COMPLETE", "NOT_COMPUTED", "IN_PROGRESS", "CLOSED", "EXACT", "UNDECIDED", "FAILED_CERTIFICATE"]},
          "relative_cohomology_status": {"enum": ["NOT_COMPUTED", "IN_PROGRESS", "CLOSED", "EXACT", "NONTRIVIAL", "UNDECIDED", "FAILED_CERTIFICATE"]},
          "diff_tower_id": {"type": "string", "minLength": 1},
          "diff_tower": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["form_degree", "ghost_number", "coefficient"],
              "properties": {
                "form_degree": {"type": "integer", "minimum": 0, "maximum": 4},
                "ghost_number": {"type": "integer"},
                "coefficient": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["numerator", "denominator"],
                  "properties": {
                    "numerator": {"type": "integer"},
                    "denominator": {"type": "integer", "minimum": 1}
                  }
                }
              }
            }
          },
          "intrinsic_tower": {"type": "array", "items": {"type": "object"}},
          "closure_certificate": {"type": "string", "minLength": 1},
          "exactness_certificate": {"type": ["string", "null"]},
          "basis_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "classical_snapshot_hash": {"const": "UNFROZEN"},
          "notes": {"type": "string"}
        }
      }
    },
    "proof_certificate": {"type": "string", "minLength": 1},
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
  }
}
