{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-h04-canonical-quotient-v1.json",
  "title": "AFN0 ghost-zero covariant counterterm candidate quotient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id", "result_state", "classical_commit", "dependency_tags",
    "scope_label", "bounds", "even_sector", "odd_sector",
    "basis_exhaustiveness_proof", "checks", "claim_boundary",
    "analysis_sha256", "provenance", "certificate_hash"
  ],
  "properties": {
    "result_id": {"const": "AFN0_H04_CANONICAL_QUOTIENT"},
    "result_state": {"const": "COMPLETE_AFN0_COVARIANT_COUNTERTERM_CANDIDATE_QUOTIENT"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "bounds": {
      "type": "object", "additionalProperties": false,
      "required": ["spacetime_dimension", "ghost_number", "form_degree", "antifield_number", "engineering_dimension", "locality_algebra"],
      "properties": {
        "spacetime_dimension": {"const": 4}, "ghost_number": {"const": 0},
        "form_degree": {"const": 4}, "antifield_number": {"const": 0},
        "engineering_dimension": {"const": 4},
        "locality_algebra": {"const": "COVARIANT_TENSOR_POLYNOMIALS"}
      }
    },
    "even_sector": {
      "type": "object", "additionalProperties": false,
      "required": ["top_basis", "incoming_q_basis", "incoming_dh_basis", "Q_matrix", "d_h_matrix", "closure_obstruction_matrix", "boundary_rank", "closure_rank", "quotient_dimension", "derivative_sector", "classes", "exact_classes", "nonclosed_carriers"],
      "properties": {
        "top_basis": {"const": ["CT_C2", "CT_E4", "CT_R2", "CT_BOX_R"]},
        "incoming_q_basis": {"const": []},
        "incoming_dh_basis": {"const": ["CURRENT_GRAD_R"]},
        "Q_matrix": {"type": "object"}, "d_h_matrix": {"type": "object"},
        "closure_obstruction_matrix": {"type": "object"},
        "boundary_rank": {"const": 1}, "closure_rank": {"const": 3},
        "quotient_dimension": {"const": 2}, "derivative_sector": {"type": "object"},
        "classes": {"type": "array", "minItems": 2, "maxItems": 2},
        "exact_classes": {"type": "array", "minItems": 1, "maxItems": 1},
        "nonclosed_carriers": {"type": "array", "minItems": 1, "maxItems": 1}
      }
    },
    "odd_sector": {
      "type": "object", "additionalProperties": false,
      "required": ["top_basis", "incoming_q_basis", "incoming_dh_basis", "Q_matrix", "d_h_matrix", "closure_obstruction_matrix", "boundary_rank", "closure_rank", "quotient_dimension", "derivative_sector", "classes"],
      "properties": {
        "top_basis": {"const": ["CT_C_DUAL_C"]},
        "incoming_q_basis": {"const": []}, "incoming_dh_basis": {"const": []},
        "Q_matrix": {"type": "object"}, "d_h_matrix": {"type": "object"},
        "closure_obstruction_matrix": {"type": "object"},
        "boundary_rank": {"const": 0}, "closure_rank": {"const": 1},
        "quotient_dimension": {"const": 1}, "derivative_sector": {"type": "object"},
        "classes": {"type": "array", "minItems": 1, "maxItems": 1}
      }
    },
    "basis_exhaustiveness_proof": {"type": "object"},
    "checks": {"type": "object"},
    "claim_boundary": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "analysis_sha256": {"$ref": "#/$defs/hash"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha256", "source_manifest_sha256", "implementation", "schema"],
      "properties": {
        "source_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
        "source_manifest_sha256": {"$ref": "#/$defs/hash"},
        "implementation": {"type": "string"}, "schema": {"type": "string"}
      }
    },
    "certificate_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
