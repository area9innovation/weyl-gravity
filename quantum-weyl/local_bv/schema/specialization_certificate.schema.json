{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-local-specialization-foundations-v1.json",
  "title": "Pure-Weyl local specialization foundations certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "result_state",
    "classical_commit",
    "dependency_tags",
    "scope",
    "checks",
    "universal_import",
    "controlled_projection_witness",
    "schouten_primitive",
    "tracefree_weyl",
    "epsilon_reduction",
    "canonical_hashes",
    "not_computed",
    "assumptions"
  ],
  "properties": {
    "result_id": {"const": "LOCAL_SPECIALIZATION_FOUNDATIONS_CERTIFICATE"},
    "result_state": {"const": "SPECIALIZATION_INFRASTRUCTURE_VERIFIED"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact_nullspace",
        "immutable_specialization_tower",
        "projection_surjectivity",
        "projection_rank_nullity",
        "relation_family_provenance",
        "parity_block_preservation",
        "named_representative_coordinates",
        "five_index_antisymmetrization_primitive",
        "tracefree_weyl_reduction",
        "epsilon_pair_elimination",
        "signature_separation",
        "four_dimensional_schouten_quotient",
        "four_dimensional_weyl_invariant_basis",
        "local_cohomology_H_s_mod_d"
      ],
      "properties": {
        "exact_nullspace": {"const": "VERIFIED"},
        "immutable_specialization_tower": {"const": "VERIFIED"},
        "projection_surjectivity": {"const": "VERIFIED"},
        "projection_rank_nullity": {"const": "VERIFIED"},
        "relation_family_provenance": {"const": "VERIFIED"},
        "parity_block_preservation": {"const": "VERIFIED"},
        "named_representative_coordinates": {"const": "VERIFIED"},
        "five_index_antisymmetrization_primitive": {"const": "VERIFIED"},
        "tracefree_weyl_reduction": {"const": "VERIFIED"},
        "epsilon_pair_elimination": {"const": "VERIFIED"},
        "signature_separation": {"const": "VERIFIED"},
        "four_dimensional_schouten_quotient": {"const": "NOT_COMPUTED"},
        "four_dimensional_weyl_invariant_basis": {"const": "NOT_COMPUTED"},
        "local_cohomology_H_s_mod_d": {"const": "NOT_COMPUTED"}
      }
    },
    "universal_import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ambient_dimension", "quotient_dimension", "parity_block_dimensions", "family_names", "tower", "named_representatives"],
      "properties": {
        "ambient_dimension": {"const": 39},
        "quotient_dimension": {"const": 10},
        "parity_block_dimensions": {"const": {"even": 10, "odd": 0}},
        "family_names": {"const": ["R3_bianchi", "nablaR_nablaR_bianchi", "R_nabla2R_bianchi", "integration_by_parts", "covariant_commutators"]},
        "tower": {"type": "object"},
        "named_representatives": {"type": "object"}
      }
    },
    "controlled_projection_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "stage_dimensions", "tower"],
      "properties": {
        "role": {"const": "INFRASTRUCTURE_ONLY_NOT_GEOMETRIC_INPUT"},
        "stage_dimensions": {"const": [4, 3, 2]},
        "tower": {"type": "object"}
      }
    },
    "schouten_primitive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "antisymmetrized_occurrence_count", "generated_permutation_count", "relation_term_count_after_canonicalization", "relation_sha256"],
      "properties": {
        "dimension": {"const": 4},
        "antisymmetrized_occurrence_count": {"const": 5},
        "generated_permutation_count": {"const": 120},
        "relation_term_count_after_canonicalization": {"const": 120},
        "relation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "tracefree_weyl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traced_riemann_input_sha256", "traced_weyl_status", "untraced_weyl_status", "untraced_weyl_sha256"],
      "properties": {
        "traced_riemann_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "traced_weyl_status": {"const": "ZERO"},
        "untraced_weyl_status": {"const": "NONZERO"},
        "untraced_weyl_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "epsilon_reduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matching_count", "euclidean_matching_sha256", "lorentzian_matching_sha256", "complete_contraction_values", "complete_contraction_payloads"],
      "properties": {
        "matching_count": {"const": 24},
        "euclidean_matching_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "lorentzian_matching_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "complete_contraction_values": {"const": {"EUCLIDEAN": 24, "LORENTZIAN": -24}},
        "complete_contraction_payloads": {"type": "object"}
      }
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universal_tower_sha256", "controlled_tower_sha256", "source_manifest_sha256"],
      "properties": {
        "universal_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "controlled_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
