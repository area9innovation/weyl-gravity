{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-local-scaling-foundations-v1.json",
  "title": "Pure-Weyl local algebra scaling foundations certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "result_state",
    "classical_commit",
    "dependency_tags",
    "scope",
    "checks",
    "tensor_product",
    "cubic_orbits",
    "canonical_hashes",
    "not_computed",
    "assumptions"
  ],
  "properties": {
    "result_id": {"const": "LOCAL_ALGEBRA_SCALING_FOUNDATIONS_CERTIFICATE"},
    "result_state": {"const": "INFRASTRUCTURE_VERIFIED"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tensor_product_alpha_renaming",
        "explicit_index_contraction",
        "contracted_commutator_Rnabla2R_R3_mixing",
        "cubic_pairing_exhaustion",
        "signed_orbit_partition",
        "orbit_representative_canonicalizer_crosscheck",
        "algebraic_bianchi_cubic_quotient",
        "six_derivative_mixed_quotient",
        "local_cohomology_H_s_mod_d"
      ],
      "properties": {
        "tensor_product_alpha_renaming": {"const": "VERIFIED"},
        "explicit_index_contraction": {"const": "VERIFIED"},
        "contracted_commutator_Rnabla2R_R3_mixing": {"const": "VERIFIED"},
        "cubic_pairing_exhaustion": {"const": "VERIFIED"},
        "signed_orbit_partition": {"const": "VERIFIED"},
        "orbit_representative_canonicalizer_crosscheck": {"const": "VERIFIED"},
        "algebraic_bianchi_cubic_quotient": {"const": "NOT_COMPUTED"},
        "six_derivative_mixed_quotient": {"const": "NOT_COMPUTED"},
        "local_cohomology_H_s_mod_d": {"const": "NOT_COMPUTED"}
      }
    },
    "tensor_product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_index_policy",
        "explicit_contraction_policy",
        "default_product_complete_contraction",
        "mapped_product_complete_contraction",
        "contracted_commutator_term_count",
        "contracted_commutator_factor_counts",
        "contracted_commutator_all_terms_complete",
        "contracted_commutator_relation"
      ],
      "properties": {
        "default_index_policy": {"const": "ALPHA_RENAME_RIGHT_DISJOINTLY"},
        "explicit_contraction_policy": {"const": "RIGHT_INDEX_MAP_REQUIRED"},
        "default_product_complete_contraction": {"const": false},
        "mapped_product_complete_contraction": {"const": true},
        "contracted_commutator_term_count": {"const": 4},
        "contracted_commutator_factor_counts": {"const": [2, 3]},
        "contracted_commutator_all_terms_complete": {"const": true},
        "contracted_commutator_relation": {"type": "object"}
      }
    },
    "cubic_orbits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_pairing_count",
        "signed_group_order",
        "orbit_count",
        "vanishing_orbit_count",
        "nonvanishing_orbit_count",
        "covered_pairing_count",
        "representatives_cross_checked",
        "raw_monomial_canonicalizations_avoided",
        "canonicalization_cache_max_entries",
        "orbit_size_histogram",
        "orbit_ledger",
        "nonzero_canonical_representatives"
      ],
      "properties": {
        "raw_pairing_count": {"const": 10395},
        "signed_group_order": {"const": 3072},
        "orbit_count": {"const": 33},
        "vanishing_orbit_count": {"const": 20},
        "nonvanishing_orbit_count": {"const": 13},
        "covered_pairing_count": {"const": 10395},
        "representatives_cross_checked": {"const": 33},
        "raw_monomial_canonicalizations_avoided": {"const": 10362},
        "canonicalization_cache_max_entries": {"const": 65536},
        "orbit_size_histogram": {"type": "object"},
        "orbit_ledger": {
          "type": "array",
          "minItems": 33,
          "maxItems": 33,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["canonical_pairing", "orbit_size", "vanishes"],
            "properties": {
              "canonical_pairing": {"type": "array", "minItems": 6, "maxItems": 6},
              "orbit_size": {"type": "integer", "minimum": 1},
              "vanishes": {"type": "boolean"}
            }
          }
        },
        "nonzero_canonical_representatives": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"type": "object"}
        }
      }
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_group_sha256",
        "signed_orbit_partition_sha256",
        "nonzero_cubic_representatives_sha256",
        "contracted_commutator_relation_sha256",
        "source_manifest_sha256"
      ],
      "properties": {
        "signed_group_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signed_orbit_partition_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "nonzero_cubic_representatives_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "contracted_commutator_relation_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "not_computed": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string"}
    },
    "assumptions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    }
  }
}
