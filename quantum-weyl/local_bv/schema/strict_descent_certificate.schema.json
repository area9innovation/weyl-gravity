{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-horizontal-bicomplex-certificate-v2.json",
  "title": "Pure-Weyl horizontal bicomplex certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "result_state", "classical_commit", "dependency_tags", "scope", "checks", "towers", "database", "canonical_hashes", "not_computed", "assumptions"],
  "properties": {
    "result_id": {"const": "HORIZONTAL_BICOMPLEX_CERTIFICATE"},
    "result_state": {"const": "PARTIAL_DESCENT_DATABASE"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope": {"type": "string", "minLength": 1},
    "checks": {
      "const": {
        "Q_squared_zero_on_density_generators": "VERIFIED",
        "d_h_squared_zero": "VERIFIED",
        "coordinate_Q_dh_commutator_zero": "VERIFIED",
        "totalized_Q_dh_anticommutator_zero": "VERIFIED",
        "contraction_coefficients_verified": "VERIFIED",
        "counterterm_diff_descent_tower_equations": "VERIFIED",
        "anomaly_diff_descent_tower_equations": "VERIFIED",
        "bottom_brst_closure": "VERIFIED",
        "euler_intrinsic_weyl_descent": "NONTRIVIAL_COMPLETE",
        "antifield_descent": "BLOCKED_CLASSICAL_EXPORT"
      }
    },
    "towers": {"type": "object"},
    "database": {
      "type": "object",
      "required": ["result_id", "entry_count", "sha256"],
      "properties": {
        "result_id": {"const": "DESCENT_DATABASE_DIMENSION_FOUR"},
        "entry_count": {"type": "integer", "const": 8},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "canonical_hashes": {
      "type": "object",
      "required": ["source_manifest_sha256", "counterterm_tower_sha256", "anomaly_tower_sha256"],
      "properties": {
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "counterterm_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "anomaly_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
