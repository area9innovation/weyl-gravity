{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-strict-descent-certificate-v1.json",
  "title": "Pure-Weyl strict-density descent certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "result_state", "classical_commit", "dependency_tags", "scope", "checks", "towers", "database", "canonical_hashes", "not_computed", "assumptions"],
  "properties": {
    "result_id": {"const": "LOCAL_STRICT_DENSITY_DESCENT_CERTIFICATE"},
    "result_state": {"const": "PARTIAL_DESCENT_DATABASE"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope": {"type": "string", "minLength": 1},
    "checks": {
      "const": {
        "horizontal_d_squared": "VERIFIED",
        "density_brst_nilpotency": "VERIFIED",
        "brst_horizontal_commutation": "VERIFIED",
        "counterterm_tower_equations": "VERIFIED",
        "anomaly_tower_equations": "VERIFIED",
        "bottom_brst_closure": "VERIFIED",
        "euler_weyl_descent": "NOT_COMPUTED",
        "antifield_descent": "BLOCKED_CLASSICAL_EXPORT"
      }
    },
    "towers": {"type": "object"},
    "database": {
      "type": "object",
      "required": ["result_id", "entry_count", "sha256"],
      "properties": {
        "result_id": {"const": "DESCENT_DATABASE_DIMENSION_FOUR_STRICT"},
        "entry_count": {"type": "integer", "const": 8},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "canonical_hashes": {
      "type": "object",
      "required": ["source_manifest_sha256", "counterterm_tower_sha256", "anomaly_tower_sha256"],
      "properties": {
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "counterterm_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "anomaly_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
