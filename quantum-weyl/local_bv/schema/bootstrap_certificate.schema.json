{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/quantum-weyl/local-bv/bootstrap-certificate.schema.json",
  "title": "Quantum Weyl local-BV bootstrap certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "result_state",
    "classical_commit",
    "dependency_tags",
    "scope",
    "checks",
    "not_computed",
    "canonical_hashes",
    "assumptions"
  ],
  "properties": {
    "result_id": {"const": "LOCAL_BV_MINIMAL_BOOTSTRAP_PROOF"},
    "result_state": {"const": "INFRASTRUCTURE_VERIFIED"},
    "classical_commit": {"enum": ["NOT_FROZEN"]},
    "dependency_tags": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]}
    },
    "scope": {"type": "string", "minLength": 1},
    "checks": {"type": "object", "additionalProperties": {"enum": ["VERIFIED", "NOT_COMPUTED", "BLOCKED"]}},
    "not_computed": {"type": "array", "items": {"type": "string"}, "minItems": 1, "uniqueItems": true},
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    },
    "assumptions": {"type": "array", "items": {"type": "string"}}
  }
}
