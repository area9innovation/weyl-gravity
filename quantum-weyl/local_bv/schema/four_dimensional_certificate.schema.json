{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-local-four-dimensional-schouten-v1.json",
  "title": "Pure-Weyl four-dimensional Schouten quotient certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id", "result_state", "classical_commit", "dependency_tags",
    "scope", "checks", "generation", "specialization",
    "independent_crosscheck", "canonical_hashes", "not_computed", "assumptions"
  ],
  "properties": {
    "result_id": {"const": "LOCAL_FOUR_DIMENSIONAL_SCHOUTEN_QUOTIENT_CERTIFICATE"},
    "result_state": {"const": "DIMENSIONAL_QUOTIENT_VERIFIED"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope": {"type": "string", "minLength": 1},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_pairing_coordinate_coverage", "endpoint_selection_exhaustion",
        "orbit_first_direct_tensor_crosscheck", "five_index_schouten_generation",
        "relation_family_provenance", "specialization_projection_surjectivity",
        "specialization_kernel_witnesses", "four_dimensional_integrated_quotient",
        "primary_literature_rank_crosscheck", "tracefree_weyl_specialization",
        "parity_odd_weyl_sector", "local_cohomology_H_s_mod_d"
      ],
      "properties": {
        "signed_pairing_coordinate_coverage": {"const": "VERIFIED"},
        "endpoint_selection_exhaustion": {"const": "VERIFIED"},
        "orbit_first_direct_tensor_crosscheck": {"const": "VERIFIED"},
        "five_index_schouten_generation": {"const": "VERIFIED"},
        "relation_family_provenance": {"const": "VERIFIED"},
        "specialization_projection_surjectivity": {"const": "VERIFIED"},
        "specialization_kernel_witnesses": {"const": "VERIFIED"},
        "four_dimensional_integrated_quotient": {"const": "VERIFIED"},
        "primary_literature_rank_crosscheck": {"const": "VERIFIED"},
        "tracefree_weyl_specialization": {"const": "NOT_COMPUTED"},
        "parity_odd_weyl_sector": {"const": "NOT_COMPUTED"},
        "local_cohomology_H_s_mod_d": {"const": "NOT_COMPUTED"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_candidate_count", "total_nonzero_candidate_count",
        "unique_nonzero_relation_count", "schouten_relation_rank_in_ambient_basis",
        "universal_quotient_dimension", "four_dimensional_quotient_dimension",
        "schouten_rank_on_universal_quotient", "sector_ranks_after_specialization",
        "sectors", "relation_family"
      ],
      "properties": {
        "total_candidate_count": {"const": 3328},
        "total_nonzero_candidate_count": {"const": 2992},
        "unique_nonzero_relation_count": {"const": 72},
        "schouten_relation_rank_in_ambient_basis": {"const": 11},
        "universal_quotient_dimension": {"const": 10},
        "four_dimensional_quotient_dimension": {"const": 8},
        "schouten_rank_on_universal_quotient": {"const": 2},
        "sector_ranks_after_specialization": {"const": {"R3": 6, "nablaR_nablaR": 4, "R_nabla2R": 4}},
        "sectors": {"type": "object"},
        "relation_family": {"type": "object"}
      }
    },
    "specialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tower", "kernel_dimension", "kernel_witnesses"],
      "properties": {
        "tower": {"type": "object"},
        "kernel_dimension": {"const": 2},
        "kernel_witnesses": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}}
      }
    },
    "independent_crosscheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "reference_table", "reference_dimension_losses", "computed_dimension_losses", "status", "role"],
      "properties": {
        "reference": {"const": "https://arxiv.org/abs/0802.1274"},
        "reference_table": {"type": "string"},
        "reference_dimension_losses": {"type": "object"},
        "computed_dimension_losses": {"type": "object"},
        "status": {"const": "MATCH"},
        "role": {"const": "INDEPENDENT_CROSSCHECK_NOT_PROOF_INPUT"}
      }
    },
    "canonical_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schouten_relation_family_sha256", "specialization_tower_sha256", "kernel_witnesses_sha256", "source_manifest_sha256"],
      "properties": {
        "schouten_relation_family_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "specialization_tower_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "kernel_witnesses_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "not_computed": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
