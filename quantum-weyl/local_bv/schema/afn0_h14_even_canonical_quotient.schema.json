{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-h14-even-canonical-quotient-v1.json",
  "title": "Even AFN0 H14 canonical candidate quotient",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id",
    "result_state",
    "classical_commit",
    "dependency_tags",
    "scope_label",
    "bounds",
    "enumeration_policy",
    "canonical_sectors",
    "top_basis",
    "smallest_relative_sector",
    "classes",
    "exact_classes",
    "basis_exhaustiveness_proof",
    "checks",
    "claim_boundary",
    "analysis_sha256",
    "provenance",
    "certificate_hash"
  ],
  "properties": {
    "result_id": {"const": "AFN0_H14_EVEN_CANONICAL_QUOTIENT"},
    "result_state": {"const": "COMPLETE_AFN0_EVEN_CANDIDATE_QUOTIENT"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spacetime_dimension", "ghost_number", "form_degree", "antifield_number", "engineering_dimension", "parity", "ghost_species"],
      "properties": {
        "spacetime_dimension": {"const": 4},
        "ghost_number": {"const": 1},
        "form_degree": {"const": 4},
        "antifield_number": {"const": 0},
        "engineering_dimension": {"const": 4},
        "parity": {"const": "even"},
        "ghost_species": {"const": "WEYL"}
      }
    },
    "enumeration_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ambient_raw_graph_count", "ambient_raw_graphs_materialized", "target_raw_pairings_materialized"],
      "properties": {
        "mode": {"const": "ORBIT_FIRST_TWO_PENDING_MIXED_SIGNATURES"},
        "ambient_raw_graph_count": {"const": 2860932903},
        "ambient_raw_graphs_materialized": {"const": 0},
        "target_raw_pairings_materialized": {"const": 30}
      }
    },
    "canonical_sectors": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sector_id", "signature", "raw_pairing_count", "signed_symmetry_orbit_count", "bianchi_relation_rank", "canonical_quotient_dimension", "canonical_basis", "identity_status"],
        "properties": {
          "sector_id": {"enum": ["RIEMANN_TIMES_HESSIAN_OMEGA", "GRAD_RIEMANN_TIMES_GRAD_OMEGA"]},
          "signature": {"type": "object"},
          "raw_pairing_count": {"const": 15},
          "signed_symmetry_orbit_count": {"const": 2},
          "bianchi_relation_rank": {"enum": [0, 1]},
          "canonical_quotient_dimension": {"enum": [1, 2]},
          "canonical_basis": {"type": "array", "minItems": 2, "maxItems": 2},
          "contracted_differential_bianchi_coefficient": {"$ref": "#/$defs/fraction"},
          "identity_status": {"type": "object"}
        }
      }
    },
    "top_basis": {
      "const": ["ANOM_OMEGA_C2", "ANOM_OMEGA_E4", "ANOM_OMEGA_R2", "ANOM_OMEGA_BOX_R", "MIXED_R_BOX_OMEGA", "MIXED_RICCI_HESS_OMEGA", "MIXED_GRAD_R_GRAD_OMEGA"]
    },
    "smallest_relative_sector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["incoming_q_basis", "incoming_dh_basis", "Q_matrix", "d_h_matrix", "combined_boundary_matrix", "closure_obstruction_matrix", "outgoing_Q_matrix", "outgoing_d_h_matrix", "outgoing_target_basis", "outgoing_current", "outgoing_d_h_quotient_dimension", "reduced_omega_R2_obstruction_coefficient", "boundary_rank", "closure_rank", "quotient_dimension", "integration_by_parts_coordinates"],
      "properties": {
        "incoming_q_basis": {"const": ["R_SQUARED"]},
        "incoming_dh_basis": {"const": ["CURRENT_R_GRAD_OMEGA", "CURRENT_RICCI_GRAD_OMEGA", "CURRENT_OMEGA_GRAD_R"]},
        "Q_matrix": {"$ref": "#/$defs/matrix"},
        "d_h_matrix": {"$ref": "#/$defs/matrix"},
        "combined_boundary_matrix": {"$ref": "#/$defs/matrix"},
        "closure_obstruction_matrix": {"$ref": "#/$defs/matrix"},
        "outgoing_Q_matrix": {"$ref": "#/$defs/matrix"},
        "outgoing_d_h_matrix": {"$ref": "#/$defs/matrix"},
        "outgoing_target_basis": {"type": "array", "minItems": 2, "maxItems": 2},
        "outgoing_current": {"type": "object"},
        "outgoing_d_h_quotient_dimension": {"const": 1},
        "reduced_omega_R2_obstruction_coefficient": {"$ref": "#/$defs/fraction"},
        "boundary_rank": {"const": 4},
        "closure_rank": {"const": 6},
        "quotient_dimension": {"const": 2},
        "integration_by_parts_coordinates": {"type": "array", "minItems": 3, "maxItems": 3}
      }
    },
    "classes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representative_id", "relative_cohomology_status", "representative_coordinates", "dual_witness_type", "dual_witness_coordinates", "dual_pairing"],
        "properties": {
          "representative_id": {"enum": ["ANOM_OMEGA_C2", "ANOM_OMEGA_E4"]},
          "relative_cohomology_status": {"const": "NONTRIVIAL"},
          "representative_coordinates": {"type": "array", "minItems": 7, "maxItems": 7},
          "dual_witness_type": {"const": "COMPLETE_NONTRIVIALITY_WITNESS"},
          "dual_witness_coordinates": {"type": "array", "minItems": 7, "maxItems": 7},
          "dual_pairing": {"const": {"numerator": 1, "denominator": 1}}
        }
      }
    },
    "exact_classes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representative_id", "relative_cohomology_status", "primitive_id", "primitive_coefficient", "current_id"],
        "properties": {
          "representative_id": {"const": "ANOM_OMEGA_BOX_R"},
          "relative_cohomology_status": {"const": "EXACT"},
          "primitive_id": {"const": "R_SQUARED"},
          "primitive_coefficient": {"const": {"numerator": -1, "denominator": 12}},
          "current_id": {"const": "CURRENT_R_GRAD_OMEGA_MINUS_OMEGA_GRAD_R"}
        }
      }
    },
    "basis_exhaustiveness_proof": {"type": "object"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["two_pending_mixed_signatures_resolved", "orbit_first_no_ambient_expansion", "curvature_and_differential_bianchi", "grassmann_signs", "integration_by_parts", "four_dimensional_antisymmetrization", "exact_Q_and_d_h_matrices", "closure_kernel_equals_boundaries_plus_two_classes", "dual_witnesses_normalized"],
      "properties": {
        "two_pending_mixed_signatures_resolved": {"const": "VERIFIED"},
        "orbit_first_no_ambient_expansion": {"const": "VERIFIED"},
        "curvature_and_differential_bianchi": {"const": "VERIFIED"},
        "grassmann_signs": {"const": "VERIFIED"},
        "integration_by_parts": {"const": "VERIFIED"},
        "four_dimensional_antisymmetrization": {"const": "VERIFIED_EXHAUSTIVE_EMPTY"},
        "exact_Q_and_d_h_matrices": {"const": "VERIFIED"},
        "closure_kernel_equals_boundaries_plus_two_classes": {"const": "VERIFIED"},
        "dual_witnesses_normalized": {"const": "VERIFIED"}
      }
    },
    "claim_boundary": {"type": "array", "minItems": 3, "items": {"type": "string"}},
    "analysis_sha256": {"$ref": "#/$defs/hash"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_sha256", "source_manifest_sha256", "implementation", "schema"],
      "properties": {
        "source_sha256": {"type": "object", "minProperties": 5, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "source_manifest_sha256": {"$ref": "#/$defs/hash"},
        "implementation": {"const": "quantum-weyl/local_bv/h14_even_canonical_quotient.py"},
        "schema": {"const": "quantum-weyl/local_bv/schema/afn0_h14_even_canonical_quotient.schema.json"}
      }
    },
    "certificate_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row_count", "column_count", "entries"],
      "properties": {
        "row_count": {"type": "integer", "minimum": 0},
        "column_count": {"type": "integer", "minimum": 0},
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "column", "coefficient"],
            "properties": {
              "row": {"type": "integer", "minimum": 0},
              "column": {"type": "integer", "minimum": 0},
              "coefficient": {"$ref": "#/$defs/fraction"}
            }
          }
        }
      }
    }
  }
}
