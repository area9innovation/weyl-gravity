{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-basis-graph-bundle-v1.json",
  "title": "Content-addressed AFN0 contraction-graph bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "dependency_tags", "artifact_count", "artifacts", "bundle_hash"],
  "properties": {
    "result_id": {"const": "AFN0_CONTRACTION_GRAPH_BUNDLE"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "artifact_count": {"type": "integer", "minimum": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["signature", "refined_grading_status", "reason", "slot_metadata", "raw_generation", "symmetry_quotient", "divergence_witness", "artifact_hash"],
        "properties": {
          "signature": {"type": "object"},
          "refined_grading_status": {"enum": ["REFINED_ADMISSIBLE", "REJECTED_BY_REFINED_GRADING"]},
          "reason": {"type": "string", "minLength": 1},
          "slot_metadata": {"type": "array"},
          "raw_generation": {"type": "object"},
          "symmetry_quotient": {"type": ["object", "string"]},
          "divergence_witness": {"type": ["object", "string"]},
          "artifact_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "bundle_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
