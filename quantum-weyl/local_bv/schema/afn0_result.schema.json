{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-production-result-v1.json",
  "title": "Antifield-zero local cohomology production run",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "classical_commit", "dependency_tags", "scope_label", "result_state", "full_bv_promotion_status", "coefficient_status", "ghost_number", "form_degree", "antifield_number", "slices", "production_boundary"],
  "properties": {
    "result_id": {"enum": ["H04_AFN0_RESULT", "H14_AFN0_RESULT"]},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "result_state": {"const": "IN_PROGRESS"},
    "full_bv_promotion_status": {"const": "BLOCKED_CLASSICAL_ANTIFIELD_EXPORT"},
    "coefficient_status": {"const": "NOT_COMPUTED"},
    "ghost_number": {"enum": [0, 1]},
    "form_degree": {"const": 4},
    "antifield_number": {"const": 0},
    "slices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "parity", "basis_completeness", "closure_result", "truncated_quotient_result", "excluded_required_candidate"],
        "properties": {
          "slice_id": {"type": "string", "minLength": 1},
          "parity": {"enum": ["even", "odd"]},
          "basis_completeness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["basis_generation_rules", "dimension_and_bidegree_bounds", "raw_monomial_count", "canonical_basis_count", "identity_quotient_ranks", "structural_grading_enumeration", "basis_manifest_hash", "top_curvature_carrier_basis_status", "full_top_form_basis_status", "lower_form_mapping_cone_basis_status", "complete_relative_ansatz_status"],
            "properties": {
              "basis_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "basis_generation_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "dimension_and_bidegree_bounds": {"type": "object"},
              "raw_monomial_count": {"type": "integer", "minimum": 0},
              "canonical_basis_count": {"type": "integer", "minimum": 0},
              "identity_quotient_ranks": {"type": "object"},
              "structural_grading_enumeration": {
                "type": "object",
                "required": ["grading_manifest_hash", "coarse_grading_signature_count", "refined_grading_signature_count", "diff_top_form_coarse_signature_count", "diff_top_form_refined_signature_count", "combined_coarse_signature_count", "multigrading_status", "exhaustiveness_status"],
                "properties": {
                  "grading_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "coarse_grading_signature_count": {"type": "integer", "minimum": 0},
                  "refined_grading_signature_count": {"type": "integer", "minimum": 0},
                  "diff_top_form_coarse_signature_count": {"type": "integer", "minimum": 0},
                  "diff_top_form_refined_signature_count": {"type": "integer", "minimum": 0},
                  "combined_coarse_signature_count": {"type": "integer", "minimum": 0},
                  "multigrading_status": {"const": "COARSE_AND_REFINED_TOP_FORM_COUNTS_SEPARATED"},
                  "exhaustiveness_status": {"const": "IN_PROGRESS"}
                }
              },
              "candidate_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
              "top_curvature_carrier_basis_status": {"const": "COMPLETE"},
              "full_top_form_basis_status": {"const": "IN_PROGRESS"},
              "lower_form_mapping_cone_basis_status": {"const": "IN_PROGRESS"},
              "pure_diff_ghost_basis_status": {"enum": ["NOT_APPLICABLE", "IN_PROGRESS"]},
              "complete_relative_ansatz_status": {"const": "IN_PROGRESS"}
            }
          },
          "closure_result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result_id", "result_state", "closure_scope", "candidates"],
            "properties": {
              "result_id": {"type": "string", "pattern": "^.*_CLOSURE$"},
              "result_state": {"const": "CLOSURE_RESULT"},
              "closure_scope": {"const": "TOP_RELATIVE_CLOSURE"},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["representative_id", "representative_sha256", "closure_status", "closure_witness"],
                  "properties": {
                    "representative_id": {"type": "string", "minLength": 1},
                    "representative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "closure_status": {"const": "CLOSED"},
                    "closure_witness": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["certificate", "intrinsic_certificate", "descent_database", "semantic_status"],
                      "properties": {
                        "certificate": {"$ref": "#/$defs/artifactReceipt"},
                        "intrinsic_certificate": {"$ref": "#/$defs/artifactReceipt"},
                        "descent_database": {"$ref": "#/$defs/databaseReceipt"},
                        "semantic_status": {"$ref": "#/$defs/closureSemanticStatus"}
                      }
                    }
                  }
                }
              }
            }
          },
          "truncated_quotient_result": {
            "type": "object",
            "additionalProperties": false,
            "required": ["result_id", "result_state", "basis_exhaustiveness_status", "relative_cohomology_status", "candidates"],
            "properties": {
              "result_id": {"type": "string", "pattern": "^.*_TRUNCATED_QUOTIENT$"},
              "result_state": {"const": "TRUNCATED_QUOTIENT_RESULT"},
              "basis_exhaustiveness_status": {"const": "TRUNCATED"},
              "relative_cohomology_status": {"const": "UNDECIDED"},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["representative_id", "representative_sha256", "relative_cohomology_status", "exactness_witness", "nonmembership_witness", "permitted_nonmembership_witness_type"],
                  "properties": {
                    "representative_id": {"type": "string", "minLength": 1},
                    "representative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "relative_cohomology_status": {"enum": ["EXACT", "UNDECIDED"]},
                    "exactness_witness": {"type": ["object", "string", "null"]},
                    "nonmembership_witness": {"type": "null"},
                    "permitted_nonmembership_witness_type": {"enum": ["TRUNCATED_NONMEMBERSHIP_WITNESS", "NOT_APPLICABLE_EXACT"]}
                  }
                }
              }
            }
          },
          "excluded_required_candidate": {"type": ["object", "null"]}
        }
      }
    },
    "production_boundary": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "$defs": {
    "artifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_id": {"type": "string", "minLength": 1}
      }
    },
    "databaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_id", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_id": {"const": "DESCENT_DATABASE_DIMENSION_FOUR"},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "closureSemanticStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diff_descent_status", "intrinsic_weyl_descent_status", "relative_cohomology_status", "intrinsic_certificate_check", "verification_status"],
      "properties": {
        "diff_descent_status": {"const": "NONZERO_DIFF_TOWER"},
        "intrinsic_weyl_descent_status": {"enum": ["STRICTLY_WEYL_INVARIANT", "CLOSED", "TRIVIAL", "TRIVIAL_WITH_PRIMITIVE", "NONTRIVIAL_COMPLETE"]},
        "relative_cohomology_status": {"enum": ["EXACT", "UNDECIDED"]},
        "intrinsic_certificate_check": {"enum": ["EULER_VARIATIONAL_TRANSGRESSION_AND_HEAD_VERIFIED", "EULER_INTRINSIC_TOWER_AND_HEAD_VERIFIED", "EXPLICIT_RELATIVE_TRIVIALIZATION_VERIFIED", "STRICT_DENSITY_CANDIDATE_CLOSURE_VERIFIED"]},
        "verification_status": {"const": "VERIFIED_FROM_HASH_BOUND_ARTIFACTS"}
      }
    }
  }
}
