{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-production-result-v1.json",
  "title": "Antifield-zero local cohomology production run",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "classical_commit", "dependency_tags", "scope_label", "result_state", "full_bv_promotion_status", "coefficient_status", "ghost_number", "form_degree", "antifield_number", "slices", "production_boundary"],
  "properties": {
    "result_id": {"enum": ["H04_AFN0_RESULT", "H14_AFN0_RESULT"]},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "result_state": {"const": "IN_PROGRESS"},
    "full_bv_promotion_status": {"const": "BLOCKED_CLASSICAL_ANTIFIELD_EXPORT"},
    "coefficient_status": {"const": "NOT_COMPUTED"},
    "ghost_number": {"enum": [0, 1]},
    "form_degree": {"const": 4},
    "antifield_number": {"const": 0},
    "slices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slice_id", "parity", "basis_completeness", "closure_result", "truncated_quotient_result", "excluded_required_candidate"],
        "properties": {
          "slice_id": {"type": "string", "minLength": 1},
          "parity": {"enum": ["even", "odd"]},
          "basis_completeness": {
            "type": "object",
            "required": ["basis_generation_rules", "dimension_and_bidegree_bounds", "raw_monomial_count", "canonical_basis_count", "identity_quotient_ranks", "structural_grading_enumeration", "basis_manifest_hash", "top_curvature_carrier_basis_status", "full_top_form_basis_status", "lower_form_mapping_cone_basis_status", "complete_relative_ansatz_status"],
            "properties": {
              "basis_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "top_curvature_carrier_basis_status": {"const": "COMPLETE"},
              "full_top_form_basis_status": {"const": "IN_PROGRESS"},
              "lower_form_mapping_cone_basis_status": {"const": "IN_PROGRESS"},
              "complete_relative_ansatz_status": {"const": "IN_PROGRESS"}
            }
          },
          "closure_result": {
            "type": "object",
            "required": ["result_id", "result_state", "closure_scope", "candidates"],
            "properties": {
              "result_id": {"type": "string", "pattern": "^.*_CLOSURE$"},
              "result_state": {"const": "CLOSURE_RESULT"},
              "closure_scope": {"const": "TOP_RELATIVE_CLOSURE"},
              "candidates": {"type": "array", "minItems": 1, "items": {"type": "object"}}
            }
          },
          "truncated_quotient_result": {
            "type": "object",
            "required": ["result_id", "result_state", "basis_exhaustiveness_status", "relative_cohomology_status", "candidates"],
            "properties": {
              "result_id": {"type": "string", "pattern": "^.*_TRUNCATED_QUOTIENT$"},
              "result_state": {"const": "TRUNCATED_QUOTIENT_RESULT"},
              "basis_exhaustiveness_status": {"const": "TRUNCATED"},
              "relative_cohomology_status": {"const": "UNDECIDED"},
              "candidates": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["representative_id", "representative_sha256", "relative_cohomology_status", "exactness_witness", "nonmembership_witness", "permitted_nonmembership_witness_type"],
                  "properties": {
                    "representative_id": {"type": "string", "minLength": 1},
                    "representative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                    "relative_cohomology_status": {"enum": ["EXACT", "UNDECIDED"]},
                    "exactness_witness": {"type": ["object", "string", "null"]},
                    "nonmembership_witness": {"type": "null"},
                    "permitted_nonmembership_witness_type": {"enum": ["TRUNCATED_NONMEMBERSHIP_WITNESS", "NOT_APPLICABLE_EXACT"]}
                  }
                }
              }
            }
          },
          "excluded_required_candidate": {"type": ["object", "null"]}
        }
      }
    },
    "production_boundary": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
