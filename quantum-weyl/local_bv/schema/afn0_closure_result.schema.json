{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-closure-result-v1.json",
  "title": "Standalone antifield-zero closure result",
  "type": "object",
  "additionalProperties": false,
  "required": ["result_id", "parent_result_id", "slice_id", "classical_commit", "dependency_tags", "scope_label", "ghost_number", "form_degree", "antifield_number", "parity", "basis_manifest_hash", "result_state", "closure_scope", "candidates"],
  "properties": {
    "result_id": {"type": "string", "pattern": "^.*_CLOSURE$"},
    "parent_result_id": {"enum": ["H04_AFN0_RESULT", "H14_AFN0_RESULT"]},
    "slice_id": {"type": "string", "minLength": 1},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_ONLY"},
    "ghost_number": {"enum": [0, 1]},
    "form_degree": {"const": 4},
    "antifield_number": {"const": 0},
    "parity": {"enum": ["even", "odd"]},
    "basis_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "result_state": {"const": "CLOSURE_RESULT"},
    "closure_scope": {"const": "TOP_RELATIVE_CLOSURE"},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["representative_id", "representative_sha256", "closure_status", "closure_witness"],
        "properties": {
          "representative_id": {"type": "string", "minLength": 1},
          "representative_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "closure_status": {"const": "CLOSED"},
          "closure_witness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["certificate", "intrinsic_certificate", "descent_database", "semantic_status"],
            "properties": {
              "certificate": {"$ref": "#/$defs/artifactReceipt"},
              "intrinsic_certificate": {"$ref": "#/$defs/artifactReceipt"},
              "descent_database": {"$ref": "#/$defs/databaseReceipt"},
              "semantic_status": {"$ref": "#/$defs/closureSemanticStatus"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifactReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_id": {"type": "string", "minLength": 1}
      }
    },
    "databaseReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_id", "canonical_sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "result_id": {"const": "DESCENT_DATABASE_DIMENSION_FOUR"},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "closureSemanticStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diff_descent_status", "intrinsic_weyl_descent_status", "relative_cohomology_status", "intrinsic_certificate_check", "verification_status"],
      "properties": {
        "diff_descent_status": {"const": "NONZERO_DIFF_TOWER"},
        "intrinsic_weyl_descent_status": {"enum": ["STRICTLY_WEYL_INVARIANT", "CLOSED", "TRIVIAL", "TRIVIAL_WITH_PRIMITIVE", "NONTRIVIAL_COMPLETE"]},
        "relative_cohomology_status": {"enum": ["EXACT", "UNDECIDED"]},
        "intrinsic_certificate_check": {"enum": ["EULER_VARIATIONAL_TRANSGRESSION_AND_HEAD_VERIFIED", "EULER_INTRINSIC_TOWER_AND_HEAD_VERIFIED", "EXPLICIT_RELATIVE_TRIVIALIZATION_VERIFIED", "STRICT_DENSITY_CANDIDATE_CLOSURE_VERIFIED"]},
        "verification_status": {"const": "VERIFIED_FROM_HASH_BOUND_ARTIFACTS"}
      }
    }
  }
}
