{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-renormalized-D-ward-insertion-export-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "dependency_tags", "setting_id", "generator_id", "phase_space_id", "renormalization", "observable_complex", "operators", "slavnov", "consistency_checks", "cartan_defect", "local_to_cartan_map", "claim_boundary"],
  "properties": {
    "schema": {"const": "quantum-weyl-renormalized-D-ward-insertion-export-v1"},
    "result_id": {"const": "RENORMALIZED_D_WARD_INSERTION"},
    "result_state": {"enum": ["REGULATED_BREAKING_COMPUTED_QME_OPEN", "QME_RESTORED_CARTAN_CLASSIFIED"]},
    "dependency_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]}},
    "setting_id": {"type": "string", "minLength": 1},
    "generator_id": {"const": "D_compact"},
    "phase_space_id": {"type": "string", "minLength": 1},
    "renormalization": {
      "type": "object", "additionalProperties": false,
      "required": ["signature", "gauge", "regularization", "scheme", "boundary_conditions", "zero_mode_policy"],
      "properties": {
        "signature": {"type": "string", "minLength": 1},
        "gauge": {"type": "string", "minLength": 1},
        "regularization": {"type": "string", "minLength": 1},
        "scheme": {"type": "string", "minLength": 1},
        "boundary_conditions": {"type": "string", "minLength": 1},
        "zero_mode_policy": {"type": "string", "minLength": 1}
      }
    },
    "observable_complex": {
      "type": "object", "additionalProperties": false,
      "required": ["algebra_id", "grading_convention", "representation_artifact", "admissibility_policy_artifact"],
      "properties": {
        "algebra_id": {"type": "string", "minLength": 1},
        "grading_convention": {"type": "string", "minLength": 1},
        "representation_artifact": {"$ref": "#/$defs/artifact"},
        "admissibility_policy_artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "operators": {
      "type": "object", "additionalProperties": false,
      "required": ["Q0", "Q1", "iota_D0", "iota_D1", "L_D0", "L_D1"],
      "properties": {
        "Q0": {"$ref": "#/$defs/operator"}, "Q1": {"$ref": "#/$defs/operator"},
        "iota_D0": {"$ref": "#/$defs/operator"}, "iota_D1": {"$ref": "#/$defs/operator"},
        "L_D0": {"$ref": "#/$defs/operator"}, "L_D1": {"$ref": "#/$defs/operator"}
      }
    },
    "slavnov": {
      "type": "object", "additionalProperties": false,
      "required": ["qme_status", "regulated_breaking", "qme_source"],
      "properties": {
        "qme_status": {"enum": ["RESTORED", "NOT_RESTORED_SOURCE_RETAINED"]},
        "regulated_breaking": {"$ref": "#/$defs/artifact"},
        "qme_source": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      }
    },
    "consistency_checks": {
      "type": "object", "additionalProperties": false,
      "required": ["Q0_squared_zero", "classical_Cartan_identity", "defect_consistency_Q_closed", "first_order_QME_linearization", "first_order_Ward_compatibility", "sourced_consistency_identity"],
      "properties": {
        "Q0_squared_zero": {"$ref": "#/$defs/check"},
        "classical_Cartan_identity": {"$ref": "#/$defs/check"},
        "defect_consistency_Q_closed": {"$ref": "#/$defs/check"},
        "first_order_QME_linearization": {"$ref": "#/$defs/check"},
        "first_order_Ward_compatibility": {"$ref": "#/$defs/check"},
        "sourced_consistency_identity": {"$ref": "#/$defs/check"}
      }
    },
    "cartan_defect": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "artifact", "primitive", "dual_witness"],
      "properties": {
        "status": {"enum": ["ZERO", "EXACT_REMOVABLE", "NONTRIVIAL_ANOMALY", "UNDEFINED_ANALYTICALLY"]},
        "artifact": {"$ref": "#/$defs/artifact"},
        "primitive": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]},
        "dual_witness": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      }
    },
    "local_to_cartan_map": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "artifact"],
      "properties": {
        "status": {"enum": ["NOT_CONSTRUCTED", "CONSTRUCTED"]},
        "artifact": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/artifact"}]}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": {"enum": ["JSON_ADMISSIBILITY_POLICY", "JSON_DUAL_WITNESS", "JSON_LOCAL_OPERATOR", "JSON_OBSERVABLE_COMPLEX", "JSON_PROOF_CERTIFICATE", "TEXT_PROOF_CERTIFICATE"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "operator": {
      "type": "object", "additionalProperties": false,
      "required": ["degree", "evaluator_id", "expression_schema_version", "artifact"],
      "properties": {
        "degree": {"type": "integer", "minimum": -1, "maximum": 1},
        "evaluator_id": {"type": "string", "minLength": 1},
        "expression_schema_version": {"type": "string", "minLength": 1},
        "artifact": {"$ref": "#/$defs/artifact"}
      }
    },
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "proof_artifact"],
      "properties": {
        "status": {"enum": ["VERIFIED", "VERIFIED_ZERO", "COMPUTED_NONZERO", "SOURCED_NONZERO"]},
        "proof_artifact": {"$ref": "#/$defs/artifact"}
      }
    }
  }
}
