    "required_operator_ids": {"const": ["P_metric", "P_metric_antifield", "Lambda_metric_minus", "Lambda_metric_plus", "Lambda_metric_antifield_minus", "Lambda_metric_antifield_plus", "realization_backward", "realization_forward"]},
