    "claim_flags": {
      "const": {
        "BERGER_RETAINED_BIWAVE_D_EQUIVARIANT": true,
        "BERGER_RETAINED_BIWAVE_FORMAL_ADJOINT_BUNDLE_READY": true,
        "BERGER_RETAINED_BIWAVE_COMPANION_CYCLIC_PAIRING": false,
        "BERGER_RETAINED_BIWAVE_CAUSAL_RESOLVENT_IMPORTED": false,
        "BERGER_26_ROW_CAUSAL_GREEN_HOMOTOPY": false,
        "BERGER_54_ROW_CAUSAL_GREEN_HOMOTOPY": false,
        "BERGER_CAUSAL_D_CARTAN": false,
        "QUANTUM_CLAIM": false
      }
    },
    "next_gate": {"const": "REPAIR_CLASSICAL_BERGER_RETAINED_BIWAVE_VOLTERRA_CERTIFICATE"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependencies", "source_manifest", "source_manifest_sha256"],
      "properties": {
        "dependencies": {"type": "object", "minProperties": 8},
        "source_manifest": {"type": "object", "minProperties": 5},
        "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
