  "properties": {
    "schema": {"const": "quantum-weyl-berger-retained-biwave-volterra-import-readiness-v1"},
    "result_id": {"const": "BERGER_RETAINED_BIWAVE_VOLTERRA_IMPORT_READINESS"},
    "result_state": {"const": "SOURCE_LANDED_REJECTED_ANALYTIC_CONTRACT_D_ADJOINT_GRAPH_READY"},
