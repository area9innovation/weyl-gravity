      "required": ["classical_commit", "classical_artifacts", "quantum_metric_import", "source_manifest", "source_manifest_sha256"],
      "properties": {
        "classical_commit": {"const": "743183594a7a33dbb869154dafd7eb2c3482bac0"},
        "classical_artifacts": {"type": "object", "minProperties": 4},
        "quantum_metric_import": {"type": "object", "minProperties": 2},
        "source_manifest": {"type": "object", "minProperties": 5},
