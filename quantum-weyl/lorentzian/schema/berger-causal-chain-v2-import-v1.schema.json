          "type": "object", "additionalProperties": false,
          "required": ["endpoint_26", "full_54", "causal_D_Cartan"],
          "properties": {
            "endpoint_26": {"type": "object", "minProperties": 7, "additionalProperties": {"const": true}},
            "full_54": {"type": "object", "minProperties": 6, "additionalProperties": {"const": true}},
            "causal_D_Cartan": {"type": "object", "minProperties": 7, "additionalProperties": {"const": true}}
          }
        }
      }
    },
    "claim_flags": {
      "const": {
        "BERGER_RETAINED_METRIC_GREEN_OPERATORS_IMPORTED": true,
        "BERGER_26_ROW_CAUSAL_GREEN_HOMOTOPY_V2_IMPORTED": true,
        "BERGER_54_ROW_CAUSAL_GREEN_HOMOTOPY_V2_IMPORTED": true,
        "BERGER_CAUSAL_D_CARTAN_V2_IMPORTED": true,
        "BERGER_ARITY_THREE_D_CARTAN": false,
        "BERGER_HADAMARD_DATA": false,
