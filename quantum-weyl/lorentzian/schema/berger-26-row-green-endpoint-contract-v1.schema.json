      "properties": {
        "result_id": {"const": "BERGER_ENDPOINT_FACTOR_INPUT_IMPORT"},
        "certificate": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"const": "quantum-weyl/lorentzian/certificates/BERGER_ENDPOINT_FACTOR_INPUT_IMPORT.json"},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "certified_blocks": {"const": ["ghost", "identity"]},
        "open_blocks": {"const": ["metric", "metric_antifield"]},
        "explicit_factor_records": {"const": "REQUESTED_FROM_CLASSICAL_SOURCE_NOT_YET_EXPORTED"},
        "required_factor_record_ids": {"const": ["F_spatial_K_spatial", "Box_1_spatial_covector", "F_spatial_K_spatial_formal_adjoint", "Box_1_spatial_covector_formal_adjoint"]},
        "preferred_metric_principal_route": {
          "type": "object", "additionalProperties": false,
          "required": ["result_id", "certificate", "kind", "status"],
          "properties": {
            "result_id": {"const": "BERGER_CLOCK_REATTACHED_PRINCIPAL_INPUT_IMPORT"},
            "certificate": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "sha256"],
              "properties": {
                "path": {"const": "quantum-weyl/lorentzian/certificates/BERGER_CLOCK_REATTACHED_PRINCIPAL_INPUT_IMPORT.json"},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            },
            "kind": {"const": "CLOCK_REATTACHED_SUPPORT_LOCAL_SDR"},
            "status": {"const": "PRINCIPAL_IMPORTED_CURVED_LOWER_ORDERS_OPEN"}
          }
        }
      }
    },
    "green_endpoint_status": {"const": "NOT_CONSTRUCTED"},
    "hadamard_status": {"const": "NOT_CONSTRUCTED"},
    "quantum_execution_authorized": {"const": false},
    "next_gate": {"const": "BERGER_CURVED_CLOCK_REATTACHED_WITNESS"},
    "claim_boundary": {"type": "string", "minLength": 1},
