{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-berger-curved-witness-export-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "result_state", "classical_commit", "dependency_tags",
    "setting_id", "row_layout", "operators", "coordinate_transport", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "quantum-weyl-berger-curved-witness-export-v1"},
    "result_id": {"const": "BERGER_CURVED_CLOCK_REATTACHED_WITNESS"},
    "result_state": {"const": "CURVED_WITNESS_CANDIDATE"},
    "classical_commit": {"$ref": "#/$defs/commit"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "setting_id": {"const": "compact_positive_berger_clock_fixed_coupling_linearized"},
    "row_layout": {"const": {"degree_ranks": [5, 12, 12, 5], "total_rows": 34}},
    "operators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["W34", "P34", "pairing34"],
      "properties": {
        "W34": {"$ref": "#/$defs/operatorArtifact"},
        "P34": {"$ref": "#/$defs/operatorArtifact"},
        "pairing34": {"$ref": "#/$defs/operatorArtifact"}
      }
    },
    "coordinate_transport": {"$ref": "#/$defs/transportHashes"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "operatorArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "path", "sha256"],
      "properties": {
        "format": {"const": "JSON_EXACT_SPARSE_OPERATOR"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "transportHashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "curved_companion_sha256", "raw_metric_from_dressed_sha256",
        "transported_gauge_condition_sha256", "row_layout_sha256",
        "q34_sha256"
      ],
      "properties": {
        "curved_companion_sha256": {"$ref": "#/$defs/hash"},
        "raw_metric_from_dressed_sha256": {"$ref": "#/$defs/hash"},
        "transported_gauge_condition_sha256": {"$ref": "#/$defs/hash"},
        "row_layout_sha256": {"$ref": "#/$defs/hash"},
        "q34_sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
