{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-retained-stationary-carrier-matrix-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "artifact_id", "shape", "row_ids", "column_ids", "entries", "sha256", "source_commit"],
  "properties": {
    "schema": {"const": "quantum-weyl-berger-retained-stationary-carrier-matrix-v1"},
    "artifact_id": {"enum": ["A104", "q_Cauchy_104", "G_Cauchy_104", "real_structure_104"]},
    "shape": {"const": [104, 104]},
    "row_ids": {"type": "array", "minItems": 104, "maxItems": 104, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "column_ids": {"type": "array", "minItems": 104, "maxItems": 104, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  },
  "$defs": {
    "entry": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 103},
        {"type": "integer", "minimum": 0, "maximum": 103},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/term"}}
      ]
    },
    "term": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 0}},
        {"type": "string", "pattern": "^[0-9A-Za-z_+*/() -]+$", "minLength": 1}
      ]
    }
  }
}
