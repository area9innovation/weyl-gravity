        "STATIONARY_GENERATOR_IMPORT_CONSUMER_READY": {"const": true},
        "POLAR_UNGAUGED_NOETHER_LIFT_IMPORTED": {"const": true},
        "PLEBANSKI_HACYAN_STABILIZER_AUTHORITY_IMPORTED": {"const": true},
        "HADAMARD_EXISTENCE_THEOREM_APPLIES": {"const": false},
        "FULL_BV_G2_COMPLETE": {"const": true}, "REPOSITORY_BV_ANOMALY_COEFFICIENT_COMPUTED": {"const": true},
        "REGULATED_SLAVNOV_BREAKING_COMPUTED": {"const": true},
        "QME_OBSTRUCTED_STRICT_FIELD_CONTENT": {"const": true},
