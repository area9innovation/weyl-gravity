        "ANTIFIELD_EXPORT_V2_RECEIVER_READY": {"const": true},
        "CLASSICAL_ANTIFIELD_EXPORT_IMPORTED": {"const": true},
        "CLASSICAL_SNAPSHOT_COMPATIBILITY_RECEIVER_READY": {"const": true},
        "CLASSICAL_SNAPSHOT_COMPATIBILITY_SEMANTIC_RECEIVER_BOUND": {"const": true},
        "REPOSITORY_CLASSICAL_SNAPSHOT_COMPATIBILITY_ACCEPTED": {"const": true},
        "REGULATED_BV_INSERTION_V2_RECEIVER_READY": {"const": true},
        "MINIMAL_KOSZUL_TATE_POSITIVE_AFN_ACYCLIC": {"const": true},
