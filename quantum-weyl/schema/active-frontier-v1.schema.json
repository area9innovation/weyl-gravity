        "REPOSITORY_EUCLIDEAN_ELLIPTIC_COMPLEX_CERTIFIED": {"const": true},
        "REPOSITORY_C2_COEFFICIENT_COMPUTED": {"const": true},
        "NONCONFORMAL_COEFFICIENT_MATCH_RECEIVER_READY": {"const": true},
        "EUCLIDEAN_ELLIPTIC_COMPLEX_RECEIVER_READY": {"const": true},
        "REGULATOR_ZERO_MODE_MEASURE_RECEIVER_READY": {"const": true},
        "NEGATIVE_SCALAR_PHASE_LOCALITY_BOUND": {"const": true},
        "CONFORMAL_ZERO_MODE_VOLUME_LOCALITY_BOUND": {"const": true},
        "CURVATURE_IMAGE_PRESYMPLECTIC_CCR_ALGEBRA_DEFINED": {"const": true},
        "CURVATURE_OBSERVABLE_CAUSAL_PROPAGATOR_CONSTRUCTED": {"const": true},
        "CLASSICAL_MAXWELL_TRANSFER_LANDED": {"const": true}, "MAXWELL_TRANSFER_FORMULA_INDEPENDENTLY_REPLAYED_BY_QUANTUM": {"const": true},
        "MAXWELL_TRANSFER_INDEPENDENTLY_REPLAYED_BY_QUANTUM": {"const": true},
        "COUPLED_Q2_CYCLIC_REPAIR_ACCEPTED": {"const": true},
        "MIXED_Q3_INPUT_UNBLOCKED": {"const": true},
        "MIXED_Q3_INDEPENDENTLY_ACCEPTED": {"const": true},
        "RETAINED_MIXED_ELL3_INDEPENDENTLY_ACCEPTED": {"const": true},
