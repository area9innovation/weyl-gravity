{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/quantum-weyl-afn0-cylinder-restriction-preflight-v1.json",
  "title": "AFN0 cylinder structural restriction preflight",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "result_id", "result_state", "classical_commit", "dependency_tags",
    "scope_label", "background", "expansion_ledger", "curvature_pipeline",
    "parity_support", "topological_and_exact_rows", "residual_evidence",
    "projection_blockers", "local_to_cylinder_map_status",
    "residual_projection_status", "source_sha256", "claim_boundary",
    "preflight_hash", "provenance", "certificate_hash"
  ],
  "properties": {
    "result_id": {"const": "AFN0_CYLINDER_RESTRICTION_PREFLIGHT"},
    "result_state": {"const": "STRUCTURAL_RESTRICTION_VERIFIED_PROJECTION_BLOCKED"},
    "classical_commit": {"const": "UNFROZEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "scope_label": {"const": "AFN0_CYLINDER_PREFLIGHT_ONLY"},
    "background": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "scalar_curvature", "weyl_nonzero_component_count", "conformal_flatness", "curvature_audit"],
      "properties": {
        "metric": {"const": "-dt^2+dOmega_3^2"}, "scalar_curvature": {"const": 6},
        "weyl_nonzero_component_count": {"const": 0},
        "conformal_flatness": {"const": "VERIFIED_EXACTLY"},
        "curvature_audit": {
          "type": "object", "additionalProperties": false,
          "required": ["riemann_product_identity", "ricci_product_identity", "riemann_squared", "ricci_squared", "scalar_curvature", "euler_density"],
          "properties": {
            "riemann_product_identity": {"type": "string"}, "ricci_product_identity": {"type": "string"},
            "riemann_squared": {"const": 12}, "ricci_squared": {"const": 12},
            "scalar_curvature": {"const": 6}, "euler_density": {"const": 0}
          }
        }
      }
    },
    "expansion_ledger": {"type": "object"},
    "curvature_pipeline": {"type": "object"},
    "parity_support": {
      "type": "object", "additionalProperties": false,
      "required": ["source_basis", "target_evidence_basis", "support_matrix", "e_even_definition", "o_odd_definition", "parity_geometry", "normalization_matrix", "normalization_status"],
      "properties": {
        "source_basis": {"const": ["CT_C2", "CT_C_DUAL_C"]},
        "target_evidence_basis": {"const": ["e_even", "o_odd"]},
        "support_matrix": {"const": [["ALLOWED_NONZERO", "ZERO_BY_PARITY"], ["ZERO_BY_PARITY", "ALLOWED_NONZERO"]]},
        "e_even_definition": {"type": "string"}, "o_odd_definition": {"type": "string"},
        "parity_geometry": {"type": "string"}, "normalization_matrix": {"type": "null"},
        "normalization_status": {"const": "UNDEFINED_PENDING_FROZEN_REPRESENTATIVE_VECTORS_AND_PI_CL"}
      }
    },
    "topological_and_exact_rows": {"type": "object"},
    "residual_evidence": {"type": "object"},
    "projection_blockers": {"type": "object"},
    "local_to_cylinder_map_status": {"const": "NOT_COMPUTED"},
    "residual_projection_status": {"const": "BLOCKED_FAIL_CLOSED"},
    "source_sha256": {"type": "object", "additionalProperties": {"$ref": "#/$defs/hash"}},
    "claim_boundary": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "preflight_hash": {"$ref": "#/$defs/hash"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["preflight", "emitter", "schema"],
      "properties": {"preflight": {"type": "string"}, "emitter": {"type": "string"}, "schema": {"type": "string"}}
    },
    "certificate_hash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
