          {"probe_shells": [0, 1], "escaping_shell": 2, "all_A_matrix_elements_zero": true, "all_continuum_B_matrix_elements_zero": true},
          {"probe_shells": [0, 1, 2], "escaping_shell": 3, "all_A_matrix_elements_zero": true, "all_continuum_B_matrix_elements_zero": true},
          {"probe_shells": [0, 1, 2, 3], "escaping_shell": 4, "all_A_matrix_elements_zero": true, "all_continuum_B_matrix_elements_zero": true}
