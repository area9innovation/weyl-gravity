        "free_bilaplacian_slow_scaling": {"const": "PROVED"}, "absolute_dobrushin_contraction": {"const": "OBSTRUCTED_ALREADY_FREE"},
        "interacting_conditional_mean_response_identity": {"const": "PROVED"}, "conditional_mixed_hessian_square_bound": {"const": "OPEN"},
        "signed_fourier_multiscale_influence": {"const": "OPEN"}, "volume_uniform_global_poincare": {"const": "OPEN"},
