{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-complete-g4-subpower-pair-bounds-v1.schema.json",
  "title": "Exact BT complete-g4 subpower pair bounds",
  "type": "object",
  "required": [
    "certificate",
    "schema_version",
    "created",
    "dependency_tags",
    "lifecycle_state",
    "result_kind",
    "question",
    "answer",
    "data",
    "data_sha256",
    "producer",
    "producer_sha256",
    "vertex_bounds",
    "convolution_bounds",
    "pair_bounds",
    "power_sector_reduction",
    "method_disposition",
    "checks",
    "does_not_establish",
    "missing_object_ledger",
    "next_gate",
    "provenance",
    "schema",
    "report",
    "independent_verifier",
    "verification_commands"
  ],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_COMPLETE_G4_SUBPOWER_PAIR_BOUNDS_V1"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-complete-g4-subpower-pair-bounds-v1"},
    "created": {"const": "2026-08-15"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "lifecycle_state": {"const": "THREE_SUBPOWER_PAIR_BOUNDS_PROVED_FOUR_PAIR_POWER_GATE_OPEN"},
    "result_kind": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "data": {"const": "reverse_physics/data/bt_euclidean_complete_g4_subpower_pair_bounds_v1.json"},
    "data_sha256": {"$ref": "#/$defs/sha256"},
    "producer": {"const": "reverse_physics/bt_euclidean_complete_g4_subpower_pair_bounds.py"},
    "producer_sha256": {"$ref": "#/$defs/sha256"},
    "vertex_bounds": {
      "type": "object",
      "required": ["cubic", "quartic", "quartic_derivation", "constants", "status"],
      "properties": {
        "cubic": {"type": "string"},
        "quartic": {"type": "string"},
        "quartic_derivation": {"type": "string"},
        "constants": {
          "type": "object",
          "required": ["cubic_two_leg", "quartic_all_leg_product"],
          "properties": {
            "cubic_two_leg": {"const": {"numerator": 2, "denominator": 3}},
            "quartic_all_leg_product": {"const": {"numerator": 56, "denominator": 3}}
          },
          "additionalProperties": false
        },
        "status": {"const": "EXACT_VERTEX_BOUNDS"}
      },
      "additionalProperties": false
    },
    "convolution_bounds": {
      "type": "object",
      "required": ["G2_definition", "G2_bound", "J_definition", "centered_dispersion", "two_center_shell_count", "dimensionless_shifted_sum", "J_bound", "status"],
      "properties": {
        "G2_definition": {"type": "string"},
        "G2_bound": {"const": "G2(L)<=N*A_L, A_L=11/32+(1/4)*log(R), R=floor(L/2)"},
        "J_definition": {"type": "string"},
        "centered_dispersion": {"type": "string"},
        "two_center_shell_count": {"type": "string"},
        "dimensionless_shifted_sum": {"const": "sum_(q!=0,-p) [rho_2(q)*rho_2(q+p)^3]^(-1)<=176+128*log(R)"},
        "J_bound": {"const": "J_L<=N*B_L, B_L=11/16+(1/2)*log(R)"},
        "status": {"const": "EXACT_FOUR_DIMENSIONAL_GREEN_AND_SHIFTED_CONVOLUTION_BOUNDS"}
      },
      "additionalProperties": false
    },
    "pair_bounds": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/pair_bound"}
    },
    "power_sector_reduction": {
      "type": "object",
      "required": ["subpower_pairs", "pairs_still_capable_of_N_omega_p_scale", "consequence", "tuned_branch", "status"],
      "properties": {
        "subpower_pairs": {"const": [1, 2, 5]},
        "pairs_still_capable_of_N_omega_p_scale": {"const": [3, 4, 6, 7]},
        "consequence": {"type": "string"},
        "tuned_branch": {"type": "string"},
        "status": {"const": "THREE_PAIRS_REMOVED_FROM_POWER_COEFFICIENT_FOUR_PAIR_POWER_GATE_OPEN"}
      },
      "additionalProperties": false
    },
    "method_disposition": {
      "type": "object",
      "required": ["pair_1_uniform_bound", "pair_2_uniform_bound", "pair_5_uniform_bound", "pairs_1_2_5_tuned_g_four_uniformity", "pairs_1_2_5_contribution_to_N_omega_p_coefficient", "pair_3_scale", "pair_4_scale", "pair_6_scale", "pair_7_scale", "combined_pairs_3_4_6_7_power_coefficient", "complete_M4_large_volume_sign_and_scaling", "nonperturbative_annealed_score", "actual_interacting_h_minus_one_second_moment", "continuum_limit", "born_rule", "krein_reconstruction", "lorentzian_transfer"],
      "properties": {
        "pair_1_uniform_bound": {"const": "O_LOG_SQUARED"},
        "pair_2_uniform_bound": {"const": "O_LOG_SQUARED"},
        "pair_5_uniform_bound": {"const": "O_LOG_SQUARED"},
        "pairs_1_2_5_tuned_g_four_uniformity": {"const": "PROVED"},
        "pairs_1_2_5_contribution_to_N_omega_p_coefficient": {"const": "ZERO"},
        "pair_3_scale": {"const": "OPEN"},
        "pair_4_scale": {"const": "NEGATIVE_ORDER_L_SQUARED_MAGNITUDE_LOWER_BOUND"},
        "pair_6_scale": {"const": "OPEN"},
        "pair_7_scale": {"const": "POSITIVE_POWER_CAPABLE"},
        "combined_pairs_3_4_6_7_power_coefficient": {"const": "OPEN"},
        "complete_M4_large_volume_sign_and_scaling": {"const": "OPEN"},
        "nonperturbative_annealed_score": {"const": "OPEN"},
        "actual_interacting_h_minus_one_second_moment": {"const": "OPEN"},
        "continuum_limit": {"const": "NOT_ESTABLISHED"},
        "born_rule": {"const": "NOT_ESTABLISHED"},
        "krein_reconstruction": {"const": "NOT_ASSESSED"},
        "lorentzian_transfer": {"const": "NOT_ESTABLISHED"}
      },
      "additionalProperties": false
    },
    "checks": {"type": "object", "minProperties": 10, "additionalProperties": {"const": true}},
    "does_not_establish": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "missing_object_ledger": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["repository_base_commit", "inputs", "exact_arithmetic", "assumptions"],
      "properties": {
        "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "inputs": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/input"}},
        "exact_arithmetic": {"type": "string"},
        "assumptions": {"type": "array", "minItems": 3, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-complete-g4-subpower-pair-bounds-v1.schema.json"},
    "report": {"const": "reverse_physics/reports/bt-euclidean-complete-g4-subpower-pair-bounds.md"},
    "independent_verifier": {"const": "reverse_physics/verify_bt_euclidean_complete_g4_subpower_pair_bounds.py"},
    "verification_commands": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "form": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer"}},
    "kernel": {
      "type": "object",
      "required": ["degree", "arguments"],
      "properties": {
        "degree": {"enum": [3, 4, 5]},
        "arguments": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/form"}}
      },
      "additionalProperties": false
    },
    "representative": {
      "type": "object",
      "required": ["kernels", "propagators"],
      "properties": {
        "kernels": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/kernel"}},
        "propagators": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"$ref": "#/$defs/form"}}
      },
      "additionalProperties": false
    },
    "upstream": {
      "type": "object",
      "required": ["atlas_rows_one_based", "origin", "paired_coefficient", "representative"],
      "properties": {
        "atlas_rows_one_based": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1, "maximum": 14}},
        "origin": {"type": "string"},
        "paired_coefficient": {"$ref": "#/$defs/rational"},
        "representative": {"$ref": "#/$defs/representative"}
      },
      "additionalProperties": false
    },
    "pair_bound": {
      "type": "object",
      "required": ["pair", "upstream", "allocation", "raw_bound", "explicit_bound", "asymptotic_status"],
      "properties": {
        "pair": {"enum": [1, 2, 5]},
        "upstream": {"$ref": "#/$defs/upstream"},
        "allocation": {"type": "string"},
        "raw_bound": {"type": "string"},
        "explicit_bound": {"type": "string"},
        "asymptotic_status": {"const": "O_LOG_SQUARED_AND_little_o_N_omega_p"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    }
  }
}
