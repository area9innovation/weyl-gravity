{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-crossed-order-chamber-completion-v1.schema.json",
  "title": "BT crossed-order chamber completion certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate",
    "schema_version",
    "dependency_tags",
    "lifecycle_state",
    "result_kind",
    "question",
    "answer",
    "assumptions",
    "HP_gauge_theorem",
    "order_chamber_completion",
    "finite_exact_leakage_witness",
    "physical_transfer_gate",
    "disposition",
    "does_not_establish",
    "next_gate",
    "provenance",
    "verification_commands",
    "checks",
    "report",
    "schema"
  ],
  "properties": {
    "certificate": {
      "const": "REVERSE_PHYSICS_BT_CROSSED_ORDER_CHAMBER_COMPLETION_V1"
    },
    "schema_version": {
      "const": "reverse-physics-bt-crossed-order-chamber-completion-v1"
    },
    "dependency_tags": {
      "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]
    },
    "lifecycle_state": {"const": "CLASSIFIED"},
    "result_kind": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "HP_gauge_theorem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system_level",
        "noise_number",
        "gauge",
        "creation",
        "annihilation",
        "drift",
        "commutation",
        "gauge_deltas",
        "boundary"
      ],
      "properties": {
        "system_level": {"const": "L|h_k>=k|h_k>"},
        "noise_number": {"type": "string", "minLength": 1},
        "gauge": {"const": "Q_HP=N_F-L"},
        "creation": {"type": "string", "minLength": 1},
        "annihilation": {"type": "string", "minLength": 1},
        "drift": {"type": "string", "minLength": 1},
        "commutation": {
          "const": "[Q_HP,U_a]=0 on the finite-particle adapted core"
        },
        "gauge_deltas": {
          "const": {
            "creation_noise_change": 1,
            "creation_level_change": 1,
            "creation_Q_change": 0,
            "annihilation_noise_change": -1,
            "annihilation_level_change": -1,
            "annihilation_Q_change": 0,
            "drift_noise_change": 0,
            "drift_level_change": 0,
            "drift_Q_change": 0
          }
        },
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "order_chamber_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_chamber",
        "insertion_rule",
        "closure_recurrence",
        "history_counts",
        "chambers_per_history",
        "canonical_history_sheets",
        "completed_history_sheets",
        "missing_crossed_sheets",
        "species_resolved_completed_multiplicities",
        "canonical_total",
        "completed_total",
        "missing_crossed_total",
        "direct_canonical_input_leakage",
        "minimality"
      ],
      "properties": {
        "canonical_chamber": {"type": "string", "minLength": 1},
        "insertion_rule": {"type": "string", "minLength": 1},
        "closure_recurrence": {
          "const": "c_0=1 and c_(k+1)=(k+1)c_k, hence c_k=k!"
        },
        "history_counts": {"const": [1, 3, 12, 60]},
        "chambers_per_history": {"const": [1, 1, 2, 6]},
        "canonical_history_sheets": {"const": [1, 3, 12, 60]},
        "completed_history_sheets": {"const": [1, 3, 24, 360]},
        "missing_crossed_sheets": {"const": [0, 0, 12, 300]},
        "species_resolved_completed_multiplicities": {
          "const": [2, 6, 48, 720]
        },
        "canonical_total": {"const": 76},
        "completed_total": {"const": 388},
        "missing_crossed_total": {"const": 312},
        "direct_canonical_input_leakage": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_level",
              "target_level",
              "insertion_positions_per_child",
              "canonical_positions_per_child",
              "crossed_positions_per_child",
              "target_histories",
              "direct_crossed_sheets",
              "per_edge_leakage_rate"
            ],
            "properties": {
              "source_level": {"type": "integer", "minimum": 0, "maximum": 2},
              "target_level": {"type": "integer", "minimum": 1, "maximum": 3},
              "insertion_positions_per_child": {"type": "integer", "minimum": 1},
              "canonical_positions_per_child": {"const": 1},
              "crossed_positions_per_child": {"type": "integer", "minimum": 0},
              "target_histories": {"type": "integer", "minimum": 1},
              "direct_crossed_sheets": {"type": "integer", "minimum": 0},
              "per_edge_leakage_rate": {"$ref": "#/$defs/rational"}
            }
          }
        },
        "minimality": {"type": "string", "minLength": 1}
      }
    },
    "finite_exact_leakage_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "rate_q1",
        "coefficient_B",
        "skew_generator_K",
        "cayley_unitary",
        "reversed_chamber_probability",
        "meaning"
      ],
      "properties": {
        "basis": {
          "const": ["late_parent", "canonical_child", "reversed_child"]
        },
        "rate_q1": {
          "const": {"numerator": 5, "denominator": 64}
        },
        "coefficient_B": {"$ref": "#/$defs/string_matrix"},
        "skew_generator_K": {"$ref": "#/$defs/string_matrix"},
        "cayley_unitary": {"$ref": "#/$defs/string_matrix"},
        "reversed_chamber_probability": {
          "const": {"numerator": 1280, "denominator": 4761}
        },
        "meaning": {"type": "string", "minLength": 1}
      }
    },
    "physical_transfer_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "certified_map",
        "required_extension",
        "conditional_transfer",
        "first_missing_block",
        "higher_missing_block",
        "external_permutation_boundary",
        "spectator_boundary"
      ],
      "properties": {
        "certified_map": {"type": "string", "minLength": 1},
        "required_extension": {"type": "string", "minLength": 1},
        "conditional_transfer": {"type": "string", "minLength": 1},
        "first_missing_block": {
          "const": "the reversed two-time chamber of each of the 12 six-point histories"
        },
        "higher_missing_block": {
          "const": "the five noncanonical time-order chambers of each of the 60 seven-point histories"
        },
        "external_permutation_boundary": {"type": "string", "minLength": 1},
        "spectator_boundary": {"type": "string", "minLength": 1}
      }
    },
    "disposition": {
      "const": {
        "HP_number_level_gauge": "PROVED_ON_FINITE_PARTICLE_ADAPTED_CORE",
        "vacuum_chronological_carrier_two_sided_invariance": "EXACTLY_OBSTRUCTED",
        "minimal_no_spectator_path_reducing_closure": "CLASSIFIED_AS_ALL_FACTORIAL_ORDER_CHAMBERS",
        "canonical_physical_history_sheets": 76,
        "required_chamber_complete_history_sheets": 388,
        "missing_crossed_physical_sheets": 312,
        "crossed_six_and_seven_point_intertwiners": "NOT_CONSTRUCTED",
        "arbitrary_incoming_spectator_sectors": "NOT_CONSTRUCTED",
        "two_sided_reduced_mode_physical_operator": "NOT_CONSTRUCTED",
        "spacetime_Moller_LSZ_S_operator": "NOT_CONSTRUCTED",
        "complete_BT_probability": "NOT_CONSTRUCTED",
        "Eq19_all_orders": "NOT_PROVED"
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 13,
      "items": {"type": "string", "minLength": 1}
    },
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs"],
      "properties": {
        "source_commit": {
          "const": "63f24352be5e68773982d772fa3acbe20ef839aa"
        },
        "retrieval_date": {"const": "2026-08-12"},
        "inputs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 28},
        "total": {"const": 28},
        "failures": {"const": []},
        "details": {
          "type": "object",
          "minProperties": 28,
          "maxProperties": 28,
          "additionalProperties": {"const": true}
        }
      }
    },
    "report": {
      "const": "reverse_physics/reports/bt-crossed-order-chamber-completion.md"
    },
    "schema": {
      "const": "reverse_physics/schema/reverse-physics-bt-crossed-order-chamber-completion-v1.schema.json"
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "string_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    }
  }
}
