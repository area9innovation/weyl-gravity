        "surviving_hermitian_classes": {"const": ["(2,6)", "(4,4)"]},
        "recorded_coefficient": {"const": "q8[I2]=2*Re<X2,X6>+||X4||^2"},
        "coherent_coefficient": {"const": "q8[E_epsilon]=2*Re<X2,E_epsilon X6>+<X4,E_epsilon X4>"},
