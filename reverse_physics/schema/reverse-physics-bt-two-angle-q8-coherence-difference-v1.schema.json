      "properties": {
        "epsilon": {"const": "2/5"},
        "X2": {"const": "(2/3-i/5)*(1,1)"},
        "X4": {"const": ["1+2*i", "-3+i"]},
        "X6": {"const": ["7/4-2*i/3", "-5/6+9*i/7"]},
