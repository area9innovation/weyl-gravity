    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "ok", "failures", "details"],
      "properties": {
        "total": {"type": "integer", "minimum": 24},
        "passed": {"type": "integer", "minimum": 24},
        "ok": {"const": true},
        "failures": {"const": []},
        "details": {"type": "object", "minProperties": 24, "additionalProperties": {"const": true}}
      }
    },
    "verification_commands": {
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": {"$ref": "#/$defs/text"}
    },
    "report": {"const": "reverse_physics/reports/bt-two-angle-q8-coherence-difference.md"}
