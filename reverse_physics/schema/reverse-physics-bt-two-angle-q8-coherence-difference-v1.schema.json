    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs", "generated_by", "independent_verifier", "method"],
      "properties": {
        "source_commit": {"const": "6c11450e1411f5d61b27422ed290d6d894d24491"},
        "retrieval_date": {"const": "2026-08-12"},
        "inputs": {
          "type": "array", "minItems": 6, "maxItems": 6,
