    "complete_q8_ledger": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_output", "odd_block_rule", "ordered_coefficient_pairs", "vanishing_pairs", "surviving_hermitian_classes", "recorded_coefficient", "coherent_coefficient", "status"],
      "properties": {
        "selected_output": {"const": "X(lambda)=lambda^2*X2+lambda^4*X4+lambda^6*X6+O(lambda^8)"},
        "odd_block_rule": {"$ref": "#/$defs/text"},
        "ordered_coefficient_pairs": {"const": ["(2,6)", "(3,5)", "(4,4)", "(5,3)", "(6,2)"]},
