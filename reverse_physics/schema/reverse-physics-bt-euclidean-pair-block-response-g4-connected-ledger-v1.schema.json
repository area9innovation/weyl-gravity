    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-pair-block-response-g4-connected-ledger-v1.schema.json"},
    "verifier": {"const": "reverse_physics/verify_bt_euclidean_pair_block_response_g4_connected_ledger.py"}
