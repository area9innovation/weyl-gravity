        "outgoing_phase_factor_at_fixture": {"const": "rho_out=3/[320*(2*pi)^5] per da*db*du*dv"},
        "incoming_and_detector_factor": {"$ref": "#/$defs/text"}, "dimensionless_local_cell_probability": {"$ref": "#/$defs/text"},
        "status": {"const": "HAMILTONIAN_PART_FIXED_INCOMING_PROJECTOR_NORMALIZATION_OPEN"}
      }
