      "properties": {
        "lambda_mass_dimension": {"const": 0}, "T_over_E_mass_dimension": {"const": -2},
        "outgoing_shell_density_mass_dimension": {"const": 0}, "phase_weighted_coefficient_mass_dimension": {"const": -2},
        "required_incoming_projector_cell_weight_mass_dimension": {"const": 2},
        "two_particle_public_example": {"$ref": "#/$defs/text"},
        "three_particle_public_status": {"const": "NO_INCOMING_CHARACTERISTIC_CELL_OR_3_TO_3_FLUX_NORMALIZATION_SPECIFIED"},
        "consequence": {"$ref": "#/$defs/text"}
      }
