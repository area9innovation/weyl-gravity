        "log2_exponents": {"$ref": "#/$defs/intVector6"},
        "reciprocal_integer_weights": {"$ref": "#/$defs/positiveIntVector6"},
        "reciprocal_marginal": {"$ref": "#/$defs/fractionVector6"},
        "phase_cosine": {"$ref": "#/$defs/fractionVector6"},
