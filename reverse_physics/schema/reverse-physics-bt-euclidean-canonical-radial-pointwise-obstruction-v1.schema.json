    "intVector4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
    "intVector6": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "integer"}},
    "positiveIntVector4": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer", "minimum": 1}},
    "positiveIntVector6": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "integer", "minimum": 1}}
