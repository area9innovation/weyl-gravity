      "properties": {
        "inputs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string"}
    },
    "checks": {
      "type": "object",
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 42},
        "total": {"const": 42},
        "failures": {"const": []}
      }
    },
    "report": {
      "const": "reverse_physics/reports/bt-six-point-profile-quotient-completion.md"
    },
    "schema": {
      "const": "reverse_physics/schema/reverse-physics-bt-six-point-profile-quotient-completion-v1.schema.json"
