    "assumptions": {
      "type": "array",
      "minItems": 5,
      "items": {"type": "string"}
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 12,
      "items": {"type": "string"}
    },
    "missing_object_ledger": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string"}
    },
