    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs", "generated_by", "independent_verifier", "method"],
      "properties": {
        "source_commit": {"const": "8bc67f0c45b8a86afdabf2a15b2cb15cc36bef87"},
        "retrieval_date": {"const": "2026-08-12"},
        "inputs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}}},
        "generated_by": {"const": "reverse_physics/bt_nine_cylinder_recorded_q6_instrument.py"},
        "independent_verifier": {"const": "reverse_physics/verify_bt_nine_cylinder_recorded_q6_instrument.py"},
        "method": {"$ref": "#/$defs/text"}
      }
