      "required": ["representative_three_masks", "rule", "by_cylinder", "source_reference", "status"],
      "properties": {
        "representative_three_masks": {"const": [7, 11, 13, 14, 19, 21, 22, 25, 26, 28]},
        "rule": {"$ref": "#/$defs/text"},
        "by_cylinder": {
          "type": "object", "minProperties": 9, "maxProperties": 9,
          "additionalProperties": {
            "type": "object", "additionalProperties": false,
            "required": ["tag_labels", "weight_five_masks", "weight_six_masks", "weight_five_count", "weight_six_count"],
            "properties": {
              "tag_labels": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 0, "maximum": 5}},
              "weight_five_masks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "integer"}},
              "weight_six_masks": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "integer"}},
              "weight_five_count": {"const": 6},
              "weight_six_count": {"const": 4}
            }
          }
        },
        "source_reference": {"$ref": "#/$defs/text"},
        "status": {"const": "ALL_NINE_TEN_CHANNEL_INCIDENCE_SPLITS_RECOMPUTED"}
      }
    },
    "record_algebra": {
      "type": "object", "additionalProperties": false,
      "required": ["ordered_sectors", "dimension", "effects", "orthogonality", "completeness", "group_average", "record_policy", "status"],
      "properties": {
        "ordered_sectors": {"const": ["bulk", "Delta_00", "Delta_01", "Delta_02", "Delta_10", "Delta_11", "Delta_12", "Delta_20", "Delta_21", "Delta_22"]},
        "dimension": {"const": 10},
        "effects": {"$ref": "#/$defs/text"},
        "orthogonality": {"$ref": "#/$defs/text"},
        "completeness": {"$ref": "#/$defs/text"},
        "group_average": {"$ref": "#/$defs/text"},
        "record_policy": {"$ref": "#/$defs/text"},
        "status": {"const": "EXACT_TEN_SECTOR_RECORDED_DIRECT_SUM"}
      }
    },
