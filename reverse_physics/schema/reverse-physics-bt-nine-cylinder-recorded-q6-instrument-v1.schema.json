    "permutation_orbit": {
      "type": "object", "additionalProperties": false,
      "required": ["group", "group_order", "action", "reference", "orbit", "orbit_size", "stabilizer_order", "orbit_stabilizer_product", "status"],
      "properties": {
        "group": {"const": "S3_in x S3_out"},
        "group_order": {"const": 36},
        "action": {"$ref": "#/$defs/text"},
        "reference": {"const": "Delta_00"},
        "orbit": {"const": ["Delta_00", "Delta_01", "Delta_02", "Delta_10", "Delta_11", "Delta_12", "Delta_20", "Delta_21", "Delta_22"]},
        "orbit_size": {"const": 9},
        "stabilizer_order": {"const": 4},
        "orbit_stabilizer_product": {"const": 36},
        "status": {"const": "ONE_TRANSITIVE_NINE_CYLINDER_ORBIT_PLUS_ONE_FIXED_BULK_SECTOR"}
