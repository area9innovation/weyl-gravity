      "type": "object", "additionalProperties": false,
      "required": ["state", "trace", "record_weights", "cylinder_union_weight", "bulk_weight", "group_invariance", "status"],
      "properties": {
        "state": {"const": "rho=I_10/10"},
        "trace": {"$ref": "#/$defs/one"},
        "record_weights": {"type": "object", "minProperties": 10, "maxProperties": 10, "additionalProperties": {"$ref": "#/$defs/tenth"}},
        "cylinder_union_weight": {"$ref": "#/$defs/nine_tenths"},
        "bulk_weight": {"$ref": "#/$defs/tenth"},
        "group_invariance": {"$ref": "#/$defs/text"},
        "status": {"const": "POSITIVE_NORMALIZED_GROUP_INVARIANT_MIXED_PREPARATION"}
      }
    },
    "probability_through_lambda6": {
      "type": "object", "additionalProperties": false,
      "required": ["selected_cylinder_probability", "leading_term", "relative_q6_coefficient", "each_cylinder_outcome", "bulk_outcome", "recorded_total", "order_completeness", "small_coupling_positivity", "status"],
      "properties": {
        "selected_cylinder_probability": {"const": "q_tag[f;T]=q4*{1+lambda^2*R6[f;T,mu]}+O(lambda^8)"},
        "leading_term": {"const": "q4=75*lambda^4*DeltaOmega/(2048*pi^2*kappa^2*Area)"},
        "relative_q6_coefficient": {"$ref": "#/$defs/text"},
        "each_cylinder_outcome": {"const": "q_ia=(1/10)*q4*{1+lambda^2*R6[f;T,mu]}+O(lambda^8)"},
        "bulk_outcome": {"const": "q_bulk=O(lambda^8)"},
        "recorded_total": {"const": "q_recorded=(9/10)*q4*{1+lambda^2*R6[f;T,mu]}+O(lambda^8)"},
        "order_completeness": {"$ref": "#/$defs/text"},
        "small_coupling_positivity": {"$ref": "#/$defs/text"},
        "status": {"const": "COMPLETE_SELECTED_ORBIT_RECORDED_PROBABILITY_THROUGH_LAMBDA6"}
      }
    },
    "disposition": {"type": "object", "minProperties": 10, "maxProperties": 10, "additionalProperties": {"$ref": "#/$defs/text"}},
    "missing_object_ledger": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["object", "status", "required_value"], "properties": {"object": {"$ref": "#/$defs/text"}, "status": {"const": "MISSING"}, "required_value": {"$ref": "#/$defs/text"}}}},
    "does_not_establish": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/text"}},
    "next_gate": {"$ref": "#/$defs/text"},
    "checks": {"type": "object", "additionalProperties": false, "required": ["total", "passed", "ok", "failures", "details"], "properties": {"total": {"type": "integer", "minimum": 30}, "passed": {"type": "integer", "minimum": 30}, "ok": {"const": true}, "failures": {"const": []}, "details": {"type": "object", "minProperties": 30, "additionalProperties": {"const": true}}}},
    "verification_commands": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/text"}},
    "report": {"const": "reverse_physics/reports/bt-nine-cylinder-recorded-q6-instrument.md"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "one": {"const": {"numerator": 1, "denominator": 1}},
    "tenth": {"const": {"numerator": 1, "denominator": 10}},
    "nine_tenths": {"const": {"numerator": 9, "denominator": 10}}
  }
