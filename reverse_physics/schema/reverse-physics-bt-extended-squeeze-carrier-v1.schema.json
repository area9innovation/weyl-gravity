      "properties": {
        "ansatz": {"$ref": "#/$defs/nonempty"},
        "square_sum_radial_integrand": {"const": "p^(2alpha-2)"},
        "square_sum_condition": {"const": "alpha>1/2"},
        "modewise_contraction_condition": {"const": "alpha>2, or alpha=2 with limiting coefficient below four"},
        "combined_condition": {"$ref": "#/$defs/nonempty"},
        "uniform_equivalence": {"$ref": "#/$defs/nonempty"}
      },
      "additionalProperties": false
    },
