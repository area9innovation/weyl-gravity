      "properties": {
        "uniform_equivalence": {"const": "0<m<=rho(p)<=M<infinity"},
        "lowest_momentum": {"const": "p_min=2pi/L"},
        "lowest_pair_amplitude_bound": {"const": "|z(p_min)|>=m L^2/(16pi^2)"},
        "contraction_failure_threshold": {"const": "L>=4pi/sqrt(m)"},
