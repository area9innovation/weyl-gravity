    "positive_adjoint_audit": {
      "type": "object",
      "required": ["normalized_cross_modes", "BT_generator", "Hilbert_adjoint", "raw_positive_Bogoliubov_fixture", "normalized_positive_repair_fixture", "conclusion", "repair_cost"],
