              "closed_partial_norm": {"$ref": "#/$defs/fraction"},
              "agree": {"const": true}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "ordinary_topology_obstruction": {
      "type": "object",
