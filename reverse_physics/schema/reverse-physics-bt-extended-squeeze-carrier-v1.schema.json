      "properties": {
        "ordered_creation_coefficient": {"const": {"numerator": 1, "denominator": 8}},
        "unordered_creation_coefficient": {"const": {"numerator": 1, "denominator": 4}},
        "positive_normalized_creator": {"$ref": "#/$defs/nonempty"},
        "pair_amplitude": {"const": "z(p)=rho(p)/(4p^2)"},
        "single_pair_state": {"$ref": "#/$defs/nonempty"},
        "single_pair_norm_squared": {"$ref": "#/$defs/nonempty"},
        "full_norm_squared": {"$ref": "#/$defs/nonempty"},
        "existence_conditions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/nonempty"}},
        "factorial_witnesses": {
          "type": "array", "minItems": 9, "maxItems": 9,
          "items": {
            "type": "object",
            "required": ["n", "exponential_denominator", "two_mode_creation_norm_factor", "normalized_basis_amplitude_factor"],
            "properties": {
              "n": {"type": "integer", "minimum": 0, "maximum": 8},
              "exponential_denominator": {"type": "integer", "minimum": 1},
              "two_mode_creation_norm_factor": {"type": "integer", "minimum": 1},
              "normalized_basis_amplitude_factor": {"const": {"numerator": 1, "denominator": 1}}
            },
            "additionalProperties": false
          }
        },
        "geometric_witnesses": {
          "type": "array", "minItems": 5, "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["z", "cutoff", "direct_partial_norm", "closed_partial_norm", "agree"],
            "properties": {
              "z": {"const": {"numerator": 1, "denominator": 2}},
