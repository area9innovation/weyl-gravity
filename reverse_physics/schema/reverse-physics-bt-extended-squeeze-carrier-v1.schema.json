      "properties": {
        "parameters": {"const": "mu>0 and 0<gamma<1"},
        "rho_mu": {"const": "4 gamma mu^2 p^2/(p^2+mu^2)"},
        "pair_amplitude": {"const": "z_mu(p)=gamma mu^2/(p^2+mu^2)"},
