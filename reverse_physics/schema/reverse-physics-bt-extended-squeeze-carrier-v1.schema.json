        "normalized_cross_modes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/nonempty"}},
        "BT_generator": {"$ref": "#/$defs/nonempty"},
        "Hilbert_adjoint": {"$ref": "#/$defs/nonempty"},
        "raw_positive_Bogoliubov_fixture": {
          "type": "object", "required": ["z", "u_squared", "v_squared", "u_squared_minus_v_squared", "required"],
          "properties": {
            "z": {"const": {"numerator": 1, "denominator": 2}},
            "u_squared": {"const": {"numerator": 1, "denominator": 1}},
            "v_squared": {"const": {"numerator": 1, "denominator": 4}},
            "u_squared_minus_v_squared": {"const": {"numerator": 3, "denominator": 4}},
            "required": {"const": {"numerator": 1, "denominator": 1}}
          }, "additionalProperties": false
        },
        "normalized_positive_repair_fixture": {
          "type": "object", "required": ["z_ratio", "u_squared", "v_squared", "u_squared_minus_v_squared"],
          "properties": {
            "z_ratio": {"const": {"numerator": 1, "denominator": 2}},
            "u_squared": {"const": {"numerator": 4, "denominator": 3}},
            "v_squared": {"const": {"numerator": 1, "denominator": 3}},
            "u_squared_minus_v_squared": {"const": {"numerator": 1, "denominator": 1}}
          }, "additionalProperties": false
        },
        "conclusion": {"const": "BT_CROSS_KREIN_SHEAR_IS_NOT_A_POSITIVE_HILBERT_BOGOLIUBOV_TRANSFORMATION"},
        "repair_cost": {"$ref": "#/$defs/nonempty"}
      },
      "additionalProperties": false
