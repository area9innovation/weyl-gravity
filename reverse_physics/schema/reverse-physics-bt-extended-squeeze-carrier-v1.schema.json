        "unordered_square_sum_density": {"const": "gamma^2 mu^3/(16pi)"},
        "density_coefficient_times_pi_inverse": {"const": {"numerator": 1, "denominator": 16}},
        "integral_identity": {"const": "integral_0^infinity x^2/(1+x^2)^2 dx=pi/4"},
        "log_norm_density_bounds": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/nonempty"}},
        "exact_gamma_half_fixtures": {
          "type": "array", "minItems": 5, "maxItems": 5,
