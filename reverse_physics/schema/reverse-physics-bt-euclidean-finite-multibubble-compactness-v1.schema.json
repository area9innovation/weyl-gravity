{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-finite-multibubble-compactness-v1.schema.json",
  "title": "BT finite multibubble compactness certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate", "schema_version", "created", "dependency_tags", "lifecycle_state",
    "result_kind", "question", "answer", "general_class", "crystal_fixture",
    "zero_endpoint", "finite_and_weak_endpoints", "method_disposition",
    "missing_object_ledger", "next_gate", "does_not_establish", "provenance",
    "verification_commands", "tier_receipt", "checks", "report", "schema", "verifier"
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "textArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}
  },
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_FINITE_MULTIBUBBLE_COMPACTNESS_V1"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-finite-multibubble-compactness-v1"},
    "created": {"const": "2026-08-15"},
    "dependency_tags": {
      "type": "array",
      "prefixItems": [
        {"const": "LOCAL-ALGEBRAIC"},
        {"const": "EUCLIDEAN-SPECTRAL"},
        {"const": "REDUCED-MODE"}
      ],
      "items": false
    },
    "lifecycle_state": {"const": "CLASSIFIED"},
    "result_kind": {"$ref": "#/$defs/text"},
    "question": {"$ref": "#/$defs/text"},
    "answer": {"$ref": "#/$defs/text"},
    "general_class": {
      "type": "object", "additionalProperties": false,
      "required": ["torus", "denominator_conditions", "family", "quotient", "theorem", "constant_status"],
      "properties": {
        "torus": {"const": "(R/(2*pi*Z))^4"},
        "denominator_conditions": {"$ref": "#/$defs/text"},
        "family": {"const": "Omega_m=1/(m+F), m>0"},
        "quotient": {"const": "Q_F(m)=||E_m||_2^2/||R_m||_2^2"},
        "theorem": {"const": "for every fixed admissible F there exists c_F>0 with Q_F(m)>=c_F for all m>0"},
        "constant_status": {"const": "EXISTS_NOT_COMPUTED"}
      }
    },
    "crystal_fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["denominator", "positivity_factor", "zero_set", "zero_count", "local_jet", "nonzero_fixture"],
      "properties": {
        "denominator": {"const": "F_16=sum_mu[sin(x_mu)^2+(1/3)*sin(x_mu)^4]"},
        "positivity_factor": {"$ref": "#/$defs/text"},
        "zero_set": {"const": "{0,pi}^4"},
        "zero_count": {"const": 16},
        "local_jet": {"$ref": "#/$defs/text"},
        "nonzero_fixture": {
          "type": "object", "additionalProperties": false,
          "required": ["point", "F_16", "Delta_F_16", "gradient_norm_squared", "q_0"],
          "properties": {
            "point": {"const": "(pi/2,0,0,0)"},
            "F_16": {"$ref": "#/$defs/fraction"},
            "Delta_F_16": {"$ref": "#/$defs/fraction"},
            "gradient_norm_squared": {"$ref": "#/$defs/fraction"},
            "q_0": {"$ref": "#/$defs/fraction"}
          }
        }
      }
    },
    "zero_endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["local_fields", "strong_limit", "residual_limit_general", "crystal_concentration", "nonvanishing_argument", "status"],
      "properties": {
        "local_fields": {"$ref": "#/$defs/text"},
        "strong_limit": {"$ref": "#/$defs/text"},
        "residual_limit_general": {"$ref": "#/$defs/text"},
        "crystal_concentration": {"const": "(512/3)*pi^2"},
        "nonvanishing_argument": {"$ref": "#/$defs/text"},
        "status": {"const": "POSITIVE_FINITE_LIMIT_PROVED"}
      }
    },
    "finite_and_weak_endpoints": {
      "type": "object", "additionalProperties": false,
      "required": ["interior", "weak_linearization", "crystal_weak_limit", "crystal_weak_value", "compactification"],
      "properties": {
        "interior": {"$ref": "#/$defs/text"},
        "weak_linearization": {"$ref": "#/$defs/text"},
        "crystal_weak_limit": {"const": "Q_F16(infinity)=512/17"},
        "crystal_weak_value": {"$ref": "#/$defs/fraction"},
        "compactification": {"$ref": "#/$defs/text"}
      }
    },
    "method_disposition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "single_repaired_bubble_collapse", "fixed_finite_repaired_multibubble_collapse",
        "sixteen_bubble_crystal_collapse", "growing_number_bubble_gas",
        "bubble_towers_necks_and_nonspherical_profiles", "positive_all_field_gradient_bound",
        "volume_uniform_witten_coercivity", "interacting_h_minus_one_bound",
        "continuum_reconstruction", "born_rule", "krein_reconstruction", "lorentzian_transfer"
      ],
      "properties": {
        "single_repaired_bubble_collapse": {"const": "RULED_OUT_BY_PREDECESSOR"},
        "fixed_finite_repaired_multibubble_collapse": {"const": "RULED_OUT"},
        "sixteen_bubble_crystal_collapse": {"const": "RULED_OUT"},
        "growing_number_bubble_gas": {"const": "OPEN"},
        "bubble_towers_necks_and_nonspherical_profiles": {"const": "OPEN"},
        "positive_all_field_gradient_bound": {"const": "OPEN"},
        "volume_uniform_witten_coercivity": {"const": "OPEN"},
        "interacting_h_minus_one_bound": {"const": "OPEN"},
        "continuum_reconstruction": {"const": "NOT_ESTABLISHED"},
        "born_rule": {"const": "NOT_ESTABLISHED"},
        "krein_reconstruction": {"const": "NOT_ASSESSED"},
        "lorentzian_transfer": {"const": "NOT_ESTABLISHED"}
      }
    },
    "missing_object_ledger": {"$ref": "#/$defs/textArray"},
    "next_gate": {"$ref": "#/$defs/text"},
    "does_not_establish": {"$ref": "#/$defs/textArray"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_base_commit", "inputs", "arithmetic"],
      "properties": {
        "repository_base_commit": {"const": "3fa9c8cc37040960afbc5f6de7a0260389c2bd66"},
        "inputs": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/text"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "arithmetic": {"$ref": "#/$defs/text"}
      }
    },
    "verification_commands": {"$ref": "#/$defs/textArray"},
    "tier_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["tier_0", "tier_1", "tier_2", "tier_3", "memory_policy", "elapsed_seconds_and_peak_kib", "repository_audits"],
      "properties": {
        "tier_0": {"$ref": "#/$defs/text"},
        "tier_1": {"$ref": "#/$defs/text"},
        "tier_2": {"$ref": "#/$defs/text"},
        "tier_3": {"$ref": "#/$defs/text"},
        "memory_policy": {"$ref": "#/$defs/text"},
        "elapsed_seconds_and_peak_kib": {
          "type": "object", "additionalProperties": false,
          "required": ["producer_check", "independent_verifier", "unit_tests"],
          "properties": {
            "producer_check": {"$ref": "#/$defs/text"},
            "independent_verifier": {"$ref": "#/$defs/text"},
            "unit_tests": {"$ref": "#/$defs/text"}
          }
        },
        "repository_audits": {
          "type": "object", "additionalProperties": false,
          "required": ["planning_conformance", "science_forge_shadow"],
          "properties": {
            "planning_conformance": {"$ref": "#/$defs/text"},
            "science_forge_shadow": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failures": {"type": "array", "maxItems": 0},
        "details": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}}
      }
    },
    "report": {"const": "reverse_physics/reports/bt-euclidean-finite-multibubble-compactness.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-finite-multibubble-compactness-v1.schema.json"},
    "verifier": {"const": "reverse_physics/verify_bt_euclidean_finite_multibubble_compactness.py"}
  }
}
