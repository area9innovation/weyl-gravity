{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-physical-shell-pseudounitary-completion-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["certificate", "schema_version", "dependency_tags", "lifecycle_state", "result_kind", "question", "answer", "assumptions", "universal_theorem", "exact_witness", "response_ledger", "disposition", "does_not_establish", "next_gate", "provenance", "verification_commands", "checks", "report", "schema"],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_PHYSICAL_SHELL_PSEUDOUNITARY_COMPLETION_V1"},
    "schema_version": {"const": "reverse-physics-bt-physical-shell-pseudounitary-completion-v1"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "lifecycle_state": {"const": "CLASSIFIED"},
    "result_kind": {"type": "string", "minLength": 100},
    "question": {"type": "string", "minLength": 220},
    "answer": {"type": "string", "minLength": 900},
    "assumptions": {
      "const": {
        "shell_parameter": "x=lambda*sqrt(log(c))/pi with c>1 and x^2=eta",
        "carrier": "positive four-channel generalized-Born quotient (hard,pair_12,pair_13,pair_23)",
        "physical_operator": "S_phys(x), not R_t P R_t^dagger",
        "pseudo_unitarity": "S_phys(x)^dagger S_phys(x)=1 through x^2",
        "real_input": "the physical five-point shell column has squared norm 1/48 per pair"
      }
    },
    "universal_theorem": {
      "const": {
        "order_x": "A^dagger+A=0",
        "order_x2": "B^dagger+B+A^dagger*A=0",
        "hard_diagonal_identity": "2 Re(B_hh)=-<Ah,Ah>=-1/16",
        "phase_independence": "only sum_i |A_ih|^2 enters",
        "second_order_freedom": "B -> B+C with C^dagger=-C does not change 2 Re(B_hh)"
      }
    },
    "exact_witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "coefficient_field", "per_pair_amplitude", "A", "B_equals_A2_over_2", "all_order_form"],
      "properties": {
        "basis": {"const": ["hard", "pair_12", "pair_13", "pair_23"]},
        "coefficient_field": {"const": "Q(sqrt(3))"},
        "per_pair_amplitude": {"const": {"rational": {"denominator": 1, "numerator": 0}, "sqrt3": {"denominator": 12, "numerator": 1}}},
        "A": {"type": "array", "minItems": 6, "maxItems": 6},
        "B_equals_A2_over_2": {"type": "array", "minItems": 10, "maxItems": 10},
        "all_order_form": {"const": "S_witness(x)=exp(x*A)"}
      }
    },
    "response_ledger": {
      "const": {
        "Born_coefficient_without_common_factors": {"denominator": 32, "numerator": 3},
        "real_per_pair_Born_normalized": {"denominator": 48, "numerator": 1},
        "real_total_Born_normalized": {"denominator": 16, "numerator": 1},
        "forced_hard_amplitude_real_part": {"denominator": 32, "numerator": -1},
        "forced_hard_survival_Born_normalized": {"denominator": 16, "numerator": -1},
        "forced_hard_absolute": {"denominator": 512, "numerator": -3},
        "real_absolute": {"denominator": 512, "numerator": 3},
        "inclusive_log_response": {"denominator": 1, "numerator": 0}
      }
    },
    "disposition": {
      "const": {
        "hard_response_under_physical_shell_pseudounitarity": "FORCED_MINUS_3_OVER_512",
        "finite_physical_shell_isometric_witness": "CONSTRUCTED",
        "coefficient_fitting": "NOT_USED",
        "continuum_dressed_physical_S_matrix": "NOT_CONSTRUCTED",
        "physical_inclusive_NLO_log_cancellation": "CONDITIONAL_ON_DRESSED_S_EXISTENCE",
        "complete_finite_NLO_constant": "NOT_COMPUTED",
        "beyond_tree_positivity": "NOT_ESTABLISHED",
        "Eq19_all_orders": "NOT_PROVED"
      }
    },
    "does_not_establish": {"type": "array", "minItems": 10, "maxItems": 10},
    "next_gate": {"type": "string", "minLength": 280},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs"],
      "properties": {
        "source_commit": {"const": "db36ed11"},
        "retrieval_date": {"const": "2026-08-11"},
        "inputs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}
          }
        }
      }
    },
    "verification_commands": {"type": "array", "minItems": 3, "maxItems": 3},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 16},
        "total": {"const": 16},
        "failures": {"const": []},
        "details": {"type": "object", "minProperties": 16, "maxProperties": 16}
      }
    },
    "report": {"const": "reverse_physics/reports/bt-physical-shell-pseudounitary-completion.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-physical-shell-pseudounitary-completion-v1.schema.json"}
  }
}
