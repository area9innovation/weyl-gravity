{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-periodic-bubble-jet-gate-v1.schema.json",
  "title": "BT periodic bubble jet gate certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate", "schema_version", "created", "dependency_tags",
    "lifecycle_state", "result_kind", "question", "answer",
    "radial_denominator_identity", "naive_chord_obstruction",
    "fourth_order_local_repair", "weak_field_endpoint", "method_disposition",
    "missing_object_ledger", "next_gate", "does_not_establish", "provenance",
    "verification_commands", "tier_receipt", "checks", "report", "schema", "verifier"
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    }
  },
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_PERIODIC_BUBBLE_JET_GATE_V1"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-periodic-bubble-jet-gate-v1"},
    "created": {"const": "2026-08-15"},
    "dependency_tags": {
      "type": "array",
      "prefixItems": [
        {"const": "LOCAL-ALGEBRAIC"},
        {"const": "EUCLIDEAN-SPECTRAL"},
        {"const": "REDUCED-MODE"}
      ],
      "items": false
    },
    "lifecycle_state": {"const": "CLASSIFIED"},
    "result_kind": {"$ref": "#/$defs/text"},
    "question": {"$ref": "#/$defs/text"},
    "answer": {"$ref": "#/$defs/text"},
    "radial_denominator_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["ansatz", "definitions", "weighted_scalar", "residual", "euler_gradient", "homogeneous_defect_rule", "euler_defect_rule"],
      "properties": {
        "ansatz": {"const": "Omega_m=1/h_m, h_m=m+F, m>0"},
        "definitions": {"$ref": "#/$defs/text"},
        "weighted_scalar": {"const": "q=-h_m*D+2*G"},
        "residual": {"const": "R=q/h_m^2"},
        "euler_gradient": {"const": "E=div(h_m^(-2)*grad q)"},
        "homogeneous_defect_rule": {"$ref": "#/$defs/text"},
        "euler_defect_rule": {"$ref": "#/$defs/text"}
      }
    },
    "naive_chord_obstruction": {
      "type": "object", "additionalProperties": false,
      "required": ["torus", "denominator", "local_expansion", "quartic_profile", "weighted_scalar_defect", "harmonicity", "euler_singular_term", "sphere_moments", "gradient_asymptotic", "residual_behavior", "quotient_conclusion", "status"],
      "properties": {
        "torus": {"const": "(R/(2*pi*Z))^4"},
        "denominator": {"const": "F_2(x)=2*sum_{mu=1}^4(1-cos x_mu)"},
        "local_expansion": {"$ref": "#/$defs/text"},
        "quartic_profile": {"$ref": "#/$defs/text"},
        "weighted_scalar_defect": {"const": "Q_4=|x|^4-2*sum_mu x_mu^4"},
        "harmonicity": {"const": "Delta Q_4=0"},
        "euler_singular_term": {"$ref": "#/$defs/text"},
        "sphere_moments": {
          "type": "object", "additionalProperties": false,
          "required": ["average_omega_1_fourth", "average_omega_1_eighth", "average_omega_1_fourth_omega_2_fourth", "average_Q_4_squared", "integral_S3_Q_4_squared"],
          "properties": {
            "average_omega_1_fourth": {"$ref": "#/$defs/fraction"},
            "average_omega_1_eighth": {"$ref": "#/$defs/fraction"},
            "average_omega_1_fourth_omega_2_fourth": {"$ref": "#/$defs/fraction"},
            "average_Q_4_squared": {"$ref": "#/$defs/fraction"},
            "integral_S3_Q_4_squared": {"const": "pi^2/5"}
          }
        },
        "gradient_asymptotic": {"const": "||E_m||_2^2=(128*pi^2/5)*log(1/m)+O(1)"},
        "residual_behavior": {"$ref": "#/$defs/text"},
        "quotient_conclusion": {"const": "||E_m||_2^2/||R_m||_2^2 tends to infinity"},
        "status": {"const": "OBSTRUCTED"}
      }
    },
    "fourth_order_local_repair": {
      "type": "object", "additionalProperties": false,
      "required": ["denominator", "positivity_identity", "local_expansion", "quartic_defect", "sixth_profile", "weighted_scalar_defect", "local_integrability", "what_is_repaired", "what_remains", "status"],
      "properties": {
        "denominator": {"$ref": "#/$defs/text"},
        "positivity_identity": {"const": "one-coordinate term=(1/3)*(1-cos x)*(7-cos x)>0 for x not congruent to zero"},
        "local_expansion": {"$ref": "#/$defs/text"},
        "quartic_defect": {"const": "P_4=0"},
        "sixth_profile": {"const": "P_6=-(1/90)*sum_mu x_mu^6"},
        "weighted_scalar_defect": {"const": "Q_6=(1/3)*|x|^2*sum_mu x_mu^4-(4/9)*sum_mu x_mu^6"},
        "local_integrability": {"$ref": "#/$defs/text"},
        "what_is_repaired": {"$ref": "#/$defs/text"},
        "what_remains": {"$ref": "#/$defs/text"},
        "status": {"const": "LOCAL_REPAIR_PROVED"}
      }
    },
    "weak_field_endpoint": {
      "type": "object", "additionalProperties": false,
      "required": ["regime", "linearized_residual", "linearized_gradient", "exact_fourier_quotient", "value", "interpretation"],
      "properties": {
        "regime": {"$ref": "#/$defs/text"},
        "linearized_residual": {"$ref": "#/$defs/text"},
        "linearized_gradient": {"$ref": "#/$defs/text"},
        "exact_fourier_quotient": {"const": "lim ||E_m||_2^2/||R_m||_2^2=32/17"},
        "value": {"$ref": "#/$defs/fraction"},
        "interpretation": {"$ref": "#/$defs/text"}
      }
    },
    "method_disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["naive_chord_periodic_bubble", "quartic_harmonic_divergence_mechanism", "fourth_order_local_jet_repair", "repaired_global_torus_quotient", "positive_volume_uniform_deterministic_gradient_bound", "volume_uniform_witten_coercivity", "interacting_h_minus_one_bound", "continuum_reconstruction", "born_rule", "krein_reconstruction", "lorentzian_transfer"],
      "properties": {
        "naive_chord_periodic_bubble": {"const": "OBSTRUCTED"},
        "quartic_harmonic_divergence_mechanism": {"const": "PROVED"},
        "fourth_order_local_jet_repair": {"const": "PROVED"},
        "repaired_global_torus_quotient": {"const": "OPEN"},
        "positive_volume_uniform_deterministic_gradient_bound": {"const": "OPEN"},
        "volume_uniform_witten_coercivity": {"const": "OPEN"},
        "interacting_h_minus_one_bound": {"const": "OPEN"},
        "continuum_reconstruction": {"const": "NOT_ESTABLISHED"},
        "born_rule": {"const": "NOT_ESTABLISHED"},
        "krein_reconstruction": {"const": "NOT_ASSESSED"},
        "lorentzian_transfer": {"const": "NOT_ESTABLISHED"}
      }
    },
    "missing_object_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "next_gate": {"$ref": "#/$defs/text"},
    "does_not_establish": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_base_commit", "inputs", "arithmetic"],
      "properties": {
        "repository_base_commit": {"const": "6e0d76f4e2774cef873b46e19ca3d7137695b438"},
        "inputs": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/text"},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "arithmetic": {"$ref": "#/$defs/text"}
      }
    },
    "verification_commands": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/text"}},
    "tier_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["tier_0", "tier_1", "tier_2", "tier_3", "memory_policy", "elapsed_seconds_and_peak_kib", "repository_audits"],
      "properties": {
        "tier_0": {"$ref": "#/$defs/text"},
        "tier_1": {"$ref": "#/$defs/text"},
        "tier_2": {"$ref": "#/$defs/text"},
        "tier_3": {"$ref": "#/$defs/text"},
        "memory_policy": {"$ref": "#/$defs/text"},
        "elapsed_seconds_and_peak_kib": {
          "type": "object", "additionalProperties": false,
          "required": ["producer_check", "independent_verifier", "unit_tests"],
          "properties": {
            "producer_check": {"const": "0.04 seconds, 20560 KiB"},
            "independent_verifier": {"const": "0.10 seconds, 30184 KiB"},
            "unit_tests": {"const": "0.13 seconds, 30936 KiB"}
          }
        },
        "repository_audits": {
          "type": "object", "additionalProperties": false,
          "required": ["planning_conformance", "science_forge_shadow"],
          "properties": {
            "planning_conformance": {"$ref": "#/$defs/text"},
            "science_forge_shadow": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failures": {"type": "array", "maxItems": 0},
        "details": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}}
      }
    },
    "report": {"const": "reverse_physics/reports/bt-euclidean-periodic-bubble-jet-gate.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-periodic-bubble-jet-gate-v1.schema.json"},
    "verifier": {"const": "reverse_physics/verify_bt_euclidean_periodic_bubble_jet_gate.py"}
  }
}
