    "target_test": {"type": "object", "required": ["required_gram", "constant_ambiguity_action", "coefficient_that_fits_target_from_plus_base", "disposition"], "properties": {"required_gram": {"const": {"numerator": 1, "denominator": 48}}, "constant_ambiguity_action": {"const": {"numerator": 2, "denominator": 1}}, "coefficient_that_fits_target_from_plus_base": {"const": {"numerator": 1, "denominator": 96}}, "disposition": {"const": "ONE_OVER_48_IS_NOT_DERIVED_BY_THE_INTERIOR_KERNEL_OR_EXTENSION_AXIOMS"}}, "additionalProperties": false},
