    "missing_object_ledger": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/s"}}, "next_gate": {"$ref": "#/$defs/s"}, "does_not_establish": {"type": "array", "minItems": 8, "items": {"$ref": "#/$defs/s"}},
