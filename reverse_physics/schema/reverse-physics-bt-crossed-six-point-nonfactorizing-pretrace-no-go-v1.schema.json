      "required": ["domain", "u_cross", "minus_six_a2_squared_x_squared_u_cross", "u_sign", "v_cross", "six_a2_x_v_cross", "v_sign", "metric_eta", "coherent_collapse_R_plus", "crossed_D", "raised_pullback", "characteristic_polynomial", "rank", "nonzero_eigenvalue", "fixed_hilbertized_gram", "status"],
