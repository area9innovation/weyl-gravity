        "raised_pullback": {"$ref": "#/$defs/string_matrix"},
        "characteristic_polynomial": {"type": "string", "minLength": 1},
        "rank": {"const": 2},
        "nonzero_eigenvalue": {"type": "string", "minLength": 1},
        "fixed_hilbertized_gram": {"$ref": "#/$defs/string_matrix"},
        "status": {"const": "NEGATIVE_FULL_RANK_FOR_ALL_POSITIVE_FINITE_HIERARCHY_PARAMETERS"}
