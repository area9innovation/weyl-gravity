    },
    "physical_disposition": {
      "const": {
        "finite_hierarchy_nonfactorizing_pretrace_residue": "EXACTLY_ZERO_ON_CORRELATED_SQUARE_FREE_CYLINDER",
        "finite_hierarchy_crossed_fixed_sharp_quotient": "NEGATIVE_RANK_TWO",
        "regular_same_carrier_parity_repair": "EXACTLY_OBSTRUCTED_BY_PREDECESSOR",
        "first_twelve_reversed_histories_on_available_cylinder": "NO_POSITIVE_FIXED_SHARP_INTERTWINER",
        "complete_noncorrelated_crossed_three_to_three_phase_space": "NOT_COMPUTED",
        "doubled_or_off_diagonal_source": "NOT_DERIVED",
        "complete_crossed_probability": "NOT_COMPUTED",
        "Eq19_all_orders": "NOT_PROVED",
        "spacetime_Moller_LSZ_S_operator": "NOT_CONSTRUCTED"
      }
    },
    "assumptions": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}},
    "does_not_establish": {"type": "array", "minItems": 14, "items": {"type": "string", "minLength": 1}},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs", "producer_method", "primary_source"],
      "properties": {
        "source_commit": {"const": "d97bf58854b9620aa29fe372bf1063a2f51aa2e5"},
        "retrieval_date": {"const": "2026-08-12"},
        "inputs": {
          "type": "array", "minItems": 4, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "producer_method": {"type": "string", "minLength": 1},
        "primary_source": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "url", "equations"],
          "properties": {
            "source": {"type": "string", "minLength": 1},
            "url": {"type": "string", "minLength": 1},
            "equations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    },
    "verification_commands": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true}, "passed": {"const": 25},
        "total": {"const": 25}, "failures": {"const": []},
        "details": {"type": "object", "minProperties": 25, "maxProperties": 25, "additionalProperties": {"const": true}}
      }
    },
    "report": {"const": "reverse_physics/reports/bt-crossed-six-point-nonfactorizing-pretrace-no-go.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-crossed-six-point-nonfactorizing-pretrace-no-go-v1.schema.json"}
  },
  "$defs": {
    "string_matrix": {
      "type": "array", "minItems": 1,
      "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}
    }
  }
}
