    "schema_version": {"const": "reverse-physics-bt-crossed-six-point-nonfactorizing-pretrace-no-go-v1"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "lifecycle_state": {"const": "COEFFICIENT_COMPUTED"},
    "result_kind": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "finite_pretrace_rows": {
      "type": "object", "additionalProperties": false,
      "required": ["leading_delta_order", "spectator_masks", "singleton_masks", "pair_masks", "cubic_mask", "singleton_row", "pair_row", "cubic_row", "three_hard_fixture_rows"],
      "properties": {
        "leading_delta_order": {"const": 2},
        "spectator_masks": {"const": [0, 1, 2, 3, 4, 5, 6]},
        "singleton_masks": {"const": [1, 2, 4]},
        "pair_masks": {"const": [3, 5, 6]},
        "cubic_mask": {"const": 7},
        "singleton_row": {"type": "string", "minLength": 1},
        "pair_row": {"type": "string", "minLength": 1},
        "cubic_row": {"const": "0"},
        "three_hard_fixture_rows": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["hard_fixture_index", "leading_order", "leading_masks", "leading_components"],
            "properties": {
              "hard_fixture_index": {"type": "integer", "minimum": 0, "maximum": 2},
              "leading_order": {"const": 2},
              "leading_masks": {"const": [0, 1, 2, 3, 4, 5, 6]},
              "leading_components": {
                "type": "object", "minProperties": 7, "maxProperties": 7,
                "additionalProperties": {"type": "string", "minLength": 1}
              }
            }
          }
        }
      }
    },
    "exact_factorization": {
      "type": "object", "additionalProperties": false,
      "required": ["outer_profile_matrix", "outer_profile_determinant", "u_e", "v_e", "reconstruction", "nonfactorizing_residual", "status", "scope"],
      "properties": {
        "outer_profile_matrix": {"$ref": "#/$defs/string_matrix"},
        "outer_profile_determinant": {"const": "-3*a2**2/(8*tau2**2)"},
        "u_e": {"type": "string", "minLength": 1},
        "v_e": {"type": "string", "minLength": 1},
        "reconstruction": {"type": "string", "minLength": 1},
        "nonfactorizing_residual": {"const": ["0", "0"]},
        "status": {"const": "EXACTLY_ZERO_BEFORE_STRONG_ORDER_LIMIT"},
        "scope": {"type": "string", "minLength": 1}
