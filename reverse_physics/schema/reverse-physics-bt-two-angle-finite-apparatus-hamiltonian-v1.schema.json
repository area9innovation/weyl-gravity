        "K_no": {"const": "sin(theta)*P_minus(phi)"},
        "E_click": {"const": "P_plus(phi)+cos(theta)^2*P_minus(phi)=I-epsilon*P_minus(phi)"},
        "E_no": {"const": "sin(theta)^2*P_minus(phi)=epsilon*P_minus(phi)"},
        "epsilon_selection": {"const": "epsilon=sin(g*tau)^2"},
        "completeness": {"const": "K_click^dagger K_click+K_no^dagger K_no=I"},
