        "leading_BT_vector": {"const": "X2=x2*(1,exp(i*delta))"},
        "calibrated_setting": {"const": "phi=delta"},
        "calibrated_fixed_point": {"const": "E_click X2=X2"},
        "mismatch": {"const": "Delta=delta-phi"},
        "leading_click_probability": {"const": "<X2,E_click X2>=2*|x2|^2*[1-epsilon*sin(Delta/2)^2]"},
