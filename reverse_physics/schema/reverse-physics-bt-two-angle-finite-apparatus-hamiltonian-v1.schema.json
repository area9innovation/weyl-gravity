        "K_click": {"$ref": "#/$defs/two_matrix"},
        "K_no": {"$ref": "#/$defs/two_matrix"},
        "E_click": {"$ref": "#/$defs/two_matrix"},
        "E_no": {"$ref": "#/$defs/two_matrix"},
        "calibrated_leading_probability_for_unit_x2": {"const": "2"},
