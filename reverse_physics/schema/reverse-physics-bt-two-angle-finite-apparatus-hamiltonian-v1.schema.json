      "required": ["interaction", "sigma_y", "self_adjoint", "bounded_norm", "duration", "theta", "spectral_square", "unitary", "status"],
      "properties": {
        "interaction": {"const": "H_int=g*P_minus(phi) tensor sigma_y"},
        "sigma_y": {"const": [["0", "-i"], ["i", "0"]]},
        "self_adjoint": {"const": true},
        "bounded_norm": {"const": "||H_int||=|g|"},
        "duration": {"const": "tau"},
        "theta": {"const": "theta=g*tau"},
