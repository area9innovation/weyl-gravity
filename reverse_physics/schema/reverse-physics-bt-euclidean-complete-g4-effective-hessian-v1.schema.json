      "type": "object",
      "required": ["definitions", "symmetrized_tensor", "gradient_R", "hessian_R", "kernel_formula", "normalization_role", "status"],
      "properties": {
        "definitions": {"type": "string"},
        "symmetrized_tensor": {"type": "string"},
