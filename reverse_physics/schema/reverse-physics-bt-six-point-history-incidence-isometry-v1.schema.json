      "properties": {
        "skew_generator": {"const": "K=[[0,-W_hist^T],[W_hist,0]] on R^10 direct_sum R^90"},
        "minimal_polynomial_identity": {"const": "K^3=-K"},
        "rotation": {"const": "U_theta=I+sin(theta)*K+(1-cos(theta))*K^2"},
