    "report": {"const": "reverse_physics/reports/bt-six-point-history-incidence-isometry.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-six-point-history-incidence-isometry-v1.schema.json"}
  },
  "$defs": {"text": {"type": "string", "minLength": 1}, "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
