        "status": {"const": "EXACT_NORMALIZED_FINITE_CHANNEL_LABEL_INSTRUMENT_NOT_BT_TIME_AFFILIATED"}
      }
    },
    "moller_defect_relation": {"type": "object", "additionalProperties": false, "required": ["constructed", "removes", "still_missing", "global_status"], "properties": {"constructed": {"$ref": "#/$defs/text"}, "removes": {"$ref": "#/$defs/text"}, "still_missing": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/text"}}, "global_status": {"const": "NOT_FIXED"}}},
