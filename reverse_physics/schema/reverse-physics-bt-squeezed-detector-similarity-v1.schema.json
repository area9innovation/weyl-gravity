{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-squeezed-detector-similarity-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate", "schema_version", "dependency_tags", "lifecycle_state",
    "result_kind", "question", "answer", "operator_identity",
    "signed_kernel_similarity_fixtures", "finite_projector_similarity_fixture",
    "bare_detector_mismatch", "coefficient_disposition", "disposition",
    "does_not_establish", "next_gate", "provenance", "verification_commands",
    "checks", "report", "schema"
  ],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_SQUEEZED_DETECTOR_SIMILARITY_V1"},
    "schema_version": {"const": "reverse-physics-bt-squeezed-detector-similarity-v1"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "lifecycle_state": {"const": "COEFFICIENT_COMPUTED"},
    "result_kind": {"type": "string", "minLength": 50},
    "question": {"type": "string", "minLength": 80},
    "answer": {"type": "string", "minLength": 500},
    "operator_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["factorization", "squeeze_adjoint", "transported_generator", "Born_similarity", "projector_similarity", "finite_rank_trace", "consequence"],
      "properties": {
        "factorization": {"type": "string"},
        "squeeze_adjoint": {"const": "S^dagger=S^-1"},
        "transported_generator": {"const": "K_S=S K S^-1"},
        "Born_similarity": {"const": "K_S^dagger K_S=S(K^dagger K)S^-1"},
        "projector_similarity": {"type": "string"},
        "finite_rank_trace": {"const": "Tr_fin(S T S^-1)=Tr_fin(T)"},
        "consequence": {"type": "string"}
      }
    },
    "signed_kernel_similarity_fixtures": {
      "type": "array", "minItems": 8, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["target_signs", "e1", "e2", "scale_r", "kernel", "parent_gram", "parent_trace", "parent_isometry", "daughter_isometry", "isometries_preserve_metrics", "transformed_kernel", "transformed_parent_gram", "transformed_parent_trace", "trace_is_zero_before_and_after"],
        "properties": {
          "target_signs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"enum": [-1, 1]}},
          "e1": {"type": "integer", "minimum": 1}, "e2": {"type": "integer", "minimum": 1},
          "scale_r": {"$ref": "#/$defs/rat"},
          "kernel": {"$ref": "#/$defs/matrix"}, "parent_gram": {"$ref": "#/$defs/matrix"},
          "parent_trace": {"const": {"numerator": 0, "denominator": 1}},
          "parent_isometry": {"$ref": "#/$defs/matrix"}, "daughter_isometry": {"$ref": "#/$defs/matrix"},
          "isometries_preserve_metrics": {"const": true},
          "transformed_kernel": {"$ref": "#/$defs/matrix"}, "transformed_parent_gram": {"$ref": "#/$defs/matrix"},
          "transformed_parent_trace": {"const": {"numerator": 0, "denominator": 1}},
          "trace_is_zero_before_and_after": {"const": true}
        }
      }
    },
    "finite_projector_similarity_fixture": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "similarity", "similarity_is_Krein_isometric", "projector", "transported_projector", "projector_idempotent_before_and_after", "projector_trace_before_and_after", "commutator_coefficient", "transported_commutator_coefficient", "commutator_trace_before_and_after"],
      "properties": {
        "metric": {"$ref": "#/$defs/matrix"}, "similarity": {"$ref": "#/$defs/matrix"},
        "similarity_is_Krein_isometric": {"const": true},
        "projector": {"$ref": "#/$defs/matrix"}, "transported_projector": {"$ref": "#/$defs/matrix"},
        "projector_idempotent_before_and_after": {"const": true},
        "projector_trace_before_and_after": {"const": [{"numerator": 1, "denominator": 1}, {"numerator": 1, "denominator": 1}]},
        "commutator_coefficient": {"$ref": "#/$defs/matrix"}, "transported_commutator_coefficient": {"$ref": "#/$defs/matrix"},
        "commutator_trace_before_and_after": {"const": [{"numerator": 0, "denominator": 1}, {"numerator": 0, "denominator": 1}]}
      }
    },
    "bare_detector_mismatch": {
      "type": "object", "additionalProperties": false,
      "required": ["normalized_squeezed_vacuum", "bare_one_pair_probability", "fixture_z", "fixture_probability", "disposition"],
      "properties": {
        "normalized_squeezed_vacuum": {"type": "string"}, "bare_one_pair_probability": {"const": "(1-x)x"},
        "fixture_z": {"const": {"numerator": 1, "denominator": 2}},
        "fixture_probability": {"const": {"numerator": 3, "denominator": 16}},
        "disposition": {"const": "NONZERO_BARE_OCCUPATION_IS_A_FIXED_DETECTOR_COMPARISON_NOT_THE_COVARIANT_EQ19_PUSHFORWARD"}
      }
    },
    "coefficient_disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["completed_public_finite_regulator_order_lambda_quadratic_coefficient", "squeeze_additive_correction", "physical_zero", "reason_physical_fails_closed"],
      "properties": {
        "completed_public_finite_regulator_order_lambda_quadratic_coefficient": {"const": {"numerator": 0, "denominator": 1}},
        "squeeze_additive_correction": {"const": {"numerator": 0, "denominator": 1}},
        "physical_zero": {"const": "NOT_ESTABLISHED"}, "reason_physical_fails_closed": {"type": "string"}
      }
    },
    "disposition": {
      "const": {
        "finite_paired_core_squeeze_transport": "CONSTRUCTED",
        "finite_regulator_quadratic_Born_trace": "ZERO",
        "finite_mode_order_lambda_Eq19": "PROVED_WITH_Q1_ZERO",
        "continuum_Eq19": "NOT_PROVED",
        "physical_zero": "NOT_ESTABLISHED"
      }
    },
    "does_not_establish": {"type": "array", "minItems": 8, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 180},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs"],
      "properties": {
        "source_commit": {"pattern": "^[0-9a-f]{40}$"}, "retrieval_date": {"const": "2026-08-11"},
        "inputs": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"pattern": "^[0-9a-f]{64}$"}}}}
      }
    },
    "verification_commands": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string", "pattern": "^ulimit -v 500000; "}},
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {"ok": {"const": true}, "passed": {"const": 20}, "total": {"const": 20}, "failures": {"const": []}, "details": {"type": "object", "minProperties": 20, "maxProperties": 20, "additionalProperties": {"const": true}}}
    },
    "report": {"const": "reverse_physics/reports/bt-squeezed-detector-similarity.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-squeezed-detector-similarity-v1.schema.json"}
  },
  "$defs": {
    "rat": {"type": "object", "additionalProperties": false, "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}},
    "matrix": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rat"}}}
  }
}
