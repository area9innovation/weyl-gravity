{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-eight-point-krein-charge-localization-v1.schema.json",
  "title": "BT eight-point Krein charge localization certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate",
    "schema_version",
    "lifecycle_state",
    "dependency_tags",
    "result_kind",
    "question",
    "answer",
    "assumptions",
    "charge_fibre",
    "canonical_negative_line",
    "profile_charge_decomposition",
    "Eq19_boundary",
    "disposition",
    "does_not_establish",
    "next_gate",
    "provenance",
    "verification_commands",
    "checks",
    "report",
    "schema"
  ],
  "properties": {
    "certificate": {
      "const": "REVERSE_PHYSICS_BT_EIGHT_POINT_KREIN_CHARGE_LOCALIZATION_V1"
    },
    "schema_version": {
      "const": "reverse-physics-bt-eight-point-krein-charge-localization-v1"
    },
    "lifecycle_state": {"const": "CLASSIFIED"},
    "dependency_tags": {
      "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]
    },
    "result_kind": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "assumptions": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string", "minLength": 1}
    },
    "charge_fibre": {
      "type": "object",
      "required": [
        "rho",
        "gram",
        "certified_missing_leg_C",
        "target_metric_J",
        "missing_leg_pullback_identity",
        "null_charge_basis_S",
        "charge_basis_gram",
        "charge_basis_gram_identity",
        "diagonal_charge_generator",
        "transported_charge_generator",
        "transported_charge_generator_identity",
        "physical_transport_identity",
        "involution",
        "gram_invariance",
        "positive_projector",
        "negative_projector"
      ],
      "additionalProperties": false,
      "properties": {
        "rho": {"$ref": "#/$defs/rational"},
        "gram": {"$ref": "#/$defs/string_matrix"},
        "certified_missing_leg_C": {"$ref": "#/$defs/string_matrix"},
        "target_metric_J": {"$ref": "#/$defs/string_matrix"},
        "missing_leg_pullback_identity": {"const": "C^T*J*C=G"},
        "null_charge_basis_S": {"$ref": "#/$defs/string_matrix"},
        "charge_basis_gram": {"$ref": "#/$defs/string_matrix"},
        "charge_basis_gram_identity": {"const": "S^T*G*S=rho^2*J"},
        "diagonal_charge_generator": {"$ref": "#/$defs/string_matrix"},
        "transported_charge_generator": {"$ref": "#/$defs/string_matrix"},
        "transported_charge_generator_identity": {
          "const": "H_G=S*diag(1,-1)*S^-1"
        },
        "physical_transport_identity": {
          "const": "H_G=C^-1*diag(1,-1)*C"
        },
        "involution": {"const": "H_G^2=I"},
        "gram_invariance": {"const": "H_G^T*G+G*H_G=0"},
        "positive_projector": {"$ref": "#/$defs/string_matrix"},
        "negative_projector": {"$ref": "#/$defs/string_matrix"}
      }
    },
    "canonical_negative_line": {
      "type": "object",
      "required": [
        "f2",
        "positive_component",
        "negative_component",
        "positive_self_pairing",
        "negative_self_pairing",
        "positive_negative_pairing",
        "negative_positive_pairing",
        "full_pairing",
        "localization"
      ],
      "additionalProperties": false,
      "properties": {
        "f2": {"$ref": "#/$defs/string_matrix"},
        "positive_component": {"$ref": "#/$defs/string_matrix"},
        "negative_component": {"$ref": "#/$defs/string_matrix"},
        "positive_self_pairing": {"$ref": "#/$defs/rational"},
        "negative_self_pairing": {"$ref": "#/$defs/rational"},
        "positive_negative_pairing": {"$ref": "#/$defs/rational"},
        "negative_positive_pairing": {"$ref": "#/$defs/rational"},
        "full_pairing": {"$ref": "#/$defs/rational"},
        "localization": {"const": "FULL_NEGATIVE_NORM_IS_ENTIRELY_CROSS_CHARGE"}
      }
    },
    "profile_charge_decomposition": {
      "type": "object",
      "required": [
        "full_forward_block",
        "positive_charge_block",
        "negative_charge_block",
        "positive_self_pullback",
        "negative_self_pullback",
        "positive_negative_pullback",
        "negative_positive_pullback",
        "full_profile_effect",
        "reconstruction",
        "one_sided_negative_Q_pullback",
        "nonzero_effect_charge"
      ],
      "additionalProperties": false,
      "properties": {
        "full_forward_block": {"$ref": "#/$defs/string_matrix"},
        "positive_charge_block": {"$ref": "#/$defs/string_matrix"},
        "negative_charge_block": {"$ref": "#/$defs/string_matrix"},
        "positive_self_pullback": {"$ref": "#/$defs/string_matrix"},
        "negative_self_pullback": {"$ref": "#/$defs/string_matrix"},
        "positive_negative_pullback": {"$ref": "#/$defs/string_matrix"},
        "negative_positive_pullback": {"$ref": "#/$defs/string_matrix"},
        "full_profile_effect": {"$ref": "#/$defs/string_matrix"},
        "reconstruction": {
          "const": "B_plus^sharp*B_minus+B_minus^sharp*B_plus=K4"
        },
        "one_sided_negative_Q_pullback": {"const": "ZERO"},
        "nonzero_effect_charge": {"const": "ZERO_FROM_PLUS_MINUS_CROSS_PAIRING"}
      }
    },
    "Eq19_boundary": {
      "type": "object",
      "required": [
        "Q_remainder_identification",
        "reason",
        "finite_mode_order_lambda_sector",
        "relation_to_order_lambda",
        "required_successor"
      ],
      "additionalProperties": false,
      "properties": {
        "Q_remainder_identification": {
          "const": "EXACTLY_REFUTED_ON_DECLARED_FIBRE"
        },
        "reason": {"type": "string", "minLength": 1},
        "finite_mode_order_lambda_sector": {
          "const": "PROVED_WITH_Q1_ZERO_IN_PREDECESSOR"
        },
        "relation_to_order_lambda": {
          "const": "COMPATIBLE_BUT_NOT_DERIVED; THE FOURTH_PROFILE_BLOCK IS HIGHER_COMPOSITE_DATA"
        },
        "required_successor": {"type": "string", "minLength": 1}
      }
    },
    "disposition": {
      "const": {
        "charge_generator_on_forced_fibre": "CONSTRUCTED_EXACTLY",
        "one_sided_charge_lines": "NULL",
        "fourth_profile_effect_charge_support": "CROSS_CHARGE_TOTAL_ZERO",
        "profile_lift_equals_negative_Q_remainder": "EXACTLY_FALSE_ON_DECLARED_FIBRE",
        "neutral_higher_composite_operator": "NOT_CONSTRUCTED",
        "generalized_Born_trace": "NOT_CONSTRUCTED",
        "physical_fourth_probability": "NOT_ESTABLISHED",
        "Eq19_all_orders": "NOT_PROVED"
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 10,
      "items": {"type": "string", "minLength": 1}
    },
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["source_commit", "retrieval_date", "inputs"],
      "additionalProperties": false,
      "properties": {
        "source_commit": {"const": "f9841cb4"},
        "retrieval_date": {"const": "2026-08-12"},
        "inputs": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string"}
    },
    "checks": {
      "type": "object",
      "required": ["ok", "passed", "total", "failures", "details"],
      "additionalProperties": false,
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 22},
        "total": {"const": 22},
        "failures": {"const": []},
        "details": {
          "type": "object",
          "minProperties": 22,
          "maxProperties": 22,
          "additionalProperties": {"const": true}
        }
      }
    },
    "report": {
      "const": "reverse_physics/reports/bt-eight-point-krein-charge-localization.md"
    },
    "schema": {
      "const": "reverse_physics/schema/reverse-physics-bt-eight-point-krein-charge-localization-v1.schema.json"
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "additionalProperties": false,
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "string_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
    }
  }
}
