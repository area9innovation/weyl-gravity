{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-abel-naimark-asymptotic-dilation-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate",
    "schema_version",
    "dependency_tags",
    "lifecycle_state",
    "result_kind",
    "question",
    "answer",
    "assumptions",
    "abel_time_intertwiner",
    "time_resolution_map",
    "coherent_limit_obstruction",
    "naimark_probability_dilation",
    "object_typing",
    "disposition",
    "does_not_establish",
    "missing_object_ledger",
    "next_gate",
