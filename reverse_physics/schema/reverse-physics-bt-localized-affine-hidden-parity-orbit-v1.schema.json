      "type": "object",
      "additionalProperties": false,
      "required": ["field_strength", "Euler_Lagrange_equation", "hidden_parity", "identity", "second_iterate", "on_shell_consequence", "off_shell_consequence", "localization_boundary"],
      "properties": {
        "field_strength": {"const": "F=Box(phi)+lambda(dphi)^2"},
        "Euler_Lagrange_equation": {"const": "E=Box(F)-2lambda d_mu(F d^mu phi)=0"},
        "hidden_parity": {"const": "h(phi)=-phi+lambda^-1 log(F)"},
        "identity": {"const": "F(h(phi))-F(phi)=E(phi)/(lambda F(phi))"},
        "second_iterate": {"const": "h^2(phi)-phi=lambda^-1 log(1+E/(lambda F^2))"},
        "on_shell_consequence": {"type": "string", "minLength": 1},
        "off_shell_consequence": {"type": "string", "minLength": 1},
        "localization_boundary": {"type": "string", "minLength": 1}
      }
    },
