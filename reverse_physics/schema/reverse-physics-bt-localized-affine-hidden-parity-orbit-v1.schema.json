      "type": "object",
      "additionalProperties": false,
      "required": ["background", "field_strength", "equation_of_motion", "localized_condition", "real_log_condition", "parity_image", "orbit", "fixed_chart_test", "homogeneity", "Lorentz_boundary", "conclusion"],
      "properties": {
        "background": {"const": "phi_v(x)=v.x+c"},
        "field_strength": {"const": "f0=lambda v^2"},
        "equation_of_motion": {"const": "E(phi_v)=0"},
        "localized_condition": {"const": "f0!=0"},
        "real_log_condition": {"const": "f0>0"},
        "parity_image": {"type": "string", "minLength": 1},
        "orbit": {"const": ["(v,c)", "(-v,-c+lambda^-1 log(f0))"]},
        "fixed_chart_test": {"type": "string", "minLength": 1},
        "homogeneity": {"type": "string", "minLength": 1},
        "Lorentz_boundary": {"type": "string", "minLength": 1},
        "conclusion": {"const": "LOCALIZED_HIDDEN_PARITY_REQUIRES_TWO_BACKGROUND_REPRESENTATIONS"}
      }
    },
    "linearized_on_shell_intertwiner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operators", "field_strength_variation", "linearized_equation", "parity_tangent", "composition", "two_sector_operator", "quotient_identity", "interpretation"],
      "properties": {
        "operators": {"type": "object", "required": ["D", "V", "L_v", "L_-v", "a"]},
        "field_strength_variation": {"const": "delta F=L_v eta"},
        "linearized_equation": {"const": "E_v^(1)=[L_-v L_v-2aD]eta=[D^2-4lambda^2 V^2-2lambda^2 v^2 D]eta"},
        "parity_tangent": {"const": "T_v=-1+L_v/a"},
        "composition": {"const": "T_-v T_v-1=E_v^(1)/a^2 and T_v T_-v-1=E_-v^(1)/a^2"},
        "two_sector_operator": {"type": "string", "minLength": 1},
        "quotient_identity": {"type": "string", "minLength": 1},
        "interpretation": {"type": "string", "minLength": 1}
      }
    },
    "zero_background_limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scaling", "multiplier", "generic_offshell", "generic_massless", "finite_massless_slice", "density_boundary", "packet_conclusion", "exact_fourier_fixtures", "Jordan_fixture"],
      "properties": {
        "scaling": {"const": "v=epsilon u with u^2!=0"},
        "multiplier": {"type": "string", "minLength": 1},
        "generic_offshell": {"type": "string", "minLength": 1},
        "generic_massless": {"type": "string", "minLength": 1},
        "finite_massless_slice": {"type": "string", "minLength": 1},
        "density_boundary": {"type": "string", "minLength": 1},
        "packet_conclusion": {"const": "NO_STRONG_LIMIT_ON_A_FIXED_DENSE_MASSLESS_PACKET_CORE"},
        "exact_fourier_fixtures": {"type": "array", "minItems": 6, "maxItems": 6},
        "Jordan_fixture": {
          "type": "object",
          "required": ["Box_matrix", "u_dot_d_matrix", "T_epsilon", "norm_growth", "rows", "conclusion"],
          "properties": {
            "Box_matrix": {"const": [["0", "1"], ["0", "0"]]},
            "u_dot_d_matrix": {"const": [["0", "0"], ["0", "0"]]},
            "norm_growth": {"const": "Frobenius norm squared=2+epsilon^-4"},
            "rows": {"type": "array", "minItems": 6, "maxItems": 6},
            "conclusion": {"const": "NO_LIMIT_ON_THE_DOUBLE_POLE_JORDAN_JET"}
          }
        }
      }
    },
    "Eq19_and_physical_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["regular_zero_vacuum_one_sheet", "localized_affine_same_action_completion", "second_sheet_status", "off_shell_projector_identity", "public_zero_vacuum_affiliation", "standard_projector_q10_comparison", "time_independent_asymptotic_affine_projector", "arbitrary_nonaffine_localized_background", "arbitrary_singular_or_nonlocal_CCR_map", "full_public_Eq19", "physical_probability"],
