        "standard_projector_q10_comparison": {"const": "NOT_TRANSFERABLE_FROM_THE_AFFINE_COMPLETION"},
        "time_independent_asymptotic_affine_projector": {"const": "NOT_CONSTRUCTED"},
        "arbitrary_nonaffine_localized_background": {"const": "NOT_CLASSIFIED"},
        "arbitrary_singular_or_nonlocal_CCR_map": {"const": "NOT_CLASSIFIED"},
        "full_public_Eq19": {"const": "NOT_PROVED"},
        "physical_probability": {"const": "SELECTED_ZERO_BACKGROUND_Q10_REMAINS_VALID_BUT_SEPARATE"}
      }
    },
    "does_not_establish": {"type": "array", "minItems": 10, "items": {"type": "string", "minLength": 1}},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
