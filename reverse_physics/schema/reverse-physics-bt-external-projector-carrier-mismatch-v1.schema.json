{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-external-projector-carrier-mismatch-v1.schema.json",
  "title": "BT external projector and real--virtual carrier mismatch",
  "$defs": {
    "string": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "items": {"$ref": "#/$defs/string"}},
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "certificate", "schema_version", "dependency_tags", "lifecycle_state",
    "result_kind", "question", "answer", "declared_carriers",
    "external_projector", "carrier_response", "boundary_layer_diagnosis",
    "disposition", "missing_object_ledger", "does_not_establish",
    "provenance", "verification_commands", "checks", "report", "schema"
  ],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EXTERNAL_PROJECTOR_CARRIER_MISMATCH_V1"},
    "schema_version": {"const": "reverse-physics-bt-external-projector-carrier-mismatch-v1"},
    "dependency_tags": {"const": ["REDUCED-MODE"]},
    "lifecycle_state": {"const": "COEFFICIENT_COMPUTED"},
    "result_kind": {"$ref": "#/$defs/string"},
    "question": {"$ref": "#/$defs/string"},
    "answer": {"$ref": "#/$defs/string"},
    "declared_carriers": {
      "type": "object",
      "required": ["virtual_hard", "real_threshold", "comparison_map"],
      "properties": {
        "virtual_hard": {"$ref": "#/$defs/string"},
        "real_threshold": {"$ref": "#/$defs/string"},
        "comparison_map": {"$ref": "#/$defs/string"}
      },
      "additionalProperties": false
    },
    "external_projector": {
      "type": "object",
      "required": [
        "bt_rate_formula", "degree_input", "degree_consequence",
        "massless_phase_value", "amplitude_interference",
        "projected_virtual_log_rate", "hard_collinear_form"
      ],
      "properties": {
        "bt_rate_formula": {"$ref": "#/$defs/string"},
        "degree_input": {"$ref": "#/$defs/string"},
        "degree_consequence": {"$ref": "#/$defs/string"},
        "massless_phase_value": {"const": "1/(256*pi^2*s)"},
        "amplitude_interference": {"const": "lambda^6/(4*pi)^2*(16/3)*15*(Ls+Lt+Lu)"},
        "projected_virtual_log_rate": {"const": "d_sigma_virtual_log/d_Omega=5*lambda^6*(Ls+Lt+Lu)/(256*pi^4*s)"},
        "hard_collinear_form": {"const": "5*lambda^6*(3*L-ell)/(256*pi^4*s)+O(t/s), where ell=log(-t/s)"}
      },
      "additionalProperties": false
    },
    "carrier_response": {
      "type": "object",
      "required": [
        "rescaling", "virtual_hard_log_response", "real_reduced_threshold_term",
        "real_finite_part_shift", "comparison", "interpretation"
      ],
      "properties": {
        "rescaling": {"const": "rho=x1/x0 -> c*rho with hard s,t,u,mu fixed"},
        "virtual_hard_log_response": {"const": "0"},
        "real_reduced_threshold_term": {"const": "-(3/8)*x0*x1*log(rho)"},
        "real_finite_part_shift": {"const": "-(3/8)*log(c)"},
        "comparison": {"const": "NONCANCELLING_ON_CURRENT_CARRIERS"},
        "interpretation": {"$ref": "#/$defs/string"}
      },
      "additionalProperties": false
    },
    "boundary_layer_diagnosis": {
      "type": "object",
      "required": [
        "missing_virtual_region", "required_function_class",
        "why_predecessor_cannot_see_it", "next_gate"
      ],
      "properties": {
        "missing_virtual_region": {"$ref": "#/$defs/string"},
        "required_function_class": {"$ref": "#/$defs/string"},
        "why_predecessor_cannot_see_it": {"$ref": "#/$defs/string"},
        "next_gate": {"$ref": "#/$defs/string"}
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": [
        "hard_log_external_projector", "hard_log_physical_coefficient",
        "hard_vs_real_carrier_comparison", "virtual_external_mass_boundary_layer",
        "full_real_phase_space_normalization", "cut_free_and_counterterm_terms",
        "real_virtual_cancellation", "physical_nlo_probability",
        "beyond_tree_positivity"
      ],
      "properties": {
        "hard_log_external_projector": {"const": "APPLIED"},
        "hard_log_physical_coefficient": {"const": "COMPUTED"},
        "hard_vs_real_carrier_comparison": {"const": "CLASSIFIED_MISMATCH"},
        "virtual_external_mass_boundary_layer": {"const": "NOT_COMPUTED"},
        "full_real_phase_space_normalization": {"const": "NOT_COMPUTED"},
        "cut_free_and_counterterm_terms": {"const": "NOT_COMPUTED"},
        "real_virtual_cancellation": {"const": "NOT_COMPUTED"},
        "physical_nlo_probability": {"const": "NOT_ESTABLISHED"},
        "beyond_tree_positivity": {"const": "NOT_ESTABLISHED"}
      },
      "additionalProperties": false
    },
    "missing_object_ledger": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/string"}},
    "does_not_establish": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/string"}},
    "provenance": {
      "type": "object",
      "required": ["source_commit", "retrieval_date", "inputs", "primary_source"],
      "properties": {
        "source_commit": {"const": "8ad343172f01dbf055b9fce83900780dfe2266f0"},
        "retrieval_date": {"const": "2026-08-10"},
        "inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/input"}},
        "primary_source": {
          "type": "object",
          "required": ["source", "equation", "use"],
          "properties": {
            "source": {"const": "Bateman--Turok arXiv:2607.00096v1"},
            "equation": {"const": "Eq. (13)"},
            "use": {"$ref": "#/$defs/string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "verification_commands": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/string"}},
    "checks": {
      "type": "object",
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 13},
        "total": {"const": 13},
        "failures": {"type": "array", "maxItems": 0},
        "details": {"type": "object", "minProperties": 13, "maxProperties": 13, "additionalProperties": {"const": true}}
      },
      "additionalProperties": false
    },
    "report": {"const": "reverse_physics/reports/bt-external-projector-carrier-mismatch.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-external-projector-carrier-mismatch-v1.schema.json"}
  },
  "additionalProperties": false
}
