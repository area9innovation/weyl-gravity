        "q0": {"$ref": "#/$defs/rational"},
        "spatial_radius_squared": {"$ref": "#/$defs/rational"},
        "rotation_numerator_N": {"$ref": "#/$defs/rational"},
        "q_squared": {"$ref": "#/$defs/rational"},
        "phase_derivative": {
          "const": "-N/sqrt(spatial_radius_squared)"
        },
        "noncritical": {"const": true},
        "on_shell": {"type": "boolean"}
      }
    },
    "GaussianFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test",
        "finite_action",
        "limit",
        "normalized_series",
        "coefficients"
      ],
      "properties": {
        "test": {"type": "string", "minLength": 1},
        "finite_action": {"type": "string", "minLength": 1},
        "limit": {"type": "string", "minLength": 1},
        "normalized_series": {"type": "string", "minLength": 1},
        "coefficients": {
          "type": "array",
          "minItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["power", "coefficient"],
            "properties": {
              "power": {"type": "integer", "minimum": 1},
              "coefficient": {"$ref": "#/$defs/rational"}
            }
          }
        }
      }
    }
  }
}
