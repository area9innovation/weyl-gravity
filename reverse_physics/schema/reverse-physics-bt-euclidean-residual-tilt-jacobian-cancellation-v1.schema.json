{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-residual-tilt-jacobian-cancellation-v1.schema.json",
  "title": "BT residual tilt Jacobian cancellation certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate", "schema_version", "created", "dependency_tags",
    "lifecycle_state", "result_kind", "question", "answer",
    "general_tilt_theorem", "conditional_marginal_reduction",
    "exact_cycle_tilt", "method_disposition", "foundational_dependency_cut",
    "missing_object_ledger", "next_gate", "does_not_establish", "provenance",
    "verification_commands", "tier_receipt", "checks", "report", "schema"
  ],
  "$defs": {
    "fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "text": {"type": "string", "minLength": 1},
    "text_array": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}
    },
    "fraction_array": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"$ref": "#/$defs/fraction"}
    },
    "proved_section": {
      "type": "object", "minProperties": 2,
      "required": ["status"],
      "properties": {"status": {"const": "PROVED"}},
      "additionalProperties": {"$ref": "#/$defs/text"}
    }
  },
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_RESIDUAL_TILT_JACOBIAN_CANCELLATION_V1"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-residual-tilt-jacobian-cancellation-v1"},
    "created": {"const": "2026-08-14"},
    "dependency_tags": {
      "type": "array",
      "prefixItems": [{"const": "LOCAL-ALGEBRAIC"}, {"const": "EUCLIDEAN-SPECTRAL"}],
      "items": false
    },
    "lifecycle_state": {"const": "EXACT_REDUCTION_PROVED"},
    "result_kind": {"$ref": "#/$defs/text"},
    "question": {"$ref": "#/$defs/text"},
    "answer": {"$ref": "#/$defs/text"},
    "general_tilt_theorem": {"$ref": "#/$defs/proved_section"},
    "conditional_marginal_reduction": {
      "type": "object", "additionalProperties": false,
      "required": ["orthogonal_decomposition", "marginal", "tree_factor", "remaining_problem", "status"],
      "properties": {
        "orthogonal_decomposition": {"$ref": "#/$defs/text"},
        "marginal": {"$ref": "#/$defs/text"},
        "tree_factor": {"const": "CANCELLED_EXACTLY"},
        "remaining_problem": {"$ref": "#/$defs/text"},
        "status": {"const": "EXACT_ACTION_FIBER_REDUCTION_ONLY"}
      }
    },
    "exact_cycle_tilt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "graph", "base_omega", "tilt", "shifted_omega", "base_residual",
        "shifted_residual", "base_action", "shifted_action", "action_gap",
        "coupling", "boltzmann_exponent_gap", "base_tree_terms",
        "shifted_tree_terms", "base_tree_density", "shifted_tree_density",
        "base_coarea_jacobian", "shifted_coarea_jacobian",
        "surface_jacobian_ratio", "inverse_density_jacobian_ratio",
        "cancellation_product", "weighted_pullback_ratio", "status"
      ],
      "properties": {
        "graph": {"const": "four-cycle C4 with degree two"},
        "base_omega": {"$ref": "#/$defs/fraction_array"},
        "tilt": {"const": "h=(1,-1,0,0), t=log(2)"},
        "shifted_omega": {"$ref": "#/$defs/fraction_array"},
        "base_residual": {"$ref": "#/$defs/fraction_array"},
        "shifted_residual": {"$ref": "#/$defs/fraction_array"},
        "base_action": {"$ref": "#/$defs/fraction"},
        "shifted_action": {"$ref": "#/$defs/fraction"},
        "action_gap": {"$ref": "#/$defs/fraction"},
        "coupling": {"$ref": "#/$defs/fraction"},
        "boltzmann_exponent_gap": {"$ref": "#/$defs/fraction"},
        "base_tree_terms": {"$ref": "#/$defs/fraction_array"},
        "shifted_tree_terms": {"$ref": "#/$defs/fraction_array"},
        "base_tree_density": {"$ref": "#/$defs/fraction"},
        "shifted_tree_density": {"$ref": "#/$defs/fraction"},
        "base_coarea_jacobian": {"$ref": "#/$defs/fraction"},
        "shifted_coarea_jacobian": {"$ref": "#/$defs/fraction"},
        "surface_jacobian_ratio": {"$ref": "#/$defs/fraction"},
        "inverse_density_jacobian_ratio": {"$ref": "#/$defs/fraction"},
        "cancellation_product": {"$ref": "#/$defs/fraction"},
        "weighted_pullback_ratio": {"const": "exp(-5325/128)"},
        "status": {"const": "EXACT_RATIONAL_JACOBIAN_CANCELLATION_FIXTURE"}
      }
    },
    "method_disposition": {
      "type": "object", "additionalProperties": false,
      "required": [
        "residual_coarea_pushforward", "induced_tilt_surface_jacobian",
        "inverse_tree_jacobian_cancellation", "tree_log_convexity_as_extra_tilt_confinement",
        "direct_action_difference_or_fiber_ratio_bound", "normalized_lowest_mode_marginal_bound",
        "actual_interacting_h_minus_one_second_moment_bound", "interacting_tightness",
        "continuum_limit", "born_rule", "krein_reconstruction", "lorentzian_transfer"
      ],
      "properties": {
        "residual_coarea_pushforward": {"const": "PROVED_BY_PREDECESSOR"},
        "induced_tilt_surface_jacobian": {"const": "PROVED"},
        "inverse_tree_jacobian_cancellation": {"const": "PROVED"},
        "tree_log_convexity_as_extra_tilt_confinement": {"const": "OBSTRUCTED"},
        "direct_action_difference_or_fiber_ratio_bound": {"const": "OPEN"},
        "normalized_lowest_mode_marginal_bound": {"const": "OPEN"},
        "actual_interacting_h_minus_one_second_moment_bound": {"const": "OPEN"},
        "interacting_tightness": {"const": "NOT_ESTABLISHED"},
        "continuum_limit": {"const": "NOT_ESTABLISHED"},
        "born_rule": {"const": "NOT_ESTABLISHED"},
        "krein_reconstruction": {"const": "NOT_ASSESSED"},
        "lorentzian_transfer": {"const": "NOT_ESTABLISHED"}
      }
    },
    "foundational_dependency_cut": {
      "type": "object", "additionalProperties": false,
      "required": ["finite_exact_layer", "finite_analytic_layer", "uniform_limit_layer", "classification", "weakest_base_or_reversal"],
      "properties": {
        "finite_exact_layer": {"$ref": "#/$defs/text"},
        "finite_analytic_layer": {"$ref": "#/$defs/text"},
        "uniform_limit_layer": {"$ref": "#/$defs/text"},
        "classification": {"const": "USED_BY_DISPLAYED_PROOF"},
        "weakest_base_or_reversal": {"const": "NOT_ESTABLISHED"}
      }
    },
    "missing_object_ledger": {"$ref": "#/$defs/text_array"},
    "next_gate": {"$ref": "#/$defs/text"},
    "does_not_establish": {"$ref": "#/$defs/text_array"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_base_commit", "inputs", "arithmetic"],
      "properties": {
        "repository_base_commit": {"pattern": "^[0-9a-f]{40}$"},
        "inputs": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/text"},
              "sha256": {"pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "arithmetic": {"$ref": "#/$defs/text"}
      }
    },
    "verification_commands": {"$ref": "#/$defs/text_array"},
    "tier_receipt": {
      "type": "object", "additionalProperties": false,
      "required": ["command_results", "tier_0", "tier_1", "tier_2", "tier_3", "resource_policy"],
      "properties": {
        "command_results": {"type": "array"},
        "tier_0": {"$ref": "#/$defs/text"},
        "tier_1": {"$ref": "#/$defs/text"},
        "tier_2": {"$ref": "#/$defs/text"},
        "tier_3": {"$ref": "#/$defs/text"},
        "resource_policy": {"$ref": "#/$defs/text"}
      }
    },
    "checks": {
      "type": "object", "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true}, "passed": {"const": 19}, "total": {"const": 19},
        "failures": {"type": "array", "maxItems": 0},
        "details": {"type": "object", "minProperties": 19, "maxProperties": 19, "additionalProperties": {"const": true}}
      }
    },
    "report": {"const": "reverse_physics/reports/bt-euclidean-residual-tilt-jacobian-cancellation.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-residual-tilt-jacobian-cancellation-v1.schema.json"}
  }
}
