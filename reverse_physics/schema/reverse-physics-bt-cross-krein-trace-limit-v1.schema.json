      "type": "object",
      "required": ["source_commit", "retrieval_date", "inputs", "primary_source", "architecture_source"],
      "properties": {
        "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "retrieval_date": {"const": "2026-08-11"},
        "inputs": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/input"}},
        "primary_source": {"$ref": "#/$defs/source"},
        "architecture_source": {"$ref": "#/$defs/architecture_source"}
      },
      "additionalProperties": false
    },
    "verification_commands": {"$ref": "#/$defs/string_array"},
    "checks": {
      "type": "object",
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 27},
        "total": {"const": 27},
        "failures": {"const": []},
        "details": {"type": "object", "minProperties": 27, "maxProperties": 27, "additionalProperties": {"const": true}}
      },
      "additionalProperties": false
    },
    "report": {"const": "reverse_physics/reports/bt-cross-krein-trace-limit.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-cross-krein-trace-limit-v1.schema.json"}
  },
  "additionalProperties": false,
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1},
    "string_array": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/nonempty"}},
    "rational": {
      "type": "object",
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}},
      "additionalProperties": false
    },
    "algebraic": {
      "type": "object",
      "required": ["basis", "coefficients"],
      "properties": {
        "basis": {"const": ["1", "sqrt(2)", "sqrt(3)", "sqrt(6)"]},
        "coefficients": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/rational"}}
      },
      "additionalProperties": false
    },
    "orbit_row": {
      "type": "object",
      "required": ["n", "J_image_index", "positive_norm_squared", "shift_test_m", "left_shift_pairing", "right_shift_pairing", "boost_test_m", "left_boost_pairing", "right_anti_boost_pairing"],
      "properties": {
        "n": {"type": "integer"},
        "J_image_index": {"type": "integer"},
        "positive_norm_squared": {"$ref": "#/$defs/rational"},
        "shift_test_m": {"type": "integer"},
        "left_shift_pairing": {"$ref": "#/$defs/rational"},
        "right_shift_pairing": {"$ref": "#/$defs/rational"},
        "boost_test_m": {"type": "integer"},
        "left_boost_pairing": {"$ref": "#/$defs/rational"},
        "right_anti_boost_pairing": {"$ref": "#/$defs/rational"}
      },
      "additionalProperties": false
