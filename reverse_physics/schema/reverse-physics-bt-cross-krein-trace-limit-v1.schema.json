      "type": "object",
      "required": ["zero_mode_Krein_completion", "weighted_cross_Krein_squeeze_factor", "finite_rank_cyclic_Born_trace", "finite_normalized_trace_on_full_orbit_operator_algebra", "normal_trace_class_thermodynamic_limit", "semifinite_relative_or_non_normal_weight", "full_nonlinear_R_t", "Eq19_in_continuum", "physical_neutral_one_over_48"],
      "properties": {
        "zero_mode_Krein_completion": {"const": "CONSTRUCTED"},
        "weighted_cross_Krein_squeeze_factor": {"const": "CONSTRUCTED_ON_PAIRED_CORES"},
        "finite_rank_cyclic_Born_trace": {"const": "CONSTRUCTED"},
        "finite_normalized_trace_on_full_orbit_operator_algebra": {"const": "OBSTRUCTED_IF_ORBIT_RANK_ONE_WEIGHT_IS_NONZERO"},
        "normal_trace_class_thermodynamic_limit": {"const": "OBSTRUCTED"},
        "semifinite_relative_or_non_normal_weight": {"const": "NOT_CONSTRUCTED"},
        "full_nonlinear_R_t": {"const": "NOT_CONSTRUCTED"},
        "Eq19_in_continuum": {"const": "NOT_REPRODUCED"},
        "physical_neutral_one_over_48": {"const": "NOT_ESTABLISHED"}
      },
      "additionalProperties": false
