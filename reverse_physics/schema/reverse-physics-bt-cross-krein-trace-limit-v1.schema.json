      "additionalProperties": false
    },
    "normalized_trace_extension_no_go": {
      "type": "object",
      "required": ["matrix_units", "translation", "hypotheses", "cyclic_consequence", "symmetric_projection", "positivity_bound", "theorem", "translate_bounds", "coefficient_trace_branch", "finite_rank_trace_branch", "disposition"],
      "properties": {
        "matrix_units": {"$ref": "#/$defs/nonempty"},
        "translation": {"$ref": "#/$defs/nonempty"},
        "hypotheses": {"$ref": "#/$defs/string_array"},
        "cyclic_consequence": {"$ref": "#/$defs/nonempty"},
        "symmetric_projection": {"$ref": "#/$defs/nonempty"},
        "positivity_bound": {"$ref": "#/$defs/nonempty"},
        "theorem": {"$ref": "#/$defs/nonempty"},
        "translate_bounds": {"type": "array", "minItems": 9, "maxItems": 9, "items": {"$ref": "#/$defs/translate_row"}},
