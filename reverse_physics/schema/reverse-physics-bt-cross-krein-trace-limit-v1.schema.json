    "answer": {"$ref": "#/$defs/nonempty"},
    "orbit_Krein_completion": {
      "type": "object",
      "required": ["Hilbert_space", "Laurent_core", "indefinite_pairing", "fundamental_symmetry", "positive_product", "orbit_shift", "Hilbert_adjoint_of_Z", "Krein_adjoint_of_Z", "boost_generator", "coefficient_functional", "exact_rows"],
      "properties": {
        "Hilbert_space": {"$ref": "#/$defs/nonempty"},
        "Laurent_core": {"$ref": "#/$defs/nonempty"},
        "indefinite_pairing": {"$ref": "#/$defs/nonempty"},
        "fundamental_symmetry": {"const": "J_0 e_n=e_-n"},
        "positive_product": {"$ref": "#/$defs/nonempty"},
        "orbit_shift": {"const": "Z e_n=e_(n+1)"},
        "Hilbert_adjoint_of_Z": {"const": "Z^star=Z^-1"},
        "Krein_adjoint_of_Z": {"const": "Z^dagger=Z"},
        "boost_generator": {"$ref": "#/$defs/nonempty"},
        "coefficient_functional": {"$ref": "#/$defs/nonempty"},
