        "finite_rank_trace_branch": {"$ref": "#/$defs/nonempty"},
        "disposition": {"const": "NO_FINITE_NORMALIZED_POSITIVE_CYCLIC_TRACE_WITH_NONZERO_ORBIT_RANK_ONE_WEIGHT"}
      },
      "additionalProperties": false
    },
    "thermodynamic_trace_norm_barrier": {
      "type": "object",
