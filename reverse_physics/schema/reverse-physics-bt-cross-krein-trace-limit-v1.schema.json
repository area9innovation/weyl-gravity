    "schema_version",
    "dependency_tags",
    "lifecycle_state",
    "result_kind",
    "question",
    "answer",
    "orbit_Krein_completion",
    "cross_Krein_squeeze_core",
    "finite_rank_Born_trace",
    "normalized_trace_extension_no_go",
    "thermodynamic_trace_norm_barrier",
    "disposition",
    "missing_object_ledger",
    "does_not_establish",
    "next_gate",
    "provenance",
