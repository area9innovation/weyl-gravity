    "translate_row": {
      "type": "object",
      "required": ["cutoff", "symmetric_projection_rank", "common_rank_one_weight_upper_bound_if_tau_identity_is_one"],
      "properties": {
        "cutoff": {"type": "integer", "minimum": 0},
        "symmetric_projection_rank": {"type": "integer", "minimum": 1},
        "common_rank_one_weight_upper_bound_if_tau_identity_is_one": {"$ref": "#/$defs/rational"}
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/nonempty"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["source", "url", "equations", "current_version_check"],
      "properties": {"source": {"$ref": "#/$defs/nonempty"}, "url": {"format": "uri"}, "equations": {"$ref": "#/$defs/string_array"}, "current_version_check": {"$ref": "#/$defs/nonempty"}},
      "additionalProperties": false
    },
    "architecture_source": {
      "type": "object",
      "required": ["source", "url", "use"],
      "properties": {"source": {"$ref": "#/$defs/nonempty"}, "url": {"format": "uri"}, "use": {"$ref": "#/$defs/nonempty"}},
      "additionalProperties": false
    }
  }
}
