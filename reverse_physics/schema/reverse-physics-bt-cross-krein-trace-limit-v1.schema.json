      "properties": {
        "vacuum": {"$ref": "#/$defs/nonempty"},
        "Krein_norm": {"const": "[Psi_V,Psi_V]=1"},
        "positive_norm_squared": {"$ref": "#/$defs/nonempty"},
        "transported_Krein_projection": {"$ref": "#/$defs/nonempty"},
        "finite_rank_trace": {"const": "Tr_fin(P_V)=1"},
        "positive_trace_norm": {"$ref": "#/$defs/nonempty"},
        "candidate_pair_amplitude": {"$ref": "#/$defs/nonempty"},
        "exact_log_trace_norm_density": {"$ref": "#/$defs/nonempty"},
        "derivative_witness": {"$ref": "#/$defs/nonempty"},
        "positivity": {"$ref": "#/$defs/nonempty"},
        "gamma_half_coefficient_times_mu_cubed_over_pi": {"$ref": "#/$defs/algebraic"},
        "gamma_half_radical": {"const": "(3sqrt(6)+sqrt(2)-8)/48"},
        "gamma_half_shifted_y": {"$ref": "#/$defs/nonempty"},
        "gamma_half_y_minimal_polynomial": {"const": "y^4-112y^2+2704=0"},
        "gamma_half_rational_bounds": {"const": "1/80 < ell*pi/mu^3 < 1/48"},
        "asymptotic_trace_norm": {"$ref": "#/$defs/nonempty"},
        "positive_normalization_cost": {"$ref": "#/$defs/nonempty"},
        "idempotence_cost": {"$ref": "#/$defs/nonempty"},
        "two_pair_normalized_Krein_norm_fixture": {"$ref": "#/$defs/rational"},
        "disposition": {"const": "NO_TRACE_NORM_THERMODYNAMIC_LIMIT_OF_THE_BT_NORMALIZED_KREIN_PROJECTION"}
