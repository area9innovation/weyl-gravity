          "maxItems": 9,
          "items": {"$ref": "#/$defs/orbit_row"}
        }
      },
      "additionalProperties": false
    },
    "cross_Krein_squeeze_core": {
      "type": "object",
      "required": ["weighted_nonzero_mode_condition", "normalized_modes", "generator", "Krein_adjoint", "factorization", "domain", "operator_status", "Krein_inverse", "implemented_shears", "CCR_check", "scope", "exact_fixtures"],
      "properties": {
        "weighted_nonzero_mode_condition": {"$ref": "#/$defs/string_array"},
        "normalized_modes": {"$ref": "#/$defs/string_array"},
        "generator": {"$ref": "#/$defs/nonempty"},
        "Krein_adjoint": {"const": "Q^dagger=-Q"},
        "factorization": {"$ref": "#/$defs/nonempty"},
        "domain": {"$ref": "#/$defs/nonempty"},
        "operator_status": {"const": "DENSELY_DEFINED_CLOSABLE_WITH_KREIN_INVERSE_ON_ITS_GAUSSIAN_IMAGE_CORE"},
        "Krein_inverse": {"$ref": "#/$defs/nonempty"},
        "implemented_shears": {"$ref": "#/$defs/string_array"},
        "CCR_check": {"$ref": "#/$defs/nonempty"},
        "scope": {"$ref": "#/$defs/nonempty"},
        "exact_fixtures": {
          "type": "object",
