          "properties": {
            "one_pair_z": {"$ref": "#/$defs/rational"},
            "one_pair_positive_norm_squared": {"$ref": "#/$defs/rational"},
            "one_pair_Krein_norm": {"$ref": "#/$defs/rational"},
            "two_pair_z_values": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/rational"}},
            "two_pair_positive_norm_squared": {"$ref": "#/$defs/rational"},
            "two_pair_Krein_norm": {"$ref": "#/$defs/rational"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
