{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-free-reconstruction-obstruction-v1.schema.json",
  "title": "BT free Euclidean reconstruction obstruction certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate",
    "schema_version",
    "created",
    "dependency_tags",
    "lifecycle_state",
    "result_kind",
    "question",
    "answer",
    "finite_volume_os_obstruction",
    "free_volume_uniform_estimate",
    "disposition",
    "missing_object_ledger",
    "next_gate",
    "does_not_establish",
    "provenance",
    "verification_commands",
    "tier_receipt",
    "checks",
    "report",
    "schema"
  ],
  "properties": {
    "certificate": {
      "const": "REVERSE_PHYSICS_BT_EUCLIDEAN_FREE_RECONSTRUCTION_OBSTRUCTION_V1"
    },
    "schema_version": {
      "const": "reverse-physics-bt-euclidean-free-reconstruction-obstruction-v1"
    },
    "created": {"const": "2026-08-14"},
    "dependency_tags": {
      "type": "array",
      "prefixItems": [
        {"const": "LOCAL-ALGEBRAIC"},
        {"const": "EUCLIDEAN-SPECTRAL"}
      ],
      "items": false
    },
    "lifecycle_state": {"const": "OBSTRUCTION_PROVED"},
    "result_kind": {"type": "string"},
    "question": {"type": "string"},
    "answer": {"type": "string"},
    "finite_volume_os_obstruction": {
      "type": "object",
      "required": [
        "coupling",
        "lattice",
        "reflection",
        "positive_time_half",
        "witness",
        "coefficients",
        "constant_shift_invariant",
        "four_dimensional_slice_average_reflected_norm",
        "persistence_lemma",
        "disposition"
      ]
    },
    "free_volume_uniform_estimate": {
      "type": "object",
      "required": [
        "family",
        "interpolation",
        "lattice_eigenvalue",
        "coefficient_variance",
        "elementary_spectral_bounds",
        "uniform_result",
        "obstruction",
        "continuum_consequence"
      ]
    },
    "disposition": {
      "type": "object",
      "required": [
        "ordinary_os_reflection_positivity_at_lambda_zero",
        "ordinary_os_reflection_positivity_near_lambda_zero",
        "ordinary_os_reflection_positivity_at_lambda_0p4",
        "krein_compatible_reconstruction",
        "free_uniform_l2_estimate",
        "free_uniform_h_minus_one_estimate",
        "interacting_uniform_estimate",
        "continuum_limit",
        "born_rule",
        "lorentzian_transfer"
      ]
    },
    "missing_object_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "next_gate": {"type": "string"},
    "does_not_establish": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "provenance": {
      "type": "object",
      "required": ["repository_base_commit", "inputs", "arithmetic"]
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string"}
    },
    "tier_receipt": {"type": "object"},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"type": "boolean"},
        "passed": {"type": "integer"},
        "total": {"type": "integer"},
        "failures": {"type": "array", "items": {"type": "string"}},
        "details": {
          "type": "object",
          "additionalProperties": {"type": "boolean"}
        }
      }
    },
    "report": {
      "const": "reverse_physics/reports/bt-euclidean-free-reconstruction-obstruction.md"
    },
    "schema": {
      "const": "reverse_physics/schema/reverse-physics-bt-euclidean-free-reconstruction-obstruction-v1.schema.json"
    }
  }
}
