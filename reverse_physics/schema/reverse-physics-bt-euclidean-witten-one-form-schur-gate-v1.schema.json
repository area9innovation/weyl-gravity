    "does_not_establish": {"$ref": "#/$defs/text_list"},
    "missing_object_ledger": {"$ref": "#/$defs/text_list"},
    "next_gate": {"$ref": "#/$defs/text"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_base_commit", "inputs", "arithmetic"],
      "properties": {
        "repository_base_commit": {"const": "06df41da"},
        "inputs": {"type": "array", "minItems": 4, "maxItems": 4},
        "arithmetic": {"$ref": "#/$defs/text"}
      }
    },
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-witten-one-form-schur-gate-v1.schema.json"},
    "report": {"const": "reverse_physics/reports/bt-euclidean-witten-one-form-schur-gate.md"},
    "independent_verifier": {"const": "reverse_physics/verify_bt_euclidean_witten_one_form_schur_gate.py"},
    "verification_commands": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/text"}}
