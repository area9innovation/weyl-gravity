        "lowest_mode_witten_operator_schur_reduction": {"const": "PROVED"},
        "volume_uniform_witten_schur_coercivity": {"const": "OPEN"},
        "controlled_low_rayleigh_sequence": {"const": "OPEN"},
        "actual_interacting_h_minus_one_second_moment": {"const": "OPEN"},
        "continuum_limit": {"const": "NOT_ESTABLISHED"},
        "born_rule": {"const": "NOT_ESTABLISHED"},
        "krein_reconstruction": {"const": "NOT_ASSESSED"},
        "lorentzian_transfer": {"const": "NOT_ESTABLISHED"}
      },
      "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 1},
        "failures": {"const": []},
        "details": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}}
      }
