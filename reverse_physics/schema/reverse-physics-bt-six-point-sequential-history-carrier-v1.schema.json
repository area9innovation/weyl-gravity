{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-six-point-sequential-history-carrier-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["certificate", "schema_version", "dependency_tags", "lifecycle_state", "result_kind", "question", "answer", "exact_channel_carrier", "finite_time_shell_normalization", "sequential_interference_boundary", "interpretation", "does_not_establish", "next_gate", "provenance", "verification_commands", "checks", "report", "schema"],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_SIX_POINT_SEQUENTIAL_HISTORY_CARRIER_V1"},
    "schema_version": {"const": "reverse-physics-bt-six-point-sequential-history-carrier-v1"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "lifecycle_state": {"const": "COEFFICIENT_COMPUTED"},
    "result_kind": {"$ref": "#/$defs/text"},
    "question": {"$ref": "#/$defs/text"},
    "answer": {"$ref": "#/$defs/text"},
    "exact_channel_carrier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel_count", "incidence_matrix", "incidence_determinant", "residue_map", "residue_map_determinant", "residue_map_inverse", "fixed_channel_residue_vector", "fixed_channel_born_norm", "complete_channel_gram", "complete_channel_gram_formula", "complete_channel_gram_spectrum", "complete_channel_gram_determinant", "sequential_diagonal_gram", "interference_gram", "interference_gram_formula", "interference_gram_spectrum", "density_split"],
      "properties": {
        "channel_count": {"const": 10},
        "incidence_matrix": {"$ref": "#/$defs/matrix10"},
        "incidence_determinant": {"const": "-9"},
        "residue_map": {"const": "R=(J-I)/4"},
        "residue_map_determinant": {"const": "-9/1048576"},
        "residue_map_inverse": {"$ref": "#/$defs/matrix10"},
        "fixed_channel_residue_vector": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/text"}},
        "fixed_channel_born_norm": {"const": "9/8"},
        "complete_channel_gram": {"$ref": "#/$defs/matrix10"},
        "complete_channel_gram_formula": {"const": "G=2*R^T*R=J+I/8"},
        "complete_channel_gram_spectrum": {"const": {"81/8": 1, "1/8": 9}},
        "complete_channel_gram_determinant": {"const": "81/1073741824"},
        "sequential_diagonal_gram": {"const": "G_seq=(9/8)*I"},
        "interference_gram": {"$ref": "#/$defs/matrix10"},
        "interference_gram_formula": {"const": "G_int=J-I"},
        "interference_gram_spectrum": {"const": {"9": 1, "-1": 9}},
        "density_split": {"const": "D=(9/8)*sum_A(1/s_A^2)+2*sum_{A<B}1/(s_A*s_B)"}
      }
    },
    "finite_time_shell_normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "exact_total_weight", "distribution_limit", "shell_coordinate", "squared_propagator_window", "matched_feynman_modulus", "coefficient_match", "BT_leading_sequential_history", "status"],
      "properties": {
        "window": {"const": "F_T(omega)=integral_0^T exp(i*omega*t) dt"},
        "exact_total_weight": {"const": "integral_R |F_T(omega)|^2 d_omega=2*pi*T"},
        "distribution_limit": {"const": "|F_T(omega)|^2/T -> 2*pi*delta(omega)"},
        "shell_coordinate": {"const": "s=2*E*omega+O(omega^2), E>0"},
        "squared_propagator_window": {"const": "|F_T(omega)|^2/(4*E^2) -> (pi*T/E)*delta(s)"},
        "matched_feynman_modulus": {"const": "1/(s^2+epsilon_s^2) -> (pi/epsilon_s)*delta(s)"},
        "coefficient_match": {"const": "epsilon_s=E/T"},
        "BT_leading_sequential_history": {"const": "(9*pi*T/(8*E))*delta(s)"},
        "status": {"const": "UNIVERSAL_FINITE_TIME_NORMALIZATION_NOT_BT_DYNAMICAL_AFFILIATION"}
      }
    },
    "sequential_interference_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequential_outcomes", "connected_interference", "isolated_channel_behavior", "what_is_gained", "what_is_not_gained"],
      "properties": {
        "sequential_outcomes": {"$ref": "#/$defs/text"},
        "connected_interference": {"$ref": "#/$defs/text"},
        "isolated_channel_behavior": {"$ref": "#/$defs/text"},
        "what_is_gained": {"$ref": "#/$defs/text"},
        "what_is_not_gained": {"$ref": "#/$defs/text"}
      }
    },
    "interpretation": {
      "const": {
        "on_shell_factorization_channel_carrier": "EXACTLY_CONSTRUCTED",
        "leading_sequential_history_normalization": "COEFFICIENT_COMPUTED",
        "connected_interference_distribution": "NOT_PRESCRIBED",
        "BT_dynamical_Moller_affiliation": "NOT_CONSTRUCTED",
        "finite_inclusive_probability": "NOT_CONSTRUCTED",
        "Eq19_all_orders": "NOT_PROVED"
      }
    },
    "does_not_establish": {"type": "array", "minItems": 11, "items": {"$ref": "#/$defs/text"}},
    "next_gate": {"$ref": "#/$defs/text"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_commit", "retrieval_date", "inputs", "method"],
      "properties": {
        "source_commit": {"const": "b37b11f6"},
        "retrieval_date": {"const": "2026-08-12"},
        "inputs": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"$ref": "#/$defs/text"}, "sha256": {"$ref": "#/$defs/hash"}}}},
        "method": {"$ref": "#/$defs/text"}
      }
    },
    "verification_commands": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/text"}},
    "checks": {"type": "object", "additionalProperties": false, "required": ["ok", "passed", "total", "failures", "details"], "properties": {"ok": {"const": true}, "passed": {"const": 16}, "total": {"const": 16}, "failures": {"const": []}, "details": {"type": "object", "minProperties": 16, "maxProperties": 16, "additionalProperties": {"const": true}}}},
    "report": {"const": "reverse_physics/reports/bt-six-point-sequential-history-carrier.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-six-point-sequential-history-carrier-v1.schema.json"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "matrix10": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/text"}}}
  }
}
