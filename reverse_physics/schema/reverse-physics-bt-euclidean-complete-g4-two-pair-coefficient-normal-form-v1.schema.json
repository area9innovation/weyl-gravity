{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-complete-g4-two-pair-coefficient-normal-form-v1.schema.json",
  "title": "BT complete-g4 two-pair coefficient normal-form certificate",
  "type": "object",
  "required": [
    "certificate", "schema_version", "created", "dependency_tags",
    "lifecycle_state", "result_kind", "question", "answer", "data",
    "data_sha256", "producer", "producer_sha256", "normalization",
    "pair_four", "pair_seven", "comparison_gate", "method_disposition",
    "checks", "does_not_establish", "missing_object_ledger", "next_gate",
    "provenance", "schema", "report", "independent_verifier",
    "verification_commands"
  ],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_COMPLETE_G4_TWO_PAIR_COEFFICIENT_NORMAL_FORM_V1"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-complete-g4-two-pair-coefficient-normal-form-v1"},
    "created": {"type": "string"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL"]},
    "lifecycle_state": {"const": "TWO_PAIR_COEFFICIENT_NORMAL_FORMS_PROVED_COMPARISON_OPEN"},
    "result_kind": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "answer": {"type": "string", "minLength": 1},
    "data": {"const": "reverse_physics/data/bt_euclidean_complete_g4_two_pair_coefficient_normal_form_v1.json"},
    "data_sha256": {"$ref": "#/$defs/sha256"},
    "producer": {"const": "reverse_physics/bt_euclidean_complete_g4_two_pair_coefficient_normal_form.py"},
    "producer_sha256": {"$ref": "#/$defs/sha256"},
    "normalization": {
      "type": "object",
      "required": ["external_mode", "volume", "coefficient_scale", "status"],
      "properties": {
        "external_mode": {"type": "string"},
        "volume": {"const": "N=L^4"},
        "coefficient_scale": {"const": "I_j(L)/(N*omega(p_L))"},
        "status": {"const": "COMMON_NORMALIZATION_FIXED"}
      },
      "additionalProperties": false
    },
    "pair_four": {
      "type": "object",
      "required": ["finite_volume_definition", "limit", "coefficient", "green_constant", "integer_sum", "soft_cubic_limit", "tadpole_limit", "dominating_tail", "walk_cutoff_half_steps", "A_4_lower", "A_4_lower_derivation", "cube_radius", "S_4_cube_lower", "pi_upper", "magnitude_lower", "magnitude_lower_decimal_floor", "status"],
      "properties": {
        "finite_volume_definition": {"type": "string"},
        "limit": {"type": "string"},
        "coefficient": {"const": "c_4=-(2*A_4/pi^4)*S_4"},
        "green_constant": {"type": "string"},
        "integer_sum": {"type": "string"},
        "soft_cubic_limit": {"type": "string"},
        "tadpole_limit": {"type": "string"},
        "dominating_tail": {"type": "string"},
        "walk_cutoff_half_steps": {"const": 30},
        "A_4_lower": {"$ref": "#/$defs/rational"},
        "A_4_lower_derivation": {"type": "string"},
        "cube_radius": {"const": 10},
        "S_4_cube_lower": {"$ref": "#/$defs/rational"},
        "pi_upper": {"const": {"numerator": 22, "denominator": 7}},
        "magnitude_lower": {"$ref": "#/$defs/rational"},
        "magnitude_lower_decimal_floor": {"const": "0.01613"},
        "status": {"const": "EXACT_STRICTLY_NEGATIVE_COEFFICIENT_NORMAL_FORM_AND_RATIONAL_GAP"}
      },
      "additionalProperties": false
    },
    "pair_seven": {
      "type": "object",
      "required": ["finite_volume_definition", "block_derivative_definition", "six_term_derivative", "collapsed_derivative", "limit", "coefficient", "domination", "positive_fixture", "status"],
      "properties": {
        "finite_volume_definition": {"type": "string"},
        "block_derivative_definition": {"type": "string"},
        "six_term_derivative": {"type": "string"},
        "collapsed_derivative": {"const": "D_4(q,r)=[omega(q)*sin(q_1)+omega(r)*sin(r_1)+omega(s)*sin(s_1)]/6, s=-q-r"},
        "limit": {"type": "string"},
        "coefficient": {"type": "string"},
        "domination": {"type": "string"},
        "positive_fixture": {"type": "string"},
        "status": {"const": "EXACT_STRICTLY_POSITIVE_FINITE_COEFFICIENT_NORMAL_FORM"}
      },
      "additionalProperties": false
    },
    "comparison_gate": {
      "type": "object",
      "required": ["pair_four_bound", "pair_seven_sign", "noncancellation", "conditional_reduction", "status"],
      "properties": {
        "pair_four_bound": {"const": "c_4<-0.01613"},
        "pair_seven_sign": {"const": "c_7>0"},
        "noncancellation": {"const": "OPEN"},
        "conditional_reduction": {"type": "string"},
        "status": {"const": "TWO_EXPLICIT_CONSTANTS_PROVED_NUMERICAL_SEPARATION_OPEN"}
      },
      "additionalProperties": false
    },
    "method_disposition": {
      "type": "object",
      "required": ["pair_4_coefficient_normal_form", "pair_7_coefficient_normal_form", "combined_pair_4_pair_7_coefficient", "complete_seven_kernel_large_volume_sign_and_scaling", "complete_M4_large_volume_sign_and_scaling", "nonperturbative_annealed_score", "actual_interacting_h_minus_one_second_moment", "continuum_limit", "born_rule", "krein_reconstruction", "lorentzian_transfer"],
      "properties": {
        "pair_4_coefficient_normal_form": {"const": "PROVED_STRICTLY_NEGATIVE"},
        "pair_7_coefficient_normal_form": {"const": "PROVED_STRICTLY_POSITIVE_FINITE"},
        "combined_pair_4_pair_7_coefficient": {"const": "OPEN"},
        "complete_seven_kernel_large_volume_sign_and_scaling": {"const": "OPEN"},
        "complete_M4_large_volume_sign_and_scaling": {"const": "OPEN"},
        "nonperturbative_annealed_score": {"const": "OPEN"},
        "actual_interacting_h_minus_one_second_moment": {"const": "OPEN"},
        "continuum_limit": {"const": "NOT_ESTABLISHED"},
        "born_rule": {"const": "NOT_ESTABLISHED"},
        "krein_reconstruction": {"const": "NOT_ASSESSED"},
        "lorentzian_transfer": {"const": "NOT_ESTABLISHED"}
      },
      "additionalProperties": false
    },
    "checks": {"type": "object", "minProperties": 7, "additionalProperties": {"const": true}},
    "does_not_establish": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "missing_object_ledger": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "required": ["repository_base_commit", "inputs", "exact_arithmetic", "assumptions"],
      "properties": {
        "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "inputs": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/input"}},
        "exact_arithmetic": {"type": "string"},
        "assumptions": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-complete-g4-two-pair-coefficient-normal-form-v1.schema.json"},
    "report": {"const": "reverse_physics/reports/bt-euclidean-complete-g4-two-pair-coefficient-normal-form.md"},
    "independent_verifier": {"const": "reverse_physics/verify_bt_euclidean_complete_g4_two_pair_coefficient_normal_form.py"},
    "verification_commands": {"type": "array", "minItems": 4, "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "rational": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "input": {"type": "object", "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false}
  }
}
