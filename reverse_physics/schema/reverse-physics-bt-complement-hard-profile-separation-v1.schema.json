    "disposition": {
      "const": {
        "rho_only_unification": "EXACTLY_REFUTED_ON_SHARED_FIXTURE",
        "complement_and_hard_profile_parameter_separation": "PROVED_ON_SHARED_FIXTURE",
        "combined_profile_cross_Krein_architecture": "TYPE_FIXED_NOT_CONSTRUCTED",
