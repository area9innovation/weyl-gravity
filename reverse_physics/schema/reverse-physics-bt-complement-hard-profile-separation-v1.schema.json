    "does_not_establish": {"type": "array", "minItems": 11, "maxItems": 11},
    "next_gate": {"type": "string", "minLength": 450},
    "provenance": {
      "type": "object",
      "required": ["source_commit", "retrieval_date", "inputs"],
      "properties": {
        "source_commit": {"pattern": "^[0-9a-f]{7,40}$"},
        "retrieval_date": {"const": "2026-08-11"},
        "inputs": {"type": "array", "minItems": 5, "maxItems": 5}
      }
    },
    "verification_commands": {"type": "array", "minItems": 3, "maxItems": 3},
    "checks": {
      "type": "object",
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 15},
        "total": {"const": 15},
        "failures": {"const": []},
        "details": {"type": "object", "minProperties": 15, "maxProperties": 15}
      }
    },
    "report": {"const": "reverse_physics/reports/bt-complement-hard-profile-separation.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-complement-hard-profile-separation-v1.schema.json"}
