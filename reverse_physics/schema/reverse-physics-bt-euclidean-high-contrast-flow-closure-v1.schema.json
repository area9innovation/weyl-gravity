{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-high-contrast-flow-closure-v1.schema.json",
  "title": "BT Euclidean high-contrast flow closure certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actual_gibbs_corollary",
    "answer",
    "certificate",
    "checks",
    "created",
    "dependency_tags",
    "does_not_establish",
    "exact_fixtures",
    "finite_amplitude_theorem",
    "lifecycle_state",
    "next_gate",
    "provenance",
    "question",
    "report",
    "research_disposition",
    "result_kind",
    "schema",
    "schema_version",
    "tier_receipt",
    "verification_commands",
    "verifier"
  ],
  "properties": {
    "actual_gibbs_corollary": {"$ref": "#/$defs/stringMap"},
    "answer": {"type": "string", "minLength": 1},
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_HIGH_CONTRAST_FLOW_CLOSURE_V1"},
    "checks": {"$ref": "#/$defs/checkSummary"},
    "created": {"type": "string", "format": "date"},
    "dependency_tags": {
      "type": "array",
      "prefixItems": [
        {"const": "LOCAL-ALGEBRAIC"},
        {"const": "EUCLIDEAN-SPECTRAL"}
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 8,
      "items": {"type": "string", "minLength": 1}
    },
    "exact_fixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/fixture"}
    },
    "finite_amplitude_theorem": {"$ref": "#/$defs/stringMap"},
    "lifecycle_state": {"const": "HIGH_CONTRAST_SECTOR_CLOSED_MODERATE_MULTISCALE_GATE_OPEN"},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assumptions", "exact_arithmetic", "inputs", "repository_base_commit"],
      "properties": {
        "assumptions": {
          "type": "array",
          "minItems": 3,
          "items": {"type": "string", "minLength": 1}
        },
        "exact_arithmetic": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "repository_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "question": {"type": "string", "minLength": 1},
    "report": {"const": "reverse_physics/reports/bt-euclidean-high-contrast-flow-closure.md"},
    "research_disposition": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "minProperties": 12
    },
    "result_kind": {"type": "string", "minLength": 1},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-high-contrast-flow-closure-v1.schema.json"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-high-contrast-flow-closure-v1"},
    "tier_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_policy", "scoped_command_receipts", "tier_0", "tier_1", "tier_2", "tier_3"],
      "properties": {
        "memory_policy": {"type": "string", "minLength": 1},
        "scoped_command_receipts": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "tier_0": {"type": "string", "minLength": 1},
        "tier_1": {"type": "string", "minLength": 1},
        "tier_2": {"type": "string", "minLength": 1},
        "tier_3": {"type": "string", "minLength": 1}
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "verifier": {"const": "reverse_physics/verify_bt_euclidean_high_contrast_flow_closure.py"}
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denominator", "numerator"],
      "properties": {
        "denominator": {"type": "integer", "minimum": 1},
        "numerator": {"type": "integer"}
      }
    },
    "rationalArray": {
      "type": "array",
      "items": {"$ref": "#/$defs/rational"}
    },
    "integerMatrix": {
      "type": "array",
      "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1},
      "minProperties": 6
    },
    "checkSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["details", "failures", "ok", "passed", "total"],
      "properties": {
        "details": {
          "type": "object",
          "additionalProperties": {"type": "boolean"},
          "minProperties": 9
        },
        "failures": {"type": "array", "items": {"type": "string"}},
        "ok": {"type": "boolean"},
        "passed": {"type": "integer", "minimum": 0},
        "total": {"type": "integer", "minimum": 1}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "equal_edge",
        "error_current",
        "head",
        "main_current",
        "normalized_ratio",
        "ratio",
        "tail"
      ],
      "properties": {
        "current": {"$ref": "#/$defs/rational"},
        "equal_edge": {"type": "boolean"},
        "error_current": {"$ref": "#/$defs/rational"},
        "head": {"type": "integer", "minimum": 0},
        "main_current": {"$ref": "#/$defs/rational"},
        "normalized_ratio": {"$ref": "#/$defs/rational"},
        "ratio": {"$ref": "#/$defs/rational"},
        "tail": {"type": "integer", "minimum": 0}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bounded_remainder",
        "checks",
        "degree",
        "edges",
        "error_divergence",
        "gradient",
        "main_flow_divergence",
        "maximum_edge_ratio",
        "name",
        "neighbors",
        "normalized_outgoing_mass",
        "norms",
        "omega",
        "residual",
        "vertex_count"
      ],
      "properties": {
        "bounded_remainder": {"$ref": "#/$defs/rationalArray"},
        "checks": {
          "type": "object",
          "additionalProperties": {"type": "boolean"},
          "minProperties": 11
        },
        "degree": {"type": "integer", "minimum": 2},
        "edges": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/edge"}},
        "error_divergence": {"$ref": "#/$defs/rationalArray"},
        "gradient": {"$ref": "#/$defs/rationalArray"},
        "main_flow_divergence": {"$ref": "#/$defs/rationalArray"},
        "maximum_edge_ratio": {"$ref": "#/$defs/rational"},
        "name": {"type": "string", "minLength": 1},
        "neighbors": {"$ref": "#/$defs/integerMatrix"},
        "normalized_outgoing_mass": {"$ref": "#/$defs/rationalArray"},
        "norms": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "divergence_l1",
            "divergence_l2_squared",
            "error_divergence_norm_squared",
            "flow_mass",
            "gradient_norm_squared",
            "residual_norm_squared"
          ],
          "properties": {
            "divergence_l1": {"$ref": "#/$defs/rational"},
            "divergence_l2_squared": {"$ref": "#/$defs/rational"},
            "error_divergence_norm_squared": {"$ref": "#/$defs/rational"},
            "flow_mass": {"$ref": "#/$defs/rational"},
            "gradient_norm_squared": {"$ref": "#/$defs/rational"},
            "residual_norm_squared": {"$ref": "#/$defs/rational"}
          }
        },
        "omega": {"$ref": "#/$defs/rationalArray"},
        "residual": {"$ref": "#/$defs/rationalArray"},
        "vertex_count": {"type": "integer", "minimum": 3}
      }
    }
  }
}
