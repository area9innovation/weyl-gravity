      "properties": {
        "selected_finite_time_q8": {"const": "COEFFICIENT_COMPUTED"},
        "selected_finite_time_q9": {"const": "EXACTLY_ZERO"},
        "selected_finite_time_q10": {"const": "COEFFICIENT_COMPUTED_AS_EXACT_PACKET_FUNCTIONAL"},
        "selected_q10_common_Born": {"const": "PROVED"}, "selected_q10_sign": {"const": "NOT_DETERMINED"},
        "selected_Rt_dressing": {"const": "CANCELLED_COEFFICIENTWISE"},
