      "properties": {
        "scheme": {"type": "string"}, "triangle_scale_derivative": {"const": "0"},
        "bubble_scale_derivative": {"type": "string"}, "q10_scale_derivative": {"type": "string"},
        "beta": {"type": "string"}, "leading_running": {"type": "string"}, "cancellation": {"type": "string"},
        "finite_scheme_rule": {"type": "string"}, "status": {"const": "ORDER_LAMBDA10_PACKET_PROBABILITY_IS_RG_INVARIANT"}
