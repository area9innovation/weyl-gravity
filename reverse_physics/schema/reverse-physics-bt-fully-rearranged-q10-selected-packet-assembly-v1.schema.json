        "pulled_y4": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "pulled_y5": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "pulled_y6": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string"}},
        "y5_norm": {"type": "string"}, "second_order_dressing_cross": {"type": "string"},
        "dressing_sum": {"const": "0"}, "fixed_q10": {"type": "string"}, "pulled_q10": {"type": "string"},
        "status": {"const": "APPARENT_Y5_NORM_CANCELS_SECOND_ORDER_SIMILARITY_DRESSING"}
