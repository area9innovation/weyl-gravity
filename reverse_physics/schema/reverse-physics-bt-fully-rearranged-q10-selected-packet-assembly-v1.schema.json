      "type": "object", "additionalProperties": false,
      "required": ["total", "passed", "ok", "failures", "details"],
      "properties": {
        "total": {"const": 33}, "passed": {"const": 33}, "ok": {"const": true},
        "failures": {"type": "array", "maxItems": 0},
        "details": {"type": "object", "minProperties": 33, "maxProperties": 33, "additionalProperties": {"const": true}}
      }
    }
