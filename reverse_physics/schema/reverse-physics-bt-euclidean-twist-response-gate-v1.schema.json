{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-euclidean-twist-response-gate-v1.schema.json",
  "title": "BT Euclidean uniform-twist response gate certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate", "schema_version", "created", "dependency_tags",
    "lifecycle_state", "result_kind", "question", "answer",
    "exact_uniform_twist_identity", "exact_fixture",
    "finite_volume_diagnostic", "witten_nontransfer_obstruction",
    "method_disposition", "missing_object_ledger", "next_gate",
    "does_not_establish", "provenance", "verification_commands",
    "tier_receipt", "checks", "schema", "report", "verifier"
  ],
  "properties": {
    "certificate": {"const": "REVERSE_PHYSICS_BT_EUCLIDEAN_TWIST_RESPONSE_GATE_V1"},
    "schema_version": {"const": "reverse-physics-bt-euclidean-twist-response-gate-v1"},
    "created": {"const": "2026-08-15"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "EUCLIDEAN-SPECTRAL", "REDUCED-MODE"]},
    "lifecycle_state": {"const": "TWIST_RESPONSE_IDENTITY_PROVED_FINITE_VOLUME_SIGN_OBSERVED"},
    "result_kind": {"$ref": "#/$defs/text"},
    "question": {"$ref": "#/$defs/text"},
    "answer": {"$ref": "#/$defs/text"},
    "exact_uniform_twist_identity": {
      "type": "object",
      "required": ["twisted_residual", "twisted_action", "integrated_current", "diamagnetic_curvature", "partition_function", "free_energy_density", "reflection_ward", "response", "susceptibility", "axis_average_identity", "moment_definitions", "orbit_relation", "alpha_before_relation", "alpha_after_relation", "one_sided_consequence", "status"],
      "properties": {
        "twisted_residual": {"$ref": "#/$defs/text"},
        "twisted_action": {"$ref": "#/$defs/text"},
        "integrated_current": {"$ref": "#/$defs/text"},
        "diamagnetic_curvature": {"$ref": "#/$defs/text"},
        "partition_function": {"$ref": "#/$defs/text"},
        "free_energy_density": {"$ref": "#/$defs/text"},
        "reflection_ward": {"const": "E_mu[I_mu]=0"},
        "response": {"$ref": "#/$defs/text"},
        "susceptibility": {"const": "chi_L=Var_mu(I_mu)/(N*lambda^2)>=0"},
        "axis_average_identity": {"$ref": "#/$defs/text"},
        "moment_definitions": {"$ref": "#/$defs/text"},
        "orbit_relation": {"$ref": "#/$defs/text"},
        "alpha_before_relation": {"$ref": "#/$defs/text"},
        "alpha_after_relation": {"const": "alpha=2U-2V+2R=E[D_mu]/N"},
        "one_sided_consequence": {"$ref": "#/$defs/text"},
        "status": {"const": "PROVED_FINITE_VOLUME"}
      },
      "additionalProperties": false
    },
    "exact_fixture": {"type": "object"},
    "finite_volume_diagnostic": {
      "type": "object",
      "required": ["evidence_type", "observation_path", "observation_sha256", "summaries", "interpretation"],
      "properties": {
        "evidence_type": {"const": "NUMERICAL_FINITE_VOLUME_OBSERVED"},
        "observation_path": {"const": "reverse_physics/data/bt_euclidean_twist_response_observations_v1.json"},
        "observation_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "summaries": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
        "interpretation": {"$ref": "#/$defs/text"}
      },
      "additionalProperties": false
    },
    "witten_nontransfer_obstruction": {
      "type": "object",
      "required": ["statement", "exact_family", "uniform_twist_rayleigh", "fixture_epsilon", "orthogonal_inverse_response", "consequence", "scope", "status"],
      "properties": {
        "statement": {"$ref": "#/$defs/text"},
        "exact_family": {"$ref": "#/$defs/text"},
        "uniform_twist_rayleigh": {"$ref": "#/$defs/fraction"},
        "fixture_epsilon": {"$ref": "#/$defs/fraction"},
        "orthogonal_inverse_response": {"$ref": "#/$defs/fraction"},
        "consequence": {"$ref": "#/$defs/text"},
        "scope": {"const": "logical non-transfer witness only; not a BT counterexample"},
        "status": {"const": "OBSTRUCTION_TO_INFERENCE"}
      },
      "additionalProperties": false
    },
    "method_disposition": {
      "type": "object",
      "required": ["uniform_twist_free_energy_identity", "diamagnetic_alpha_identification", "paramagnetic_integrated_current_subtraction", "positive_L6_L8_complete_twist_response", "positive_thermodynamic_twist_modulus", "inhomogeneous_low_momentum_response_kernel", "response_to_witten_coercivity_transfer", "volume_uniform_witten_coercivity", "actual_interacting_h_minus_one_second_moment"],
      "properties": {
        "uniform_twist_free_energy_identity": {"const": "PROVED"},
        "diamagnetic_alpha_identification": {"const": "PROVED"},
        "paramagnetic_integrated_current_subtraction": {"const": "PROVED"},
        "positive_L6_L8_complete_twist_response": {"const": "OBSERVED_NOT_CERTIFIED"},
        "positive_thermodynamic_twist_modulus": {"const": "OPEN"},
        "inhomogeneous_low_momentum_response_kernel": {"const": "OPEN"},
        "response_to_witten_coercivity_transfer": {"const": "OPEN"},
        "volume_uniform_witten_coercivity": {"const": "OPEN"},
        "actual_interacting_h_minus_one_second_moment": {"const": "OPEN"}
      },
      "additionalProperties": false
    },
    "missing_object_ledger": {"$ref": "#/$defs/textArray"},
    "next_gate": {"$ref": "#/$defs/text"},
    "does_not_establish": {"$ref": "#/$defs/textArray"},
    "provenance": {"type": "object"},
    "verification_commands": {"$ref": "#/$defs/textArray"},
    "tier_receipt": {"type": "object"},
    "checks": {
      "type": "object",
      "required": ["ok", "passed", "total", "failures", "details"],
      "properties": {
        "ok": {"const": true},
        "passed": {"const": 20},
        "total": {"const": 20},
        "failures": {"type": "array", "maxItems": 0},
        "details": {"type": "object", "minProperties": 20, "maxProperties": 20, "additionalProperties": {"const": true}}
      },
      "additionalProperties": false
    },
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-euclidean-twist-response-gate-v1.schema.json"},
    "report": {"const": "reverse_physics/reports/bt-euclidean-twist-response-gate.md"},
    "verifier": {"const": "reverse_physics/verify_bt_euclidean_twist_response_gate.py"}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "textArray": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
    "fraction": {
      "type": "object", "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {"numerator": {"type": "integer"}, "denominator": {"type": "integer", "minimum": 1}}
    }
  }
}
