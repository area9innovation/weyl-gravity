    "current_identity": {"type": "object", "required": ["residual", "action", "canonical_oriented_current", "action_gradient", "fourier_divergence", "axial_score_identity", "equivalent_current_gate", "status"], "properties": {"status": {"const": "EXACT_ONE_SOFT_FACTOR_AND_EQUIVALENT_SUSCEPTIBILITY_GATE"}}, "additionalProperties": {"type": "string"}},
