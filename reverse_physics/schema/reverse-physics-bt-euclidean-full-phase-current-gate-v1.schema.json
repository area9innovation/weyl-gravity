    "missing_object_ledger": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "next_gate": {"type": "string", "minLength": 1},
    "provenance": {"type": "object", "required": ["repository_base_commit", "inputs", "exact_arithmetic", "analytic_arithmetic", "assumptions"], "properties": {"repository_base_commit": {"const": "d07ce6c0c0d621b704e319e636839bf5510b13e5"}, "inputs": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/input"}}, "exact_arithmetic": {"type": "string"}, "analytic_arithmetic": {"type": "string"}, "assumptions": {"type": "array", "minItems": 3, "items": {"type": "string"}}}, "additionalProperties": false},
