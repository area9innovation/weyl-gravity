        "not_established_relation": {"$ref": "#/$defs/text"},
        "status": {"const": "OPERATIONAL_INSTRUMENT_EXACT_LOCAL_KRAUS_REALIZATION_OPEN"}
      }
    },
    "disposition": {"type": "object", "minProperties": 12, "maxProperties": 12, "additionalProperties": {"$ref": "#/$defs/text"}},
    "does_not_establish": {"type": "array", "minItems": 14, "maxItems": 14, "items": {"$ref": "#/$defs/text"}},
    "next_gate": {"$ref": "#/$defs/text"},
    "checks": {"type": "object", "additionalProperties": false, "required": ["total", "passed", "ok", "failures", "details"],
      "properties": {
        "total": {"const": 28}, "passed": {"const": 28}, "ok": {"const": true}, "failures": {"const": []},
        "details": {"type": "object", "minProperties": 28, "maxProperties": 28, "additionalProperties": {"const": true}}
      }
