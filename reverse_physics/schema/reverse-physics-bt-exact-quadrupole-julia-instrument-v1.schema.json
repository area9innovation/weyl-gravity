      "properties": {
        "input_decomposition": {"$ref": "#/$defs/text"},
        "response_mode": {"$ref": "#/$defs/text"},
        "click_Kraus": {"const": "K_click=(1/2)|0><u2|"},
        "click_norm": {"const": "1/2"},
        "source_effect": {"const": "E_click=K_click^*K_click=(1/4)P_u"},
        "no_click_Kraus": {"const": "K_no=I+(sqrt(3)/2-1)P_u"},
        "no_click_effect": {"const": "E_no=K_no^*K_no=I-(1/4)P_u"},
