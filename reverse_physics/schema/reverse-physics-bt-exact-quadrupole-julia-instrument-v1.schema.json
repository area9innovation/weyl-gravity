      "properties": {
        "quadrupole": {"const": "P2(c)=(3*c^2-1)/2"},
        "mean": {"const": "int_-1^1 P2(c)dc=0"},
        "cubic_moment": {"const": "int_-1^1 P2(c)^3dc=4/35"},
        "scalar_projection_coefficient": {"const": "(1/2)*int_-1^1 P2(c)^3dc=2/35"},
        "consequence": {"$ref": "#/$defs/text"},
        "status": {"const": "FULL_LOCAL_EXPONENTIAL_DARKNESS_NOT_DERIVED"}
      }
    },
    "locality_ledger": {"type": "object", "additionalProperties": false,
      "required": ["underlying_density", "click_compression", "global_objects_in_click", "global_object_in_no_click", "established_relation", "not_established_relation", "status"],
      "properties": {
        "underlying_density": {"$ref": "#/$defs/text"},
