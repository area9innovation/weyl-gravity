      "properties": {
        "source_fixture_basis": {"const": ["u2", "u2_perp"]},
        "click_matrix": {"const": [["1/2", "0"]]},
        "source_defect": {"const": [["sqrt(3)/2", "0"], ["0", "1"]]},
        "output_defect": {"const": [["sqrt(3)/2"]]},
        "Julia_matrix": {"const": [["sqrt(3)/2", "0", "-1/2"], ["0", "1", "0"], ["1/2", "0", "sqrt(3)/2"]]},
        "intertwining": {"const": "D_Y K_click=K_click D_X"},
        "unitarity": {"const": "U_J^* U_J=U_J U_J^*=I exactly"},
        "detector_isometry": {"$ref": "#/$defs/text"},
        "status": {"const": "EXACT_JULIA_UNITARY_DILATION"}
