        "orthogonality": {"$ref": "#/$defs/text"},
        "strict_response": {"$ref": "#/$defs/text"},
        "exact_instrument_probability": {"const": "p_click[X(lambda)]=(1/4)|<u2,X(lambda)>|^2"},
        "coefficient_statement": {"$ref": "#/$defs/text"},
        "detector_coupling_status": {"const": "EXACT_FINITE_STRENGTH_NO_G_DETECTOR_REMAINDER"},
