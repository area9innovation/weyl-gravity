        "window_bound": {"type": "string"}, "bubble_thresholds": {"type": "string"}, "bridge_poles": {"type": "string"},
        "nu_axis": {"type": "string"}, "rho_axis": {"type": "string"}, "cancellation_line": {"type": "string"}, "generic_cone": {"type": "string"},
