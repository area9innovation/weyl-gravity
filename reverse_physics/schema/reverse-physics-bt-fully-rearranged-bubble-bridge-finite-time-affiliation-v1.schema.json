      "required": ["off_diagonal_bubble_time_distribution", "six_time_orderings", "finite_time_bubble_bridge", "finite_time_MSbar_counterterm", "covariant_boundary", "bridge_shell", "selected_source_compact_packet", "isolated_common_Born_interference", "selected_source_direct_auxiliary_connected_finite_time_T6", "full_carrier_zero_mode_extension", "connected_y4_y6_interference_value", "complete_q10", "general_Eq19", "gravity_or_metric_BV_BRST_transfer", "Lorentzian_causal_claim"],
      "properties": {
        "off_diagonal_bubble_time_distribution": {"const": "CONSTRUCTED"}, "six_time_orderings": {"const": "EXHAUSTIVE"},
