        "full_carrier_zero_mode_extension": {"const": "NOT_CONSTRUCTED"}, "connected_y4_y6_interference_value": {"const": "NOT_COMPUTED"},
        "complete_q10": {"const": "NOT_COMPUTED"}, "general_Eq19": {"const": "NOT_PROVED"},
