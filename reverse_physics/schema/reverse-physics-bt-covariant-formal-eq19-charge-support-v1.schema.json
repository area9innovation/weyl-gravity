        "passed": {"const": 29},
        "total": {"const": 29},
        "failures": {"const": []},
        "details": {
          "type": "object",
          "minProperties": 29,
          "maxProperties": 29,
          "additionalProperties": {"const": true}
        }
      }
    },
    "report": {"const": "reverse_physics/reports/bt-covariant-formal-eq19-charge-support.md"},
    "schema": {"const": "reverse_physics/schema/reverse-physics-bt-covariant-formal-eq19-charge-support-v1.schema.json"}
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "integer"},
        "denominator": {"type": "integer", "minimum": 1}
      }
    },
    "omega_coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coupling_order", "varphi_power", "coefficient", "orbit_power", "charge"],
      "properties": {
        "coupling_order": {"type": "integer", "minimum": -1},
        "varphi_power": {"type": "integer", "minimum": 0},
        "coefficient": {"$ref": "#/$defs/rational"},
        "orbit_power": {"const": 1},
        "charge": {"const": 1}
      }
    },
    "upsilon_term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "varphi_power", "coefficient"],
      "properties": {
        "kind": {
          "enum": [
            "varphi_power_times_Box_varphi",
            "varphi_power_times_gradient_square"
          ]
        },
        "varphi_power": {"type": "integer", "minimum": 0},
        "coefficient": {"$ref": "#/$defs/rational"}
      }
    },
    "upsilon_coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coupling_order", "terms", "orbit_power", "charge"],
      "properties": {
        "coupling_order": {"type": "integer", "minimum": 0},
        "terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/upsilon_term"}
        },
        "orbit_power": {"const": -1},
        "charge": {"const": -1}
      }
    },
    "string_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string"}
      }
