{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-physics-bt-covariant-formal-eq19-charge-support-v1.schema.json",
  "title": "BT covariant formal Eq. 19 charge-support certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "certificate",
    "schema_version",
    "dependency_tags",
    "lifecycle_state",
    "result_kind",
    "question",
    "answer",
    "assumptions",
