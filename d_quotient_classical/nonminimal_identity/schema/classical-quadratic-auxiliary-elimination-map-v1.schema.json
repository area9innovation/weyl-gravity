{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/classical-quadratic-auxiliary-elimination-map-v1.schema.json",
  "type": "object",
  "required": ["schema", "result_id", "result_state", "lifecycle", "dependency_tags", "quadratic_auxiliary_map", "disposition", "claim_flags", "provenance", "human_report"],
  "properties": {
    "schema": {"const": "classical-quadratic-auxiliary-elimination-map-v1"},
    "result_id": {"const": "CLASSICAL_QUADRATIC_AUXILIARY_ELIMINATION_MAP_V1"},
    "result_state": {"const": "QUADRATIC_VECTOR_COMPONENT_EXPORTED_ONE_CUBIC_CHANNEL_CANCELED_FULL_CYCLIC_EQUIVALENCE_OPEN"},
    "lifecycle": {"const": "CLASSIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "quadratic_auxiliary_map": {
      "type": "object",
      "required": ["full_source_to_split_map", "source_to_split_homogeneous_quadratic_component", "fixture"],
      "properties": {
        "full_source_to_split_map": {"const": "phi_hat=phi-A_g^{-1}G^b(g,b)"},
        "source_to_split_homogeneous_quadratic_component": {"const": "F_(2)(v)=v tensor v-(1/2)g v^2"},
        "fixture": {"type": "object", "properties": {"source_f_hat_v_v_mixed_polarization": {"const": "-1"}, "inverse_shift_mass_cross_mixed_polarization": {"const": "1"}, "corrected_channel_residual": {"const": "0"}}}
      }
    },
    "human_report": {"const": "d_quotient_classical/reports/classical-quadratic-auxiliary-elimination-map-v1.md"}
  }
}
