import prelude;
import testing;
import math/rational;
import math/qmat;
import math/snf;
import math/bigint;
import ds/vec;

fn e(r: i64, c: i64, n: i64) -> QEnt {
  return new QEnt(r, c, rat(n, 1));
}

fn matrix(r: i64, c: i64, entries: Vec<QEnt>) -> QMat {
  return qm_from_triplets(r, c, entries);
}

fn main() -> i64 {
  let p: Vec<QEnt> = vec_new<QEnt>(system_allocator(), 1);
  vec_push(p, e(0, 0, 1));
  let primitive: QMat = matrix(2, 1, p);
  let fp: Vec<Big> = snf_invariant_factors(primitive);
  assert(snf_rank(primitive) == 1);
  assert(usize_to_i64(len(fp)) == 1);
  assert(vec_get_ref(fp, (0:usize)) == big_from_i64(1));

  let n: Vec<QEnt> = vec_new<QEnt>(system_allocator(), 1);
  vec_push(n, e(0, 0, 2));
  let nonprimitive: QMat = matrix(2, 1, n);
  let fnp: Vec<Big> = snf_invariant_factors(nonprimitive);
  assert(snf_rank(nonprimitive) == 1);
  assert(vec_get_ref(fnp, (0:usize)) == big_from_i64(2));

  let it: Vec<QEnt> = vec_new<QEnt>(system_allocator(), 2);
  vec_push(it, e(0, 0, 1)); vec_push(it, e(1, 1, 1));
  let identity: QMat = matrix(2, 2, it);
  let fi: Vec<Big> = snf_invariant_factors(identity);
  assert(snf_rank(identity) == 2);
  assert(usize_to_i64(len(fi)) == 2);
  assert(vec_get_ref(fi, (0:usize)) == big_from_i64(1));
  assert(vec_get_ref(fi, (1:usize)) == big_from_i64(1));

  let d: Vec<QEnt> = vec_new<QEnt>(system_allocator(), 2);
  vec_push(d, e(0, 0, 2)); vec_push(d, e(1, 1, 4));
  let finite: QMat = matrix(2, 2, d);
  let ff: Vec<Big> = snf_invariant_factors(finite);
  assert(snf_rank(finite) == 2);
  assert(vec_get_ref(ff, (0:usize)) == big_from_i64(2));
  assert(vec_get_ref(ff, (1:usize)) == big_from_i64(4));

  println("two-field compact charge SNF: PASS");
  drop(ff); drop(finite); drop(fi); drop(identity);
  drop(fnp); drop(nonprimitive); drop(fp); drop(primitive);
  return 0;
}
