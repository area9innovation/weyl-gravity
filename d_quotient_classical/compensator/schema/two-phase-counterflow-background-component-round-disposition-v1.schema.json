{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/two-phase-counterflow-background-component-round-disposition-v1.schema.json",
  "title": "Two-phase counterflow background component and round disposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "lifecycle_state",
    "dependency_tags",
    "imports",
    "payload_ref",
    "terminal_verdict",
    "claim_boundary",
    "claim_flags",
    "content_hashes"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-two-phase-counterflow-background-component-round-disposition-v1"},
    "result_id": {"const": "TWO_PHASE_COUNTERFLOW_BACKGROUND_COMPONENT_ROUND_DISPOSITION_V1"},
    "result_state": {"const": "CERTIFIED_ISOLATED_PHYSICAL_BERGER_COMPONENT_AND_ROUND_NONINHERITANCE"},
    "lifecycle_state": {"const": "CLASSIFIED"},
    "dependency_tags": {
      "type": "array",
      "minItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["LOCAL-ALGEBRAIC", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]}
    },
    "imports": {"type": "object", "minProperties": 4},
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "content_sha256"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "terminal_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_state", "physical_stationary_component_dimension", "open_fixed_action_geometry_family", "selected_causal_parent_retained", "same_action_round_stationary_background", "round_boundary_inherited"],
      "properties": {
        "result_state": {"const": "CERTIFIED_ISOLATED_PHYSICAL_BERGER_COMPONENT_AND_ROUND_NONINHERITANCE"},
        "physical_stationary_component_dimension": {"const": 0},
        "open_fixed_action_geometry_family": {"const": false},
        "selected_causal_parent_retained": {"const": true},
        "same_action_round_stationary_background": {"const": false},
        "round_boundary_inherited": {"const": false}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["establishes", "does_not_establish"],
      "properties": {
        "establishes": {"type": "array", "minItems": 5, "items": {"type": "string"}},
        "does_not_establish": {"type": "array", "minItems": 5, "items": {"type": "string"}}
      }
    },
    "claim_flags": {"type": "object", "minProperties": 7},
    "content_hashes": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    }
  }
}
