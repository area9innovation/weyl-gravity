{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/two-phase-counterflow-residual-bfv-receiver-obstruction-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "dependency_tags", "imports", "stabilizer_dimension", "jacobi_defects", "old_round_crosswalk_sha256", "missing_carrier_sha256", "receiver_status", "payload_ref", "claim_boundary"],
  "properties": {
    "schema": {"const": "pure-weyl-two-phase-counterflow-residual-bfv-receiver-obstruction-v1"},
    "result_id": {"const": "TWO_PHASE_COUNTERFLOW_RESIDUAL_BFV_RECEIVER_OBSTRUCTION_V1"},
    "result_state": {"const": "OBSTRUCTED_MISSING_SPATIAL_STABILIZER_LIFT_AND_MOMENT_MAPS"},
    "dependency_tags": {"type": "array", "minItems": 2, "items": {"enum": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]}},
    "imports": {"type": "object", "minProperties": 5},
    "stabilizer_dimension": {"const": 5},
    "jacobi_defects": {"const": 0},
    "old_round_crosswalk_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "missing_carrier_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "receiver_status": {
      "type": "object",
      "additionalProperties": false,
      "required": ["abstract_CE_nilpotency", "full_BFV_nilpotency", "local_to_time_slice_chain_map", "causal_Cartan_all_five_generators", "residual_cohomology", "descended_pairing", "terminal_state"],
      "properties": {
        "abstract_CE_nilpotency": {"const": "CERTIFIED"},
        "full_BFV_nilpotency": {"const": "NOT_DEFINED_MISSING_MATTER_REPRESENTATION_AND_MOMENT_MAPS"},
        "local_to_time_slice_chain_map": {"const": "NOT_DEFINED"},
        "causal_Cartan_all_five_generators": {"const": "NOT_DEFINED"},
        "residual_cohomology": {"const": "NOT_COMPUTED"},
        "descended_pairing": {"const": "NOT_COMPUTED"},
        "terminal_state": {"const": "OBSTRUCTED_MISSING_SPATIAL_STABILIZER_LIFT_AND_MOMENT_MAPS"}
      }
    },
    "payload_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_sha256"],
      "properties": {"path": {"type": "string"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["establishes", "does_not_establish"],
      "properties": {"establishes": {"type": "array", "items": {"type": "string"}}, "does_not_establish": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
