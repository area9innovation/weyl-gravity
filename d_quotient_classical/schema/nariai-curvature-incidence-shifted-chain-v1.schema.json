{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/nariai-curvature-incidence-shifted-chain-v1.schema.json",
  "title": "Nariai curvature-incidence shifted-chain gate",
  "type": "object",
  "required": ["schema", "result_id", "result_state", "dependency_tags", "dependency_refs", "conventions", "exact_data", "exact_checks", "theorem", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "pure-weyl-nariai-curvature-incidence-shifted-chain-v1"},
    "result_id": {"const": "NARIAI_CURVATURE_INCIDENCE_SHIFTED_CHAIN_V1"},
    "result_state": {"const": "SHIFTED_CHAIN_AND_FACTORIZED_SADDLE_EXACT_PBW_ADJOINT_GATE_OPEN"},
