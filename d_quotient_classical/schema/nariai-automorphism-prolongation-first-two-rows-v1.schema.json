{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/pure-weyl/nariai-automorphism-prolongation-first-two-rows-v1.schema.json",
  "title": "Nariai curvature-corrected automorphism prolongation",
  "type": "object",
  "required": ["schema", "result_id", "result_state", "dependency_tags", "dependency_refs", "construction", "exact_operators", "exact_checks", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "pure-weyl-nariai-automorphism-prolongation-first-two-rows-v1"},
    "result_id": {"const": "NARIAI_AUTOMORPHISM_PROLONGATION_FIRST_TWO_ROWS_V1"},
    "result_state": {"const": "CURVATURE_CORRECTED_AUTOMORPHISM_GAUGE_CONSTRAINT_COMPLEX_EXACT"},
    "dependency_tags": {"type": "array", "prefixItems": [{"const": "LOCAL-ALGEBRAIC"}], "items": false, "minItems": 1, "maxItems": 1},
    "dependency_refs": {
      "type": "object",
      "required": ["reducibility_mismatch", "curvature_incidence", "shifted_chain"],
      "properties": {"reducibility_mismatch": {"$ref": "#/$defs/dependency"}, "curvature_incidence": {"$ref": "#/$defs/dependency"}, "shifted_chain": {"$ref": "#/$defs/dependency"}},
      "additionalProperties": false
    },
    "construction": {"$ref": "#/$defs/stringObject"},
    "exact_operators": {
      "type": "object",
      "required": ["L0_corrected", "L1_corrected", "d_aut", "K_p0", "Phi", "G_aut", "P_aut", "metric_field_graph"],
      "properties": {
        "L0_corrected": {"$ref": "#/$defs/sparseTable"},
        "L1_corrected": {"$ref": "#/$defs/sparseTable"},
        "d_aut": {"$ref": "#/$defs/sparseTable"},
        "K_p0": {"$ref": "#/$defs/sparseTable"},
        "Phi": {"$ref": "#/$defs/sparseTable"},
        "G_aut": {"$ref": "#/$defs/sparseTable"},
        "P_aut": {"$ref": "#/$defs/sparseTable"},
        "metric_field_graph": {"$ref": "#/$defs/sparseTable"}
      },
      "additionalProperties": false
    },
    "exact_checks": {
      "type": "object",
      "required": ["p0_L0_minus_identity_entries", "d_aut_L0_minus_L1_K_entries", "M_d_aut_minus_Phi_K_p0_entries", "P_aut_G_aut_entries", "P_aut_metric_graph_entries", "d_aut_orders", "G_aut_orders", "P_aut_orders", "metric_reducibility_graph_exact", "support_local_finite_order"],
      "properties": {
        "p0_L0_minus_identity_entries": {"const": 0},
        "d_aut_L0_minus_L1_K_entries": {"const": 0},
        "M_d_aut_minus_Phi_K_p0_entries": {"const": 0},
        "P_aut_G_aut_entries": {"const": 0},
        "P_aut_metric_graph_entries": {"const": 0},
        "d_aut_orders": {"type": "array", "prefixItems": [{"const": 0}, {"const": 1}], "items": false, "minItems": 2, "maxItems": 2},
        "G_aut_orders": {"type": "array", "prefixItems": [{"const": 0}, {"const": 1}], "items": false, "minItems": 2, "maxItems": 2},
        "P_aut_orders": {"type": "array", "prefixItems": [{"const": 0}, {"const": 1}, {"const": 2}, {"const": 4}], "items": false, "minItems": 4, "maxItems": 4},
        "metric_reducibility_graph_exact": {"const": true},
        "support_local_finite_order": {"const": true}
      },
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "required": ["NARIAI_AUTOMORPHISM_PROLONGATION_FIRST_TWO_ROWS_V1", "CURVATURE_CORRECTED_GHOST_PROLONGATION", "AUTOMORPHISM_GAUGE_CONSTRAINT_COMPLEX", "METRIC_GAUGE_GRAPH_CHAIN_MAP", "CYCLIC_COTANGENT_COMPLETION", "METRIC_BACH_MIDDLE_EXTENSION", "FULL_PARENT_METRIC_QUASI_ISOMORPHISM", "NARIAI_GREEN_HOMOTOPY", "OPEN_BACKGROUND_CLASS", "QUANTUM_CLAIM"],
      "properties": {
        "NARIAI_AUTOMORPHISM_PROLONGATION_FIRST_TWO_ROWS_V1": {"const": true},
        "CURVATURE_CORRECTED_GHOST_PROLONGATION": {"const": true},
        "AUTOMORPHISM_GAUGE_CONSTRAINT_COMPLEX": {"const": true},
        "METRIC_GAUGE_GRAPH_CHAIN_MAP": {"const": true},
        "CYCLIC_COTANGENT_COMPLETION": {"const": false},
        "METRIC_BACH_MIDDLE_EXTENSION": {"const": false},
        "FULL_PARENT_METRIC_QUASI_ISOMORPHISM": {"const": false},
        "NARIAI_GREEN_HOMOTOPY": {"const": false},
        "OPEN_BACKGROUND_CLASS": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      },
      "additionalProperties": false
    },
    "next_gate": {"const": "C_G2_NARIAI_AUTOMORPHISM_CYCLIC_BACH_EXTENSION"},
    "claim_boundary": {"type": "string", "minLength": 300},
    "provenance": {"$ref": "#/$defs/provenance"}
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency": {"type": "object", "required": ["artifact_id", "path", "sha256"], "properties": {"artifact_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}, "additionalProperties": false},
    "stringObject": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string"}},
    "sparseMatrix": {
      "type": "object",
      "required": ["shape", "entries", "sha256"],
      "properties": {
        "shape": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 2, "maxItems": 2},
        "entries": {"type": "array", "items": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "string"}], "items": false, "minItems": 3, "maxItems": 3}},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "sparseTable": {
      "type": "object",
      "required": ["entries", "sha256"],
      "properties": {
        "entries": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["word", "matrix"], "properties": {"word": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 3}, "maxItems": 4}, "matrix": {"$ref": "#/$defs/sparseMatrix"}}, "additionalProperties": false}},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_manifest", "verification_commands"],
      "properties": {"source_manifest": {"type": "object", "minProperties": 9, "additionalProperties": {"$ref": "#/$defs/sha256"}}, "verification_commands": {"type": "array", "minItems": 4, "items": {"type": "string"}}},
      "additionalProperties": false
    }
  }
}
