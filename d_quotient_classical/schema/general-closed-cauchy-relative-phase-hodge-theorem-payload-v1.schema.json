    "fixtures": {
      "type": "array",
      "minItems": 3,
      "contains": {
        "type": "object",
        "properties": {
          "topology": {
            "type": "object",
            "properties": {
              "betti_1": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "betti_1"
            ]
          }
        },
        "required": [
          "topology"
        ]
      },
      "items": {
        "$ref": "#/$defs/fixture"
      }
    },
    "presentation_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "charge",
        "topology",
        "relative_form",
        "wilson_lattice"
