    "flags": {
      "type": "object", "additionalProperties": false,
      "required": ["BERGER_RETAINED_36_RESIDUAL_BRANCH_BASIS_V2", "BERGER_RETAINED_36_CANONICAL_LOCAL_BRANCH_PROJECTOR", "BERGER_RETAINED_36_CANONICAL_LOCAL_BRANCH_PROJECTOR_OBSTRUCTION", "ELL3_BRANCH_PROJECTION_AUTHORIZED", "PAPER_11_ALGEBRAIC_THEOREM_REMAINS_VALID", "QUANTUM_CLAIM"],
      "properties": {
        "BERGER_RETAINED_36_RESIDUAL_BRANCH_BASIS_V2": {"const": false},
        "BERGER_RETAINED_36_CANONICAL_LOCAL_BRANCH_PROJECTOR": {"const": false},
        "BERGER_RETAINED_36_CANONICAL_LOCAL_BRANCH_PROJECTOR_OBSTRUCTION": {"const": true},
        "ELL3_BRANCH_PROJECTION_AUTHORIZED": {"const": false},
        "PAPER_11_ALGEBRAIC_THEOREM_REMAINS_VALID": {"const": true},
