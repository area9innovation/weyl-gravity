  "properties": {
    "schema": {"const": "pure-weyl-nariai-curvature-incidence-cyclic-mapping-cylinder-v1"},
    "result_id": {"const": "NARIAI_CURVATURE_INCIDENCE_CYCLIC_MAPPING_CYLINDER_V1"},
    "result_state": {"const": "CYCLIC_PARENT_MAPPING_CYLINDER_AND_SDR_EXACT"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
