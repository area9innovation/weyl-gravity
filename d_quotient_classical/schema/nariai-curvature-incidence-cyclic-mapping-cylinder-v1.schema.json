    "next_gate": {"const": "C_G2_NARIAI_METRIC_BACH_ENDPOINT_CHAIN_MAP_AND_GREEN_TRANSFER"},
    "claim_boundary": {"type": "string", "minLength": 900},
    "provenance": {"type": "object", "required": ["source_manifest", "verification_commands"], "properties": {"source_manifest": {"type": "object", "minProperties": 6, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "verification_commands": {"type": "array", "minItems": 4, "items": {"type": "string"}}}, "additionalProperties": false}
  },
  "additionalProperties": false,
  "$defs": {
    "dependency": {"type": "object", "required": ["artifact_id", "path", "sha256"], "properties": {"artifact_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "term": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "array", "items": {"enum": ["d", "dsharp", "M", "L", "Lsharp"]}}, {"type": "integer"}, {"type": "integer", "minimum": 1}]},
    "entry": {"type": "array", "minItems": 3, "maxItems": 3, "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 7}, {"type": "integer", "minimum": 0, "maximum": 7}, {"type": "array", "items": {"$ref": "#/$defs/term"}}]},
    "matrix": {"type": "object", "required": ["shape", "entries", "sha256"], "properties": {"shape": {"const": [8, 8]}, "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false}
  }
