    "block_ledger": {"type": "object", "required": ["names", "degrees", "parent_retract_indices", "split_coordinates", "graph_coordinates", "parent_relations"], "properties": {"names": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "string"}}, "degrees": {"const": [-1, -1, 0, 0, 1, 1, 2, 2]}, "parent_retract_indices": {"const": [0, 3, 5, 6]}, "split_coordinates": {"type": "string"}, "graph_coordinates": {"type": "string"}, "parent_relations": {"const": ["M d=0", "dsharp M=0"]}}, "additionalProperties": false},
    "exact_matrices": {"type": "object", "required": ["split", "pairing", "split_to_graph", "graph_to_split", "prolonged", "inclusion", "projection", "homotopy"], "properties": {"split": {"$ref": "#/$defs/matrix"}, "pairing": {"$ref": "#/$defs/matrix"}, "split_to_graph": {"$ref": "#/$defs/matrix"}, "graph_to_split": {"$ref": "#/$defs/matrix"}, "prolonged": {"$ref": "#/$defs/matrix"}, "inclusion": {"$ref": "#/$defs/matrix"}, "projection": {"$ref": "#/$defs/matrix"}, "homotopy": {"$ref": "#/$defs/matrix"}}, "additionalProperties": false},
    "exact_checks": {"type": "object", "required": ["split_Q_squared", "prolonged_Q_squared", "split_odd_cyclic", "prolonged_odd_cyclic", "canonical_shear", "shear_right_inverse", "shear_left_inverse", "projection_inclusion_identity", "inclusion_chain_map", "projection_chain_map", "retract_identity", "homotopy_odd_cyclic", "block_count", "split_nonzero_blocks", "prolonged_nonzero_blocks", "pairing_nonzero_blocks", "no_inverse_operator_atoms", "shifted_chain_substitution_exact", "factorized_saddle_substitution_exact"], "properties": {"split_Q_squared": {"const": true}, "prolonged_Q_squared": {"const": true}, "split_odd_cyclic": {"const": true}, "prolonged_odd_cyclic": {"const": true}, "canonical_shear": {"const": true}, "shear_right_inverse": {"const": true}, "shear_left_inverse": {"const": true}, "projection_inclusion_identity": {"const": true}, "inclusion_chain_map": {"const": true}, "projection_chain_map": {"const": true}, "retract_identity": {"const": true}, "homotopy_odd_cyclic": {"const": true}, "block_count": {"const": 8}, "split_nonzero_blocks": {"const": 5}, "prolonged_nonzero_blocks": {"const": 10}, "pairing_nonzero_blocks": {"const": 8}, "no_inverse_operator_atoms": {"const": true}, "shifted_chain_substitution_exact": {"const": true}, "factorized_saddle_substitution_exact": {"const": true}}, "additionalProperties": false},
    "endpoint_ghost_embedding": {"type": "object", "required": ["map", "field_image", "incidence_identity_used", "strict_metric_graph_chain_map"], "properties": {"map": {"type": "string"}, "field_image": {"type": "string"}, "incidence_identity_used": {"const": true}, "strict_metric_graph_chain_map": {"const": false}}, "additionalProperties": false},
    "theorem": {"type": "object", "required": ["statement", "sdr", "incidence"], "properties": {"statement": {"type": "string", "minLength": 250}, "sdr": {"type": "string", "minLength": 180}, "incidence": {"type": "string", "minLength": 200}}, "additionalProperties": false},
