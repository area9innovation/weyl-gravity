{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/compensator-independent-weyl-connection-level4-no-go-v1.schema.json",
  "title": "Exact Level-4 rank and charge no-go for one real Weyl connection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "dependency_tags",
    "imports",
    "domain",
    "complete_minimal_action",
    "gauge_rank_and_reducibility",
    "exact_Ward_locus",
    "minimal_BV_data",
    "charge_and_cohomology_separator",
    "gate_disposition",
    "terminal_verdict",
    "exact_checks",
    "claim_flags",
    "claim_boundary",
    "next_gate",
    "content_hashes"
  ],
  "properties": {
    "schema": {
      "const": "pure-weyl-compensator-independent-weyl-connection-level4-no-go-v1"
    },
    "result_id": {
      "const": "COMPENSATOR_INDEPENDENT_WEYL_CONNECTION_LEVEL4_NO_GO_V1"
    },
    "result_state": {
      "const": "SCOPED_LEVEL4_INDEPENDENT_WEYL_CONNECTION_GOOD_LOCUS_EMPTY"
    },
    "dependency_tags": {
      "const": [
        "LOCAL-ALGEBRAIC",
        "LORENTZIAN-CAUSAL"
      ]
    },
    "imports": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level3_no_go"
      ],
      "properties": {
        "level3_no_go": {
          "$ref": "#/$defs/import"
        }
      }
    },
    "domain": {
      "$ref": "#/$defs/nonempty-object"
    },
    "complete_minimal_action": {
      "$ref": "#/$defs/nonempty-object"
    },
    "gauge_rank_and_reducibility": {
      "$ref": "#/$defs/nonempty-object"
    },
    "exact_Ward_locus": {
      "$ref": "#/$defs/nonempty-object"
    },
    "minimal_BV_data": {
      "$ref": "#/$defs/nonempty-object"
    },
    "charge_and_cohomology_separator": {
      "$ref": "#/$defs/nonempty-object"
    },
    "gate_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seven_gates",
        "background_boundary",
        "selected_action",
        "support_local_Green_parent",
        "nonlinear_q2"
      ],
      "properties": {
        "seven_gates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7
        },
        "background_boundary": {
          "$ref": "#/$defs/nonempty"
        },
        "selected_action": {
          "const": false
        },
        "support_local_Green_parent": {
          "const": false
        },
        "nonlinear_q2": {
          "const": false
        }
      }
    },
    "terminal_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_minimal_real_Weyl_connection_family_checked",
        "independent_trace_gauge_and_nonzero_clock_charge_intersection",
        "selected_level4_action",
        "first_invariant_separator",
        "result"
      ],
      "properties": {
        "complete_minimal_real_Weyl_connection_family_checked": {
          "const": true
        },
        "independent_trace_gauge_and_nonzero_clock_charge_intersection": {
          "const": "EMPTY"
        },
        "selected_level4_action": {
          "const": false
        },
        "first_invariant_separator": {
          "$ref": "#/$defs/nonempty"
        },
        "result": {
          "const": "SCOPED_LEVEL4_INDEPENDENT_WEYL_CONNECTION_GOOD_LOCUS_EMPTY"
        }
      }
    },
    "exact_checks": {
      "type": "object",
      "minProperties": 11,
      "additionalProperties": {
        "const": true
      }
    },
    "claim_flags": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "const": false
      }
    },
    "claim_boundary": {
      "$ref": "#/$defs/nonempty"
    },
    "next_gate": {
      "$ref": "#/$defs/nonempty"
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "imports_sha256",
        "action_sha256",
        "rank_sha256",
        "ward_sha256",
        "bv_sha256",
        "separator_sha256",
        "gates_sha256",
        "verdict_sha256"
      ],
      "properties": {
        "imports_sha256": {
          "$ref": "#/$defs/sha"
        },
        "action_sha256": {
          "$ref": "#/$defs/sha"
        },
        "rank_sha256": {
          "$ref": "#/$defs/sha"
        },
        "ward_sha256": {
          "$ref": "#/$defs/sha"
        },
        "bv_sha256": {
          "$ref": "#/$defs/sha"
        },
        "separator_sha256": {
          "$ref": "#/$defs/sha"
        },
        "gates_sha256": {
          "$ref": "#/$defs/sha"
        },
        "verdict_sha256": {
          "$ref": "#/$defs/sha"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "nonempty-object": {
      "type": "object",
      "minProperties": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "result_id",
        "result_state",
        "sha256",
        "source_commit",
        "selected_action"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "result_id": {
          "$ref": "#/$defs/nonempty"
        },
        "result_state": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "selected_action": {
          "const": false
        }
      }
    }
  }
}
