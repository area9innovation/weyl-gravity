{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-berger-support-local-q3-v1.json",
  "title": "Complete support-local Berger classical q3 certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "setting_id", "claim_status", "dependency_tags",
    "dependency_refs", "derivation", "row_layout", "classical_ternary_q3",
    "local_D_arity_three", "exact_checks", "tier_receipts", "flags", "next_gates", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-berger-support-local-q3-v1"},
    "result_id": {"const": "BERGER_SUPPORT_LOCAL_Q3"},
    "setting_id": {"type": "string", "minLength": 1},
    "claim_status": {"const": "CERTIFIED_COMPLETE_SUPPORT_LOCAL_CLASSICAL_Q3"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "dependency_refs": {
      "type": "object", "additionalProperties": {"$ref": "#/$defs/dependency"},
      "required": ["gauge_fixed_classical_unary_q1", "support_local_classical_q2", "local_D_action"]
    },
    "derivation": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "method", "not_fitted_to_residual_data", "background_fixture", "coefficient_field", "raw_minimal_rows", "gauge_fixed_rows", "raw_support_theorem"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "method": {"type": "string", "minLength": 1},
        "not_fitted_to_residual_data": {"const": true},
        "background_fixture": {"type": "string", "minLength": 1},
        "coefficient_field": {"const": "Q(sqrt(10))"},
        "raw_minimal_rows": {"const": 34},
        "gauge_fixed_rows": {"const": 54},
        "raw_support_theorem": {"type": "string", "minLength": 1}
      }
    },
    "row_layout": {
      "type": "object", "additionalProperties": false,
      "required": ["total_rows", "component_rows", "parities", "all_rows_ledgered"],
      "properties": {
        "total_rows": {"const": 54},
        "component_rows": {"type": "array", "minItems": 54, "maxItems": 54},
        "parities": {"type": "array", "minItems": 54, "maxItems": 54, "items": {"enum": [0, 1]}},
        "all_rows_ledgered": {"const": true}
      }
    },
    "classical_ternary_q3": {
      "type": "object", "additionalProperties": false,
      "required": ["payload_path", "payload_file_sha256", "total_rows", "nonzero_rows", "term_count", "maximum_total_jet_order", "payload_canonical_sha256", "payload_format", "chunk_count", "support_local", "Taylor_convention"],
      "properties": {
        "payload_path": {"type": "string", "minLength": 1},
        "payload_file_sha256": {"$ref": "#/$defs/sha256"},
        "total_rows": {"const": 54},
        "nonzero_rows": {"type": "integer", "minimum": 1, "maximum": 54},
        "term_count": {"type": "integer", "minimum": 1},
        "maximum_total_jet_order": {"type": "integer", "minimum": 0},
        "payload_canonical_sha256": {"$ref": "#/$defs/sha256"},
        "payload_format": {"const": "strict-json-manifest-plus-deterministic-gzip-strict-json-row-chunks"},
        "chunk_count": {"const": 54},
        "support_local": {"const": true},
        "Taylor_convention": {"const": "suspended-graded-symmetric-factorial-v1"}
      }
    },
    "local_D_arity_three": {
      "type": "object", "additionalProperties": false,
      "required": ["L_D3", "reason", "D_q3_derivation"],
      "properties": {
        "L_D3": {"const": "ZERO"},
        "reason": {"type": "string", "minLength": 1},
        "D_q3_derivation": {"const": true}
      }
    },
    "exact_checks": {"type": "object", "minProperties": 9, "additionalProperties": {"const": true}},
    "tier_receipts": {
      "type": "object", "additionalProperties": false,
      "required": ["cache_key", "raw_receipt_sha256", "transport_receipt_sha256", "verify_receipt_sha256", "publication_receipt_path", "publication_receipt_sha256", "raw_elapsed_seconds", "transport_elapsed_seconds", "verify_elapsed_seconds", "test_tier", "tier_3_not_run"],
      "properties": {
        "cache_key": {"$ref": "#/$defs/sha256"},
        "raw_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "transport_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "verify_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "publication_receipt_path": {"type": "string", "minLength": 1},
        "publication_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "raw_elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
        "transport_elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
        "verify_elapsed_seconds": {"type": "number", "exclusiveMinimum": 0},
        "test_tier": {"const": 2},
        "tier_3_not_run": {"type": "string", "minLength": 1}
      }
    },
    "flags": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "next_gates": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["result_id", "sha256"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
