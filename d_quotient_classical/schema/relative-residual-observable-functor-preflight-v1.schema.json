{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-relative-residual-observable-functor-preflight-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "result_state", "setting", "dependency_tags",
    "dependency_refs", "shared_relative_row", "required_import",
    "background_scope", "flags", "next_gate", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-relative-residual-observable-functor-preflight-v1"},
    "result_id": {"const": "RELATIVE_RESIDUAL_AND_OBSERVABLE_FUNCTOR_PREFLIGHT_V1"},
    "result_state": {"enum": ["PARTIAL_OFFSHELL_PREFLIGHT_IMPORTED_FULL_TRIANGLE_MISSING", "OFFSHELL_TRIANGLE_EQUIVARIANT_COFIBER_IMPORTED_OBSERVABLE_PULLBACK_OPEN"]},
    "setting": {"type": "object", "additionalProperties": false, "required": ["theory_pair", "background", "generator", "phase_space"], "properties": {"theory_pair": {"const": "Einstein-Maxwell_to_Weyl-Maxwell"}, "background": {"const": "compact_Einstein-Maxwell_product"}, "generator": {"const": "H_product"}, "phase_space": {"type": "string", "minLength": 1}}},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "dependency_refs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/ref"}, "minProperties": 4},
    "shared_relative_row": {"type": "object", "additionalProperties": false, "required": ["map_iota", "cofiber", "relative_pairing", "O2", "residual_action", "observable_map", "quantum_lift"], "properties": {"map_iota": {"enum": ["PARTIAL_OFFSHELL_GENERIC_AXIAL_PREFLIGHT", "IMPORTED_OFFSHELL_TRIANGLE"]}, "cofiber": {"enum": ["PARTIAL_GENERIC_AXIAL_COFIBER_FULL_GLOBAL_BLOCKED", "IMPORTED_MAPPING_COFIBER"]}, "relative_pairing": {"enum": ["CLASSICAL_REDUCED_MODE_PULLBACK_ONLY", "NONCYCLIC_THREE_ACTION_FORMS_IMPORTED"]}, "O2": {"const": "PARTIAL_FIXTURES_ONLY"}, "residual_action": {"enum": ["BLOCKED_OFFSHELL_EQUIVARIANCE_MISSING", "IMPORTED_H_PRODUCT_EQUIVARIANCE_AND_ENDPOINT_MAPS"]}, "observable_map": {"const": "BLOCKED_OFFSHELL_PULLBACK_MISSING"}, "quantum_lift": {"const": "NOT_APPLICABLE_TO_CLASSICAL_PREFLIGHT"}}},
    "required_import": {"type": "object", "additionalProperties": false, "required": ["result_id", "required_components", "acceptance_flags", "candidate_paths", "status"], "properties": {"result_id": {"const": "EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_V1"}, "required_components": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}}, "acceptance_flags": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "candidate_paths": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "status": {"enum": ["MISSING", "IMPORTED"]}}},
    "background_scope": {"type": "object", "additionalProperties": false, "required": ["common_product_background", "berger_clock_background"], "properties": {"common_product_background": {"const": "APPLICABLE"}, "berger_clock_background": {"const": "NOT_APPLICABLE_NO_SAME_BASE_EINSTEIN_TANGENT"}}},
    "flags": {"type": "object", "additionalProperties": false, "required": ["RELATIVE_RESIDUAL_AND_OBSERVABLE_FUNCTOR_PREFLIGHT_V1", "RELATIVE_RESIDUAL_AND_OBSERVABLE_FUNCTOR_V1", "EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_IMPORTED", "OBSERVABLE_PULLBACK_CONSTRUCTED", "RESIDUAL_EQUIVARIANCE_CERTIFIED", "COFIBER_COMPATIBILITY_CERTIFIED", "BERGER_SAME_BASE_RELATIVE_MAP_APPLICABLE"], "properties": {"RELATIVE_RESIDUAL_AND_OBSERVABLE_FUNCTOR_PREFLIGHT_V1": {"const": true}, "RELATIVE_RESIDUAL_AND_OBSERVABLE_FUNCTOR_V1": {"const": false}, "EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_IMPORTED": {"type": "boolean"}, "OBSERVABLE_PULLBACK_CONSTRUCTED": {"const": false}, "RESIDUAL_EQUIVARIANCE_CERTIFIED": {"type": "boolean"}, "COFIBER_COMPATIBILITY_CERTIFIED": {"type": "boolean"}, "BERGER_SAME_BASE_RELATIVE_MAP_APPLICABLE": {"const": false}}},
    "next_gate": {"enum": ["IMPORT_EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_V1_BY_HASH", "CONSTRUCT_OBSERVABLE_PULLBACK_ON_IMPORTED_NONCYCLIC_TRIANGLE"]},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"required_import": {"properties": {"status": {"const": "MISSING"}}}}},
      "then": {"properties": {"result_state": {"const": "PARTIAL_OFFSHELL_PREFLIGHT_IMPORTED_FULL_TRIANGLE_MISSING"}, "flags": {"properties": {"EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_IMPORTED": {"const": false}}}, "shared_relative_row": {"properties": {"map_iota": {"const": "PARTIAL_OFFSHELL_GENERIC_AXIAL_PREFLIGHT"}, "cofiber": {"const": "PARTIAL_GENERIC_AXIAL_COFIBER_FULL_GLOBAL_BLOCKED"}}}, "next_gate": {"const": "IMPORT_EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_V1_BY_HASH"}}}
    },
    {
      "if": {"properties": {"required_import": {"properties": {"status": {"const": "IMPORTED"}}}}},
      "then": {"properties": {"result_state": {"const": "OFFSHELL_TRIANGLE_EQUIVARIANT_COFIBER_IMPORTED_OBSERVABLE_PULLBACK_OPEN"}, "flags": {"properties": {"EINSTEIN_WEYL_RELATIVE_LINEAR_TRIANGLE_IMPORTED": {"const": true}, "RESIDUAL_EQUIVARIANCE_CERTIFIED": {"const": true}, "COFIBER_COMPATIBILITY_CERTIFIED": {"const": true}}}, "shared_relative_row": {"properties": {"map_iota": {"const": "IMPORTED_OFFSHELL_TRIANGLE"}, "cofiber": {"const": "IMPORTED_MAPPING_COFIBER"}, "relative_pairing": {"const": "NONCYCLIC_THREE_ACTION_FORMS_IMPORTED"}, "residual_action": {"const": "IMPORTED_H_PRODUCT_EQUIVARIANCE_AND_ENDPOINT_MAPS"}}}, "next_gate": {"const": "CONSTRUCT_OBSERVABLE_PULLBACK_ON_IMPORTED_NONCYCLIC_TRIANGLE"}}}
    }
  ],
  "$defs": {"ref": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "path", "commit", "sha256"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
}
