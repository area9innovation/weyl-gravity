{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-support-local-coupled-maxwell-q2-payload-v1.schema.json",
  "title": "Support-local coupled Maxwell q2 overlay payload",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "coefficient_field", "pbw_basis", "shape", "factorial_convention", "composition", "gravity_base", "rows"],
  "properties": {
    "schema": {"const": "pure-weyl-berger-support-local-coupled-maxwell-q2-payload-v1"},
    "coefficient_field": {"const": "Q(sqrt(10))"},
    "pbw_basis": {"const": "left-invariant Berger frame; words e0^n0 e1^n1 e2^n2 e3^n3"},
    "shape": {"const": [64, 64, 64]},
    "factorial_convention": {"const": "suspended-graded-symmetric-factorial-v1"},
    "composition": {"const": "zero-extend the pinned 54-row gravity payload to 64 rows, then add this 64-row Maxwell overlay"},
    "gravity_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_path", "shape", "file_sha256", "canonical_sha256"],
      "properties": {
        "payload_path": {"const": "d_quotient_classical/certificates/BERGER_SUPPORT_LOCAL_Q2_PAYLOAD.json"},
        "shape": {"const": [54, 54, 54]},
        "file_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "rows": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/row"},
      "allOf": [
        {"contains": {"type": "object", "required": ["output", "terms"], "properties": {"output": {"const": 37}, "terms": {"type": "array", "maxItems": 0}}}, "minContains": 1, "maxContains": 1},
        {"contains": {"type": "object", "required": ["output", "terms"], "properties": {"output": {"const": 38}, "terms": {"type": "array", "minItems": 1}}}, "minContains": 1, "maxContains": 1}
      ]
    }
  },
  "$defs": {
    "exact_rational": {
      "oneOf": [
        {"type": "integer"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["numerator", "denominator"],
          "properties": {
            "numerator": {"type": "integer"},
            "denominator": {"type": "integer", "minimum": 2}
          }
        }
      ]
    },
    "coefficient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rational", "sqrt10"],
      "properties": {
        "rational": {"$ref": "#/$defs/exact_rational"},
        "sqrt10": {"$ref": "#/$defs/exact_rational"}
      }
    },
    "multiindex": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"type": "integer", "minimum": 0}
    },
    "term": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 63},
        {"$ref": "#/$defs/multiindex"},
        {"type": "integer", "minimum": 0, "maximum": 63},
        {"$ref": "#/$defs/multiindex"},
        {"$ref": "#/$defs/coefficient"}
      ],
      "items": false
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "terms", "canonical_sha256"],
      "properties": {
        "output": {"type": "integer", "minimum": 0, "maximum": 63},
        "terms": {"type": "array", "items": {"$ref": "#/$defs/term"}},
        "canonical_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
