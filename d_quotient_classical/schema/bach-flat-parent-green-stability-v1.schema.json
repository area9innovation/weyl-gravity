    "stringMap": {"type": "object", "minProperties": 7, "additionalProperties": {"type": "string", "minLength": 1}},
    "operatorTerm": {"type": "array", "prefixItems": [{"type": "array", "items": {"type": "string", "minLength": 1}}, {"type": "integer"}, {"type": "integer", "minimum": 1}], "items": false, "minItems": 3, "maxItems": 3},
    "operatorEntry": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "array", "items": {"$ref": "#/$defs/operatorTerm"}}], "items": false, "minItems": 3, "maxItems": 3},
    "operatorMatrix": {"type": "object", "additionalProperties": false, "required": ["shape", "entries", "sha256"], "properties": {"shape": {"const": [4, 4]}, "entries": {"type": "array", "items": {"$ref": "#/$defs/operatorEntry"}}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
