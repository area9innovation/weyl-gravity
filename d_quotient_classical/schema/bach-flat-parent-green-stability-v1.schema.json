    "nonconstant_consumer": {"type": "object", "additionalProperties": false, "required": ["metric", "Omega", "nonconstant", "lapse_deviation_sup", "spatial_relative_deviation_sup", "inside_radius", "Bach_flat", "not_conformally_flat"], "properties": {"metric": {"type": "string", "minLength": 1}, "Omega": {"const": "1+1/(10(1+t^2))"}, "nonconstant": {"const": true}, "lapse_deviation_sup": {"const": "1/10"}, "spatial_relative_deviation_sup": {"const": "21/100"}, "inside_radius": {"const": true}, "Bach_flat": {"type": "string", "minLength": 1}, "not_conformally_flat": {"type": "string", "minLength": 1}}},
    "universal_parent": {"type": "object", "additionalProperties": false, "required": ["geometric_input", "sequence", "middle", "complex_condition", "bundle_ranks", "abstract_Q", "backward_witness", "wave_anticommutator"], "properties": {"geometric_input": {"type": "string", "minLength": 1}, "sequence": {"type": "string", "minLength": 1}, "middle": {"type": "string", "minLength": 1}, "complex_condition": {"type": "string", "minLength": 1}, "bundle_ranks": {"const": [15, 60, 60, 15]}, "abstract_Q": {"$ref": "#/$defs/operatorMatrix"}, "backward_witness": {"$ref": "#/$defs/operatorMatrix"}, "wave_anticommutator": {"$ref": "#/$defs/operatorMatrix"}}},
