{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-berger-q3-action-sector-crosscheck-v1.json",
  "title": "Independent Berger q3 action-sector cross-check",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "claim_status", "dependency_tags", "setting_id",
    "independent_method", "source_manifest", "coefficients", "exact_checks",
    "flags", "verification_commands", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-berger-q3-action-sector-crosscheck-v1"},
    "result_id": {"const": "BERGER_Q3_ACTION_SECTOR_CROSSCHECK"},
    "claim_status": {"const": "CERTIFIED_STRATEGIC_INDEPENDENT_CROSSCHECK"},
    "dependency_tags": {
      "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]
    },
    "setting_id": {
      "const": "rational_positive_berger_clock_homogeneous_lapse_radial_sector"
    },
    "independent_method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_imported", "method", "variables", "outputs",
        "factorial_normalization", "ordered_payload_coefficients_checked",
        "independent_derivative_values"
      ],
      "properties": {
        "producer_imported": {"const": false},
        "method": {"type": "string", "minLength": 1},
        "variables": {"const": ["h_hat_00", "R"]},
        "outputs": {"const": ["h_hat_star_00", "R_star"]},
        "factorial_normalization": {"type": "string", "minLength": 1},
        "ordered_payload_coefficients_checked": {"const": 16},
        "independent_derivative_values": {"const": 8}
      }
    },
    "source_manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosscheck_source", "q3_producer_under_test", "q3_certificate",
        "q3_payload_manifest", "q3_row_27", "q3_row_37"
      ],
      "properties": {
        "crosscheck_source": {"$ref": "#/$defs/source"},
        "q3_producer_under_test": {"$ref": "#/$defs/source"},
        "q3_certificate": {"$ref": "#/$defs/source"},
        "q3_payload_manifest": {"$ref": "#/$defs/source"},
        "q3_row_27": {"$ref": "#/$defs/source"},
        "q3_row_37": {"$ref": "#/$defs/source"}
      }
    },
    "coefficients": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "output", "output_row", "input_h_count", "input_R_count",
          "ordered_permutations_checked", "expected_from_direct_action",
          "observed_in_frozen_payload"
        ],
        "properties": {
          "output": {"enum": [27, 37]},
          "output_row": {"enum": ["h_hat_star_00", "R_star"]},
          "input_h_count": {"type": "integer", "minimum": 0, "maximum": 3},
          "input_R_count": {"type": "integer", "minimum": 0, "maximum": 3},
          "ordered_permutations_checked": {"type": "integer", "minimum": 1, "maximum": 3},
          "expected_from_direct_action": {"type": "string", "pattern": "^-?[0-9]+(/[0-9]+)?$"},
          "observed_in_frozen_payload": {"type": "string", "pattern": "^-?[0-9]+(/[0-9]+)?$"}
        }
      }
    },
    "exact_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "direct_background_density_stationary",
        "all_eight_action_derivatives_match",
        "all_sixteen_ordered_payload_coefficients_match",
        "lapse_sector_checked", "dressed_radial_weyl_sector_checked",
        "q3_producer_not_imported"
      ],
      "properties": {
        "direct_background_density_stationary": {"const": true},
        "all_eight_action_derivatives_match": {"const": true},
        "all_sixteen_ordered_payload_coefficients_match": {"const": true},
        "lapse_sector_checked": {"const": true},
        "dressed_radial_weyl_sector_checked": {"const": true},
        "q3_producer_not_imported": {"const": true}
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BERGER_Q3_ACTION_SECTOR_CROSSCHECK",
        "FULL_INDEPENDENT_Q3_REDERIVATION", "THEOREM_FROZEN"
      ],
      "properties": {
        "BERGER_Q3_ACTION_SECTOR_CROSSCHECK": {"const": true},
        "FULL_INDEPENDENT_Q3_REDERIVATION": {"const": false},
        "THEOREM_FROZEN": {"const": false}
      }
    },
    "verification_commands": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
