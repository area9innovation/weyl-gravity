    "scope": {"$ref": "#/$defs/stringObject"},
    "dependencies": {"type": "object", "additionalProperties": {"$ref": "#/$defs/artifact"}, "minProperties": 4, "maxProperties": 4},
    "construction": {
      "type": "object", "additionalProperties": false,
      "required": ["relative_current", "polarized_current", "metric_action", "maxwell_action", "horizontal_carrier", "global_charge_operation"],
