  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator"
      ],
      "properties": {
        "numerator": {
          "type": "integer"
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "artifact_id",
        "sha256",
        "source_commit"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 10
        },
        "artifact_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "$ref": "#/$defs/git_sha1"
        }
      }
    },
    "git_sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "string_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "column_count",
        "entries",
        "sha256"
      ],
      "properties": {
        "row_count": {
          "const": 8
        },
        "column_count": {
          "const": 8
        },
        "entries": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row",
              "column",
              "coefficient"
            ],
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "column": {
                "type": "integer",
                "minimum": 0,
                "maximum": 7
              },
              "coefficient": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "rational_matrix": {
      "type": "object",
      "additionalProperties": false,
