{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/relative-hessian-second-current-payload-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "background_id", "coefficient_field", "operator",
    "maximum_operator_order", "current_coefficient_jet_order",
    "profile_completeness_rule", "term_count", "newly_visible_term_count",
    "raw_action_jet_census", "coefficient_jet_counts_by_operator_order",
    "terms", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-relative-hessian-second-current-payload-v1"},
    "result_id": {"const": "EINSTEIN_WEYL_RELATIVE_HESSIAN_SECOND_CURRENT_INPUT_V1_PAYLOAD"},
    "background_id": {"const": "compact_magnetic_Plebanski_Hacyan_product"},
    "coefficient_field": {"const": "Q"},
    "operator": {"const": "sin(theta)*(E_Weyl-Maxwell-E_Einstein-Maxwell)"},
    "maximum_operator_order": {"const": 4},
    "current_coefficient_jet_order": {"const": 2},
    "profile_completeness_rule": {"type": "string", "minLength": 80},
    "term_count": {"type": "integer", "minimum": 800},
    "newly_visible_term_count": {"type": "integer", "minimum": 0},
    "raw_action_jet_census": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_fifth", "source_third"],
      "properties": {
        "target_fifth": {"type": "integer", "minimum": 1},
        "source_third": {"type": "integer", "minimum": 1}
      }
    },
    "coefficient_jet_counts_by_operator_order": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0", "1", "2", "3", "4"],
      "properties": {
        "0": {"type": "integer", "minimum": 0},
        "1": {"type": "integer", "minimum": 0},
        "2": {"type": "integer", "minimum": 0},
        "3": {"type": "integer", "minimum": 0},
        "4": {"type": "integer", "minimum": 0}
      }
    },
    "terms": {
      "type": "array",
      "minItems": 800,
      "items": {"$ref": "#/$defs/term"}
    },
    "claim_boundary": {"type": "string", "minLength": 150}
  },
  "$defs": {
    "word": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 3},
      "maxItems": 5
    },
    "jet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "coefficient"],
      "properties": {
        "word": {"$ref": "#/$defs/word"},
        "coefficient": {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_local", "input_local", "word",
        "required_coefficient_jet_order", "coefficient_jets"
      ],
      "properties": {
        "output_local": {"type": "integer", "minimum": 0, "maximum": 13},
        "input_local": {"type": "integer", "minimum": 0, "maximum": 13},
        "word": {
          "type": "array",
          "items": {"type": "integer", "minimum": 0, "maximum": 3},
          "maxItems": 4
        },
        "required_coefficient_jet_order": {"type": "integer", "minimum": 1, "maximum": 5},
        "coefficient_jets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/jet"}
        }
      }
    }
  }
}
