{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pure-weyl.example/schema/relative-order-one-chain-obstruction-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "lifecycle_status",
    "dependency_tags",
    "scope",
    "dependencies",
    "invariant_basis",
    "system_payload",
    "exact_linear_system",
    "classification",
    "next_gate",
    "provenance",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-relative-order-one-chain-obstruction-v1"},
    "result_id": {"const": "EINSTEIN_WEYL_RELATIVE_ORDER_ONE_CHAIN_OBSTRUCTION_V1"},
    "result_state": {"const": "COMPLETE_ENDPOINT_NORMALIZED_ORDER_ONE_CHAIN_MAP_OBSTRUCTED"},
    "lifecycle_status": {"const": "OBSTRUCTED"},
    "dependency_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"const": "LOCAL-ALGEBRAIC"}],
      "items": false
    },
    "scope": {"type": "object"},
    "dependencies": {"type": "object"},
    "invariant_basis": {
      "type": "object",
      "required": [
        "A1_order_zero_dimension",
        "A1_order_one_dimension",
        "A2_order_one_dimension",
        "total_unknowns",
        "primitive_sparse_basis_sha256",
        "globalization"
      ],
      "properties": {
        "A1_order_zero_dimension": {"const": 80},
        "A1_order_one_dimension": {"const": 284},
        "A2_order_one_dimension": {"const": 42},
        "total_unknowns": {"const": 406},
        "primitive_sparse_basis_sha256": {"type": "object"},
        "globalization": {"type": "string"}
      },
      "additionalProperties": false
    },
    "system_payload": {
      "type": "object",
      "required": ["path", "sha256", "matrix_records", "rhs_records"],
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matrix_records": {"type": "integer", "minimum": 1},
        "rhs_records": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "exact_linear_system": {
      "type": "object",
      "required": [
        "equations",
        "unknowns",
        "nonzero_entries",
        "rank_over_Q",
        "nullity",
        "augmented_rank_over_Q",
        "consistent",
        "matrix_coo_sha256",
        "left_null_witness"
      ],
      "properties": {
        "equations": {"const": 822},
        "unknowns": {"const": 406},
        "nonzero_entries": {"type": "integer", "minimum": 1},
        "rank_over_Q": {"const": 398},
        "nullity": {"const": 8},
        "augmented_rank_over_Q": {"const": 399},
        "consistent": {"const": false},
        "matrix_coo_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "left_null_witness": {
          "type": "object",
          "required": ["terms", "evaluation", "rows"],
          "properties": {
            "terms": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "prefixItems": [{"type": "integer"}, {"type": "string"}],
                "items": false
              }
            },
            "evaluation": {"type": "string", "not": {"const": "0"}},
            "rows": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "object"}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_endpoint_normalized_invariant_order_one_system_solved",
        "order_one_chain_map_exists",
        "order_one_chain_map_obstructed",
        "higher_order_chain_map_obstructed",
        "nonzero_f2_obstructed",
        "alternate_current_improvement_obstructed",
        "relative_q2_repaired",
        "causal_observable_particle_or_quantum_claim"
      ],
      "properties": {
        "complete_endpoint_normalized_invariant_order_one_system_solved": {"const": true},
        "order_one_chain_map_exists": {"const": false},
        "order_one_chain_map_obstructed": {"const": true},
        "higher_order_chain_map_obstructed": {"const": false},
        "nonzero_f2_obstructed": {"const": false},
        "alternate_current_improvement_obstructed": {"const": false},
        "relative_q2_repaired": {"const": false},
        "causal_observable_particle_or_quantum_claim": {"const": false}
      }
    },
    "next_gate": {"type": "string"},
    "provenance": {"type": "object"},
    "claim_boundary": {"type": "string"}
  }
}
