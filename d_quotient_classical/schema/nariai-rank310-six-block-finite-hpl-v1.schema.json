{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/nariai-rank310-six-block-finite-hpl-v1.schema.json",
  "title": "Nariai rank-310 six-block finite HPL theorem v1",
  "type": "object",
  "required": ["schema", "result_id", "result_state", "dependency_tags", "dependency_refs", "theorem", "exact_fixture", "analytic_consequence", "exact_checks", "flags", "next_gate", "provenance", "claim_boundary"],
  "properties": {
    "schema": {"const": "pure-weyl-nariai-rank310-six-block-finite-hpl-v1"},
    "result_id": {"const": "NARIAI_RANK310_SIX_BLOCK_FINITE_HPL_V1"},
    "result_state": {"const": "SIX_BLOCK_FINITE_HPL_TERMINATES_WITH_EXACT_METRIC_CROSS_CORRECTIONS"},
    "dependency_tags": {"type": "array", "prefixItems": [{"const": "LOCAL-ALGEBRAIC"}, {"const": "LORENTZIAN-CAUSAL"}], "items": false, "minItems": 2, "maxItems": 2},
    "dependency_refs": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/dependency"}},
    "theorem": {
      "type": "object",
      "required": ["statement", "finite_formulas", "scope"],
      "properties": {
        "statement": {"type": "string", "minLength": 1},
        "finite_formulas": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "exact_fixture": {
      "type": "object",
      "required": ["coefficient_algebra", "block_count", "delta_nonzero_blocks", "H_delta_nonzero_blocks", "delta_H_nonzero_blocks", "identity_defect_counts", "inverse_series_length", "metric_quadratic_cross_corrections", "transferred_metric_differential", "finite_relations"],
      "properties": {
        "coefficient_algebra": {"type": "string", "minLength": 1},
        "block_count": {"const": 10},
        "delta_nonzero_blocks": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/blockEntry"}},
        "H_delta_nonzero_blocks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/blockEntry"}},
        "delta_H_nonzero_blocks": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/blockEntry"}},
        "identity_defect_counts": {"$ref": "#/$defs/zeroRecord"},
        "inverse_series_length": {"const": 2},
        "metric_quadratic_cross_corrections": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/blockEntry"}},
        "transferred_metric_differential": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/metricBlockEntry"}},
        "finite_relations": {"type": "array", "minItems": 5, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "analytic_consequence": {
      "type": "object",
      "required": ["nonlocal_HPL_inverse_required", "convergence_condition_required", "quadratic_metric_cross_terms_may_be_dropped", "remaining_input"],
      "properties": {
        "nonlocal_HPL_inverse_required": {"const": false},
        "convergence_condition_required": {"const": false},
        "quadratic_metric_cross_terms_may_be_dropped": {"const": false},
        "remaining_input": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "exact_checks": {"$ref": "#/$defs/trueRecord"},
    "flags": {
      "type": "object",
      "required": ["NARIAI_RANK310_SIX_BLOCK_FINITE_HPL_V1", "SIX_BLOCK_FINITE_SUPPORT_LOCAL_HPL", "KS_SIX_BLOCK_GEOMETRIC_COEFFICIENT_BINDING", "TRANSVERSE_KS_COMMON_SLAB_CAUSAL_TRANSFER", "TRANSVERSE_KS_GLOBAL_SMOOTH_CYLINDER_FAMILY", "HADAMARD_STATE", "QUANTUM_CLAIM"],
      "properties": {
        "NARIAI_RANK310_SIX_BLOCK_FINITE_HPL_V1": {"const": true},
        "SIX_BLOCK_FINITE_SUPPORT_LOCAL_HPL": {"const": true},
        "KS_SIX_BLOCK_GEOMETRIC_COEFFICIENT_BINDING": {"const": false},
        "TRANSVERSE_KS_COMMON_SLAB_CAUSAL_TRANSFER": {"const": false},
        "TRANSVERSE_KS_GLOBAL_SMOOTH_CYLINDER_FAMILY": {"const": false},
        "HADAMARD_STATE": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      },
      "additionalProperties": false
    },
    "next_gate": {"const": "NARIAI_KS_SIX_BLOCK_GEOMETRIC_BINDING_AND_COMMON_SLAB_ENDPOINT"},
    "provenance": {
      "type": "object",
      "required": ["source_manifest", "verification_commands"],
      "properties": {
        "source_manifest": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "verification_commands": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "claim_boundary": {"type": "string", "minLength": 200}
  },
  "additionalProperties": false,
  "$defs": {
    "dependency": {"type": "object", "required": ["artifact_id", "path", "sha256"], "properties": {"artifact_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "additionalProperties": false},
    "trueRecord": {"type": "object", "minProperties": 1, "additionalProperties": {"const": true}},
    "zeroRecord": {"type": "object", "minProperties": 1, "additionalProperties": {"const": 0}},
    "blockEntry": {"type": "object", "required": ["row", "column", "value"], "properties": {"row": {"type": "integer", "minimum": 0, "maximum": 9}, "column": {"type": "integer", "minimum": 0, "maximum": 9}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "metricBlockEntry": {"type": "object", "required": ["row", "column", "value"], "properties": {"row": {"type": "integer", "minimum": 0, "maximum": 3}, "column": {"type": "integer", "minimum": 0, "maximum": 3}, "value": {"type": "string", "minLength": 1}}, "additionalProperties": false}
  }
}
