{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/closed-s3-relative-phase-nonhomogeneous-hodge-payload-v1.schema.json",
  "title": "Oracle-free exact matrix payload for nonhomogeneous relative phases",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "payload_status",
    "dependency_tags",
    "import_ref",
    "symbolic_parameters",
    "matrix_identities",
    "fixtures",
    "consumer_contract",
    "content_sha256"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-closed-s3-relative-phase-nonhomogeneous-hodge-payload-v1"},
    "result_id": {"const": "CLOSED_S3_RELATIVE_PHASE_NONHOMOGENEOUS_HODGE_PAYLOAD_V1"},
    "payload_status": {"const": "ORACLE_FREE_EXACT_MATRIX_PAYLOAD_NO_CONFLUX_VERDICT"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "import_ref": {"type": "object", "minProperties": 6},
    "symbolic_parameters": {"type": "object", "minProperties": 10},
    "matrix_identities": {"type": "object", "minProperties": 9},
    "fixtures": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "fixture_id",
          "Q",
          "phase_kinetic_M",
          "gauge_kinetic_K",
          "n",
          "r",
          "rank_Q",
          "relative_dimension",
          "matter_kernel_gauge_dimension",
          "relative_character_basis_N",
          "active_gauge_complement_S",
          "matter_kernel_basis_T",
          "K_orthogonal_active_basis_Sperp",
          "Q_active",
          "effective_active_gauge_kinetic_Ka",
          "matter_kernel_gauge_kinetic_K0",
          "vertical_phase_Gram_V",
          "relative_inverse_metric_A",
          "relative_metric_Grel",
          "relative_horizontal_lift_H",
          "ell",
          "scalar_eigenvalue_lambda",
          "coexact_one_form_eigenvalue_mu",
          "scalar_harmonic_degeneracy",
          "coexact_one_form_total_degeneracy",
          "longitudinal_kinetic_after_Gauss",
          "longitudinal_frequency_squared_operator",
          "coexact_frequency_squared_operator",
          "exact_checks"
        ],
        "properties": {
          "fixture_id": {"type": "string", "minLength": 1},
          "Q": {"type": "array"},
          "phase_kinetic_M": {"type": "array"},
          "gauge_kinetic_K": {"type": "array"},
          "n": {"type": "integer", "minimum": 1},
          "r": {"type": "integer", "minimum": 0},
          "rank_Q": {"type": "integer", "minimum": 0},
          "relative_dimension": {"type": "integer", "minimum": 0},
          "matter_kernel_gauge_dimension": {"type": "integer", "minimum": 0},
          "relative_character_basis_N": {"type": "array"},
          "active_gauge_complement_S": {"type": "array"},
          "matter_kernel_basis_T": {"type": "array"},
          "K_orthogonal_active_basis_Sperp": {"type": "array"},
          "Q_active": {"type": "array"},
          "effective_active_gauge_kinetic_Ka": {"type": "array"},
          "matter_kernel_gauge_kinetic_K0": {"type": "array"},
          "vertical_phase_Gram_V": {"type": "array"},
          "relative_inverse_metric_A": {"type": "array"},
          "relative_metric_Grel": {"type": "array"},
          "relative_horizontal_lift_H": {"type": "array"},
          "ell": {"type": "integer", "minimum": 1},
          "scalar_eigenvalue_lambda": {"type": "integer", "minimum": 3},
          "coexact_one_form_eigenvalue_mu": {"type": "integer", "minimum": 4},
          "scalar_harmonic_degeneracy": {"type": "integer", "minimum": 4},
          "coexact_one_form_total_degeneracy": {"type": "integer", "minimum": 6},
          "longitudinal_kinetic_after_Gauss": {"type": "array"},
          "longitudinal_frequency_squared_operator": {"type": "array"},
          "coexact_frequency_squared_operator": {"type": "array"},
          "exact_checks": {
            "type": "object",
            "minProperties": 10,
            "additionalProperties": {"const": true}
          }
        },
        "additionalProperties": false
      }
    },
    "consumer_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_use", "forbidden_use", "equivalence_level"],
      "properties": {
        "allowed_use": {"type": "string", "minLength": 1},
        "forbidden_use": {"type": "string", "minLength": 1},
        "equivalence_level": {"const": "L2_CANONICAL_MATRIX_EQUALITY_AFTER_DECLARED_BASIS_SPLIT"}
      }
    },
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
