{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-positive-jet-super-cotangent-redefinition-convention-v1.schema.json",
  "title": "Berger positive-jet super-cotangent redefinition convention v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "dependency_tags",
    "generality_level",
    "dependency_refs",
    "scientific_replay",
    "claim_flags",
    "next_gate",
    "source_manifest",
    "verification_commands",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-berger-positive-jet-super-cotangent-redefinition-convention-v1"},
    "result_id": {"const": "BERGER_POSITIVE_JET_SUPER_COTANGENT_REDEFINITION_CONVENTION_V1"},
    "result_state": {"const": "PBW_POSITIVE_JET_SUPER_COTANGENT_CONVENTION_CERTIFIED"},
    "dependency_tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{"const": "LOCAL-ALGEBRAIC"}],
      "items": false
    },
    "generality_level": {"const": "G0"},
    "dependency_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "scientific_replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "zero_word_restriction", "positive_jet_controls"],
      "properties": {
        "formula": {"type": "string"},
        "zero_word_restriction": {"type": "object"},
        "positive_jet_controls": {"type": "object"}
      }
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "next_gate": {"const": "BERGER_RETAINED_MIXED_ELL3_PBW_ORDER_TWO_FULL_BV_REDEFINITION_V1"},
    "source_manifest": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "verification_commands": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "string"}
    },
    "claim_boundary": {"type": "string"}
  }
}
