        "records": {
          "type": "array",
          "minItems": 160,
          "maxItems": 160,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "row_id", "q2_role"],
            "properties": {
              "row": {"type": "integer", "minimum": 0, "maximum": 159},
              "row_id": {"type": "string", "minLength": 1},
