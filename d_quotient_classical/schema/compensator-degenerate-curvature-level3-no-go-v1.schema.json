    "nonempty-object": {
      "type": "object",
      "minProperties": 1
    },
    "sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "result_id",
        "result_state",
        "sha256",
        "source_commit",
        "selected_action"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "result_id": {
          "$ref": "#/$defs/nonempty"
        },
        "result_state": {
          "$ref": "#/$defs/nonempty"
