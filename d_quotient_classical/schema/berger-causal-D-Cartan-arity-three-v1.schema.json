{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-berger-causal-D-Cartan-arity-three-v1.json",
  "title": "Complete four-dimensional Berger arity-three causal D-Cartan certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "setting_id", "claim_status", "dependency_tags",
    "dependency_refs", "convention", "arity_three_source", "cyclic_completion",
    "support_scope", "exact_checks", "publication", "flags", "next_gates",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-berger-causal-D-Cartan-arity-three-v1"},
    "result_id": {"const": "BERGER_ARITY_THREE_D_CARTAN_FULL_4D"},
    "setting_id": {"type": "string", "minLength": 1},
    "claim_status": {"const": "CERTIFIED_CAUSAL_CYCLIC_D_CARTAN_THROUGH_ARITY_THREE"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]},
    "dependency_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete_causal_contraction", "lower_causal_Cartan", "support_local_q2",
        "support_local_q3", "support_local_q3_payload", "local_D_action",
        "odd_Darboux_pairing"
      ],
      "properties": {
        "complete_causal_contraction": {"$ref": "#/$defs/dependency"},
        "lower_causal_Cartan": {"$ref": "#/$defs/dependency"},
        "support_local_q2": {"$ref": "#/$defs/dependency"},
        "support_local_q3": {"$ref": "#/$defs/dependency"},
        "support_local_q3_payload": {"$ref": "#/$defs/dependency"},
        "local_D_action": {"$ref": "#/$defs/dependency"},
        "odd_Darboux_pairing": {"$ref": "#/$defs/dependency"}
      }
    },
    "convention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["Taylor", "recurrence", "source_degree", "cyclic_tensorization"],
      "properties": {
        "Taylor": {"const": "suspended-graded-symmetric-factorial-v1"},
        "recurrence": {"type": "string", "minLength": 1},
        "source_degree": {"const": 0},
        "cyclic_tensorization": {"type": "string", "minLength": 1}
      }
    },
    "arity_three_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source", "L_D3", "delta_q3_substitution", "delta_iota_D1_substitution",
        "delta_iota_D2_substitution", "D_q3_derivation", "graded_Jacobi",
        "normalized_channel_coefficients", "delta_A_D3"
      ],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "L_D3": {"const": "ZERO"},
        "delta_q3_substitution": {"type": "string", "minLength": 1},
        "delta_iota_D1_substitution": {"type": "string", "minLength": 1},
        "delta_iota_D2_substitution": {"type": "string", "minLength": 1},
        "D_q3_derivation": {"type": "string", "minLength": 1},
        "graded_Jacobi": {"type": "string", "minLength": 1},
        "normalized_channel_coefficients": {
          "type": "object",
          "additionalProperties": false,
          "required": ["[[q2,q2],iota_D1]", "[q3,D]"],
          "properties": {
            "[[q2,q2],iota_D1]": {"const": "0"},
            "[q3,D]": {"const": "0"}
          }
        },
        "delta_A_D3": {"const": "ZERO"}
      }
    },
    "cyclic_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_primitive", "raw_identity", "projector", "primitive", "identity",
        "pairing_and_sign_audit", "Reynolds_audit"
      ],
      "properties": {
        "raw_primitive": {"type": "string", "minLength": 1},
        "raw_identity": {"const": "delta R^(3)=-A_D^(3)"},
        "projector": {"const": "Cyc_4=(I+tau+tau^2+tau^3)/4"},
        "primitive": {"type": "string", "minLength": 1},
        "identity": {"const": "delta iota_D,cyc^(3)=-A_D^(3)"},
        "pairing_and_sign_audit": {"$ref": "#/$defs/signAudit"},
        "Reynolds_audit": {"$ref": "#/$defs/reynoldsAudit"}
      }
    },
    "support_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "q2_q3_D_and_pairing_are_support_local",
        "advanced_retarded_chain_homotopies_remain_one_sided",
        "cyclic_arity_three_primitive_is_two_sided_causal", "support_bound",
        "separately_retarded_or_advanced_cyclic_primitive_claimed",
        "inverse_spatial_laplacian", "mode_or_helicity_projector"
      ],
      "properties": {
        "q2_q3_D_and_pairing_are_support_local": {"const": true},
        "advanced_retarded_chain_homotopies_remain_one_sided": {"const": true},
        "cyclic_arity_three_primitive_is_two_sided_causal": {"const": true},
        "support_bound": {"type": "string", "minLength": 1},
        "separately_retarded_or_advanced_cyclic_primitive_claimed": {"const": false},
        "inverse_spatial_laplacian": {"const": false},
        "mode_or_helicity_projector": {"const": false}
      }
    },
    "exact_checks": {
      "type": "object",
      "minProperties": 16,
      "additionalProperties": {"const": true}
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_path", "report_path", "source_manifest_path",
        "source_manifest_schema_path", "verification_receipt_path",
        "verification_receipt_schema_path"
      ],
      "properties": {
        "schema_path": {"type": "string", "minLength": 1},
        "report_path": {"type": "string", "minLength": 1},
        "source_manifest_path": {"type": "string", "minLength": 1},
        "source_manifest_schema_path": {"type": "string", "minLength": 1},
        "verification_receipt_path": {"type": "string", "minLength": 1},
        "verification_receipt_schema_path": {"type": "string", "minLength": 1}
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "BERGER_CAUSAL_D_CARTAN_V2", "BERGER_ARITY_THREE_D_CARTAN_SOURCE_CLOSED",
        "BERGER_ARITY_THREE_D_CARTAN_CYCLIC_COMPLETION",
        "BERGER_ARITY_THREE_D_CARTAN_FULL_4D",
        "BERGER_CAUSAL_D_CARTAN_THROUGH_ARITY_THREE",
        "BERGER_HADAMARD_DATA", "QUANTUM_CLAIM"
      ],
      "properties": {
        "BERGER_CAUSAL_D_CARTAN_V2": {"const": true},
        "BERGER_ARITY_THREE_D_CARTAN_SOURCE_CLOSED": {"const": true},
        "BERGER_ARITY_THREE_D_CARTAN_CYCLIC_COMPLETION": {"const": true},
        "BERGER_ARITY_THREE_D_CARTAN_FULL_4D": {"const": true},
        "BERGER_CAUSAL_D_CARTAN_THROUGH_ARITY_THREE": {"const": true},
        "BERGER_HADAMARD_DATA": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      }
    },
    "next_gates": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_id", "sha256"],
      "properties": {
        "result_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "signAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows", "degree_multiplicities", "odd_Darboux_negative_orientations",
        "pairing_partner_involution", "pairing_degree_sum_one",
        "pairing_odd_skew_orientation", "tensor_rotation_sign",
        "admissible_degree_zero_row_quartets", "C4_group_law_defects", "audit_method"
      ],
      "properties": {
        "total_rows": {"const": 54},
        "degree_multiplicities": {"const": {"-1": 5, "0": 22, "1": 22, "2": 5}},
        "odd_Darboux_negative_orientations": {"const": 27},
        "pairing_partner_involution": {"const": true},
        "pairing_degree_sum_one": {"const": true},
        "pairing_odd_skew_orientation": {"const": true},
        "tensor_rotation_sign": {"type": "string", "minLength": 1},
        "admissible_degree_zero_row_quartets": {"const": 978736},
        "C4_group_law_defects": {"const": 0},
        "audit_method": {"type": "string", "minLength": 1}
      }
    },
    "reynoldsAudit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "group_algebra", "projector_coefficients", "Cyc4_squared_equals_Cyc4",
        "Cyc4_commutes_with_delta", "Cyc4_fixes_cyclic_source",
        "delta_Cyc4_raw_primitive_coefficient", "cyclic_primitive_identity"
      ],
      "properties": {
        "group_algebra": {"const": "Q[C4]/(tau^4-1)"},
        "projector_coefficients": {"const": ["1/4", "1/4", "1/4", "1/4"]},
        "Cyc4_squared_equals_Cyc4": {"const": true},
        "Cyc4_commutes_with_delta": {"const": true},
        "Cyc4_fixes_cyclic_source": {"const": true},
        "delta_Cyc4_raw_primitive_coefficient": {"const": "-1"},
        "cyclic_primitive_identity": {"const": true}
      }
    }
  }
}
