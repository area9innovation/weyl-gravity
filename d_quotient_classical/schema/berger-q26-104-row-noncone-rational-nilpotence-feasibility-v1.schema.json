    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nilpotence_rank_only_global_104_row_obstruction",
        "retained_cohomology_rank_only_global_104_row_obstruction",
        "rational_PBW_operator_completion_constructed",
        "A104_evolution_lift_constructed",
