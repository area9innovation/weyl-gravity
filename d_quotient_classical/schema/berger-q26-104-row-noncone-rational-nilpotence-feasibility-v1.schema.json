        "retained_cohomology_rank_only_global_104_row_obstruction": {"const": false},
        "rational_PBW_operator_completion_constructed": {"const": false},
        "A104_evolution_lift_constructed": {"const": false},
        "cyclic_pairing_constructed": {"const": false},
        "real_involution_constructed": {"const": false},
        "retained_SDR_constructed": {"const": false},
        "Hadamard_or_quantum_claim": {"const": false}
      }
