    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest", "verification_commands"],
      "properties": {
        "source_manifest": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string", "minLength": 1}
