{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-berger-q26-104-row-noncone-evolution-extension-obstruction-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "lifecycle_status",
    "dependency_tags",
    "scope",
    "pinned_inputs",
    "exact_obstruction",
    "theorem",
    "classification",
    "next_gate",
    "claim_boundary",
    "provenance"
  ],
  "properties": {
    "schema": {
      "const": "pure-weyl-berger-q26-104-row-noncone-evolution-extension-obstruction-v1"
    },
    "result_id": {
      "const": "BERGER_Q26_104_ROW_NONCONE_EVOLUTION_EXTENSION_OBSTRUCTION_V1"
    },
    "result_state": {
      "const": "EXACT_RATIONAL_BOUNDARY_COKERNEL_OBSTRUCTS_A104_CHAIN_EXTENSION_ON_THE_NONCONE_FEASIBILITY_WITNESS"
    },
    "lifecycle_status": {"const": "OBSTRUCTED"},
    "dependency_tags": {
      "const": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]
    },
    "scope": {"type": "object"},
    "pinned_inputs": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/artifact"}
    },
    "exact_obstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "path",
        "sha256",
        "source_basis_index",
        "pure_old_boundary_index",
        "boundary_cokernel_index",
        "normalized_pairing",
        "free_new_evolution_blocks_eliminated"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_basis_index": {"const": 16},
        "pure_old_boundary_index": {"const": 5},
        "boundary_cokernel_index": {"const": 25},
        "normalized_pairing": {"const": "-51/2"},
        "free_new_evolution_blocks_eliminated": {"const": true}
      }
    },
    "theorem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hypothesis", "identity", "contradiction", "conclusion"],
      "properties": {
        "hypothesis": {"type": "string", "minLength": 1},
        "identity": {"const": "E_0 d_-1 = d_-1 E_-1"},
        "contradiction": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string", "minLength": 1}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixed_noncone_witness_A104_chain_extension_exists",
        "all_104_row_noncone_differentials_obstructed",
        "rational_PBW_operator_completion_constructed",
        "cyclic_pairing_constructed",
        "real_involution_constructed",
        "retained_SDR_constructed",
        "Hadamard_or_quantum_claim"
      ],
      "properties": {
        "fixed_noncone_witness_A104_chain_extension_exists": {"const": false},
        "all_104_row_noncone_differentials_obstructed": {"const": false},
        "rational_PBW_operator_completion_constructed": {"const": false},
        "cyclic_pairing_constructed": {"const": false},
        "real_involution_constructed": {"const": false},
        "retained_SDR_constructed": {"const": false},
        "Hadamard_or_quantum_claim": {"const": false}
      }
    },
    "next_gate": {
      "const": "SOLVE_THE_SIMULTANEOUS_NILPOTENCE_AND_A104_EQUIVARIANCE_SYSTEM_BEFORE_IMPOSING_CYCLIC_FREE_ADJOINTNESS"
    },
    "claim_boundary": {"type": "string", "minLength": 1},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_manifest", "verification_commands"],
      "properties": {
        "source_manifest": {
          "type": "object",
          "minProperties": 4,
          "additionalProperties": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "verification_commands": {
          "type": "array",
          "minItems": 4,
          "items": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "path", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
