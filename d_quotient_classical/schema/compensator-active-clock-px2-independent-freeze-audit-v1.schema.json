      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "column_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
