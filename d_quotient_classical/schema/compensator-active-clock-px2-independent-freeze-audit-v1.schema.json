      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonempty-object": {
      "type": "object",
      "minProperties": 1
    },
    "boolean-ledger": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
