{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/relative-arity-two-pbw-defect-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "coefficient_field", "background_id", "source_carrier_id", "target_carrier_id", "source_rows", "target_rows", "content", "canonical_sha256", "degree_profile"],
  "properties": {
    "schema": {"const": "relative-arity-two-pbw-defect-v1"},
    "result_id": {"const": "EINSTEIN_WEYL_RELATIVE_ARITY_TWO_DEFECT_V1_PBW"},
    "coefficient_field": {"const": "Q"},
    "background_id": {"const": "compact_magnetic_Plebanski_Hacyan_product"},
    "source_carrier_id": {"const": "einstein_maxwell_minimal_bv_38_product_coordinate_jet"},
    "target_carrier_id": {"const": "weyl_maxwell_minimal_bv_40_product_coordinate_theta_jet"},
    "source_rows": {"type": "array", "minItems": 38, "maxItems": 38, "items": {"$ref": "#/$defs/row"}},
    "target_rows": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"$ref": "#/$defs/row"}},
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["formula", "evaluation", "source_row_count", "target_row_count", "maximum_total_order", "term_count", "row_defect_counts", "terms"],
      "properties": {
        "formula": {"const": "Delta2=q2_W(f1,f1)-f1*q2_E"},
        "evaluation": {"const": "complete_homogeneous_basepoint_PBW_operator"},
        "source_row_count": {"const": 38},
        "target_row_count": {"const": 40},
        "maximum_total_order": {"type": "integer", "minimum": 0},
        "term_count": {"type": "integer", "minimum": 1},
        "row_defect_counts": {"type": "array", "minItems": 40, "maxItems": 40, "items": {"type": "integer", "minimum": 0}},
        "terms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/term"}}
      }
    },
    "canonical_sha256": {"$ref": "#/$defs/hash"},
    "degree_profile": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["output_degree", "input_degrees", "term_count"],
        "properties": {
          "output_degree": {"type": "integer"},
          "input_degrees": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
          "term_count": {"type": "integer", "minimum": 1}
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "row_id", "degree", "parity", "bundle_id", "dual_row"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "row_id": {"type": "string", "minLength": 1},
        "degree": {"type": "integer"},
        "parity": {"enum": ["even", "odd"]},
        "bundle_id": {"type": "string", "minLength": 1},
        "dual_row": {"type": "integer", "minimum": 0}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "word"],
      "properties": {
        "row": {"type": "integer", "minimum": 0, "maximum": 37},
        "word": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 3}}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_row", "inputs", "coefficient"],
      "properties": {
        "output_row": {"type": "integer", "minimum": 0, "maximum": 39},
        "inputs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/input"}},
        "coefficient": {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}
      }
    }
  }
}
