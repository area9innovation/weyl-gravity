    "field_coordinates": {"type": "object"},
    "gauge_incidence": {"type": "object"},
    "canonical_antifield_lift": {"type": "object"},
    "minimal_row_layout": {"type": "array", "minItems": 12, "maxItems": 12},
    "clock_block": {"type": "object"},
    "hessian_split_argument": {"type": "object"},
    "sdr": {"type": "object"},
    "retained_layout_ref": {"type": "object"},
    "operator_fingerprints": {"type": "object"},
    "rational_fixture": {"type": "object"},
    "flags": {"type": "object"},
    "next_gate": {"const": "BERGER_RETAINED_MINIMAL_OPERATOR"},
    "not_established": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
