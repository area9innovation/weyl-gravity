{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-berger-minimal-bv-clock-sdr-v1.schema.json",
  "title": "Support-local minimal Berger clock BV contraction",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "setting_id", "phase_space_id", "claim_status",
    "dependency_tags", "background_inputs", "field_coordinates",
    "gauge_incidence", "canonical_antifield_lift", "minimal_row_layout",
    "clock_block", "hessian_split_argument", "sdr", "retained_layout_ref", "operator_fingerprints",
    "rational_fixture", "flags", "next_gate", "not_established",
    "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-berger-minimal-bv-clock-sdr-v1"},
    "result_id": {"const": "BERGER_MINIMAL_BV_CLOCK_SDR"},
    "setting_id": {"const": "compact_positive_berger_clock_fixed_coupling_linearized"},
    "phase_space_id": {"const": "positive_berger_fixed_coupling_linearized_solutions"},
