{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/relative-full-five-current-second-jet-chunk-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "generator", "component_axis",
    "vector_density_component", "output", "vector_density_to_form_sign",
    "maximum_input_derivative_order", "maximum_coefficient_jet_order",
    "input_exchange_symmetry", "coefficient_profiles",
    "coefficient_profile_count", "canonical_term_count",
    "diagonal_term_count", "expanded_term_count", "terms"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-relative-full-five-current-second-jet-chunk-v1"},
    "result_id": {"type": "string", "minLength": 20},
    "generator": {"enum": ["H", "P_x", "J_1", "J_2", "J_3"]},
    "component_axis": {"type": "integer", "minimum": 0, "maximum": 3},
    "vector_density_component": {"enum": ["t", "x", "theta", "phi"]},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["row", "row_id"],
      "properties": {
        "row": {"type": "integer", "minimum": 0, "maximum": 159},
        "row_id": {"type": "string", "minLength": 1}
      }
    },
    "vector_density_to_form_sign": {"enum": [-1, 1]},
    "maximum_input_derivative_order": {"const": 4},
    "maximum_coefficient_jet_order": {"const": 2},
    "input_exchange_symmetry": {"const": "symmetric_expand_off_diagonal"},
    "coefficient_profiles": {
      "type": "array",
      "items": {"$ref": "#/$defs/profile"}
    },
    "coefficient_profile_count": {"type": "integer", "minimum": 0},
    "canonical_term_count": {"type": "integer", "minimum": 0},
    "diagonal_term_count": {"type": "integer", "minimum": 0},
    "expanded_term_count": {"type": "integer", "minimum": 0},
    "terms": {"type": "array", "items": {"$ref": "#/$defs/term"}}
  },
  "$defs": {
    "word": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 3},
      "maxItems": 4
    },
    "coefficientWord": {
      "type": "array",
      "items": {"type": "integer", "minimum": 0, "maximum": 3},
      "maxItems": 2
    },
    "jet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["word", "coefficient"],
      "properties": {
        "word": {"$ref": "#/$defs/coefficientWord"},
        "coefficient": {"type": "string", "pattern": "^-?[0-9]+(?:/[1-9][0-9]*)?$"}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "coefficient_jets"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "coefficient_jets": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/jet"}
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local_field", "row", "row_id", "word"],
      "properties": {
        "local_field": {"type": "integer", "minimum": 0, "maximum": 13},
        "row": {"type": "integer", "minimum": 0},
        "row_id": {"type": "string", "minLength": 1},
        "word": {"$ref": "#/$defs/word"}
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inputs", "coefficient_profile"],
      "properties": {
        "inputs": {
          "type": "array",
          "prefixItems": [{"$ref": "#/$defs/input"}, {"$ref": "#/$defs/input"}],
          "minItems": 2,
          "maxItems": 2
        },
        "coefficient_profile": {"type": "integer", "minimum": 0}
      }
    }
  }
}
