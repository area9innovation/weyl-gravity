{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/conformally-einstein-tractor-curvature-obstruction-v1.schema.json",
  "title": "Conformally Einstein tractor-curvature obstruction",
  "type": "object",
  "required": ["schema", "result_id", "result_state", "dependency_tags", "dependency_ref", "target_background", "exact_curvature", "obstruction", "exact_checks", "flags", "next_gate", "claim_boundary", "provenance"],
  "properties": {
    "schema": {"const": "pure-weyl-conformally-einstein-tractor-curvature-obstruction-v1"},
    "result_id": {"const": "CONFORMALLY_EINSTEIN_TRACTOR_CURVATURE_OBSTRUCTION_V1"},
    "result_state": {"const": "ZERO_ORDER_CONFORMAL_CONJUGATION_OBSTRUCTED_ON_NARIAI"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "dependency_ref": {"$ref": "#/$defs/dependency"},
    "target_background": {
      "type": "object",
      "required": ["name", "manifold", "metric", "orthonormal_signature", "factor_curvatures", "global_hyperbolicity", "boundary", "einstein", "scalar_curvature", "locally_symmetric", "cotton_zero", "bach_flat"],
      "properties": {
        "name": {"const": "unit Nariai spacetime"},
        "manifold": {"const": "M_N=R x S1 x S2"},
        "metric": {"type": "string"},
        "orthonormal_signature": {"const": "(-,+,+,+)"},
        "factor_curvatures": {"const": ["1", "1"]},
        "global_hyperbolicity": {"type": "string", "minLength": 30},
        "boundary": {"const": "no timelike boundary"},
        "einstein": {"const": "Ric(g_N)=g_N"},
        "scalar_curvature": {"const": "4"},
        "locally_symmetric": {"const": true},
        "cotton_zero": {"const": true},
        "bach_flat": {"const": true}
      },
      "additionalProperties": false
    },
    "exact_curvature": {
      "type": "object",
      "required": ["orthonormal_metric", "ricci", "weyl_components", "weyl_trace_defect", "tractor_curvature"],
      "properties": {
        "orthonormal_metric": {"$ref": "#/$defs/matrix4"},
        "ricci": {"$ref": "#/$defs/matrix4"},
        "weyl_components": {
          "type": "object",
          "required": ["C_0101", "C_2323", "C_0202"],
          "properties": {"C_0101": {"const": "-2/3"}, "C_2323": {"const": "2/3"}, "C_0202": {"const": "1/3"}},
          "additionalProperties": false
        },
        "weyl_trace_defect": {"const": "0"},
        "tractor_curvature": {"type": "string", "minLength": 30}
      },
      "additionalProperties": false
    },
    "obstruction": {
      "type": "object",
      "required": ["attempted_extension", "integrability_equation", "source_curvature", "forced_target_condition", "normalized_witness", "normalized_witness_value", "conclusion"],
      "properties": {
        "attempted_extension": {"type": "string", "minLength": 50},
        "integrability_equation": {"const": "Omega^T_N U=U Omega^T_0"},
        "source_curvature": {"type": "string"},
        "forced_target_condition": {"type": "string"},
        "normalized_witness": {"const": "(3/2) C_2323"},
        "normalized_witness_value": {"const": "1"},
        "conclusion": {"const": "no such zero-order conformal/tractor conjugation exists, even locally"}
      },
      "additionalProperties": false
    },
    "exact_checks": {
      "type": "object",
      "required": ["target_is_globally_hyperbolic", "target_is_Einstein", "target_is_Bach_flat", "target_Weyl_is_nonzero", "source_tractor_curvature_zero", "target_tractor_curvature_nonzero", "zero_order_intertwiner_obstructed"],
      "properties": {
        "target_is_globally_hyperbolic": {"const": true},
        "target_is_Einstein": {"const": true},
        "target_is_Bach_flat": {"const": true},
        "target_Weyl_is_nonzero": {"const": true},
        "source_tractor_curvature_zero": {"const": true},
        "target_tractor_curvature_nonzero": {"const": true},
        "zero_order_intertwiner_obstructed": {"const": true}
      },
      "additionalProperties": false
    },
    "flags": {
      "type": "object",
      "required": ["CONFORMALLY_EINSTEIN_TRACTOR_CURVATURE_OBSTRUCTION_V1", "C_G2_ZERO_ORDER_CONJUGATION_EXTENDS_TO_NARIAI", "CURVED_DIFFERENTIAL_HPL_CORRECTION_EXISTS", "NARIAI_GREEN_HOMOTOPY_CONSTRUCTED", "ALL_BACH_FLAT_BACKGROUNDS_OBSTRUCTED", "LOCAL_PATCHING_OBSTRUCTED", "QUANTUM_CLAIM"],
      "properties": {
        "CONFORMALLY_EINSTEIN_TRACTOR_CURVATURE_OBSTRUCTION_V1": {"const": true},
        "C_G2_ZERO_ORDER_CONJUGATION_EXTENDS_TO_NARIAI": {"const": false},
        "CURVED_DIFFERENTIAL_HPL_CORRECTION_EXISTS": {"const": false},
        "NARIAI_GREEN_HOMOTOPY_CONSTRUCTED": {"const": false},
        "ALL_BACH_FLAT_BACKGROUNDS_OBSTRUCTED": {"const": false},
        "LOCAL_PATCHING_OBSTRUCTED": {"const": false},
        "QUANTUM_CLAIM": {"const": false}
      },
      "additionalProperties": false
    },
    "next_gate": {"const": "C_G2_BACH_FLAT_CURVED_HPL_CORRECTION_OR_OBSTRUCTION"},
    "claim_boundary": {"type": "string", "minLength": 300},
    "provenance": {
      "type": "object",
      "required": ["source_manifest", "verification_commands"],
      "properties": {
        "source_manifest": {"type": "object", "minProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
        "verification_commands": {"type": "array", "minItems": 4, "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "dependency": {
      "type": "object",
      "required": ["artifact_id", "path", "sha256"],
      "properties": {"artifact_id": {"const": "CONFORMALLY_RELATED_CYCLIC_CAUSAL_TRANSFER_V1"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
      "additionalProperties": false
    },
    "matrix4": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "string"}}
    }
  }
}
