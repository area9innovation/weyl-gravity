        "typed_pairing_lowering_used": {"const": true},
        "complete_constant_field_matter_parity_ansatz_enumerated": {"const": true},
        "constant_field_coboundary_map_surjective": {"const": true},
        "explicit_primitive_reconstructs_target": {"const": true},
        "no_floating_point": {"const": true}
      },
      "additionalProperties": false
