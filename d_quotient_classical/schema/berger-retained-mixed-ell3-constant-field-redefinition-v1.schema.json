        "BV_cyclicity_reason": {"type": "string", "minLength": 1},
        "matter_parity": {"type": "string", "minLength": 1},
        "F2_unknown_count": {"const": 810},
        "F3_unknown_count": {"const": 1880},
        "total_unknown_count": {"const": 2690}
