        "augmented_rank": {"const": 550},
        "cokernel_dimension": {"const": 0},
        "rank_basis_columns": {"type": "array", "minItems": 550, "maxItems": 550, "uniqueItems": true, "items": {"type": "integer", "minimum": 0, "maximum": 2689}},
