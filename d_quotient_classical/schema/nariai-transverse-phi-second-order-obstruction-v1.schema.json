{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/nariai-transverse-phi-second-order-obstruction-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "result_id", "result_state", "lifecycle_state", "dependency_tags", "dependency_refs", "exact_data", "exact_checks", "flags", "next_gate", "claim_boundary", "source_manifest", "verification_commands"],
  "properties": {
    "schema": {"const": "nariai-transverse-phi-second-order-obstruction-v1"},
    "schema_version": {"const": "1.0.0"},
    "result_id": {"const": "NARIAI_TRANSVERSE_PHI_SECOND_ORDER_OBSTRUCTION_V1"},
    "result_state": {"type": "string", "minLength": 1}, "lifecycle_state": {"const": "CERTIFIED"},
    "dependency_tags": {"type": "array", "items": {"enum": ["LOCAL-ALGEBRAIC", "LORENTZIAN-CAUSAL"]}, "minItems": 1, "uniqueItems": true},
    "dependency_refs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/dependency"}, "minProperties": 2},
    "exact_data": {
      "type": "object", "additionalProperties": false,
      "required": ["ansatz", "coefficient_system", "normalized_left_null_witness", "interpretation"],
      "properties": {
        "ansatz": {"type": "object", "additionalProperties": false, "required": ["scope", "words", "basis", "unknowns_per_output_row", "output_rows"], "properties": {"scope": {"type": "string"}, "words": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}}}, "basis": {"type": "array", "items": {"$ref": "#/$defs/basis"}}, "unknowns_per_output_row": {"type": "integer"}, "output_rows": {"type": "integer"}}},
        "coefficient_system": {"type": "object", "additionalProperties": false, "required": ["shape", "rank", "kernel_dimension", "matrix_receipt", "equation_basis", "full_rank_minor", "augmented_ranks", "consistent_rows", "obstructed_rows"], "properties": {"shape": {"type": "array", "items": {"type": "integer"}}, "rank": {"type": "integer"}, "kernel_dimension": {"type": "integer"}, "matrix_receipt": {"$ref": "#/$defs/matrixReceipt"}, "equation_basis": {"type": "array", "items": {"$ref": "#/$defs/equationKey"}}, "full_rank_minor": {"$ref": "#/$defs/rankMinor"}, "augmented_ranks": {"type": "array", "items": {"type": "integer"}}, "consistent_rows": {"type": "array", "items": {"type": "integer"}}, "obstructed_rows": {"type": "array", "items": {"type": "integer"}}}},
        "normalized_left_null_witness": {"type": "object", "additionalProperties": false, "required": ["output_row", "support_size", "terms", "left_null_target_value"], "properties": {"output_row": {"type": "integer"}, "support_size": {"type": "integer"}, "terms": {"type": "array", "items": {"$ref": "#/$defs/witnessTerm"}}, "left_null_target_value": {"type": "string"}}},
        "interpretation": {"type": "object", "additionalProperties": false, "required": ["order_two_Phi_only_repair_exists", "complete_coupled_SDR_obstructed", "required_next_ansatz"], "properties": {"order_two_Phi_only_repair_exists": {"const": false}, "complete_coupled_SDR_obstructed": {"const": false}, "required_next_ansatz": {"type": "string"}}}
      }
    },
    "exact_checks": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 1}, "flags": {"type": "object", "additionalProperties": {"type": "boolean"}, "minProperties": 1},
    "next_gate": {"type": "string", "minLength": 1}, "claim_boundary": {"type": "string", "minLength": 1}, "source_manifest": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "minProperties": 4}, "verification_commands": {"type": "array", "items": {"type": "string"}, "minItems": 4}
  },
  "$defs": {
    "dependency": {"type": "object", "additionalProperties": false, "required": ["path", "result_id", "sha256"], "properties": {"path": {"type": "string"}, "result_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "matrixReceipt": {"type": "object", "additionalProperties": false, "required": ["shape", "rank", "nonzero_coefficients", "sha256"], "properties": {"shape": {"type": "array", "items": {"type": "integer"}}, "rank": {"type": "integer"}, "nonzero_coefficients": {"type": "integer"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "basis": {"type": "object", "additionalProperties": false, "required": ["word", "middle_column"], "properties": {"word": {"type": "array", "items": {"type": "integer"}}, "middle_column": {"type": "integer"}}},
    "equationKey": {"type": "object", "additionalProperties": false, "required": ["word", "input_column"], "properties": {"word": {"type": "array", "items": {"type": "integer"}}, "input_column": {"type": "integer"}}},
    "rankMinor": {"type": "object", "additionalProperties": false, "required": ["rows", "columns", "determinant"], "properties": {"rows": {"type": "array", "items": {"$ref": "#/$defs/equationKey"}}, "columns": {"type": "array", "items": {"type": "integer"}}, "determinant": {"type": "string"}}},
    "witnessTerm": {"type": "object", "additionalProperties": false, "required": ["word", "input_column", "coefficient"], "properties": {"word": {"type": "array", "items": {"type": "integer"}}, "input_column": {"type": "integer"}, "coefficient": {"type": "string"}}}
  }
}
