{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-paper-09-berger-claim-table-v1.json",
  "title": "Paper IX Berger claim-to-certificate table",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "result_id", "paper_state", "theorem_frozen", "paper_sources",
    "setting", "claims", "claim_ids_complete", "independent_cross_checks", "signoff_evidence", "required_signoffs",
    "forbidden_promotions", "next_gate", "claim_boundary"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-paper-09-berger-claim-table-v1"},
    "result_id": {"const": "PAPER_09_BERGER_CLAIM_TABLE"},
    "paper_state": {"const": "WRITING_STARTED"},
    "theorem_frozen": {"const": false},
    "paper_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "paper/09-relational-clocks-berger-d-cartan.tex",
        "paper/09-relational-clocks-berger-d-cartan-computational-supplement.tex"
      ],
      "properties": {
        "paper/09-relational-clocks-berger-d-cartan.tex": {
          "$ref": "#/$defs/sha256"
        },
        "paper/09-relational-clocks-berger-d-cartan-computational-supplement.tex": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "setting": {"type": "string", "minLength": 1},
    "claims": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {"$ref": "#/$defs/claim"}
    },
    "claim_ids_complete": {
      "const": [
        "P09-C1", "P09-C2", "P09-C3", "P09-C4", "P09-C5",
        "P09-C6", "P09-C7", "P09-C8", "P09-C9", "P09-C10"
      ]
    },
    "independent_cross_checks": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/crosscheck"}
    },
    "signoff_evidence": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/nonlinear_signoff"},
        {"$ref": "#/$defs/quantum_signoff"}
      ],
      "items": false
    },
    "required_signoffs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classical_team", "nonlinear_team", "quantum_team", "einstein_team"],
      "properties": {
        "classical_team": {"const": "DRAFTED"},
        "nonlinear_team": {"const": "SIGNED_K_GENERATOR_INTERPRETATION"},
        "quantum_team": {"const": "SIGNED_OFF_CLASSICAL_K_ONLY_QUANTUM_BLOCKED"},
        "einstein_team": {"const": "OPTIONAL_INTERNAL_REFEREE"}
      }
    },
    "forbidden_promotions": {
      "type": "array",
      "minItems": 6,
      "items": {"type": "string", "minLength": 1}
    },
    "next_gate": {"const": "PAPER_09_CLEAN_TREE_REPLAY_DEFERRED"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "crosscheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supports_claim", "certificate_path", "certificate_result_id",
        "certificate_sha256", "certificate_claim_boundary",
        "required_true", "required_false"
      ],
      "properties": {
        "supports_claim": {"type": "string", "minLength": 1},
        "certificate_path": {"type": "string", "minLength": 1},
        "certificate_result_id": {"type": "string", "minLength": 1},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_claim_boundary": {"type": "string", "minLength": 1},
        "required_true": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required_false": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "signoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team", "status", "certificate_path", "certificate_result_id",
        "certificate_sha256", "certificate_claim_boundary", "required_true", "required_false"
      ],
      "properties": {
        "team": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "certificate_path": {"type": "string", "minLength": 1},
        "certificate_result_id": {"type": "string", "minLength": 1},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_claim_boundary": {"type": "string", "minLength": 1},
        "required_true": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required_false": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "nonlinear_signoff": {
      "allOf": [
        {"$ref": "#/$defs/signoff"},
        {
          "properties": {
            "team": {"const": "nonlinear_team"},
            "status": {"const": "SIGNED_SCOPED_K_THEOREM"},
            "certificate_result_id": {"const": "PAPER_09_NONLINEAR_K_GENERATOR_SIGNOFF"}
          }
        }
      ]
    },
    "quantum_signoff": {
      "allOf": [
        {"$ref": "#/$defs/signoff"},
        {
          "properties": {
            "team": {"const": "quantum_team"},
            "status": {"const": "SIGNED_OFF_CLASSICAL_K_ONLY_QUANTUM_BLOCKED"},
            "certificate_result_id": {"const": "PAPER09_QUANTUM_CLAIM_BOUNDARY_SIGNOFF"}
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id", "paper_sections", "claim", "certificate", "required_true",
        "required_false", "certificate_path", "certificate_result_id",
        "certificate_sha256", "certificate_claim_boundary"
      ],
      "properties": {
        "claim_id": {"type": "string", "pattern": "^P09-C([1-9]|10)$"},
        "paper_sections": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "claim": {"type": "string", "minLength": 1},
        "certificate": {"type": "string", "pattern": "^[A-Z0-9_]+\\.json$"},
        "required_true": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "required_false": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "certificate_path": {"type": "string", "minLength": 1},
        "certificate_result_id": {"type": "string", "minLength": 1},
        "certificate_sha256": {"$ref": "#/$defs/sha256"},
        "certificate_claim_boundary": {"type": "string", "minLength": 1}
      }
    }
  }
}
