{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-berger-admissible-same-background-branch-map-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "claim_status", "dependency_tags", "background_id", "source_carrier_id", "map_category", "branch_ids", "mode_scope", "interaction_dependency", "map_artifacts", "acceptance_flags", "claim_boundary"],
  "properties": {
    "schema": {"const": "pure-weyl-berger-admissible-same-background-branch-map-v1"},
    "result_id": {"const": "BERGER_ADMISSIBLE_SAME_BACKGROUND_BRANCH_MAP_V1"},
    "claim_status": {"enum": ["CERTIFIED", "THEOREM_FROZEN", "CERTIFIED_SAME_BACKGROUND_BRANCH_MAP"]},
    "dependency_tags": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["LOCAL-ALGEBRAIC", "REDUCED-MODE", "LORENTZIAN-CAUSAL"]}},
    "background_id": {"const": "fixed_rational_positive_Berger_clock"},
    "source_carrier_id": {"type": "string", "minLength": 1},
    "map_category": {"enum": ["SUPPORT_LOCAL_MIXED_BUNDLE", "NONCONTRACTIBLE_COFIBER", "REDUCED_MODE_NONLOCAL"]},
    "branch_ids": {"type": "array", "minItems": 4, "uniqueItems": true, "allOf": [{"contains": {"const": "Einstein_like"}}, {"contains": {"const": "extra_Weyl"}}, {"contains": {"const": "Maxwell"}}, {"contains": {"const": "gauge_nondynamical"}}], "items": {"type": "string", "minLength": 1}},
    "mode_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theory", "background", "boundaries", "charge_sector", "carrier", "degree", "parity", "ell", "m", "k", "omega"],
      "properties": {
        "theory": {"type": "string", "minLength": 1},
        "background": {"const": "fixed_rational_positive_Berger_clock"},
        "boundaries": {"type": "string", "minLength": 1},
        "charge_sector": {"type": "string", "minLength": 1},
        "carrier": {"type": "string", "minLength": 1},
        "degree": {"type": "string", "minLength": 1},
        "parity": {"type": "string", "minLength": 1},
        "ell": {"type": "string", "minLength": 1},
        "m": {"type": "string", "minLength": 1},
        "k": {"type": "string", "minLength": 1},
        "omega": {"type": "string", "minLength": 1}
      }
    },
    "interaction_dependency": {"$ref": "#/$defs/artifact"},
    "map_artifacts": {
      "type": "array",
      "minItems": 8,
      "allOf": [
        {"contains": {"type": "object", "properties": {"role": {"const": "carrier_crosswalk"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "chain_map"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "branch_inclusion_projection_or_cofiber"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "pairing_transport"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "gauge_nondynamical_disposition"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "k_berger_equivariance"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "cohomology_map"}}, "required": ["role"]}},
        {"contains": {"type": "object", "properties": {"role": {"const": "independent_verifier"}}, "required": ["role"]}}
      ],
      "items": {"$ref": "#/$defs/map_artifact"}
    },
    "acceptance_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SAME_BACKGROUND_AS_INTERACTION", "EXPLICIT_CARRIER_CROSSWALK", "CHAIN_MAP_ALL_DECLARED_ROWS", "EINSTEIN_EXTRA_MAXWELL_BRANCH_MAPS", "GAUGE_AND_NONDYNAMICAL_DISPOSITION", "PAIRING_TRANSPORT_VERIFIED", "K_BERGER_EQUIVARIANT", "COHOMOLOGY_MAP_VERIFIED", "INDEPENDENT_VERIFIER_PASS"],
      "properties": {
        "SAME_BACKGROUND_AS_INTERACTION": {"const": true},
        "EXPLICIT_CARRIER_CROSSWALK": {"const": true},
        "CHAIN_MAP_ALL_DECLARED_ROWS": {"const": true},
        "EINSTEIN_EXTRA_MAXWELL_BRANCH_MAPS": {"const": true},
        "GAUGE_AND_NONDYNAMICAL_DISPOSITION": {"const": true},
        "PAIRING_TRANSPORT_VERIFIED": {"const": true},
        "K_BERGER_EQUIVARIANT": {"const": true},
        "COHOMOLOGY_MAP_VERIFIED": {"const": true},
        "INDEPENDENT_VERIFIER_PASS": {"const": true}
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact": {"type": "object", "additionalProperties": false, "required": ["result_id", "path", "sha256"], "properties": {"result_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "map_artifact": {"type": "object", "additionalProperties": false, "required": ["role", "path", "sha256"], "properties": {"role": {"enum": ["carrier_crosswalk", "chain_map", "branch_inclusion_projection_or_cofiber", "pairing_transport", "gauge_nondynamical_disposition", "k_berger_equivariance", "cohomology_map", "independent_verifier"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
  }
}
