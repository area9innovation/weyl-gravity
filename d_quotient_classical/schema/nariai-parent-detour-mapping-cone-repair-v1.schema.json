    },
    "operatorEntry": {
      "type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}, {"type": "array", "items": {"$ref": "#/$defs/operatorTerm"}}], "items": false, "minItems": 3, "maxItems": 3
