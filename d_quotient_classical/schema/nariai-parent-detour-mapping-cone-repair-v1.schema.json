        "homotopy_odd_cyclic": {"const": true}, "metric_pairing_pullback": {"const": true},
        "canonical_transform": {"const": true}, "transform_left_inverse": {"const": true},
        "transform_right_inverse": {"const": true}, "original_Q_squared": {"const": true},
        "original_odd_cyclic": {"const": true}, "original_retract_identity": {"const": true}
