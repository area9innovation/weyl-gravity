{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/compensator-active-clock-px2-locus-v1.schema.json",
  "title": "Quadratic active-clock compensator coefficient locus",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "dependency_tags",
    "dependencies",
    "action_family",
    "action_family_sha256",
    "stationary_background_equations",
    "coupled_homogeneous_analysis",
    "Berger_sound_cone_and_clock",
    "charges",
    "seven_gate_classification",
    "selection",
    "exact_checks",
    "claim_flags",
    "claim_boundary",
    "next_gate",
    "content_hashes"
  ],
  "properties": {
    "schema": {
      "const": "pure-weyl-compensator-active-clock-px2-locus-v1"
    },
    "result_id": {
      "const": "COMPENSATOR_ACTIVE_CLOCK_PX2_LOCUS_V1"
    },
    "result_state": {
      "const": "SCOPED_QUADRATIC_ACTIVE_CLOCK_GOOD_LOCUS_EMPTY"
    },
    "dependency_tags": {
      "const": [
        "LOCAL-ALGEBRAIC",
        "LORENTZIAN-CAUSAL"
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimal_action_classification",
        "positive_Berger_clock",
        "Berger_charge_convention"
      ],
      "properties": {
        "minimal_action_classification": {
          "$ref": "#/$defs/import-with-lifecycle"
        },
        "positive_Berger_clock": {
          "$ref": "#/$defs/import"
        },
        "Berger_charge_convention": {
          "$ref": "#/$defs/import"
        }
      }
    },
    "action_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "declared_scope",
        "dressed_action",
        "X_definition",
        "coefficient_basis_mod_topology",
        "complete_phase_basis_argument",
        "unchanged_metric_basis",
        "modulo",
        "excluded"
      ],
      "properties": {
        "declared_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "dressed_action": {
          "$ref": "#/$defs/nonempty"
        },
        "X_definition": {
          "const": "X=g_hat^ab partial_a(theta)partial_b(theta)"
        },
        "coefficient_basis_mod_topology": {
          "const": [
            "alpha_B",
            "alpha_R",
            "M_P_squared",
            "p0",
            "p1",
            "p2"
          ]
        },
        "complete_phase_basis_argument": {
          "$ref": "#/$defs/nonempty"
        },
        "unchanged_metric_basis": {
          "$ref": "#/$defs/nonempty"
        },
        "modulo": {
          "$ref": "#/$defs/nonempty-string-array"
        },
        "excluded": {
          "type": "array",
          "minItems": 6,
          "items": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "action_family_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "stationary_background_equations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "coefficient_order",
        "metric_Euler_formula",
        "clock_Euler_formula",
        "unit_cylinder",
        "frozen_Berger_clock",
        "common_system"
      ],
      "properties": {
        "coefficient_order": {
          "const": [
            "alpha_B",
            "alpha_R",
            "M_P_squared",
            "p0",
            "p1",
            "p2"
          ]
        },
        "metric_Euler_formula": {
          "$ref": "#/$defs/nonempty"
        },
        "clock_Euler_formula": {
          "$ref": "#/$defs/nonempty"
        },
        "unit_cylinder": {
          "$ref": "#/$defs/nonempty-object"
        },
        "frozen_Berger_clock": {
          "$ref": "#/$defs/nonempty-object"
        },
        "common_system": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "matrix",
            "rank",
            "pivot_columns",
            "pivot_minor_first_five_columns",
            "rref",
            "kernel_dimension",
            "kernel_generator_rational",
            "kernel_generator_integer",
            "complete_real_locus",
            "singular_strata"
          ],
          "properties": {
            "matrix": {
              "$ref": "#/$defs/matrix"
            },
            "rank": {
              "const": 5
            },
            "pivot_columns": {
              "const": [
                0,
                1,
                2,
                3,
                4
              ]
            },
            "pivot_minor_first_five_columns": {
              "const": "91791/40960"
            },
            "rref": {
              "$ref": "#/$defs/matrix"
            },
            "kernel_dimension": {
              "const": 1
            },
            "kernel_generator_rational": {
              "const": [
                "81/20",
                "27/3290",
                "-324/1645",
                "486/1645",
                "18/25",
                "1"
              ]
            },
            "kernel_generator_integer": {
              "const": [
                133245,
                270,
                -6480,
                9720,
                23688,
                32900
              ]
            },
            "complete_real_locus": {
              "$ref": "#/$defs/nonempty"
            },
            "singular_strata": {
              "$ref": "#/$defs/nonempty-object"
            }
          }
        }
      }
    },
    "coupled_homogeneous_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activation",
        "auxiliary_shift",
        "complete_homogeneous_quadratic_density",
        "field_basis",
        "Euler_Hessian_of_D",
        "Euler_Hessian_determinant",
        "principal_D2_matrix",
        "principal_characteristic_polynomial",
        "velocity_Hessian",
        "velocity_characteristic_polynomial",
        "velocity_inertia_strata_positive_negative_zero",
        "inertia_separator",
        "state_basis",
        "D_evolution_matrix",
        "characteristic_polynomial",
        "minimal_polynomial",
        "Jordan_data",
        "Lee_Wald_current_project_convention",
        "raw_D_Hamiltonian",
        "raw_D_sign_witnesses",
        "cylinder_clock_condition"
      ],
      "properties": {
        "activation": {
          "$ref": "#/$defs/nonempty"
        },
        "auxiliary_shift": {
          "$ref": "#/$defs/nonempty"
        },
        "complete_homogeneous_quadratic_density": {
          "$ref": "#/$defs/nonempty"
        },
        "field_basis": {
          "const": [
            "u",
            "psi",
            "v"
          ]
        },
        "Euler_Hessian_of_D": {
          "$ref": "#/$defs/matrix"
        },
        "Euler_Hessian_determinant": {
          "const": "-324 t D^2(D^2-2)^2/25"
        },
        "principal_D2_matrix": {
          "$ref": "#/$defs/matrix"
        },
        "principal_characteristic_polynomial": {
          "$ref": "#/$defs/nonempty"
        },
        "velocity_Hessian": {
          "$ref": "#/$defs/matrix"
        },
        "velocity_characteristic_polynomial": {
          "$ref": "#/$defs/nonempty"
        },
        "velocity_inertia_strata_positive_negative_zero": {
          "$ref": "#/$defs/nonempty-object"
        },
        "inertia_separator": {
          "$ref": "#/$defs/nonempty"
        },
        "state_basis": {
          "const": [
            "u",
            "D(u)",
            "psi",
            "D(psi)",
            "v",
            "D(v)"
          ]
        },
        "D_evolution_matrix": {
          "$ref": "#/$defs/matrix"
        },
        "characteristic_polynomial": {
          "const": "spectral^2(spectral^2-2)^2"
        },
        "minimal_polynomial": {
          "const": "spectral^2(spectral^2-2)^2"
        },
        "Jordan_data": {
          "$ref": "#/$defs/nonempty-string-array"
        },
        "Lee_Wald_current_project_convention": {
          "$ref": "#/$defs/nonempty"
        },
        "raw_D_Hamiltonian": {
          "$ref": "#/$defs/nonempty"
        },
        "raw_D_sign_witnesses": {
          "$ref": "#/$defs/nonempty-string-array"
        },
        "cylinder_clock_condition": {
          "$ref": "#/$defs/nonempty-object"
        }
      }
    },
    "Berger_sound_cone_and_clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "general_principal_tensor",
        "Berger_X",
        "P_on_background",
        "P_X",
        "P_X_plus_2X_P_XX",
        "Lorentzian_hyperbolicity",
        "standard_sign_clock",
        "sound_speed_squared",
        "subluminal",
        "standard_sign_and_hyperbolic_locus",
        "energy_density",
        "relational_monotonicity"
      ],
      "properties": {
        "general_principal_tensor": {
          "$ref": "#/$defs/nonempty"
        },
        "Berger_X": {
          "const": "-9/16"
        },
        "P_on_background": {
          "const": "435537 t/2105600"
        },
        "P_X": {
          "const": "-81 t/200"
        },
        "P_X_plus_2X_P_XX": {
          "const": "-531 t/200"
        },
        "Lorentzian_hyperbolicity": {
          "$ref": "#/$defs/nonempty"
        },
        "standard_sign_clock": {
          "const": [
            "P_X<0",
            "P_X+2X P_XX<0"
          ]
        },
        "sound_speed_squared": {
          "const": "P_X/(P_X+2X P_XX)=9/59"
        },
        "subluminal": {
          "const": "0<9/59<1"
        },
        "standard_sign_and_hyperbolic_locus": {
          "const": "t>0"
        },
        "energy_density": {
          "$ref": "#/$defs/nonempty"
        },
        "relational_monotonicity": {
          "$ref": "#/$defs/nonempty-object"
        }
      }
    },
    "charges": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shift_current_convention",
        "internal_charge_density",
        "matter_raw_D_density",
        "matter_K_Berger_density",
        "total_covariant_phase_space_identities",
        "important_scope",
        "surface_and_flux"
      ],
      "properties": {
        "shift_current_convention": {
          "$ref": "#/$defs/nonempty"
        },
        "internal_charge_density": {
          "$ref": "#/$defs/nonempty"
        },
        "matter_raw_D_density": {
          "$ref": "#/$defs/nonempty"
        },
        "matter_K_Berger_density": {
          "$ref": "#/$defs/nonempty"
        },
        "total_covariant_phase_space_identities": {
          "$ref": "#/$defs/nonempty-string-array"
        },
        "important_scope": {
          "$ref": "#/$defs/nonempty"
        },
        "surface_and_flux": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "seven_gate_classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gates",
        "stationary_locus",
        "exact_semialgebraic_separator",
        "all_seven_gate_good_locus",
        "numerical_scan_used",
        "real_root_or_sign_method"
      ],
      "properties": {
        "gates": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "$ref": "#/$defs/gate"
          }
        },
        "stationary_locus": {
          "$ref": "#/$defs/nonempty"
        },
        "exact_semialgebraic_separator": {
          "$ref": "#/$defs/nonempty-string-array"
        },
        "all_seven_gate_good_locus": {
          "const": "EMPTY"
        },
        "numerical_scan_used": {
          "const": false
        },
        "real_root_or_sign_method": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_C_active_selected",
        "candidate_C_active_action",
        "candidate_C_active_action_hash",
        "downstream_selected_action_work_authorized"
      ],
      "properties": {
        "candidate_C_active_selected": {
          "const": false
        },
        "candidate_C_active_action": {
          "type": "null"
        },
        "candidate_C_active_action_hash": {
          "type": "null"
        },
        "downstream_selected_action_work_authorized": {
          "const": false
        }
      }
    },
    "exact_checks": {
      "$ref": "#/$defs/boolean-ledger"
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "SCOPED_QUADRATIC_ACTIVE_CLOCK_NO_GO",
        "UNIVERSAL_K_ESSENCE_OR_COMPENSATOR_NO_GO",
        "CANDIDATE_C_ACTIVE_SELECTED",
        "COMPLETE_SUPPORT_LOCAL_CAUSAL_PARENT",
        "HADAMARD_OR_QUANTUM_RESULT",
        "PARTICLE_SCATTERING_POSITIVITY_UNITARITY"
      ],
      "properties": {
        "SCOPED_QUADRATIC_ACTIVE_CLOCK_NO_GO": {
          "const": true
        },
        "UNIVERSAL_K_ESSENCE_OR_COMPENSATOR_NO_GO": {
          "const": false
        },
        "CANDIDATE_C_ACTIVE_SELECTED": {
          "const": false
        },
        "COMPLETE_SUPPORT_LOCAL_CAUSAL_PARENT": {
          "const": false
        },
        "HADAMARD_OR_QUANTUM_RESULT": {
          "const": false
        },
        "PARTICLE_SCATTERING_POSITIVITY_UNITARITY": {
          "const": false
        }
      }
    },
    "claim_boundary": {
      "$ref": "#/$defs/nonempty"
    },
    "next_gate": {
      "$ref": "#/$defs/nonempty"
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_family_sha256",
        "stationary_system_sha256",
        "coupled_homogeneous_sha256",
        "sound_charge_sha256",
        "classification_sha256",
        "locus_generator_sha256"
      ],
      "properties": {
        "action_family_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "stationary_system_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "coupled_homogeneous_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "sound_charge_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "classification_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "locus_generator_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "nonempty-string-array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/nonempty"
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "result_id",
        "sha256",
        "source_commit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "result_id": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "import-with-lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "result_id",
        "sha256",
        "source_commit",
        "lifecycle_commit"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "result_id": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "lifecycle_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_count",
        "column_count",
        "entries",
        "sha256"
      ],
      "properties": {
        "row_count": {
          "type": "integer",
          "minimum": 1
        },
        "column_count": {
          "type": "integer",
          "minimum": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "row",
              "column",
              "coefficient"
            ],
            "properties": {
              "row": {
                "type": "integer",
                "minimum": 0
              },
              "column": {
                "type": "integer",
                "minimum": 0
              },
              "coefficient": {
                "$ref": "#/$defs/nonempty"
              }
            }
          }
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "nonempty-object": {
      "type": "object",
      "minProperties": 1
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate",
        "normalized_name",
        "status",
        "reason"
      ],
      "properties": {
        "gate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "normalized_name": {
          "$ref": "#/$defs/nonempty"
        },
        "status": {
          "$ref": "#/$defs/nonempty"
        },
        "reason": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "boolean-ledger": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "const": true
      }
    }
  }
}
