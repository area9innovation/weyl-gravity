    "receipt": {"type": "object", "additionalProperties": false, "required": ["test_tier", "command", "elapsed_seconds", "status"], "properties": {"test_tier": {"const": 1}, "command": {"type": "string", "minLength": 50}, "elapsed_seconds": {"type": "number", "minimum": 0}, "status": {"const": "PASS"}}}
