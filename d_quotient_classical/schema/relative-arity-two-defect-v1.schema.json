{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/relative-arity-two-defect-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "dependency_tags", "lifecycle_status", "result_state", "background_id", "source_carrier_id", "target_carrier_id", "dependencies", "defect_payload", "checks", "claim_flags", "next_gate", "claim_boundary"],
  "properties": {
    "schema": {"const": "relative-arity-two-defect-v1"},
    "result_id": {"const": "EINSTEIN_WEYL_RELATIVE_ARITY_TWO_DEFECT_V1"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC"]},
    "lifecycle_status": {"const": "COEFFICIENT_COMPUTED"},
    "result_state": {"const": "NONZERO_STRICT_ARITY_TWO_DEFECT_F2_SOLVE_REQUIRED"},
    "background_id": {"const": "compact_magnetic_Plebanski_Hacyan_product"},
    "source_carrier_id": {"const": "einstein_maxwell_minimal_bv_38_product_coordinate_jet"},
    "target_carrier_id": {"const": "weyl_maxwell_minimal_bv_40_product_coordinate_theta_jet"},
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_taylor_certificate", "source_q2", "target_taylor_certificate", "target_q2", "unary_inclusion", "unary_inclusion_receipt"],
      "properties": {
        "source_taylor_certificate": {"$ref": "#/$defs/artifact"},
        "source_q2": {"$ref": "#/$defs/artifact"},
        "target_taylor_certificate": {"$ref": "#/$defs/artifact"},
        "target_q2": {"$ref": "#/$defs/artifact"},
        "unary_inclusion": {"$ref": "#/$defs/artifact"},
        "unary_inclusion_receipt": {"$ref": "#/$defs/artifact"}
      }
    },
    "defect_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "result_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "result_id": {"const": "EINSTEIN_WEYL_RELATIVE_ARITY_TWO_DEFECT_V1_PBW"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unary_chain_map_replayed", "strict_arity_two_defect_zero", "nonzero_row_count", "term_count", "maximum_total_order", "maxwell_equation_rows_strict", "u1_identity_row_strict"],
      "properties": {
        "unary_chain_map_replayed": {"const": true},
        "strict_arity_two_defect_zero": {"const": false},
        "nonzero_row_count": {"const": 15},
        "term_count": {"const": 50854},
        "maximum_total_order": {"const": 4},
        "maxwell_equation_rows_strict": {"const": true},
        "u1_identity_row_strict": {"const": true}
      }
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["STRICT_F1_ARITY_TWO_MORPHISM", "F2_SOLVE_REQUIRED", "F2_EXISTS", "F2_OBSTRUCTED", "ARITY_THREE_AUTHORIZED"],
      "properties": {
        "STRICT_F1_ARITY_TWO_MORPHISM": {"const": false},
        "F2_SOLVE_REQUIRED": {"const": true},
        "F2_EXISTS": {"const": false},
        "F2_OBSTRUCTED": {"const": false},
        "ARITY_THREE_AUTHORIZED": {"const": false}
      }
    },
    "next_gate": {"const": "SOLVE_SUPPORT_LOCAL_RELATIVE_F2_OR_CERTIFY_NORMALIZED_OBSTRUCTION"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
