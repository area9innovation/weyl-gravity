{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/berger-support-local-coupled-maxwell-q3-payload-v1.schema.json",
  "title": "Content-addressed typed mixed Maxwell q3 row manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "coefficient_field", "pbw_basis", "shape", "factorial_convention", "storage", "chunks"],
  "properties": {
    "schema": {"const": "pure-weyl-berger-support-local-coupled-maxwell-q3-payload-v1"},
    "coefficient_field": {"const": "Q(sqrt(10))"},
    "pbw_basis": {"const": "left-invariant Berger frame; words e0^n0 e1^n1 e2^n2 e3^n3"},
    "shape": {"const": [64, 64, 64, 64]},
    "factorial_convention": {"const": "suspended-graded-symmetric-factorial-v1"},
    "storage": {"const": "deterministic-gzip-strict-json-row-chunks"},
    "chunks": {
      "type": "array",
      "minItems": 64,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/chunk"}
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output", "path", "file_sha256", "canonical_sha256", "term_count", "maximum_total_jet_order"],
      "properties": {
        "output": {"type": "integer", "minimum": 0, "maximum": 63},
        "path": {"type": "string", "pattern": "^d_quotient_classical/generated/berger_support_local_coupled_maxwell_q3/row_[0-9]{2}\\.json\\.gz$"},
        "file_sha256": {"$ref": "#/$defs/hash"},
        "canonical_sha256": {"$ref": "#/$defs/hash"},
        "term_count": {"type": "integer", "minimum": 0},
        "maximum_total_jet_order": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    }
  }
}
