{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/two-phase-counterflow-trace-charge-preflight-payload-v1.schema.json",
  "title": "Two-phase counterflow trace/charge preflight payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "dependency_tags",
    "imports",
    "oracle_fields_consumed",
    "phase_decomposition",
    "stationary_loci",
    "quadratic_hessian_and_constraints",
    "characteristic_and_Jordan_ledger",
    "charge_ledger",
    "selected_fixture",
    "content_sha256"
  ],
  "properties": {
    "schema": {"const": "pure-weyl-two-phase-counterflow-trace-charge-preflight-payload-v1"},
    "result_id": {"const": "TWO_PHASE_COUNTERFLOW_TRACE_CHARGE_PREFLIGHT_PAYLOAD_V1"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "imports": {"type": "object", "minProperties": 2},
    "oracle_fields_consumed": {"const": []},
    "phase_decomposition": {"type": "object", "minProperties": 7},
    "stationary_loci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["universal_static_equations", "cylinder", "berger"],
      "properties": {
        "universal_static_equations": {"type": "object"},
        "cylinder": {"type": "object"},
        "berger": {"type": "object"}
      }
    },
    "quadratic_hessian_and_constraints": {"type": "object", "minProperties": 12},
    "characteristic_and_Jordan_ledger": {"type": "object", "minProperties": 4},
    "charge_ledger": {"type": "array", "minItems": 4, "maxItems": 4},
    "selected_fixture": {"type": "object", "minProperties": 12},
    "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
