{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/schemas/pure-weyl-relative-linfinity-through-arity-three-preflight-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "result_id", "result_state", "lifecycle_status", "dependency_tags", "setting", "input_status", "input_contracts", "dependency_refs", "required_computation", "scope_guard", "claim_flags", "next_gate", "source_manifest", "verification_commands", "verification_receipt", "claim_boundary"],
  "properties": {
    "schema": {"const": "pure-weyl-relative-linfinity-through-arity-three-preflight-v1"},
    "result_id": {"const": "EINSTEIN_WEYL_RELATIVE_LINFINITY_THROUGH_ARITY_THREE_PREFLIGHT_V1"},
    "result_state": {"enum": ["INPUT_BLOCKED_FULL_TRIANGLE_AND_PRODUCT_TAYLOR_PAYLOADS_MISSING", "INPUTS_IMPORTED_RELATIVE_MORPHISM_SOLVE_READY"]},
    "lifecycle_status": {"const": "OPEN"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "setting": {"type": "object", "required": ["background_id", "boundaries", "generator"], "properties": {"background_id": {"const": "compact_magnetic_Plebanski_Hacyan_product"}, "boundaries": {"type": "string"}, "generator": {"const": "H_product"}}},
    "input_status": {"type": "object", "additionalProperties": false, "required": ["relative_linear_triangle", "einstein_product_q2_q3", "weyl_product_q2_q3"], "properties": {"relative_linear_triangle": {"enum": ["MISSING", "IMPORTED"]}, "einstein_product_q2_q3": {"enum": ["MISSING", "IMPORTED"]}, "weyl_product_q2_q3": {"enum": ["MISSING", "IMPORTED"]}}},
    "input_contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_triangle", "einstein_taylor", "weyl_taylor", "taylor_schema"],
      "properties": {
        "relative_triangle": {"$ref": "#/$defs/contract"},
        "einstein_taylor": {"$ref": "#/$defs/contract"},
        "weyl_taylor": {"$ref": "#/$defs/contract"},
        "taylor_schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "dependency_refs": {"type": "object", "minProperties": 3, "additionalProperties": {"$ref": "#/$defs/artifact"}},
    "required_computation": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "scope_guard": {"type": "object", "additionalProperties": false, "required": ["berger_tensors_eligible", "reason", "berger_filtered_obstruction_preserved", "q4_authorized"], "properties": {"berger_tensors_eligible": {"const": false}, "reason": {"type": "string", "minLength": 1}, "berger_filtered_obstruction_preserved": {"const": true}, "q4_authorized": {"const": false}}},
    "claim_flags": {"type": "object", "additionalProperties": false, "required": ["PREFLIGHT_READY", "ALL_SCIENTIFIC_INPUTS_IMPORTED", "RELATIVE_ARITY_TWO_DEFECT_COMPUTED", "RELATIVE_ARITY_THREE_DEFECT_COMPUTED", "COHOMOLOGY_OPERATION_DECIDED", "CYCLIC_DEFORMATION_CLASS_DECIDED", "Q4_AUTHORIZED", "QUANTUM_CLAIM"], "properties": {"PREFLIGHT_READY": {"const": true}, "ALL_SCIENTIFIC_INPUTS_IMPORTED": {"type": "boolean"}, "RELATIVE_ARITY_TWO_DEFECT_COMPUTED": {"const": false}, "RELATIVE_ARITY_THREE_DEFECT_COMPUTED": {"const": false}, "COHOMOLOGY_OPERATION_DECIDED": {"const": false}, "CYCLIC_DEFORMATION_CLASS_DECIDED": {"const": false}, "Q4_AUTHORIZED": {"const": false}, "QUANTUM_CLAIM": {"const": false}}},
    "next_gate": {"enum": ["SUPPLY_FULL_TRIANGLE_AND_SAME_BACKGROUND_PRODUCT_Q2_Q3_PAYLOADS", "COMPUTE_RELATIVE_ARITY_TWO_AND_THREE_DEFECTS"]},
    "source_manifest": {"type": "object", "minProperties": 5, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "verification_commands": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "verification_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["producing_date", "tier_0", "tier_1", "tier_2", "tier_3"],
      "properties": {
        "producing_date": {"const": "2026-07-18"},
        "tier_0": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commands", "status"],
          "properties": {
            "commands": {"type": "array", "minItems": 3, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "status": {"const": "PASS"}
          }
        },
        "tier_1": {"$ref": "#/$defs/passing_timed_tier"},
        "tier_2": {"$ref": "#/$defs/passing_timed_tier"},
        "tier_3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason"],
          "properties": {
            "status": {"const": "NOT_RUN"},
            "reason": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "input_status": {
            "type": "object",
            "properties": {
              "relative_linear_triangle": {"const": "IMPORTED"},
              "einstein_product_q2_q3": {"const": "IMPORTED"},
              "weyl_product_q2_q3": {"const": "IMPORTED"}
            }
          }
        }
      },
      "then": {
        "properties": {
          "result_state": {"const": "INPUTS_IMPORTED_RELATIVE_MORPHISM_SOLVE_READY"},
          "claim_flags": {"type": "object", "properties": {"ALL_SCIENTIFIC_INPUTS_IMPORTED": {"const": true}}},
          "next_gate": {"const": "COMPUTE_RELATIVE_ARITY_TWO_AND_THREE_DEFECTS"}
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_flags": {
            "type": "object",
            "properties": {
              "ALL_SCIENTIFIC_INPUTS_IMPORTED": {"const": false}
            }
          }
        }
      },
      "then": {
        "properties": {
          "result_state": {"const": "INPUT_BLOCKED_FULL_TRIANGLE_AND_PRODUCT_TAYLOR_PAYLOADS_MISSING"},
          "next_gate": {"const": "SUPPLY_FULL_TRIANGLE_AND_SAME_BACKGROUND_PRODUCT_Q2_Q3_PAYLOADS"}
        }
      }
    }
  ],
  "$defs": {
    "artifact": {"type": "object", "required": ["result_id", "path", "sha256"], "properties": {"result_id": {"type": "string"}, "path": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "contract": {"type": "object", "additionalProperties": false, "required": ["required_result_id", "required_background_id", "candidate_paths", "required_flags"], "properties": {"required_result_id": {"type": "string", "minLength": 1}, "required_background_id": {"const": "compact_magnetic_Plebanski_Hacyan_product"}, "candidate_paths": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}}, "required_flags": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "timed_command": {"type": "object", "additionalProperties": false, "required": ["command", "elapsed_seconds"], "properties": {"command": {"type": "string", "minLength": 1}, "elapsed_seconds": {"type": "number", "minimum": 0}}},
    "passing_timed_tier": {"type": "object", "additionalProperties": false, "required": ["commands_and_elapsed_seconds", "status"], "properties": {"commands_and_elapsed_seconds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/timed_command"}}, "status": {"const": "PASS"}}}
  }
}
