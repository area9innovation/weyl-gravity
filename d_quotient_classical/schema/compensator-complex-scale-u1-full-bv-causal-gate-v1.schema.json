{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/compensator-complex-scale-u1-full-bv-causal-gate-v1.schema.json",
  "title": "Conditional separated scale/U1 full BV causal gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "result_id",
    "result_state",
    "dependency_tags",
    "predecessor",
    "activation_condition",
    "activation_condition_satisfied",
    "skipped_gates",
    "terminal_verdict",
    "claim_flags",
    "claim_boundary",
    "content_hashes"
  ],
  "properties": {
    "schema": {
      "const": "pure-weyl-compensator-complex-scale-u1-full-bv-causal-gate-v1"
    },
    "result_id": {
      "const": "COMPENSATOR_COMPLEX_SCALE_U1_FULL_BV_CAUSAL_GATE_V1"
    },
    "result_state": {
      "const": "NOT_ACTIVATED_EMPTY_PREDECESSOR_LOCUS"
    },
    "dependency_tags": {
      "const": [
        "LOCAL-ALGEBRAIC",
        "LORENTZIAN-CAUSAL"
      ]
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "source_commit",
        "result_id",
        "result_state",
        "healthy_locus",
        "selected_action"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "const": "3b7b1f86392f0d5daeec4b1adac99a0e16e472ff37b44253908a20c53aad1404"
        },
        "source_commit": {
          "const": "6cc041fadaaf6259142aa8f30a2f75879cf92dd3"
        },
        "result_id": {
          "const": "COMPENSATOR_COMPLEX_SCALE_U1_CONNECTION_PREFLIGHT_V1"
        },
        "result_state": {
          "const": "SCOPED_SEPARATED_SCALE_U1_MINIMAL_GOOD_LOCUS_EMPTY"
        },
        "healthy_locus": {
          "const": "EMPTY"
        },
        "selected_action": {
          "const": false
        }
      }
    },
    "activation_condition": {
      "type": "string",
      "minLength": 1
    },
    "activation_condition_satisfied": {
      "const": false
    },
    "skipped_gates": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "reason"
        ],
        "properties": {
          "status": {
            "const": "NOT_ACTIVATED"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terminal_verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result",
        "full_gate_activated",
        "selected_action",
        "causal_parent_constructed",
        "zero_charge_sector_declared",
        "nonlinear_or_quantum_successor_activated",
        "reason"
      ],
      "properties": {
        "result": {
          "const": "NOT_ACTIVATED_EMPTY_PREDECESSOR_LOCUS"
        },
        "full_gate_activated": {
          "const": false
        },
        "selected_action": {
          "const": false
        },
        "causal_parent_constructed": {
          "const": false
        },
        "zero_charge_sector_declared": {
          "const": false
        },
        "nonlinear_or_quantum_successor_activated": {
          "const": false
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "claim_flags": {
      "type": "object",
      "minProperties": 6,
      "additionalProperties": {
        "const": false
      }
    },
    "claim_boundary": {
      "type": "string",
      "minLength": 1
    },
    "content_hashes": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  }
}
