    "dependency_refs": {"type": "object", "additionalProperties": false, "required": ["candidate13_derived_source", "support_local_unary_triangle", "finite_generic_zero_block"], "properties": {"candidate13_derived_source": {"$ref": "#/$defs/dependency"}, "support_local_unary_triangle": {"$ref": "#/$defs/dependency"}, "finite_generic_zero_block": {"$ref": "#/$defs/dependency"}}},
