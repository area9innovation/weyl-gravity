  "properties": {
    "schema": {"const": "pure-weyl-candidate13-reduced-source-support-local-upgrade-obstruction-v1"},
    "result_id": {"const": "CANDIDATE13_REDUCED_SOURCE_SUPPORT_LOCAL_UPGRADE_OBSTRUCTION_V1"},
