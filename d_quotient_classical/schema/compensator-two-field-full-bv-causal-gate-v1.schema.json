          "const": "e597c687ae064ac6809b674c056aa08d0167a9184b6addb95b5b7330c33dcc62"
        },
        "source_commit": {
          "const": "2b1609cedc77e85dd71967fb46e49a4595c75763"
        },
        "result_id": {
          "const": "COMPENSATOR_TWO_FIELD_CHARGE_MATRIX_PREFLIGHT_V1"
