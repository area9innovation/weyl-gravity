    "record36": {"type": "object", "additionalProperties": false, "required": ["shape", "entries", "sha256"], "properties": {"shape": {"const": [36, 36]}, "entries": {"type": "array", "items": {"$ref": "#/$defs/operatorEntry"}}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "record64x36": {"type": "object", "additionalProperties": false, "required": ["shape", "entries", "sha256"], "properties": {"shape": {"const": [64, 36]}, "entries": {"type": "array", "items": {"$ref": "#/$defs/operatorEntry"}}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "record36x64": {"type": "object", "additionalProperties": false, "required": ["shape", "entries", "sha256"], "properties": {"shape": {"const": [36, 64]}, "entries": {"type": "array", "items": {"$ref": "#/$defs/operatorEntry"}}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "receipt": {"type": "object", "additionalProperties": false, "required": ["test_tier", "command", "elapsed_seconds", "status"], "properties": {"test_tier": {"const": 1}, "command": {"type": "string", "minLength": 60}, "elapsed_seconds": {"type": "number", "minimum": 0}, "status": {"const": "PASS"}}}
