      }
    },
    "next_gate": {"const": "QUANTUM_SIDE_INDEPENDENT_REPLAY_OF_CLASSICAL_MAXWELL_TRANSFER"},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["source_manifest"], "properties": {"source_manifest": {"type": "object", "minProperties": 4, "maxProperties": 4, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}},
    "verification_receipts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/receipt"}},
    "higher_tiers_not_run": {"type": "object", "additionalProperties": false, "required": ["tier_2", "tier_3"], "properties": {"tier_2": {"type": "string", "minLength": 140}, "tier_3": {"type": "string", "minLength": 130}}},
    "claim_boundary": {"type": "string", "minLength": 1100}
  },
  "$defs": {
    "dependency": {"type": "object", "additionalProperties": false, "required": ["path", "result_id", "sha256"], "properties": {"path": {"type": "string", "minLength": 10}, "result_id": {"type": "string", "minLength": 10}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "row": {"type": "object", "additionalProperties": false, "required": ["index", "row_id", "degree", "sector"], "properties": {"index": {"type": "integer", "minimum": 0, "maximum": 63}, "row_id": {"type": "string", "minLength": 1}, "degree": {"type": "integer", "minimum": -1, "maximum": 2}, "sector": {"type": "string", "minLength": 3}}},
