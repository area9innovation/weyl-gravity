{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://area9.dk/pure-weyl/closed-s3-relative-phase-clock-atlas-v1.schema.json",
  "title": "Closed-S3 exact relative-phase clock quotient atlas",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema",
    "result_id",
    "result_state",
    "dependency_tags",
    "imports",
    "scope",
    "theorem",
    "strata",
    "exact_cases",
    "atlas_export",
    "conflux_export",
    "proof_obligations",
    "claim_flags",
    "claim_boundary",
    "content_hashes"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "schema": {
      "const": "pure-weyl-closed-s3-relative-phase-clock-atlas-v1"
    },
    "result_id": {
      "const": "CLOSED_S3_RELATIVE_PHASE_CLOCK_ATLAS_V1"
    },
    "result_state": {
      "const": "CERTIFIED_EXACT_CLASSICAL_QUOTIENT_ATLAS_CONFLUX_PENDING"
    },
    "dependency_tags": {
      "const": [
        "LOCAL-ALGEBRAIC"
      ]
    },
    "imports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/import"
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spatial_manifold",
        "field_counts_fully_classified",
        "charge_domain",
        "carrier",
        "kinetic_domain",
        "external_sources",
        "boundary"
      ],
      "properties": {
        "spatial_manifold": {
          "const": "closed smooth S3"
        },
        "field_counts_fully_classified": {
          "const": [
            2,
            3
          ]
        },
        "charge_domain": {
          "$ref": "#/$defs/nonempty"
        },
        "carrier": {
          "$ref": "#/$defs/nonempty"
        },
        "kinetic_domain": {
          "$ref": "#/$defs/nonempty"
        },
        "external_sources": {
          "const": false
        },
        "boundary": {
          "const": false
        }
      }
    },
    "theorem": {
      "type": "object",
      "minProperties": 7
    },
    "strata": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/stratum"
      }
    },
    "exact_cases": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "items": {
        "$ref": "#/$defs/exactCase"
      }
    },
    "atlas_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "physical_mode_identification"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "status": {
          "const": "CERTIFIED_STRUCTURAL_FRAGMENT"
        },
        "physical_mode_identification": {
          "const": "NO_CERTIFIED_MAP"
        }
      }
    },
    "conflux_export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_export_path",
        "raw_export_sha256",
        "field",
        "oracle_exclusion",
        "consumer_id",
        "consumer_policy_status",
        "generic_math_request",
        "consumer_request",
        "certified_conflux_map",
        "lifecycle_status"
      ],
      "properties": {
        "raw_export_path": {
          "$ref": "#/$defs/nonempty"
        },
        "raw_export_sha256": {
          "$ref": "#/$defs/hash"
        },
        "field": {
          "const": "Q"
        },
        "oracle_exclusion": {
          "const": "STRUCTURAL"
        },
        "consumer_id": {
          "const": "sf:program/work/classical-closed-s3-relative-phase-clock-atlas"
        },
        "consumer_policy_status": {
          "const": "NO_CONSUMER_DECLARATION"
        },
        "generic_math_request": {
          "$ref": "#/$defs/request"
        },
        "consumer_request": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "state"
          ],
          "properties": {
            "path": {
              "$ref": "#/$defs/nonempty"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "state": {
              "enum": [
                "REQUESTED",
                "ACCEPTED",
                "LANDED"
              ]
            }
          }
        },
        "certified_conflux_map": {
          "const": false
        },
        "lifecycle_status": {
          "const": "NO_CERTIFIED_CONFLUX_IMPORTER"
        }
      }
    },
    "proof_obligations": {
      "type": "object",
      "minProperties": 8
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "EXACT_TWO_AND_THREE_FIELD_ATLAS",
        "ARBITRARY_FINITE_N_CLASSIFICATION",
        "MODEL_SPECIFIC_ACTION_SELECTED",
        "SCALE_GAUGE_REPAIR",
        "FULL_BV_OR_CAUSAL_PARENT",
        "CONFLUX_IDENTIFICATION",
        "PHYSICAL_RESIDUAL_MODE",
        "HADAMARD_OR_QUANTUM"
      ],
      "properties": {
        "EXACT_TWO_AND_THREE_FIELD_ATLAS": {
          "const": true
        },
        "ARBITRARY_FINITE_N_CLASSIFICATION": {
          "const": false
        },
        "MODEL_SPECIFIC_ACTION_SELECTED": {
          "const": false
        },
        "SCALE_GAUGE_REPAIR": {
          "const": false
        },
        "FULL_BV_OR_CAUSAL_PARENT": {
          "const": false
        },
        "CONFLUX_IDENTIFICATION": {
          "const": false
        },
        "PHYSICAL_RESIDUAL_MODE": {
          "const": false
        },
        "HADAMARD_OR_QUANTUM": {
          "const": false
        }
      }
    },
    "claim_boundary": {
      "$ref": "#/$defs/nonempty"
    },
    "content_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_export_sha256",
        "theorem_sha256",
        "strata_sha256",
        "exact_cases_sha256",
        "conflux_boundary_sha256",
        "claim_boundary_sha256"
      ],
      "properties": {
        "raw_export_sha256": {
          "$ref": "#/$defs/hash"
        },
        "theorem_sha256": {
          "$ref": "#/$defs/hash"
        },
        "strata_sha256": {
          "$ref": "#/$defs/hash"
        },
        "exact_cases_sha256": {
          "$ref": "#/$defs/hash"
        },
        "conflux_boundary_sha256": {
          "$ref": "#/$defs/hash"
        },
        "claim_boundary_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "matrix": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "string"
            }
          ]
        }
      }
    },
    "inertia": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative",
        "zero"
      ],
      "properties": {
        "positive": {
          "type": "integer",
          "minimum": 0
        },
        "negative": {
          "type": "integer",
          "minimum": 0
        },
        "zero": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "source_commit",
        "result_id",
        "result_state",
        "actual_sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        },
        "source_commit": {
          "$ref": "#/$defs/commit"
        },
        "result_id": {
          "$ref": "#/$defs/nonempty"
        },
        "result_state": {
          "$ref": "#/$defs/nonempty"
        },
        "actual_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "state"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonempty"
        },
        "state": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stratum_id",
        "field_count",
        "rank",
        "smith_parameter_locus",
        "canonical_effective_representative_D",
        "compact_orbit_dimension",
        "continuous_stabilizer_dimension_for_r_generators",
        "finite_stabilizer",
        "relative_phase_torus_dimension",
        "zero_charge_fibre_dimension",
        "nonzero_physical_relative_momentum_exists",
        "positive_M_reduced_sign",
        "declared_indefinite_M_reduced_sign_rule",
        "raw_D_restriction",
        "K_Berger_restriction"
      ],
      "properties": {
        "stratum_id": {
          "type": "string",
          "pattern": "^n[23]_rank[0-3](_(primitive|nonprimitive))?$"
        },
        "field_count": {
          "enum": [
            2,
            3
          ]
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "smith_parameter_locus": {
          "$ref": "#/$defs/nonempty"
        },
        "canonical_effective_representative_D": {
          "$ref": "#/$defs/matrix"
        },
        "compact_orbit_dimension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "continuous_stabilizer_dimension_for_r_generators": {
          "$ref": "#/$defs/nonempty"
        },
        "finite_stabilizer": {
          "$ref": "#/$defs/nonempty"
        },
        "relative_phase_torus_dimension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "zero_charge_fibre_dimension": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "nonzero_physical_relative_momentum_exists": {
          "type": "boolean"
        },
        "positive_M_reduced_sign": {
          "$ref": "#/$defs/nonempty"
        },
        "declared_indefinite_M_reduced_sign_rule": {
          "$ref": "#/$defs/nonempty"
        },
        "raw_D_restriction": {
          "$ref": "#/$defs/nonempty"
        },
        "K_Berger_restriction": {
          "$ref": "#/$defs/nonempty"
        }
      }
    },
    "exactCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "input_class",
        "field_count",
        "gauge_generator_count",
        "rank",
        "smith",
        "lattices",
        "orbit_and_stabilizer",
        "zero_total_charge_fibre",
        "kinetic_restriction",
        "moment_maps",
        "basis_change_witness"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/nonempty"
        },
        "input_class": {
          "$ref": "#/$defs/nonempty"
        },
        "field_count": {
          "enum": [
            2,
            3
          ]
        },
        "gauge_generator_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "smith": {
          "type": "object"
        },
        "lattices": {
          "type": "object"
        },
        "orbit_and_stabilizer": {
          "type": "object"
        },
        "zero_total_charge_fibre": {
          "type": "object"
        },
        "kinetic_restriction": {
          "type": "object"
        },
        "moment_maps": {
          "type": "object"
        },
        "basis_change_witness": {
          "type": "object"
        }
      }
    }
  }
}
