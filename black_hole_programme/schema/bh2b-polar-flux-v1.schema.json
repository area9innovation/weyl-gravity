{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pure-weyl-bh2b-polar-flux-v1",
  "title": "BH-2B stage 4: polar flux matrix stage 1 -- Einstein branch symplectically null",
  "type": "object",
  "required": [
    "schema",
    "schema_path",
    "schema_sha256",
    "result_id",
    "result_token",
    "dependency_tags",
    "declaration",
    "bilinear",
    "einstein_block",
    "conformal_control",
    "claim_flags",
    "missing_objects",
    "stage_seconds",
    "provenance",
    "verification_command"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pure-weyl-bh2b-polar-flux-v1" },
    "schema_path": {
      "const": "black_hole_programme/schema/bh2b-polar-flux-v1.schema.json"
    },
    "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_id": { "const": "PURE_WEYL_BH2B_POLAR_FLUX" },
    "result_token": { "const": "BH2B_POLAR_FLUX_STAGE1_EINSTEIN_BRANCH_SYMPLECTICALLY_NULL" },
    "dependency_tags": { "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"] },
    "declaration": {
      "type": "object",
      "required": [
        "theory",
        "background_family",
        "conformal_frame",
        "generator",
        "phase_space",
        "horizon_condition",
        "infinity_condition",
        "frequency_domain",
        "lifecycle"
      ],
      "properties": { "lifecycle": { "const": "CLASSIFIED" } }
    },
    "bilinear": {
      "type": "object",
      "required": ["Ft", "Fr", "offshell_identity"]
    },
    "einstein_block": {
      "type": "object",
      "required": ["coefficients", "structure", "null_theorem"],
      "properties": {
        "coefficients": {
          "type": "object",
          "required": ["KK", "KH", "HK", "HH"]
        }
      }
    },
    "conformal_control": {
      "type": "object",
      "required": ["statement", "consequence", "result"],
      "properties": { "result": { "const": "EXACT_ZERO_OFF_SHELL" } }
    },
    "claim_flags": {
      "type": "object",
      "required": [
        "machinery_controls_certified",
        "polar_bilinear_certified",
        "offshell_identity_certified",
        "einstein_block_null_certified",
        "conformal_degeneracy_certified",
        "extra_block_certified",
        "cross_block_certified",
        "flux_signs_certified",
        "outer_boundary_domain_certified",
        "causal_exclusion_decided",
        "growth_or_stability_certified",
        "general_l_certified"
      ],
      "properties": {
        "machinery_controls_certified": { "const": true },
        "polar_bilinear_certified": { "const": true },
        "offshell_identity_certified": { "const": true },
        "einstein_block_null_certified": { "const": true },
        "conformal_degeneracy_certified": { "const": true },
        "extra_block_certified": { "const": false },
        "cross_block_certified": { "const": false },
        "flux_signs_certified": { "const": false },
        "outer_boundary_domain_certified": { "const": false },
        "causal_exclusion_decided": { "const": false },
        "growth_or_stability_certified": { "const": false },
        "general_l_certified": { "const": false }
      }
    },
    "missing_objects": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "stage_seconds": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": [
        "generator_path",
        "engine_path",
        "engine_sha256",
        "theta_path",
        "theta_sha256",
        "bach_path",
        "bach_sha256",
        "bh1b_certificate",
        "bh1b_certificate_sha256",
        "bh2b_einstein_certificate",
        "bh2b_einstein_certificate_sha256"
      ]
    },
    "verification_command": {
      "const": "python3 black_hole_programme/verify_bh2b_polar_flux.py"
    }
  }
}
