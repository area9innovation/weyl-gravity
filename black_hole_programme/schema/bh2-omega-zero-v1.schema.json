{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pure-weyl-bh2-omega-zero-v1",
  "title": "BH-2 omega = 0: static-sector classification of the carrier systems",
  "type": "object",
  "required": [
    "schema",
    "schema_path",
    "schema_sha256",
    "result_id",
    "result_token",
    "dependency_tags",
    "declaration",
    "classification",
    "headline",
    "claim_flags",
    "missing_objects",
    "stage_seconds",
    "provenance",
    "verification_command"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pure-weyl-bh2-omega-zero-v1" },
    "schema_path": {
      "const": "black_hole_programme/schema/bh2-omega-zero-v1.schema.json"
    },
    "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_id": { "const": "PURE_WEYL_BH2_OMEGA_ZERO" },
    "result_token": { "const": "BH2_OMEGA_ZERO_STATIC_SECTOR_CLASSIFIED" },
    "dependency_tags": { "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"] },
    "declaration": {
      "type": "object",
      "required": [
        "theory",
        "background_family",
        "conformal_frame",
        "generator",
        "phase_space",
        "horizon_condition",
        "infinity_condition",
        "frequency_domain",
        "lifecycle"
      ],
      "properties": { "lifecycle": { "const": "CLASSIFIED" } }
    },
    "classification": {
      "type": "object",
      "required": ["axial_carrier", "polar_carrier_sliced",
                   "axial_einstein_rw", "polar_einstein"]
    },
    "headline": {
      "type": "object",
      "required": ["axial", "polar", "consequence"]
    },
    "claim_flags": {
      "type": "object",
      "required": [
        "axial_static_sector_classified",
        "polar_static_sector_classified",
        "einstein_controls_classified",
        "static_metric_composition_certified",
        "static_flux_or_charge_certified",
        "matching_to_l0_parameter_modes_certified",
        "general_l_certified"
      ],
      "properties": {
        "axial_static_sector_classified": { "const": true },
        "polar_static_sector_classified": { "const": true },
        "einstein_controls_classified": { "const": true },
        "static_metric_composition_certified": { "const": false },
        "static_flux_or_charge_certified": { "const": false },
        "matching_to_l0_parameter_modes_certified": { "const": false },
        "general_l_certified": { "const": false }
      }
    },
    "missing_objects": {
      "type": "array",
      "minItems": 5,
      "items": { "type": "string" }
    },
    "stage_seconds": { "type": "object" },
    "provenance": {
      "type": "object",
      "required": [
        "generator_path",
        "engine_path",
        "engine_sha256",
        "axial_reach_certificate",
        "axial_reach_certificate_sha256",
        "polar_reach_certificate",
        "polar_reach_certificate_sha256",
        "polar_einstein_certificate",
        "polar_einstein_certificate_sha256"
      ]
    },
    "verification_command": {
      "const": "python3 black_hole_programme/verify_bh2_omega_zero.py"
    }
  }
}
