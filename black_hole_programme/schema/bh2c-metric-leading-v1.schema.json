{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pure-weyl-bh2c-metric-leading-v1",
  "title": "BH-2C stage 2: leading-order metric reconstruction and flux symbol",
  "type": "object",
  "required": ["schema", "schema_path", "schema_sha256", "result_id",
               "result_token", "dependency_tags", "declaration", "axial",
               "polar", "flux_symbol", "headline", "claim_flags",
               "missing_objects", "stage_seconds", "provenance",
               "verification_command"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pure-weyl-bh2c-metric-leading-v1" },
    "schema_path": { "const": "black_hole_programme/schema/bh2c-metric-leading-v1.schema.json" },
    "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_id": { "const": "PURE_WEYL_BH2C_METRIC_LEADING" },
    "result_token": { "const": "BH2C_METRIC_RECONSTRUCTION_LEADING_ORDER_CLASSIFIED" },
    "dependency_tags": { "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"] },
    "declaration": { "type": "object",
      "required": ["theory", "background_family", "conformal_frame", "generator",
                   "phase_space", "horizon_condition", "infinity_condition", "lifecycle"],
      "properties": { "lifecycle": { "const": "CLASSIFIED" } } },
    "axial": { "type": "object", "required": ["B0h", "sectors"] },
    "polar": { "type": "object", "required": ["B0h", "sectors"] },
    "flux_symbol": { "type": "object",
      "required": ["leading", "relative_power", "reading"],
      "properties": { "relative_power": { "const": 0 } } },
    "headline": { "type": "object", "required": ["statement", "paper_gate"] },
    "claim_flags": { "type": "object",
      "required": ["enhancement_bound_certified", "rank_one_resonance_certified",
                   "flux_leading_symbol_certified", "on_characteristic_vanishing_certified",
                   "all_orders_reconstruction_certified", "finite_flux_boundary_class_certified",
                   "polar_flux_symbol_certified", "general_l_certified"],
      "properties": {
        "enhancement_bound_certified": { "const": true },
        "rank_one_resonance_certified": { "const": true },
        "flux_leading_symbol_certified": { "const": true },
        "on_characteristic_vanishing_certified": { "const": true },
        "all_orders_reconstruction_certified": { "const": false },
        "finite_flux_boundary_class_certified": { "const": false },
        "polar_flux_symbol_certified": { "const": false },
        "general_l_certified": { "const": false } } },
    "missing_objects": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "stage_seconds": { "type": "object" },
    "provenance": { "type": "object",
      "required": ["generator_path", "engine_path", "engine_sha256",
                   "axial_flux_certificate", "axial_flux_certificate_sha256",
                   "jordan_certificate", "jordan_certificate_sha256"] },
    "verification_command": { "const": "python3 black_hole_programme/verify_bh2c_metric_leading.py" }
  }
}
