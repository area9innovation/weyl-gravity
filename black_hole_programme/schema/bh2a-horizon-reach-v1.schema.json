{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pure-weyl-bh2a-horizon-reach-v1",
  "title": "BH-2A stage 2: extra branch reaches the horizon (linear mode level)",
  "type": "object",
  "required": [
    "schema",
    "schema_path",
    "schema_sha256",
    "result_id",
    "result_token",
    "dependency_tags",
    "declaration",
    "carrier",
    "horizon_analysis",
    "rw_benchmark",
    "claim_flags",
    "missing_objects",
    "stage_seconds",
    "provenance",
    "verification_command"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pure-weyl-bh2a-horizon-reach-v1" },
    "schema_path": {
      "const": "black_hole_programme/schema/bh2a-horizon-reach-v1.schema.json"
    },
    "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_id": { "const": "PURE_WEYL_BH2A_HORIZON_REACH" },
    "result_token": { "const": "BH2A_EXTRA_BRANCH_REACHES_HORIZON_LINEAR_MODE_LEVEL" },
    "dependency_tags": { "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"] },
    "declaration": {
      "type": "object",
      "required": [
        "theory",
        "background_family",
        "conformal_frame",
        "generator",
        "phase_space",
        "horizon_condition",
        "infinity_condition",
        "lifecycle"
      ],
      "properties": { "lifecycle": { "const": "CLASSIFIED" } }
    },
    "carrier": {
      "type": "object",
      "required": ["definition", "constraint_regularity", "equation"]
    },
    "horizon_analysis": {
      "type": "object",
      "required": [
        "singular_point",
        "indicial_exponents",
        "zero_eigenspace",
        "conclusion"
      ],
      "properties": {
        "indicial_exponents": {
          "const": ["0 (multiplicity 2)", "-4*I*m*omega", "-2 - 4*I*m*omega"]
        }
      }
    },
    "rw_benchmark": {
      "type": "object",
      "required": ["statement", "consequence"]
    },
    "claim_flags": {
      "type": "object",
      "required": [
        "carrier_constraint_regular_certified",
        "regular_singular_point_certified",
        "indicial_exponents_certified",
        "ingoing_family_dimension_certified",
        "rw_benchmark_certified",
        "flux_or_sign_certified",
        "outer_boundary_domain_certified",
        "causal_exclusion_decided",
        "growth_or_stability_certified",
        "general_l_or_polar_certified",
        "non_einstein_background_certified"
      ],
      "properties": {
        "carrier_constraint_regular_certified": { "const": true },
        "regular_singular_point_certified": { "const": true },
        "indicial_exponents_certified": { "const": true },
        "ingoing_family_dimension_certified": { "const": true },
        "rw_benchmark_certified": { "const": true },
        "flux_or_sign_certified": { "const": false },
        "outer_boundary_domain_certified": { "const": false },
        "causal_exclusion_decided": { "const": false },
        "growth_or_stability_certified": { "const": false },
        "general_l_or_polar_certified": { "const": false },
        "non_einstein_background_certified": { "const": false }
      }
    },
    "missing_objects": { "type": "array", "items": { "type": "string" }, "minItems": 5 },
    "stage_seconds": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "provenance": {
      "type": "object",
      "required": [
        "generator_path",
        "engine_path",
        "engine_sha256",
        "bh2a_certificate",
        "bh2a_certificate_sha256"
      ],
      "properties": {
        "generator_path": { "const": "black_hole_programme/bh2a_horizon_reach.py" },
        "engine_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bh2a_certificate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "verification_command": {
      "const": "python3 black_hole_programme/verify_bh2a_horizon_reach.py"
    }
  }
}
