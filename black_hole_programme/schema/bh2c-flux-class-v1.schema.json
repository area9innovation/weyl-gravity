{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pure-weyl-bh2c-flux-class-v1",
  "title": "BH-2C stage 3: finite-flux boundary class -- Einstein selected at infinity",
  "type": "object",
  "required": ["schema", "schema_path", "schema_sha256", "result_id", "result_token",
               "dependency_tags", "declaration", "log_tails", "flux_table", "headline",
               "claim_flags", "missing_objects", "stage_seconds", "provenance",
               "verification_command"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "pure-weyl-bh2c-flux-class-v1" },
    "schema_path": { "const": "black_hole_programme/schema/bh2c-flux-class-v1.schema.json" },
    "schema_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "result_id": { "const": "PURE_WEYL_BH2C_FLUX_CLASS" },
    "result_token": { "const": "BH2C_FINITE_FLUX_BOUNDARY_CLASS_EINSTEIN_SELECTED_AT_INFINITY" },
    "dependency_tags": { "const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"] },
    "declaration": { "type": "object",
      "required": ["theory", "background_family", "conformal_frame", "generator",
                   "phase_space", "horizon_condition", "infinity_condition", "lifecycle"],
      "properties": { "lifecycle": { "const": "CLASSIFIED" } } },
    "log_tails": { "type": "object", "required": ["statement", "contrast"] },
    "flux_table": { "type": "object",
      "required": ["E0|E0", "E0|X0", "X0|X0", "E2|E2", "E2|X2", "X2|X2"],
      "properties": {
        "E0|E0": { "const": ["-2", 0] },
        "E0|X0": { "const": ["0", 0] },
        "X0|X0": { "const": ["0", 1] },
        "E2|E2": { "const": ["-2", 0] },
        "E2|X2": { "const": ["1", 0] },
        "X2|X2": { "const": ["2", 0] } } },
    "headline": { "type": "object", "required": ["statement", "complement"] },
    "claim_flags": { "type": "object",
      "required": ["composed_log_tails_certified", "pure_power_exclusion_certified",
                   "flux_power_table_certified", "einstein_finite_class_certified",
                   "extra_divergent_class_certified", "symbolic_frequency_certified",
                   "polar_table_certified", "summability_certified",
                   "asymptotic_phase_space_constructed", "general_l_certified"],
      "properties": {
        "composed_log_tails_certified": { "const": true },
        "pure_power_exclusion_certified": { "const": true },
        "flux_power_table_certified": { "const": true },
        "einstein_finite_class_certified": { "const": true },
        "extra_divergent_class_certified": { "const": true },
        "symbolic_frequency_certified": { "const": false },
        "polar_table_certified": { "const": false },
        "summability_certified": { "const": false },
        "asymptotic_phase_space_constructed": { "const": false },
        "general_l_certified": { "const": false } } },
    "missing_objects": { "type": "array", "minItems": 5, "items": { "type": "string" } },
    "stage_seconds": { "type": "object" },
    "provenance": { "type": "object",
      "required": ["generator_path", "engine_path", "engine_sha256",
                   "jordan_certificate", "jordan_certificate_sha256",
                   "metric_leading_certificate", "metric_leading_certificate_sha256"] },
    "verification_command": { "const": "python3 black_hole_programme/verify_bh2c_flux_class.py" }
  }
}
