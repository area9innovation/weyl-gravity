{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase3-axial-normalized-r4-plane-handoff-v1",
  "title": "Normalized r=4 axial plane channel handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "dependency_tags",
    "scope",
    "normalization",
    "state_conventions",
    "cells",
    "claim_flags",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "phase3-axial-normalized-r4-plane-handoff-v1"
    },
    "status": {
      "enum": ["CERTIFIED", "SCOPED_SHORTFALL"]
    },
    "dependency_tags": {
      "const": ["LORENTZIAN-CAUSAL", "REDUCED-MODE"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["theory", "background", "ell", "mass", "matching_radius"],
      "properties": {
        "theory": {"const": "strict linearized four-dimensional pure Weyl C^2 gravity"},
        "background": {"const": "Schwarzschild exterior"},
        "ell": {"const": 2},
        "mass": {"const": "M=1"},
        "matching_radius": {"const": "r=4M"}
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "accumulated_endpoint_amplitudes",
        "canonical_endpoint_normalization",
        "basis_covariance"
      ],
      "properties": {
        "kind": {"const": "chart-identity-normalized-r4-planes"},
        "accumulated_endpoint_amplitudes": {"const": false},
        "canonical_endpoint_normalization": {"const": false},
        "basis_covariance": {
          "const": "Cpm' = Apm^-1*Cpm*AH; G' = A^dagger*G*A"
        }
      }
    },
    "state_conventions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "complex_state_order",
        "real_state_order",
        "current",
        "hermitian_current",
        "realification",
        "horizon_orientation",
        "stokes_identity"
      ],
      "properties": {
        "phase": {"const": "exp(+i*omega*v)"},
        "complex_state_order": {
          "const": ["P", "Pprime", "Q", "Qprime", "H1", "F"]
        },
        "real_state_order": {
          "const": [
            "Re(P)", "Re(Pprime)", "Re(Q)", "Re(Qprime)", "Re(H1)", "Re(F)",
            "Im(P)", "Im(Pprime)", "Im(Q)", "Im(Qprime)", "Im(H1)", "Im(F)"
          ]
        },
        "current": {
          "const": "F^r/(pi*alpha_W) = z^dagger*Jhat*y"
        },
        "hermitian_current": {"const": "K4 = +i*Jhat(r=4,omega)"},
        "realification": {
          "const": "R(K4) = [[Re(K4),-Im(K4)],[Im(K4),Re(K4)]]"
        },
        "horizon_orientation": {"const": "GHplus = -H^dagger*K4*H"},
        "stokes_identity": {"const": "GHplus+gplus-gminus=0"}
      }
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/cell"}
    },
    "claim_flags": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalized_plane_connection_certified",
        "negative_endpoint_wavepacket_certified",
        "canonical_amplitudes_certified",
        "origin_labels_certified",
        "frozen_endpoint_L2_equivalence_certified",
        "full_scattering_matrix_certified",
        "stability_or_CPT_certified",
        "quantum_ghost_or_unitarity_certified"
      ],
      "properties": {
        "normalized_plane_connection_certified": {"type": "boolean"},
        "negative_endpoint_wavepacket_certified": {"type": "boolean"},
        "canonical_amplitudes_certified": {"const": false},
        "origin_labels_certified": {"const": false},
        "frozen_endpoint_L2_equivalence_certified": {"const": false},
        "full_scattering_matrix_certified": {"const": false},
        "stability_or_CPT_certified": {"const": false},
        "quantum_ghost_or_unitarity_certified": {"const": false}
      }
    },
    "does_not_establish": {
      "type": "array",
      "minItems": 7,
      "items": {"type": "string", "minLength": 12},
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_id",
        "path",
        "sha256",
        "verifier_path",
        "verifier_sha256",
        "replay_command",
        "certified_claim_path"
      ],
      "properties": {
        "result_id": {"type": "string", "minLength": 8},
        "path": {"type": "string", "minLength": 8},
        "sha256": {"$ref": "#/$defs/sha256"},
        "verifier_path": {"type": "string", "minLength": 8},
        "verifier_sha256": {"$ref": "#/$defs/sha256"},
        "replay_command": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "string", "minLength": 1}
        },
        "certified_claim_path": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "gateSet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plus_i_current_sign",
        "standard_state_order",
        "complex_structure_equivariance",
        "separate_plane_rank",
        "combined_endpoint_rank",
        "validated_connection_solve",
        "endpoint_cross_block_zero",
        "stokes_identity",
        "continuous_endpoint_gram_and_connection",
        "basis_covariance",
        "whole_cell"
      ],
      "properties": {
        "plus_i_current_sign": {"const": true},
        "standard_state_order": {"const": true},
        "complex_structure_equivariance": {"const": true},
        "separate_plane_rank": {"const": true},
        "combined_endpoint_rank": {"const": true},
        "validated_connection_solve": {"const": true},
        "endpoint_cross_block_zero": {"const": true},
        "stokes_identity": {"const": true},
        "continuous_endpoint_gram_and_connection": {"const": true},
        "basis_covariance": {"const": true},
        "whole_cell": {"const": true}
      }
    },
    "inertia": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0, "maximum": 3},
        {"type": "integer", "minimum": 0, "maximum": 3},
        {"type": "integer", "minimum": 0, "maximum": 3}
      ],
      "items": false
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"disposition": {"const": "CERTIFIED"}},
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "evidence": {"type": "object"},
              "gates": {"$ref": "#/$defs/gateSet"},
              "results": {"type": "object"},
              "shortfall": {"type": "null"}
            }
          },
          "else": {
            "properties": {
              "evidence": {"type": "null"},
              "gates": {"type": "null"},
              "results": {"type": "null"},
              "shortfall": {
                "type": "object",
                "minProperties": 1
              }
            }
          }
        }
      ],
      "required": [
        "id",
        "omega_interval",
        "generator",
        "disposition",
        "evidence",
        "gates",
        "results",
        "shortfall"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^q[0-9]+$"},
        "omega_interval": {
          "type": "array",
          "prefixItems": [
            {"type": "string"},
            {"type": "string"}
          ],
          "items": false
        },
        "generator": {"const": 7315},
        "disposition": {"enum": ["CERTIFIED", "SCOPED_SHORTFALL"]},
        "evidence": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "horizon_plane",
                "iminus_plane",
                "iplus_plane",
                "connection",
                "current_and_pullbacks",
                "basis_covariance"
              ],
              "properties": {
                "horizon_plane": {"$ref": "#/$defs/artifact"},
                "iminus_plane": {"$ref": "#/$defs/artifact"},
                "iplus_plane": {"$ref": "#/$defs/artifact"},
                "connection": {"$ref": "#/$defs/artifact"},
                "current_and_pullbacks": {"$ref": "#/$defs/artifact"},
                "basis_covariance": {"$ref": "#/$defs/artifact"}
              }
            }
          ]
        },
        "gates": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/gateSet"}
          ]
        },
        "results": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "rank_Cminus",
                "rank_Cplus",
                "endpoint_Gplus_inertia",
                "GHplus_inertia",
                "gminus_inertia",
                "gplus_inertia",
                "negative_index_lower_bound",
                "compact_frequency_negative_endpoint_flux_wavepacket",
                "infinite_dimensional_negative_endpoint_flux_subspace",
                "activation_branch",
                "normalized_one_sided_J_isometry"
              ],
              "properties": {
                "rank_Cminus": {"type": "integer", "minimum": 0, "maximum": 3},
                "rank_Cplus": {"type": "integer", "minimum": 0, "maximum": 3},
                "endpoint_Gplus_inertia": {"$ref": "#/$defs/inertia"},
                "GHplus_inertia": {"$ref": "#/$defs/inertia"},
                "gminus_inertia": {"$ref": "#/$defs/inertia"},
                "gplus_inertia": {"$ref": "#/$defs/inertia"},
                "negative_index_lower_bound": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 2
                },
                "compact_frequency_negative_endpoint_flux_wavepacket": {
                  "type": "boolean"
                },
                "infinite_dimensional_negative_endpoint_flux_subspace": {
                  "type": "boolean"
                },
                "activation_branch": {
                  "enum": [
                    "rank-two-endpoint-negative-flux",
                    "full-rank-normalized-one-sided-J-isometry",
                    "no-negative-endpoint-activation"
                  ]
                },
                "normalized_one_sided_J_isometry": {"type": "boolean"}
              }
            }
          ]
        },
        "shortfall": {
          "type": ["object", "null"]
        }
      }
    }
  }
}
