    "schema", "result_id", "result_token", "lifecycle", "dependency_tags",
    "declaration", "axial_system", "landed_capabilities", "uncontrolled_pilot",
    "rounded_output_counterexample", "obstruction", "claim_flags",
    "does_not_establish", "provenance", "verification"
