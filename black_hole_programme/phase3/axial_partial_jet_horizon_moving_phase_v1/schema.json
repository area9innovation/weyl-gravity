{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "result_id",
    "dependency_tags",
    "lifecycle",
    "status",
    "imports",
    "moving_phase",
    "reduced_frobenius_recurrence",
    "finite_seed_rail",
    "shortfall",
    "claim_flags",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "phase3-axial-partial-jet-horizon-moving-phase-v1"
    },
    "status": {
      "const": "CERTIFIED_MOVING_PHASE_TAIL_AND_FIRST_PANEL_PARTIAL_JET_PASS"
    },
    "dependency_tags": {
      "contains": {
        "const": "REDUCED-MODE"
      }
    },
    "moving_phase": {
      "type": "object",
      "required": [
        "selected_exponent",
        "dot_lambda_H",
        "tau_log_rho_required"
      ],
      "properties": {
        "selected_exponent": {"const": "0"},
        "dot_lambda_H": {"const": "0"},
        "tau_log_rho_required": {"const": false}
      }
    },
    "finite_seed_rail": {
      "type": "object",
      "required": ["passed", "tail_included"],
      "properties": {
        "passed": {"const": true},
        "tail_included": {"const": true}
      }
    },
    "claim_flags": {
      "type": "object",
      "required": [
        "dot_lambda_H_exactly_zero",
        "uniform_frobenius_tail_enclosed",
        "first_panel_transport_certified",
        "T_plus_recovered",
        "H4_pass_certified"
      ],
      "properties": {
        "dot_lambda_H_exactly_zero": {"const": true},
        "uniform_frobenius_tail_enclosed": {"const": true},
        "first_panel_transport_certified": {"const": true},
        "T_plus_recovered": {"const": false},
        "H4_pass_certified": {"const": false}
      }
    }
  }
}
