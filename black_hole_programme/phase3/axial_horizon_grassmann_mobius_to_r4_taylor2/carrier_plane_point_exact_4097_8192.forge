fn hc_initial_model(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,hc_initial_model_center(),
    hc_initial_model_derivative(),hc_initial_model_remainder());
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn hc_runtime(xc:Rat,xbox:Iv,xhalf:Rat,cell:borrow IvAffineCell)->IvAffineMat{
  let c:QMat=qm_new(12,12);let d:QMat=qm_new(12,12);
  let rem:IvMat=ivm_zeros(12,12);
  let wc:Rat=big("4097/8192");
  let wlo:Iv=iv_from_rat(big("4097/8192"));
  let whi:Iv=iv_from_rat(big("4097/8192"));
  let wbox:Iv=iv(wlo.lo,whi.hi);
  let dx:Iv=iv_from_rat(xhalf);
  let dw:Iv=iv_from_rat(big("0/1"));
  c=qm_set(c,0,1,big("1/1"));
  c=qm_set(c,6,7,big("1/1"));
  c=qm_set(c,1,0,(big("2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/((big("2/1")+rat_clone(xc))*(big("2/1")+rat_clone(xc))))*(big("4/1")+(big("3/1")*rat_clone(xc)))));
  c=qm_set(c,7,6,(big("2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/((big("2/1")+rat_clone(xc))*(big("2/1")+rat_clone(xc))))*(big("4/1")+(big("3/1")*rat_clone(xc)))));
