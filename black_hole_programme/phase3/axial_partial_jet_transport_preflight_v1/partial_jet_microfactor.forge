  direct=jt_put(direct,0,11,t48);
  direct=jt_put(direct,1,0,t5);
  direct=jt_put(direct,1,1,t8);
  direct=jt_put(direct,1,2,t49);
  direct=jt_put(direct,1,3,t50);
  direct=jt_put(direct,1,4,t32);
  direct=jt_put(direct,1,5,t51);
  direct=jt_put(direct,1,7,t10);
  direct=jt_put(direct,1,8,t52);
  direct=jt_put(direct,1,9,t42);
  direct=jt_put(direct,1,10,t54);
  direct=jt_put(direct,1,11,t56);
  direct=jt_put(direct,2,3,jt_const(big("1/1")));
  direct=jt_put(direct,3,2,t5);
  direct=jt_put(direct,3,3,t8);
  direct=jt_put(direct,3,4,jt_const(big("1/1")));
  direct=jt_put(direct,3,9,t10);
  direct=jt_put(direct,4,5,jt_const(big("1/1")));
  direct=jt_put(direct,5,4,t12);
  direct=jt_put(direct,5,5,t13);
