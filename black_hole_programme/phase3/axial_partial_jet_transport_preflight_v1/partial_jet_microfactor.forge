  let t38:IvTaylor4Mat=jt_mul(t37,jt_add(jt_mul(jt_const(big("3/1")),t21),jt_const(big("20/1"))));
  let t39:IvTaylor4Mat=jt_mul(t18,t38);
  let t40:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t39);
  let t41:IvTaylor4Mat=jt_mul(jt_const(big("6/1")),t21);
  let t42:IvTaylor4Mat=jt_mul(t37,jt_add(jt_add(jt_add(jt_mul(jt_const(big("44/1")),ivtm4_clone(r_model)),jt_mul(jt_const(big("9/1")),t26)),jt_mul(jt_const(big("-1/1")),t41)),jt_const(big("-40/1"))));
  let t43:IvTaylor4Mat=jt_mul(ivtm4_clone(r_model),t42);
  let t44:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t43);
  let t45:IvTaylor4Mat=jt_mul(t37,jt_add(jt_add(jt_add(jt_add(jt_add(jt_mul(jt_mul(jt_const(big("6/1")),jt_pow(ivtm4_clone(r_model),4)),t20),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("60/1"))),ivtm4_clone(r_model))),jt_mul(jt_const(big("24/1")),t0)),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("13/1"))),t26)),t41),jt_const(big("40/1"))));
  let t46:IvTaylor4Mat=jt_mul(t0,t45);
  let t47:IvTaylor4Mat=jt_mul(jt_mul(ivtm4_clone(w_model),t34),jt_add(jt_add(jt_add(jt_mul(jt_const(big("20/1")),ivtm4_clone(r_model)),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("2/1"))),t21)),jt_mul(jt_const(big("3/1")),t26)),jt_const(big("-24/1"))));
  let t48:IvTaylor4Mat=jt_mul(t25,t47);
  let t49:IvTaylor4Mat=jt_mul(jt_mul(t1,t18),t23);
  let t50:IvTaylor4Mat=jt_mul(jt_mul(jt_const(big("-1/1")),t30),t6);
  let t51:IvTaylor4Mat=jt_mul(ivtm4_clone(r_model),t35);
  let t52:IvTaylor4Mat=jt_mul(t19,t38);
  let t53:IvTaylor4Mat=jt_mul(ivtm4_clone(r_model),t45);
  let t54:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t53);
  let t55:IvTaylor4Mat=jt_mul(t0,t47);
  let t56:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t55);
  let t57:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t46);
  let t58:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t48);
  let t59:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t52);
  let t60:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t42);
  let base:IvTaylor4Mat=jt_zero(8,8);
  let tangent:IvTaylor4Mat=jt_zero(8,8);
  let direct:IvTaylor4Mat=jt_zero(12,12);
  base=jt_put(base,0,1,jt_const(big("1/1")));
  base=jt_put(base,1,0,t5);
  base=jt_put(base,1,1,t8);
  base=jt_put(base,1,2,jt_const(big("1/1")));
  base=jt_put(base,1,5,t10);
