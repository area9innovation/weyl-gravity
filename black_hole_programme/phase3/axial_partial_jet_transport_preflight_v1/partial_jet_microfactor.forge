  tangent=jt_put(tangent,5,5,t50);
  tangent=jt_put(tangent,5,6,t32);
  tangent=jt_put(tangent,5,7,t51);
  direct=jt_put(direct,0,1,jt_const(big("1/1")));
  direct=jt_put(direct,0,2,t24);
  direct=jt_put(direct,0,3,t30);
  direct=jt_put(direct,0,4,t33);
  direct=jt_put(direct,0,5,t36);
  direct=jt_put(direct,0,8,t40);
