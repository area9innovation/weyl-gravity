{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "dependency_tags",
    "lifecycle",
    "status",
    "imports",
    "disk",
    "inverse_tortoise_branch",
    "volterra",
    "claim_flags",
    "next_gates",
    "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "phase3-axial-qnm-ecs-inverse-tortoise-v1"
    },
    "dependency_tags": {
      "contains": {
        "const": "REDUCED-MODE"
      }
    },
    "lifecycle": {
