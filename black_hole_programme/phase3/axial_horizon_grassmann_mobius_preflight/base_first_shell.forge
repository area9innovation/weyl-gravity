fn ht_initial_model(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,ht_initial_model_center(),
    ht_initial_model_derivative(),ht_initial_model_remainder());
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn ht_initial()->IvAffineMat{return ht_initial_model(ht_cell());}

fn ht_runtime(xc:Rat,xbox:Iv,xhalf:Rat,cell:borrow IvAffineCell)->IvAffineMat{
