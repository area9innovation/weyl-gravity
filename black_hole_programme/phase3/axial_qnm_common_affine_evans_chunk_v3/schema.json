{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema", "status", "lifecycle", "dependency_tags", "claim_flags",
    "method", "result", "imports", "run", "does_not_establish"
  ],
  "properties": {
    "schema": {
      "const": "phase3-axial-qnm-common-affine-evans-chunk-v3"
    },
    "status": {
      "enum": [
        "PANELS_32_THROUGH_47_BOUNDARY_NONVANISHING_CERTIFIED",
        "CHUNK_32_THROUGH_47_FAIL_CLOSED"
      ]
    },
    "lifecycle": {"const": "CLASSIFIED"},
    "dependency_tags": {"type": "array"},
    "claim_flags": {"type": "object"},
    "method": {"type": "object"},
    "result": {"type": "object"},
    "imports": {"type": "object"},
    "run": {"type": "object", "required": ["path", "sha256"]},
    "does_not_establish": {"type": "array", "minItems": 7}
  },
  "additionalProperties": false
}
