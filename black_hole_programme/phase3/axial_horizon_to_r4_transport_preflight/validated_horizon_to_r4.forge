fn ht_initial_model(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,ht_initial_model_center(),
    ht_initial_model_derivative(),ht_initial_model_remainder());
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn ht_initial()->IvAffineMat{return ht_initial_model(ht_cell());}

fn ht_runtime(xc:Rat,xbox:Iv,xhalf:Rat,cell:borrow IvAffineCell)->IvAffineMat{
  let c:QMat=qm_new(12,12);let d:QMat=qm_new(12,12);
  let rem:IvMat=ivm_zeros(12,12);
  let wc:Rat=big("257/512");
  let wlo:Iv=iv_from_rat(big("1/2"));
  let whi:Iv=iv_from_rat(big("129/256"));
  let wbox:Iv=iv(wlo.lo,whi.hi);
  let dx:Iv=iv_from_rat(xhalf);
  let dw:Iv=iv_from_rat(big("1/512"));
  c=qm_set(c,0,1,big("1/1"));
  c=qm_set(c,6,7,big("1/1"));
  c=qm_set(c,1,0,(big("2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/((big("2/1")+rat_clone(xc))*(big("2/1")+rat_clone(xc))))*(big("4/1")+(big("3/1")*rat_clone(xc)))));
