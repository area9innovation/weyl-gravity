      iv(ta_31.lo,tb_31.hi));
    let w_31:IvAffineMat=match(sl_local_transition(
      a_31,big("1/8192"),12)){
      some(z)=>z,none=>{println("LOCAL_REFUSAL 31");return false;}};
    let z_31:IvAffineResult=ivam_apply_rect(w_31,y);
    if(!z_31.ok){return false;}
    let rb_31:IvAffineResult=
      ivam_rebase_dyadic(z_31.value,128);
    if(!rb_31.ok){return false;}y=ivam_clone(rb_31.value);
    p_31=p_31+1;}
  let rk_31:IvAffineRank=ivam_full_column_rank_cells(y,32);
  println(strfmt(system_allocator(),"SHELL 31 {} {}",
    [rk_31.certified,ivam_max_width(y)]));
  let p_32:i64=0;while(p_32<16){
