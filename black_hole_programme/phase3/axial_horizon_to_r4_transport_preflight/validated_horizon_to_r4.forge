    big("1/32");
  return ht_runtime(xc,tbox,big("1/32"),c);
}

fn gc_cell()->IvAffineCell{return ht_cell();}

fn gc_affine_submatrix(a:borrow IvAffineMat,kind:i64)->IvAffineMat{
  let nr:i64=if(kind==0){8}else{if(kind==1){4}else{4}};
  let nc:i64=if(kind==2){8}else{nr};
  let c:QMat=qm_new(nr,nc);let l:QMat=qm_new(nr,nc);
  let r:IvMat=ivm_zeros(nr,nc);let i:i64=0;
  while(i<nr){let si:i64=if(kind==0){if(i<4){i}else{i+2}}
    else{if(i<2){i+4}else{i+8}};let j:i64=0;
    while(j<nc){let sj:i64=if(kind==1){if(j<2){j+4}else{j+8}}
      else{if(j<4){j}else{j+2}};
      c=qm_set(c,i,j,qm_get(a.center,si,sj));
      l=qm_set(l,i,j,qm_get(a.linear,si,sj));
      ivm_set(r,i,j,ivm_at(a.remainder,si,sj));j=j+1;}i=i+1;}
  return new IvAffineMat(a.generator,nr,nc,c,l,r);
}

fn ht_standard_to_block_rows(a:borrow IvAffineMat)->IvAffineMat{
  let c:QMat=qm_new(12,a.cols);let l:QMat=qm_new(12,a.cols);
  let r:IvMat=ivm_zeros(12,a.cols);let i:i64=0;
  while(i<12){let si:i64=if(i<8){if(i<4){i}else{i+2}}
    else{if(i<10){i-4}else{i}};let j:i64=0;
    while(j<a.cols){c=qm_set(c,i,j,qm_get(a.center,si,j));
      l=qm_set(l,i,j,qm_get(a.linear,si,j));
      ivm_set(r,i,j,ivm_at(a.remainder,si,j));j=j+1;}i=i+1;}
  return new IvAffineMat(a.generator,12,a.cols,c,l,r);
}

fn ht_block_to_standard_rows(a:borrow IvAffineMat)->IvAffineMat{
  let c:QMat=qm_new(12,a.cols);let l:QMat=qm_new(12,a.cols);
  let r:IvMat=ivm_zeros(12,a.cols);let i:i64=0;
  while(i<12){let si:i64=if(i<4){i}else{if(i<6){8+i-4}
    else{if(i<10){4+i-6}else{i}}};let j:i64=0;
    while(j<a.cols){c=qm_set(c,i,j,qm_get(a.center,si,j));
      l=qm_set(l,i,j,qm_get(a.linear,si,j));
      ivm_set(r,i,j,ivm_at(a.remainder,si,j));j=j+1;}i=i+1;}
  return new IvAffineMat(a.generator,12,a.cols,c,l,r);
}

fn sl_inf_norm_hi(a:borrow IvMat)->f64{
  let best:f64=0.0;let i:i64=0;
  while(i<ivm_rows(a)){let s:Iv=iv_point(0.0);let j:i64=0;
    while(j<ivm_cols(a)){s=iv_add(s,iv_abs(ivm_at(a,i,j)));j=j+1;}
    if(!iv_finite(s)){return -1.0;}if(s.hi>best){best=s.hi;}i=i+1;}
  return best;
}

fn sl_exp_tail(x:f64,first_power:i64)->f64{
  if(x<0.0 || !f64_is_finite(x) || first_power<1){return -1.0;}
  let fact:f64=1.0;let j:i64=1;
  while(j<=first_power){fact=fact*f64(j);j=j+1;}
  let xp:f64=1.0;j=0;while(j<first_power){xp=xp*x;j=j+1;}
  let q:f64=x/f64(first_power+1);
  if(!f64_is_finite(fact) || !f64_is_finite(xp) || q>=1.0){return -1.0;}
  return (xp/fact)/(1.0-q);
}

// One panel of A=[[Ac,0],[G,Ak]].  The polynomial terms are the exact
// block recurrence for powers of the interval coefficient set.  The omitted
// diagonal tails use Ac and Ak separately.  The lower tail uses
//   ||(A^n)_lower|| <= beta*n*max(alpha_c,alpha_k)^(n-1),
// hence beta*h*sum_{m=order}^\infty (a*h)^m/m!.
fn sl_local_transition(a:borrow IvAffineMat,h:borrow Rat,
order:i64)->Option<IvAffineMat>{
  if(a.rows!=12 || a.cols!=12 || a.generator!=gc_cell().generator ||
     rat_sign(h)<=0 || order<1){return Option.none;}
  let ac:IvAffineMat=gc_affine_submatrix(a,0);
  let ak:IvAffineMat=gc_affine_submatrix(a,1);
  let g:IvAffineMat=gc_affine_submatrix(a,2);
  let sc:IvAffineMat=ivam_identity(a.generator,8);
  let sk:IvAffineMat=ivam_identity(a.generator,4);
  let sl:IvAffineMat=ivam_constant(a.generator,qm_new(4,8));
  let pc:IvAffineMat=ivam_identity(a.generator,8);
  let pk:IvAffineMat=ivam_identity(a.generator,4);
  let pl:IvAffineMat=ivam_constant(a.generator,qm_new(4,8));
  let coeff:Rat=rat(1,1);let n:i64=1;
  while(n<=order){
    let oldc:IvAffineMat=ivam_clone(pc);
    let oldk:IvAffineMat=ivam_clone(pk);
    let oldl:IvAffineMat=ivam_clone(pl);
    let rc:IvAffineResult=ivam_mul_checked(ac,oldc);
    let rk:IvAffineResult=ivam_mul_checked(ak,oldk);
    let lg:IvAffineResult=ivam_mul_checked(g,oldc);
    let lk:IvAffineResult=ivam_mul_checked(ak,oldl);
    if(!rc.ok || !rk.ok || !lg.ok || !lk.ok){return Option.none;}
    let rl:IvAffineResult=ivam_add_checked(lg.value,lk.value);
    if(!rl.ok){return Option.none;}
    pc=ivam_clone(rc.value);pk=ivam_clone(rk.value);pl=ivam_clone(rl.value);
    coeff=(rat_clone(coeff)*rat_clone(h))/rat(n,1);
    let qc:IvAffineResult=ivam_add_checked(sc,ivam_scale_rat(pc,coeff));
    let qk:IvAffineResult=ivam_add_checked(sk,ivam_scale_rat(pk,coeff));
    let ql:IvAffineResult=ivam_add_checked(sl,ivam_scale_rat(pl,coeff));
    if(!qc.ok || !qk.ok || !ql.ok){return Option.none;}
    sc=ivam_clone(qc.value);sk=ivam_clone(qk.value);sl=ivam_clone(ql.value);
    n=n+1;
  }
  let alphac:f64=sl_inf_norm_hi(ivam_hull(ac));
  let alphak:f64=sl_inf_norm_hi(ivam_hull(ak));
  let beta:f64=sl_inf_norm_hi(ivam_hull(g));
  if(alphac<0.0 || alphak<0.0 || beta<0.0){return Option.none;}
  let hf:f64=rat_to_f64(h);
  let tc:f64=sl_exp_tail(hf*alphac,order+1);
  let tk:f64=sl_exp_tail(hf*alphak,order+1);
  let aa:f64=if(alphac>alphak){alphac}else{alphak};
  let tl0:f64=sl_exp_tail(hf*aa,order);
  let tl:f64=beta*hf*tl0;
  if(tc<0.0 || tk<0.0 || tl<0.0 || !f64_is_finite(tl)){return Option.none;}
  let pcorr:IvAffineResult=ivam_pad_remainder(sc,tc);
  let pkorr:IvAffineResult=ivam_pad_remainder(sk,tk);
  let plorr:IvAffineResult=ivam_pad_remainder(sl,tl);
  if(!pcorr.ok || !pkorr.ok || !plorr.ok){return Option.none;}
  let out:IvAffineResult=ivam_block_lower(pcorr.value,plorr.value,pkorr.value);
  if(!out.ok){return Option.none;}return Option.some(ivam_clone(out.value));
}

fn ht_emit(a:borrow IvAffineMat)->void{
  let h:IvMat=ivam_hull(a);let i:i64=0;while(i<12){
    let j:i64=0;while(j<6){
      let cs:String=rat_str(qm_get(a.center,i,j));
      let ls:String=rat_str(qm_get(a.linear,i,j));
      let r:Iv=ivm_at(a.remainder,i,j);let q:Iv=ivm_at(h,i,j);
      println(strfmt(system_allocator(),
        "A {} {} {} {} {} {} {} {}",
        [i,j,str_view(cs),str_view(ls),f64_bits(r.lo),f64_bits(r.hi),
         f64_bits(q.lo),f64_bits(q.hi)]));
      drop(cs);drop(ls);j=j+1;}i=i+1;}
}

fn ht_standard_at_r4(a:borrow IvAffineMat)->Option<IvAffineMat>{
  let s:QMat=qm_new(12,12);let i:i64=0;while(i<12){
    s=qm_set(s,i,i,if(i==5 || i==11){rat(1,2)}else{rat(1,1)});
    i=i+1;}
  let c:IvAffineMat=ivam_constant(ht_cell().generator,s);
  let z:IvAffineResult=ivam_apply_rect(c,a);
  if(!z.ok){return Option.none;}
  let rb:IvAffineResult=ivam_rebase_dyadic(z.value,128);
  if(!rb.ok){return Option.none;}return Option.some(ivam_clone(rb.value));
}

pub fn axial_horizon_to_r4()->bool{
  let y:IvAffineMat=ht_standard_to_block_rows(ht_initial());
  println("BEGIN HORIZON_TO_R4");
  let p_0:i64=0;while(p_0<16){
    let ta_0:Iv=iv_from_rat(big("1/1099511627776")+
      rat(p_0,1)*big("1/17592186044416"));
    let tb_0:Iv=iv_from_rat(big("1/1099511627776")+
      rat(p_0+1,1)*big("1/17592186044416"));
    let a_0:IvAffineMat=ht_coeff_0(p_0,
      iv(ta_0.lo,tb_0.hi));
    let w_0:IvAffineMat=match(sl_local_transition(
      a_0,big("1/17592186044416"),12)){
      some(z)=>z,none=>{println("LOCAL_REFUSAL 0");return false;}};
    let z_0:IvAffineResult=ivam_apply_rect(w_0,y);
    if(!z_0.ok){return false;}
    let rb_0:IvAffineResult=
      ivam_rebase_dyadic(z_0.value,128);
    if(!rb_0.ok){return false;}y=ivam_clone(rb_0.value);
    p_0=p_0+1;}
  let rk_0:IvAffineRank=ivam_full_column_rank_cells(y,32);
  println(strfmt(system_allocator(),"SHELL 0 {} {}",
    [rk_0.certified,ivam_max_width(y)]));
  let p_1:i64=0;while(p_1<16){
    let ta_1:Iv=iv_from_rat(big("1/549755813888")+
