fn ht_coeff_0(panel:i64,tbox:Iv)->IvAffineMat{
  let c:IvAffineCell=ht_cell();
  let xc:Rat=big("1/4194304")+rat(2*panel+1,1)*
    big("1/134217728");
  return ht_runtime(xc,tbox,big("1/134217728"),c);
}

