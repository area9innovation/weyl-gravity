fn hr_i(chart:i64,k:i64)->i64{if(chart==0){return if(k==0){0}else{if(k==1){1}else{if(k==2){2}else{if(k==3){4}else{if(k==4){5}else{{6}}}}}};}else{if(chart==1){return if(k==0){0}else{if(k==1){1}else{if(k==2){3}else{if(k==3){4}else{if(k==4){5}else{{7}}}}}};}else{if(chart==2){return if(k==0){0}else{if(k==1){1}else{if(k==2){8}else{if(k==3){4}else{if(k==4){5}else{{10}}}}}};}else{if(chart==3){return if(k==0){0}else{if(k==1){1}else{if(k==2){9}else{if(k==3){4}else{if(k==4){5}else{{11}}}}}};}else{if(chart==4){return if(k==0){0}else{if(k==1){2}else{if(k==2){3}else{if(k==3){4}else{if(k==4){6}else{{7}}}}}};}else{if(chart==5){return if(k==0){0}else{if(k==1){2}else{if(k==2){8}else{if(k==3){4}else{if(k==4){6}else{{10}}}}}};}else{if(chart==6){return if(k==0){0}else{if(k==1){2}else{if(k==2){9}else{if(k==3){4}else{if(k==4){6}else{{11}}}}}};}else{if(chart==7){return if(k==0){0}else{if(k==1){3}else{if(k==2){8}else{if(k==3){4}else{if(k==4){7}else{{10}}}}}};}else{if(chart==8){return if(k==0){0}else{if(k==1){3}else{if(k==2){9}else{if(k==3){4}else{if(k==4){7}else{{11}}}}}};}else{if(chart==9){return if(k==0){0}else{if(k==1){8}else{if(k==2){9}else{if(k==3){4}else{if(k==4){10}else{{11}}}}}};}else{if(chart==10){return if(k==0){1}else{if(k==1){2}else{if(k==2){3}else{if(k==3){5}else{if(k==4){6}else{{7}}}}}};}else{if(chart==11){return if(k==0){1}else{if(k==1){2}else{if(k==2){8}else{if(k==3){5}else{if(k==4){6}else{{10}}}}}};}else{if(chart==12){return if(k==0){1}else{if(k==1){2}else{if(k==2){9}else{if(k==3){5}else{if(k==4){6}else{{11}}}}}};}else{if(chart==13){return if(k==0){1}else{if(k==1){3}else{if(k==2){8}else{if(k==3){5}else{if(k==4){7}else{{10}}}}}};}else{if(chart==14){return if(k==0){1}else{if(k==1){3}else{if(k==2){9}else{if(k==3){5}else{if(k==4){7}else{{11}}}}}};}else{if(chart==15){return if(k==0){1}else{if(k==1){8}else{if(k==2){9}else{if(k==3){5}else{if(k==4){10}else{{11}}}}}};}else{if(chart==16){return if(k==0){2}else{if(k==1){3}else{if(k==2){8}else{if(k==3){6}else{if(k==4){7}else{{10}}}}}};}else{if(chart==17){return if(k==0){2}else{if(k==1){3}else{if(k==2){9}else{if(k==3){6}else{if(k==4){7}else{{11}}}}}};}else{if(chart==18){return if(k==0){2}else{if(k==1){8}else{if(k==2){9}else{if(k==3){6}else{if(k==4){10}else{{11}}}}}};}else{{return if(k==0){3}else{if(k==1){8}else{if(k==2){9}else{if(k==3){7}else{if(k==4){10}else{{11}}}}}};}}}}}}}}}}}}}}}}}}}}}
fn hr_j(chart:i64,k:i64)->i64{if(chart==0){return if(k==0){3}else{if(k==1){8}else{if(k==2){9}else{if(k==3){7}else{if(k==4){10}else{{11}}}}}};}else{if(chart==1){return if(k==0){2}else{if(k==1){8}else{if(k==2){9}else{if(k==3){6}else{if(k==4){10}else{{11}}}}}};}else{if(chart==2){return if(k==0){2}else{if(k==1){3}else{if(k==2){9}else{if(k==3){6}else{if(k==4){7}else{{11}}}}}};}else{if(chart==3){return if(k==0){2}else{if(k==1){3}else{if(k==2){8}else{if(k==3){6}else{if(k==4){7}else{{10}}}}}};}else{if(chart==4){return if(k==0){1}else{if(k==1){8}else{if(k==2){9}else{if(k==3){5}else{if(k==4){10}else{{11}}}}}};}else{if(chart==5){return if(k==0){1}else{if(k==1){3}else{if(k==2){9}else{if(k==3){5}else{if(k==4){7}else{{11}}}}}};}else{if(chart==6){return if(k==0){1}else{if(k==1){3}else{if(k==2){8}else{if(k==3){5}else{if(k==4){7}else{{10}}}}}};}else{if(chart==7){return if(k==0){1}else{if(k==1){2}else{if(k==2){9}else{if(k==3){5}else{if(k==4){6}else{{11}}}}}};}else{if(chart==8){return if(k==0){1}else{if(k==1){2}else{if(k==2){8}else{if(k==3){5}else{if(k==4){6}else{{10}}}}}};}else{if(chart==9){return if(k==0){1}else{if(k==1){2}else{if(k==2){3}else{if(k==3){5}else{if(k==4){6}else{{7}}}}}};}else{if(chart==10){return if(k==0){0}else{if(k==1){8}else{if(k==2){9}else{if(k==3){4}else{if(k==4){10}else{{11}}}}}};}else{if(chart==11){return if(k==0){0}else{if(k==1){3}else{if(k==2){9}else{if(k==3){4}else{if(k==4){7}else{{11}}}}}};}else{if(chart==12){return if(k==0){0}else{if(k==1){3}else{if(k==2){8}else{if(k==3){4}else{if(k==4){7}else{{10}}}}}};}else{if(chart==13){return if(k==0){0}else{if(k==1){2}else{if(k==2){9}else{if(k==3){4}else{if(k==4){6}else{{11}}}}}};}else{if(chart==14){return if(k==0){0}else{if(k==1){2}else{if(k==2){8}else{if(k==3){4}else{if(k==4){6}else{{10}}}}}};}else{if(chart==15){return if(k==0){0}else{if(k==1){2}else{if(k==2){3}else{if(k==3){4}else{if(k==4){6}else{{7}}}}}};}else{if(chart==16){return if(k==0){0}else{if(k==1){1}else{if(k==2){9}else{if(k==3){4}else{if(k==4){5}else{{11}}}}}};}else{if(chart==17){return if(k==0){0}else{if(k==1){1}else{if(k==2){8}else{if(k==3){4}else{if(k==4){5}else{{10}}}}}};}else{if(chart==18){return if(k==0){0}else{if(k==1){1}else{if(k==2){3}else{if(k==3){4}else{if(k==4){5}else{{7}}}}}};}else{{return if(k==0){0}else{if(k==1){1}else{if(k==2){2}else{if(k==3){4}else{if(k==4){5}else{{6}}}}}};}}}}}}}}}}}}}}}}}}}}}


pub type HrSolve = scoped struct {
  pub ok: bool,
  pub value: IvTaylor4Mat,
};

pub type HrState = scoped struct {
  pub ok: bool,
  pub chart: i64,
  pub z: IvTaylor4Mat,
  pub amplitude: IvTaylor4Mat,
};

fn hr_zero()->IvTaylor4Mat{
  return ivtm4_constant(7315,qm_new(6,6));
}

fn hr_fail()->HrState{
  return new HrState(false,-1,hr_zero(),hr_zero());
}


fn hr_rows(a:borrow IvTaylor4Mat,chart:i64,pivot:bool)->IvTaylor4Mat{
  let c0:QMat=qm_new(6,a.cols);let c1:QMat=qm_new(6,a.cols);
  let c2:QMat=qm_new(6,a.cols);let c3:QMat=qm_new(6,a.cols);
  let c4:QMat=qm_new(6,a.cols);let rem:IvMat=ivm_zeros(6,a.cols);
  let i:i64=0;while(i<6){
    let si:i64=if(pivot){hr_i(chart,i)}else{hr_j(chart,i)};
    let j:i64=0;while(j<a.cols){
      c0=qm_set(c0,i,j,qm_get(a.c0,si,j));
      c1=qm_set(c1,i,j,qm_get(a.c1,si,j));
      c2=qm_set(c2,i,j,qm_get(a.c2,si,j));
      c3=qm_set(c3,i,j,qm_get(a.c3,si,j));
      c4=qm_set(c4,i,j,qm_get(a.c4,si,j));
      ivm_set(rem,i,j,ivm_at(a.remainder,si,j));j=j+1;}i=i+1;}
  let z:IvTaylor4Result=ivtm4_new(
    a.generator,c0,c1,c2,c3,c4,rem);
  if(!z.ok){trap();}return ivtm4_clone(z.value);
}


fn hr_block(a:borrow IvTaylor4Mat,chart:i64,row_i:bool,col_i:bool)
->IvTaylor4Mat{
  let c0:QMat=qm_new(6,6);let c1:QMat=qm_new(6,6);
  let c2:QMat=qm_new(6,6);let c3:QMat=qm_new(6,6);
  let c4:QMat=qm_new(6,6);let rem:IvMat=ivm_zeros(6,6);
  let i:i64=0;while(i<6){
    let si:i64=if(row_i){hr_i(chart,i)}else{hr_j(chart,i)};
    let j:i64=0;while(j<6){
      let sj:i64=if(col_i){hr_i(chart,j)}else{hr_j(chart,j)};
      c0=qm_set(c0,i,j,qm_get(a.c0,si,sj));
      c1=qm_set(c1,i,j,qm_get(a.c1,si,sj));
      c2=qm_set(c2,i,j,qm_get(a.c2,si,sj));
      c3=qm_set(c3,i,j,qm_get(a.c3,si,sj));
      c4=qm_set(c4,i,j,qm_get(a.c4,si,sj));
      ivm_set(rem,i,j,ivm_at(a.remainder,si,sj));j=j+1;}i=i+1;}
  let z:IvTaylor4Result=ivtm4_new(
    a.generator,c0,c1,c2,c3,c4,rem);
  if(!z.ok){trap();}return ivtm4_clone(z.value);
}

// Checked degree-two right solve X*A=B.
fn hr_right(b:borrow IvTaylor4Mat,a:borrow IvTaylor4Mat)->HrSolve{
  if(a.generator!=7315 || b.generator!=7315 ||
     a.rows!=6 || a.cols!=6 || b.rows!=6 || b.cols!=6){
    return new HrSolve(false,hr_zero());}
  let x:IvTaylor4Result=ivtm4_solve_right(b,a);
  if(!x.ok){return new HrSolve(false,hr_zero());}
  let rb:IvTaylor4Result=ivtm4_rebase_dyadic(x.value,128);
  if(!rb.ok){return new HrSolve(false,hr_zero());}
  let xa:IvTaylor4Result=ivtm4_mul_checked(rb.value,a);
  if(!xa.ok){return new HrSolve(false,hr_zero());}
  let defect:IvTaylor4Result=ivtm4_sub_checked(xa.value,b);
  if(!defect.ok || !hr_contains_zero(defect.value)){
    return new HrSolve(false,hr_zero());}
  return new HrSolve(true,ivtm4_clone(rb.value));
}

fn hr_contains_zero(a:borrow IvTaylor4Mat)->bool{
  let h:IvMat=ivtm4_hull(a);let i:i64=0;while(i<a.rows){
    let j:i64=0;while(j<a.cols){let x:Iv=ivm_at(h,i,j);
      if(x.lo>0.0 || x.hi<0.0){return false;}j=j+1;}i=i+1;}
  return true;
}

fn hr_intersects(a:borrow IvTaylor4Mat,b:borrow IvTaylor4Mat)->bool{
  if(a.rows!=b.rows || a.cols!=b.cols){return false;}
  let ah:IvMat=ivtm4_hull(a);let bh:IvMat=ivtm4_hull(b);
  let i:i64=0;while(i<a.rows){let j:i64=0;while(j<a.cols){
    let x:Iv=ivm_at(ah,i,j);let y:Iv=ivm_at(bh,i,j);
    if(x.hi<y.lo || y.hi<x.lo){return false;}j=j+1;}i=i+1;}
  return true;
}

fn hr_norm(z:borrow IvTaylor4Mat)->f64{
  let h:IvMat=ivtm4_hull(z);let best:f64=0.0;let i:i64=0;
  while(i<z.rows){let j:i64=0;while(j<z.cols){
    let a:Iv=iv_abs(ivm_at(h,i,j));if(a.hi>best){best=a.hi;}
    j=j+1;}i=i+1;}return best;
}

// Diagnostic only.  Centre rank and a floating SVD computed from these exact
// entries do not certify the uniform interval family.
fn hr_emit_amplitude_center(a:borrow IvTaylor4Mat)->void{
  println(strfmt(system_allocator(),"AMPLITUDE_CENTER_RANK {}",
    [qm_rank(a.c0)]));
  let i:i64=0;while(i<a.rows){let j:i64=0;while(j<a.cols){
    let s:String=rat_str(qm_get(a.c0,i,j));
    println(strfmt(system_allocator(),"AC {} {} {}",[i,j,str_view(s)]));
    drop(s);j=j+1;}i=i+1;}
}


fn hr_graph_basis(z:borrow IvTaylor4Mat,chart:i64)->IvTaylor4Mat{
  let c0:QMat=qm_new(12,6);let c1:QMat=qm_new(12,6);
  let c2:QMat=qm_new(12,6);let c3:QMat=qm_new(12,6);
  let c4:QMat=qm_new(12,6);let rem:IvMat=ivm_zeros(12,6);
  let i:i64=0;while(i<6){
    c0=qm_set(c0,hr_i(chart,i),i,rat(1,1));
    let j:i64=0;while(j<6){
      c0=qm_set(c0,hr_j(chart,i),j,qm_get(z.c0,i,j));
      c1=qm_set(c1,hr_j(chart,i),j,qm_get(z.c1,i,j));
      c2=qm_set(c2,hr_j(chart,i),j,qm_get(z.c2,i,j));
      c3=qm_set(c3,hr_j(chart,i),j,qm_get(z.c3,i,j));
      c4=qm_set(c4,hr_j(chart,i),j,qm_get(z.c4,i,j));
      ivm_set(rem,hr_j(chart,i),j,ivm_at(z.remainder,i,j));
      j=j+1;}i=i+1;}
  let out:IvTaylor4Result=ivtm4_new(
    z.generator,c0,c1,c2,c3,c4,rem);
  if(!out.ok){trap();}return ivtm4_clone(out.value);
}

fn hr_from_basis(y:borrow IvTaylor4Mat,chart:i64)->HrState{
  let u:IvTaylor4Mat=hr_rows(y,chart,true);
  let v:IvTaylor4Mat=hr_rows(y,chart,false);
  let z:HrSolve=hr_right(v,u);
  if(!z.ok){return hr_fail();}
  let amp:IvTaylor4Result=ivtm4_rebase_dyadic(u,128);
  if(!amp.ok){return hr_fail();}
  return new HrState(true,chart,ivtm4_clone(z.value),ivtm4_clone(amp.value));
}

fn hr_reconstruct(s:borrow HrState)->HrSolve{
  let y:IvTaylor4Result=ivtm4_mul_checked(hr_graph_basis(s.z,s.chart),s.amplitude);
  if(!y.ok){return new HrSolve(false,hr_zero());}
  let rb:IvTaylor4Result=ivtm4_rebase_dyadic(y.value,128);
  if(!rb.ok){return new HrSolve(false,hr_zero());}
  return new HrSolve(true,ivtm4_clone(rb.value));
}

fn hr_rechart(s:borrow HrState,new_chart:i64)->HrState{
  if(!s.ok){return hr_fail();}
  if(new_chart==s.chart){
    return new HrState(true,s.chart,ivtm4_clone(s.z),ivtm4_clone(s.amplitude));}
  let g:IvTaylor4Mat=hr_graph_basis(s.z,s.chart);
  let u:IvTaylor4Mat=hr_rows(g,new_chart,true);
  let v:IvTaylor4Mat=hr_rows(g,new_chart,false);
  let z:HrSolve=hr_right(v,u);
  if(!z.ok || hr_norm(z.value)>=2.0){return hr_fail();}
  let amp0:IvTaylor4Result=ivtm4_mul_checked(u,s.amplitude);
  if(!amp0.ok){return hr_fail();}
  let amp:IvTaylor4Result=ivtm4_rebase_dyadic(amp0.value,128);
  if(!amp.ok){return hr_fail();}
  return new HrState(true,new_chart,ivtm4_clone(z.value),ivtm4_clone(amp.value));
}

fn hr_best_chart(s:borrow HrState)->HrState{
  let best:HrState=new HrState(true,s.chart,ivtm4_clone(s.z),
    ivtm4_clone(s.amplitude));
  let c:i64=0;while(c<20){
    let cand:HrState=hr_rechart(s,c);
    if(cand.ok && hr_norm(cand.z)<hr_norm(best.z)){
      best=new HrState(true,cand.chart,ivtm4_clone(cand.z),
        ivtm4_clone(cand.amplitude));
    }
    drop(cand);c=c+1;
  }
  return best;
}

fn hr_step(phi:borrow IvTaylor4Mat,s:borrow HrState)->HrState{
  let pii:IvTaylor4Mat=hr_block(phi,s.chart,true,true);
  let pij:IvTaylor4Mat=hr_block(phi,s.chart,true,false);
  let pji:IvTaylor4Mat=hr_block(phi,s.chart,false,true);
  let pjj:IvTaylor4Mat=hr_block(phi,s.chart,false,false);
  let az:IvTaylor4Result=ivtm4_mul_checked(pij,s.z);
  let bz:IvTaylor4Result=ivtm4_mul_checked(pjj,s.z);
  if(!az.ok || !bz.ok){return hr_fail();}
  let m0:IvTaylor4Result=ivtm4_add_checked(pii,az.value);
  let n0:IvTaylor4Result=ivtm4_add_checked(pji,bz.value);
  if(!m0.ok || !n0.ok){return hr_fail();}
  let m:IvTaylor4Result=ivtm4_rebase_dyadic(m0.value,128);
  let n:IvTaylor4Result=ivtm4_rebase_dyadic(n0.value,128);
  if(!m.ok || !n.ok){return hr_fail();}
  let z:HrSolve=hr_right(n.value,m.value);
  if(!z.ok || hr_norm(z.value)>=2.0){return hr_fail();}
  let amp0:IvTaylor4Result=ivtm4_mul_checked(m.value,s.amplitude);
  if(!amp0.ok){return hr_fail();}
  let amp:IvTaylor4Result=ivtm4_rebase_dyadic(amp0.value,128);
  if(!amp.ok){return hr_fail();}
  return new HrState(true,s.chart,ivtm4_clone(z.value),ivtm4_clone(amp.value));
}

fn hr_step_any(phi:borrow IvTaylor4Mat,s:borrow HrState)->HrState{
  let direct:HrState=hr_step(phi,s);
  if(direct.ok){
    return new HrState(true,direct.chart,ivtm4_clone(direct.z),
      ivtm4_clone(direct.amplitude));
  }
  let best:HrState=hr_fail();let c:i64=0;while(c<20){
    let charted:HrState=hr_rechart(s,c);
    if(charted.ok){
      let stepped:HrState=hr_step(phi,charted);
      if(stepped.ok && (!best.ok || hr_norm(stepped.z)<hr_norm(best.z))){
        best=new HrState(true,stepped.chart,ivtm4_clone(stepped.z),
          ivtm4_clone(stepped.amplitude));
      }
      drop(stepped);
    }
    drop(charted);c=c+1;
  }
  return best;
}

fn hr_gauge()->IvTaylor4Mat{
  let s:QMat=qm_new(6,6);let i:i64=0;while(i<6){
    s=qm_set(s,i,i,rat(1,1));i=i+1;}
  s=qm_set(s,0,1,rat(1,2));s=qm_set(s,1,2,rat(1,3));
  s=qm_set(s,3,4,rat(1,2));s=qm_set(s,4,5,rat(1,3));
  return ivtm4_constant(7315,s);
}

fn hr_gauge_covariant(s:borrow HrState)->bool{
  let recon:HrSolve=hr_reconstruct(s);
  if(!recon.ok){return false;}
  let gamp0:IvTaylor4Result=ivtm4_mul_checked(s.amplitude,hr_gauge());
  if(!gamp0.ok){return false;}
  let gamp:IvTaylor4Result=ivtm4_rebase_dyadic(gamp0.value,128);
  if(!gamp.ok){return false;}
  let gs:HrState=new HrState(true,s.chart,ivtm4_clone(s.z),
    ivtm4_clone(gamp.value));
  let grecon:HrSolve=hr_reconstruct(gs);
  if(!grecon.ok){return false;}
  let expected:IvTaylor4Result=ivtm4_mul_checked(recon.value,hr_gauge());
  if(!expected.ok){return false;}
  let defect:IvTaylor4Result=ivtm4_sub_checked(grecon.value,expected.value);
  return defect.ok && hr_contains_zero(defect.value);
}


fn hr_max_width(a:borrow IvTaylor4Mat)->f64{
  let h:IvMat=ivtm4_hull(a);let best:f64=0.0;let i:i64=0;
  while(i<a.rows){let j:i64=0;while(j<a.cols){
    let x:Iv=ivm_at(h,i,j);let w:f64=x.hi-x.lo;
    if(w>best){best=w;}j=j+1;}i=i+1;}return best;
}


fn hr_reorder_rows(a:borrow IvTaylor4Mat,to_block:bool)->IvTaylor4Mat{
  let c0:QMat=qm_new(12,a.cols);let c1:QMat=qm_new(12,a.cols);
  let c2:QMat=qm_new(12,a.cols);let c3:QMat=qm_new(12,a.cols);
  let c4:QMat=qm_new(12,a.cols);let rem:IvMat=ivm_zeros(12,a.cols);
  let i:i64=0;while(i<12){
    let si:i64=if(to_block){
      if(i<8){if(i<4){i}else{i+2}}else{if(i<10){i-4}else{i}}
    }else{
      if(i<4){i}else{if(i<6){8+i-4}else{if(i<10){4+i-6}else{i}}}
    };
    let j:i64=0;while(j<a.cols){
      c0=qm_set(c0,i,j,qm_get(a.c0,si,j));
      c1=qm_set(c1,i,j,qm_get(a.c1,si,j));
      c2=qm_set(c2,i,j,qm_get(a.c2,si,j));
      c3=qm_set(c3,i,j,qm_get(a.c3,si,j));
      c4=qm_set(c4,i,j,qm_get(a.c4,si,j));
      ivm_set(rem,i,j,ivm_at(a.remainder,si,j));j=j+1;}i=i+1;}
  let out:IvTaylor4Result=ivtm4_new(
    a.generator,c0,c1,c2,c3,c4,rem);
  if(!out.ok){trap();}return ivtm4_clone(out.value);
}

fn hr_at_r4(a:borrow IvTaylor4Mat)->HrSolve{
  let s:QMat=qm_new(12,12);let i:i64=0;while(i<12){
    s=qm_set(s,i,i,if(i==5 || i==11){rat(1,2)}else{rat(1,1)});
    i=i+1;}
  let z:IvTaylor4Result=ivtm4_mul_checked(ivtm4_constant(7315,s),a);
  if(!z.ok){return new HrSolve(false,hr_zero());}
  let rb:IvTaylor4Result=ivtm4_rebase_dyadic(z.value,128);
  if(!rb.ok){return new HrSolve(false,hr_zero());}
  return new HrSolve(true,ivtm4_clone(rb.value));
}


fn hr_emit(a:borrow IvTaylor4Mat)->void{
  let h:IvMat=ivtm4_hull(a);let i:i64=0;while(i<12){
    let j:i64=0;while(j<6){
      let c0:String=rat_str(qm_get(a.c0,i,j));
      let c1:String=rat_str(qm_get(a.c1,i,j));
      let c2:String=rat_str(qm_get(a.c2,i,j));
      let c3:String=rat_str(qm_get(a.c3,i,j));
      let c4:String=rat_str(qm_get(a.c4,i,j));
      let r:Iv=ivm_at(a.remainder,i,j);let q:Iv=ivm_at(h,i,j);
      println(strfmt(system_allocator(),
        "T4 {} {} {} {} {} {} {} {} {} {} {}",
        [i,j,str_view(c0),str_view(c1),str_view(c2),str_view(c3),
         str_view(c4),f64_bits(r.lo),f64_bits(r.hi),
         f64_bits(q.lo),f64_bits(q.hi)]));
      drop(c0);drop(c1);drop(c2);drop(c3);drop(c4);j=j+1;}i=i+1;}
}

fn hr_coeff(shell:i64,panel:i64,tbox:Iv)->IvAffineMat{
  return if(shell==0){ht_coeff_0(panel,tbox)} else if(shell==1){ht_coeff_1(panel,tbox)} else if(shell==2){ht_coeff_2(panel,tbox)} else if(shell==3){ht_coeff_3(panel,tbox)} else if(shell==4){ht_coeff_4(panel,tbox)} else if(shell==5){ht_coeff_5(panel,tbox)} else if(shell==6){ht_coeff_6(panel,tbox)} else if(shell==7){ht_coeff_7(panel,tbox)} else if(shell==8){ht_coeff_8(panel,tbox)} else if(shell==9){ht_coeff_9(panel,tbox)} else if(shell==10){ht_coeff_10(panel,tbox)} else if(shell==11){ht_coeff_11(panel,tbox)} else if(shell==12){ht_coeff_12(panel,tbox)} else if(shell==13){ht_coeff_13(panel,tbox)} else if(shell==14){ht_coeff_14(panel,tbox)} else if(shell==15){ht_coeff_15(panel,tbox)} else if(shell==16){ht_coeff_16(panel,tbox)} else if(shell==17){ht_coeff_17(panel,tbox)} else if(shell==18){ht_coeff_18(panel,tbox)} else if(shell==19){ht_coeff_19(panel,tbox)} else if(shell==20){ht_coeff_20(panel,tbox)} else if(shell==21){ht_coeff_21(panel,tbox)} else {ht_coeff_22(panel,tbox)};
}
fn hr_shell_lo(shell:i64)->Rat{return if(shell==0){big("1/4194304")} else if(shell==1){big("1/2097152")} else if(shell==2){big("1/1048576")} else if(shell==3){big("1/524288")} else if(shell==4){big("1/262144")} else if(shell==5){big("1/131072")} else if(shell==6){big("1/65536")} else if(shell==7){big("1/32768")} else if(shell==8){big("1/16384")} else if(shell==9){big("1/8192")} else if(shell==10){big("1/4096")} else if(shell==11){big("1/2048")} else if(shell==12){big("1/1024")} else if(shell==13){big("1/512")} else if(shell==14){big("1/256")} else if(shell==15){big("1/128")} else if(shell==16){big("1/64")} else if(shell==17){big("1/32")} else if(shell==18){big("1/16")} else if(shell==19){big("1/8")} else if(shell==20){big("1/4")} else if(shell==21){big("1/2")} else {big("1/1")};}
fn hr_panel_width(shell:i64)->Rat{return if(shell==0){big("1/1073741824")} else if(shell==1){big("1/536870912")} else if(shell==2){big("1/268435456")} else if(shell==3){big("1/134217728")} else if(shell==4){big("1/67108864")} else if(shell==5){big("1/33554432")} else if(shell==6){big("1/16777216")} else if(shell==7){big("1/8388608")} else if(shell==8){big("1/4194304")} else if(shell==9){big("1/2097152")} else if(shell==10){big("1/1048576")} else if(shell==11){big("1/524288")} else if(shell==12){big("1/262144")} else if(shell==13){big("1/131072")} else if(shell==14){big("1/65536")} else if(shell==15){big("1/32768")} else if(shell==16){big("1/16384")} else if(shell==17){big("1/8192")} else if(shell==18){big("1/4096")} else if(shell==19){big("1/2048")} else if(shell==20){big("1/1024")} else if(shell==21){big("1/512")} else {big("1/256")};}

fn hr_cell()->IvAffineCell{
  return match(iva_cell(7315,big("4097/8192"),
    big("1/8192"))){
    some(z)=>z,none=>{trap();}};
}




pub type H4Result = scoped struct {
  pub ok: bool,
  pub value: IvTaylor4Mat,
  pub refusal_code: i64,
};

pub type H4Scalar = value struct {
  pub ok: bool,
  pub value: f64,
  pub refusal_code: i64,
};

pub type H4Stats = value struct {
  pub ok: bool,
  pub norm: f64,
  pub width: f64,
  pub refusal_code: i64,
};

fn h4_result(a:borrow IvTaylor4Result)->H4Result{
  return new H4Result(a.ok,ivtm4_clone(a.value),a.refusal_code);
}

fn h4_result_fail(code:i64)->H4Result{
  return new H4Result(false,hr_zero(),code);
}

fn h4_mul_checked(a:borrow IvTaylor4Mat,b:borrow IvTaylor4Mat)->H4Result{
  let z:IvTaylor4Result=ivtm4_mul_checked(a,b);
  return h4_result(z);
}

fn h4_stats(a:borrow IvTaylor4Mat)->H4Stats{
  let hull:IvMat=match(ivtm4_hull_checked(a)){
    some(z)=>z,
    none=>{return H4Stats(false,0.0,0.0,IVTAY_INTERVAL_OVERFLOW);}
  };
  let norm:f64=0.0;let width:f64=0.0;
  let i:i64=0;while(i<a.rows){let j:i64=0;while(j<a.cols){
    let x:Iv=ivm_at(hull,i,j);let ax:Iv=iv_abs(x);
    if(ax.hi>norm){norm=ax.hi;}
    let w:f64=x.hi-x.lo;if(!f64_is_finite(w)){
      return H4Stats(false,0.0,0.0,IVTAY_INTERVAL_OVERFLOW);}
    if(w>width){width=w;}j=j+1;}i=i+1;}
  return H4Stats(true,norm,width,IVTAY_OK);
}

fn h4_from_affine(a:borrow IvAffineMat)->IvTaylor4Mat{
  return ivtm4_from_degree2(ivtm_from_affine(a));
}

fn h4_pad_checked(a:borrow IvTaylor4Mat,radius:f64)->H4Result{
  if(radius<0.0 || !f64_is_finite(radius)){
    return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  let rem:IvMat=ivm_zeros(a.rows,a.cols);
  let i:i64=0;while(i<a.rows){let j:i64=0;while(j<a.cols){
    let padded:Iv=match(iv_add_checked(
      ivm_at(a.remainder,i,j),iv(-radius,radius))){
      some(z)=>z,
      none=>{return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
    };
    ivm_set(rem,i,j,padded);
    j=j+1;}i=i+1;}
  let z:IvTaylor4Result=ivtm4_new(a.generator,a.c0,a.c1,a.c2,a.c3,a.c4,rem);
  return h4_result(z);
}

fn h4_block_lower(wc:borrow IvTaylor4Mat,lower:borrow IvTaylor4Mat,
wk:borrow IvTaylor4Mat)->H4Result{
  if(wc.rows!=8 || wc.cols!=8 || lower.rows!=4 || lower.cols!=8 ||
     wk.rows!=4 || wk.cols!=4 || wc.generator!=wk.generator ||
     wc.generator!=lower.generator){
    return h4_result_fail(IVTAY_BAD_SHAPE);}
  let c0:QMat=qm_new(12,12);let c1:QMat=qm_new(12,12);
  let c2:QMat=qm_new(12,12);let c3:QMat=qm_new(12,12);
  let c4:QMat=qm_new(12,12);let rem:IvMat=ivm_zeros(12,12);
  let i:i64=0;while(i<8){let j:i64=0;while(j<8){
    c0=qm_set(c0,i,j,qm_get(wc.c0,i,j));
    c1=qm_set(c1,i,j,qm_get(wc.c1,i,j));
    c2=qm_set(c2,i,j,qm_get(wc.c2,i,j));
    c3=qm_set(c3,i,j,qm_get(wc.c3,i,j));
    c4=qm_set(c4,i,j,qm_get(wc.c4,i,j));
    ivm_set(rem,i,j,ivm_at(wc.remainder,i,j));j=j+1;}i=i+1;}
  i=0;while(i<4){let j:i64=0;while(j<8){
    c0=qm_set(c0,i+8,j,qm_get(lower.c0,i,j));
    c1=qm_set(c1,i+8,j,qm_get(lower.c1,i,j));
    c2=qm_set(c2,i+8,j,qm_get(lower.c2,i,j));
    c3=qm_set(c3,i+8,j,qm_get(lower.c3,i,j));
    c4=qm_set(c4,i+8,j,qm_get(lower.c4,i,j));
    ivm_set(rem,i+8,j,ivm_at(lower.remainder,i,j));j=j+1;}
    let k:i64=0;while(k<4){
      c0=qm_set(c0,i+8,k+8,qm_get(wk.c0,i,k));
      c1=qm_set(c1,i+8,k+8,qm_get(wk.c1,i,k));
      c2=qm_set(c2,i+8,k+8,qm_get(wk.c2,i,k));
      c3=qm_set(c3,i+8,k+8,qm_get(wk.c3,i,k));
      c4=qm_set(c4,i+8,k+8,qm_get(wk.c4,i,k));
      ivm_set(rem,i+8,k+8,ivm_at(wk.remainder,i,k));k=k+1;}
    i=i+1;}
  let z:IvTaylor4Result=ivtm4_new(wc.generator,c0,c1,c2,c3,c4,rem);
  return h4_result(z);
}

// Quartic Peano--Baker panel.  Every shared-omega coefficient through C4 is
// retained; only C5+ and the analytic exponential tail enter the remainder.
fn h4_local_transition(a:borrow IvAffineMat,h:borrow Rat,
order:i64)->H4Result{
  if(a.rows!=12 || a.cols!=12 || a.generator!=gc_cell().generator ||
     rat_sign(h)<=0 || order<1){return h4_result_fail(IVTAY_BAD_SHAPE);}
  let ac:IvTaylor4Mat=h4_from_affine(gc_affine_submatrix(a,0));
  let ak:IvTaylor4Mat=h4_from_affine(gc_affine_submatrix(a,1));
  let g:IvTaylor4Mat=h4_from_affine(gc_affine_submatrix(a,2));
  let sc:IvTaylor4Mat=ivtm4_identity(a.generator,8);
  let sk:IvTaylor4Mat=ivtm4_identity(a.generator,4);
  let sl:IvTaylor4Mat=ivtm4_constant(a.generator,qm_new(4,8));
  let pc:IvTaylor4Mat=ivtm4_identity(a.generator,8);
  let pk:IvTaylor4Mat=ivtm4_identity(a.generator,4);
  let pl:IvTaylor4Mat=ivtm4_constant(a.generator,qm_new(4,8));
  let coeff:Rat=rat(1,1);let n:i64=1;
  while(n<=order){
    let rc:IvTaylor4Result=ivtm4_mul_checked(ac,pc);
    let rk:IvTaylor4Result=ivtm4_mul_checked(ak,pk);
    let lg:IvTaylor4Result=ivtm4_mul_checked(g,pc);
    let lk:IvTaylor4Result=ivtm4_mul_checked(ak,pl);
    if(!rc.ok){return h4_result(rc);}
    if(!rk.ok){return h4_result(rk);}
    if(!lg.ok){return h4_result(lg);}
    if(!lk.ok){return h4_result(lk);}
    let rl:IvTaylor4Result=ivtm4_add_checked(lg.value,lk.value);
    if(!rl.ok){return h4_result(rl);}
    pc=ivtm4_clone(rc.value);pk=ivtm4_clone(rk.value);
    pl=ivtm4_clone(rl.value);
    coeff=(rat_clone(coeff)*rat_clone(h))/rat(n,1);
    let pc_scaled:IvTaylor4Result=ivtm4_scale_rat_checked(pc,coeff);
    let pk_scaled:IvTaylor4Result=ivtm4_scale_rat_checked(pk,coeff);
    let pl_scaled:IvTaylor4Result=ivtm4_scale_rat_checked(pl,coeff);
    if(!pc_scaled.ok){return h4_result(pc_scaled);}
    if(!pk_scaled.ok){return h4_result(pk_scaled);}
    if(!pl_scaled.ok){return h4_result(pl_scaled);}
    let qc:IvTaylor4Result=ivtm4_add_checked(sc,pc_scaled.value);
    let qk:IvTaylor4Result=ivtm4_add_checked(sk,pk_scaled.value);
    let ql:IvTaylor4Result=ivtm4_add_checked(sl,pl_scaled.value);
    if(!qc.ok){return h4_result(qc);}
    if(!qk.ok){return h4_result(qk);}
    if(!ql.ok){return h4_result(ql);}
    sc=ivtm4_clone(qc.value);sk=ivtm4_clone(qk.value);
    sl=ivtm4_clone(ql.value);n=n+1;
  }
  let ach:IvMat=match(ivtm4_hull_checked(ac)){
    some(z)=>z,
    none=>{return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  };
  let akh:IvMat=match(ivtm4_hull_checked(ak)){
    some(z)=>z,
    none=>{return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  };
  let gh:IvMat=match(ivtm4_hull_checked(g)){
    some(z)=>z,
    none=>{return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  };
  let alphac:f64=sl_inf_norm_hi(ach);
  let alphak:f64=sl_inf_norm_hi(akh);
  let beta:f64=sl_inf_norm_hi(gh);
  if(alphac<0.0 || alphak<0.0 || beta<0.0){
    return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  let hf:f64=rat_to_f64(h);
  let tc:f64=sl_exp_tail(hf*alphac,order+1);
  let tk:f64=sl_exp_tail(hf*alphak,order+1);
  let aa:f64=if(alphac>alphak){alphac}else{alphak};
  let tl:f64=beta*hf*sl_exp_tail(hf*aa,order);
  if(tc<0.0 || tk<0.0 || tl<0.0 ||
     !f64_is_finite(tc) || !f64_is_finite(tk) || !f64_is_finite(tl)){
    return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  let pcorr:H4Result=h4_pad_checked(sc,tc);
  if(!pcorr.ok){return pcorr;}
  let pkorr:H4Result=h4_pad_checked(sk,tk);
  if(!pkorr.ok){return pkorr;}
  let plorr:H4Result=h4_pad_checked(sl,tl);
  if(!plorr.ok){return plorr;}
  return h4_block_lower(pcorr.value,plorr.value,pkorr.value);
}

fn h4_full_rank(a:borrow IvTaylor4Mat,cells:i64)->bool{
  if(a.rows!=a.cols || cells<=0){return false;}
  let parent:IvTaylorCell=match(
    ivt_cell(a.generator,rat(0,1),rat(1,1))){
    some(z)=>z,none=>{return false;}};
  let cell:i64=0;while(cell<cells){
    let mid:Rat=rat(-1,1)+rat(2*cell+1,cells);
    let child:IvTaylorCell=match(
      ivt_cell(a.generator,mid,rat(1,cells))){
      some(z)=>z,none=>{return false;}};
    let rr:IvTaylor4Result=ivtm4_restrict(a,parent,child);
    if(!rr.ok || qm_rank(rr.value.c0)!=a.cols){return false;}
    let inv:IvTaylor4Result=ivtm4_solve_left(
      rr.value,ivtm4_identity(a.generator,a.rows));
    if(!inv.ok){return false;}cell=cell+1;
  }
  return true;
}

fn h4_at_r4(a:borrow IvTaylor4Mat)->H4Result{
  let s:QMat=qm_new(12,12);let i:i64=0;while(i<12){
    s=qm_set(s,i,i,if(i==5 || i==11){rat(1,2)}else{rat(1,1)});
    i=i+1;}
  let z:IvTaylor4Result=ivtm4_mul_checked(ivtm4_constant(7315,s),a);
  if(!z.ok){return h4_result(z);}
  let rb:IvTaylor4Result=ivtm4_rebase_dyadic(z.value,128);
  return h4_result(rb);
}

pub type PlCx = scoped struct {
  pub ok: bool,
  pub re: IvTaylor4Mat,
  pub im: IvTaylor4Mat,
  pub refusal_code: i64,
};

pub type PlCheck = value struct {
  pub ok: bool,
  pub refusal_code: i64,
};

pub type PlPivot = value struct {
  pub ok: bool,
  pub index: i64,
  pub margin: f64,
  pub norm: f64,
  pub refusal_code: i64,
};

pub type PlState = scoped struct {
  pub ok: bool,
  pub value: IvTaylor4Mat,
  pub pivot: i64,
  pub margin: f64,
  pub norm: f64,
  pub scale_exponent: i64,
  pub refusal_code: i64,
};

fn pl_zero(rows:i64,cols:i64)->IvTaylor4Mat{
  return ivtm4_constant(7315,qm_new(rows,cols));
}

fn pl_fail(code:i64)->PlState{
  return new PlState(false,pl_zero(40,1),-1,0.0,0.0,0,code);
}

fn pl_scalar(a:borrow IvTaylor4Mat,row:i64,col:i64)->IvTaylor4Mat{
  let c0:QMat=qm_new(1,1);let c1:QMat=qm_new(1,1);
  let c2:QMat=qm_new(1,1);let c3:QMat=qm_new(1,1);
  let c4:QMat=qm_new(1,1);let rem:IvMat=ivm_zeros(1,1);
  c0=qm_set(c0,0,0,qm_get(a.c0,row,col));
  c1=qm_set(c1,0,0,qm_get(a.c1,row,col));
  c2=qm_set(c2,0,0,qm_get(a.c2,row,col));
  c3=qm_set(c3,0,0,qm_get(a.c3,row,col));
  c4=qm_set(c4,0,0,qm_get(a.c4,row,col));
  ivm_set(rem,0,0,ivm_at(a.remainder,row,col));
  let out:IvTaylor4Result=ivtm4_new(
    a.generator,c0,c1,c2,c3,c4,rem);
  if(!out.ok){return pl_zero(1,1);}
  return ivtm4_clone(out.value);
}

fn pl_czero(generator:i64)->PlCx{
  return new PlCx(true,ivtm4_constant(generator,qm_new(1,1)),
    ivtm4_constant(generator,qm_new(1,1)),IVTAY_OK);
}

fn pl_cfail(generator:i64,code:i64)->PlCx{
  return new PlCx(false,ivtm4_constant(generator,qm_new(1,1)),
    ivtm4_constant(generator,qm_new(1,1)),code);
}

fn pl_centry(y:borrow IvTaylor4Mat,row:i64,col:i64)->PlCx{
  let rr:i64=if(row<4){row}else{row+4};
  let ri:i64=if(row<4){row+4}else{row+6};
  return new PlCx(true,pl_scalar(y,rr,col),pl_scalar(y,ri,col),IVTAY_OK);
}

fn pl_coord(y:borrow IvTaylor4Mat,index:i64)->PlCx{
  return new PlCx(true,pl_scalar(y,index,0),
    pl_scalar(y,index+20,0),IVTAY_OK);
}

fn pl_cmul(a:borrow PlCx,b:borrow PlCx)->PlCx{
  if(!a.ok){return pl_cfail(a.re.generator,a.refusal_code);}
  if(!b.ok){return pl_cfail(b.re.generator,b.refusal_code);}
  let rr:IvTaylor4Result=ivtm4_mul_checked(a.re,b.re);
  let ii:IvTaylor4Result=ivtm4_mul_checked(a.im,b.im);
  let ri:IvTaylor4Result=ivtm4_mul_checked(a.re,b.im);
  let ir:IvTaylor4Result=ivtm4_mul_checked(a.im,b.re);
  if(!rr.ok){return pl_cfail(a.re.generator,rr.refusal_code);}
  if(!ii.ok){return pl_cfail(a.re.generator,ii.refusal_code);}
  if(!ri.ok){return pl_cfail(a.re.generator,ri.refusal_code);}
  if(!ir.ok){return pl_cfail(a.re.generator,ir.refusal_code);}
  let real:IvTaylor4Result=ivtm4_sub_checked(rr.value,ii.value);
  let imag:IvTaylor4Result=ivtm4_add_checked(ri.value,ir.value);
  if(!real.ok){return pl_cfail(a.re.generator,real.refusal_code);}
  if(!imag.ok){return pl_cfail(a.re.generator,imag.refusal_code);}
  return new PlCx(true,ivtm4_clone(real.value),
    ivtm4_clone(imag.value),IVTAY_OK);
}

fn pl_cadd_signed(a:borrow PlCx,b:borrow PlCx,sign:i64)->PlCx{
  if(!a.ok){return pl_cfail(a.re.generator,a.refusal_code);}
  if(!b.ok){return pl_cfail(b.re.generator,b.refusal_code);}
  let rr:IvTaylor4Result=if(sign>0){
    ivtm4_add_checked(a.re,b.re)
  }else{ivtm4_sub_checked(a.re,b.re)};
  let ii:IvTaylor4Result=if(sign>0){
    ivtm4_add_checked(a.im,b.im)
  }else{ivtm4_sub_checked(a.im,b.im)};
  if(!rr.ok){return pl_cfail(a.re.generator,rr.refusal_code);}
  if(!ii.ok){return pl_cfail(a.re.generator,ii.refusal_code);}
  return new PlCx(true,ivtm4_clone(rr.value),
    ivtm4_clone(ii.value),IVTAY_OK);
}

fn pl_cmul3(a:borrow PlCx,b:borrow PlCx,c:borrow PlCx)->PlCx{
  let ab:PlCx=pl_cmul(a,b);
  if(!ab.ok){return ab;}
  return pl_cmul(ab,c);
}

fn pl_minor3(y:borrow IvTaylor4Mat,i:i64,j:i64,k:i64)->PlCx{
  let out:PlCx=pl_czero(y.generator);
  let t0:PlCx=pl_cmul3(
    pl_centry(y,i,0),pl_centry(y,j,1),pl_centry(y,k,2));
  out=pl_cadd_signed(out,t0,1);
  let t1:PlCx=pl_cmul3(
    pl_centry(y,i,1),pl_centry(y,j,2),pl_centry(y,k,0));
  out=pl_cadd_signed(out,t1,1);
  let t2:PlCx=pl_cmul3(
    pl_centry(y,i,2),pl_centry(y,j,0),pl_centry(y,k,1));
  out=pl_cadd_signed(out,t2,1);
  let t3:PlCx=pl_cmul3(
    pl_centry(y,i,2),pl_centry(y,j,1),pl_centry(y,k,0));
  out=pl_cadd_signed(out,t3,-1);
  let t4:PlCx=pl_cmul3(
    pl_centry(y,i,1),pl_centry(y,j,0),pl_centry(y,k,2));
  out=pl_cadd_signed(out,t4,-1);
  let t5:PlCx=pl_cmul3(
    pl_centry(y,i,0),pl_centry(y,j,2),pl_centry(y,k,1));
  out=pl_cadd_signed(out,t5,-1);
  return out;
}

fn pl_embed(z:borrow PlCx,index:i64)->H4Result{
  if(!z.ok){return h4_result_fail(z.refusal_code);}
  let c0:QMat=qm_new(40,1);let c1:QMat=qm_new(40,1);
  let c2:QMat=qm_new(40,1);let c3:QMat=qm_new(40,1);
  let c4:QMat=qm_new(40,1);let rem:IvMat=ivm_zeros(40,1);
  c0=qm_set(c0,index,0,qm_get(z.re.c0,0,0));
  c1=qm_set(c1,index,0,qm_get(z.re.c1,0,0));
  c2=qm_set(c2,index,0,qm_get(z.re.c2,0,0));
  c3=qm_set(c3,index,0,qm_get(z.re.c3,0,0));
  c4=qm_set(c4,index,0,qm_get(z.re.c4,0,0));
  ivm_set(rem,index,0,ivm_at(z.re.remainder,0,0));
  c0=qm_set(c0,index+20,0,qm_get(z.im.c0,0,0));
  c1=qm_set(c1,index+20,0,qm_get(z.im.c1,0,0));
  c2=qm_set(c2,index+20,0,qm_get(z.im.c2,0,0));
  c3=qm_set(c3,index+20,0,qm_get(z.im.c3,0,0));
  c4=qm_set(c4,index+20,0,qm_get(z.im.c4,0,0));
  ivm_set(rem,index+20,0,ivm_at(z.im.remainder,0,0));
  let out:IvTaylor4Result=ivtm4_new(
    z.re.generator,c0,c1,c2,c3,c4,rem);
  return h4_result(out);
}

fn pl_initial_placeholder(y:borrow IvTaylor4Mat)->H4Result{
  if(y.rows!=12 || y.cols<3){return h4_result_fail(IVTAY_BAD_SHAPE);}
  let out:IvTaylor4Mat=pl_zero(40,1);
  let index:i64=0;
  while(index<20){
    let i:i64=if(index<10){if(index<4){0}else{if(index<7){1}else{2}}}
      else{if(index<16){if(index<13){0}else{1}}else{if(index<19){0}else{3}}};
    // The generated caller replaces this function with explicit triples.
    index=index+1;
  }
  return h4_result_fail(34);
}

fn pl_c_contains_zero(a:borrow PlCx)->bool{
  if(!a.ok){return false;}
  let rh:IvMat=match(ivtm4_hull_checked(a.re)){
    some(z)=>z,none=>{return false;}};
  let ih:IvMat=match(ivtm4_hull_checked(a.im)){
    some(z)=>z,none=>{return false;}};
  let r:Iv=ivm_at(rh,0,0);let i:Iv=ivm_at(ih,0,0);
  return r.lo<=0.0 && r.hi>=0.0 && i.lo<=0.0 && i.hi>=0.0;
}

fn pl_complex_linear(a:borrow IvTaylor4Mat)->PlCheck{
  let h:IvMat=match(ivtm4_hull_checked(a)){
    some(z)=>z,none=>{return PlCheck(false,IVTAY_INTERVAL_OVERFLOW);}};
  let i:i64=0;while(i<6){let j:i64=0;while(j<6){
    let ri:i64=i;let ii:i64=i+6;
    let rj:i64=j;let ij:i64=j+6;
    let d0:Iv=match(iv_sub_checked(ivm_at(h,ri,rj),ivm_at(h,ii,ij))){
      some(z)=>z,none=>{return PlCheck(false,IVTAY_INTERVAL_OVERFLOW);}};
    let d1:Iv=match(iv_add_checked(ivm_at(h,ii,rj),ivm_at(h,ri,ij))){
      some(z)=>z,none=>{return PlCheck(false,IVTAY_INTERVAL_OVERFLOW);}};
    if(d0.lo>0.0 || d0.hi<0.0 || d1.lo>0.0 || d1.hi<0.0){
      return PlCheck(false,33);}
    j=j+1;}i=i+1;}
  return PlCheck(true,IVTAY_OK);
}

fn pl_pivot(a:borrow IvTaylor4Mat)->PlPivot{
  let h:IvMat=match(ivtm4_hull_checked(a)){
    some(z)=>z,none=>{return PlPivot(false,-1,0.0,0.0,
      IVTAY_INTERVAL_OVERFLOW);}};
  let best:i64=-1;let margin:f64=0.0;let norm:f64=0.0;
  let i:i64=0;while(i<20){
    let re:Iv=ivm_at(h,i,0);let im:Iv=ivm_at(h,i+20,0);
    let ar:Iv=iv_abs(re);let ai:Iv=iv_abs(im);
    if(ar.hi>norm){norm=ar.hi;}if(ai.hi>norm){norm=ai.hi;}
    let mr:f64=if(re.lo>0.0){re.lo}else{if(re.hi<0.0){0.0-re.hi}else{0.0}};
    let mi:f64=if(im.lo>0.0){im.lo}else{if(im.hi<0.0){0.0-im.hi}else{0.0}};
    let candidate:f64=if(mr>mi){mr}else{mi};
    if(candidate>margin){margin=candidate;best=i;}
    i=i+1;
  }
  if(best<0 || margin<=0.0){return PlPivot(false,-1,0.0,norm,32);}
  return PlPivot(true,best,margin,norm,IVTAY_OK);
}

fn pl_projective_normalize(a:borrow IvTaylor4Mat)->PlState{
  let before:PlPivot=pl_pivot(a);
  if(!before.ok){return pl_fail(before.refusal_code);}
  if(before.norm<=0.0 || !f64_is_finite(before.norm)){
    return pl_fail(IVTAY_INTERVAL_OVERFLOW);}
  let scale:Rat=rat(1,1);let exponent:i64=0;let n:f64=before.norm;
  while(n>1.0 && exponent<1024){
    scale=rat_clone(scale)/rat(2,1);n=n/2.0;exponent=exponent+1;}
  while(n<0.5 && exponent>(-1024)){
    scale=rat_clone(scale)*rat(2,1);n=n*2.0;exponent=exponent-1;}
  if(exponent==1024 || exponent==(-1024)){
    return pl_fail(IVTAY_INTERVAL_OVERFLOW);}
  let scaled:IvTaylor4Result=ivtm4_scale_rat_checked(a,scale);
  if(!scaled.ok){return pl_fail(scaled.refusal_code);}
  let rebased:IvTaylor4Result=ivtm4_rebase_dyadic(scaled.value,160);
  if(!rebased.ok){return pl_fail(rebased.refusal_code);}
  let after:PlPivot=pl_pivot(rebased.value);
  if(!after.ok){return pl_fail(after.refusal_code);}
  return new PlState(true,ivtm4_clone(rebased.value),after.index,
    after.margin,after.norm,exponent,IVTAY_OK);
}

fn pl_step(a:borrow IvAffineMat,h:borrow Rat,start:borrow IvTaylor4Mat,
order:i64)->H4Result{
  if(a.rows!=12 || a.cols!=12 || order<1 || rat_sign(h)<=0){
    return h4_result_fail(IVTAY_BAD_SHAPE);}
  let at:IvTaylor4Mat=h4_from_affine(a);
  let linear:PlCheck=pl_complex_linear(at);
  if(!linear.ok){return h4_result_fail(linear.refusal_code);}
  let induced:H4Result=pl_induced(at);
  if(!induced.ok){return induced;}
  let bh:IvMat=match(ivtm4_hull_checked(induced.value)){
    some(z)=>z,none=>{return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}};
  let alpha:f64=sl_inf_norm_hi(bh);
  let start_stats:H4Stats=h4_stats(start);
  if(!start_stats.ok || alpha<0.0){
    return h4_result_fail(IVTAY_INTERVAL_OVERFLOW);}
  let sum:IvTaylor4Mat=ivtm4_clone(start);
  let power:IvTaylor4Mat=ivtm4_clone(start);
  let coefficient:Rat=rat(1,1);let n:i64=1;
  while(n<=order){
    let next:IvTaylor4Result=ivtm4_mul_checked(induced.value,power);
    if(!next.ok){return h4_result(next);}
    power=ivtm4_clone(next.value);
    coefficient=(rat_clone(coefficient)*rat_clone(h))/rat(n,1);
    let scaled:IvTaylor4Result=ivtm4_scale_rat_checked(power,coefficient);
    if(!scaled.ok){return h4_result(scaled);}
    let added:IvTaylor4Result=ivtm4_add_checked(sum,scaled.value);
    if(!added.ok){return h4_result(added);}
    sum=ivtm4_clone(added.value);n=n+1;
  }
  let tail:f64=start_stats.norm*
    sl_exp_tail(rat_to_f64(h)*alpha,order+1);
  return h4_pad_checked(sum,tail);
}

fn pl_attempt(shell:i64,segment:i64,cell:borrow IvAffineCell,
start:borrow PlState)->PlState{
  if(!start.ok){return pl_fail(start.refusal_code);}
  let state:PlState=new PlState(true,ivtm4_clone(start.value),
    start.pivot,start.margin,start.norm,start.scale_exponent,IVTAY_OK);
  let count:i64=32;let panel:i64=segment*count;
  while(panel<(segment+1)*count){
    let lo:Rat=hr_shell_lo(shell);
    let width:Rat=hr_panel_width(shell);
    let xc:Rat=rat_clone(lo)+(rat(2*panel+1,2)*rat_clone(width));
    let ta:Iv=iv_from_rat(rat_clone(lo)+rat(panel,1)*rat_clone(width));
    let tb:Iv=iv_from_rat(rat_clone(lo)+rat(panel+1,1)*rat_clone(width));
    let a:IvAffineMat=hc_runtime(
      xc,iv(ta.lo,tb.hi),rat_clone(width)/rat(2,1),cell);
    let stepped:H4Result=pl_step(a,width,state.value,12);
    if(!stepped.ok){return pl_fail(stepped.refusal_code);}
    let normalized:PlState=pl_projective_normalize(stepped.value);
    if(!normalized.ok){return normalized;}
    state=new PlState(true,ivtm4_clone(normalized.value),
      normalized.pivot,normalized.margin,normalized.norm,
      normalized.scale_exponent,IVTAY_OK);
    panel=panel+1;
  }
  return state;
}
pub type PlTerm = value struct {
  pub dest_row:i64,pub dest_col:i64,
  pub source_row:i64,pub source_col:i64,pub sign:i64,
};

fn pl_term(index:i64)->PlTerm{
  return match(index){
    0=>PlTerm(0,0,0,0,1),
    1=>PlTerm(20,20,0,0,1),
    2=>PlTerm(20,0,6,0,1),
    3=>PlTerm(0,20,6,0,-1),
    4=>PlTerm(0,0,1,1,1),
    5=>PlTerm(20,20,1,1,1),
    6=>PlTerm(20,0,7,1,1),
    7=>PlTerm(0,20,7,1,-1),
    8=>PlTerm(0,0,2,2,1),
    9=>PlTerm(20,20,2,2,1),
    10=>PlTerm(20,0,8,2,1),
    11=>PlTerm(0,20,8,2,-1),
    12=>PlTerm(0,1,2,3,1),
    13=>PlTerm(20,21,2,3,1),
    14=>PlTerm(20,1,8,3,1),
    15=>PlTerm(0,21,8,3,-1),
    16=>PlTerm(0,2,2,4,1),
    17=>PlTerm(20,22,2,4,1),
    18=>PlTerm(20,2,8,4,1),
    19=>PlTerm(0,22,8,4,-1),
    20=>PlTerm(0,3,2,5,1),
    21=>PlTerm(20,23,2,5,1),
    22=>PlTerm(20,3,8,5,1),
    23=>PlTerm(0,23,8,5,-1),
    24=>PlTerm(0,4,1,3,-1),
    25=>PlTerm(20,24,1,3,-1),
