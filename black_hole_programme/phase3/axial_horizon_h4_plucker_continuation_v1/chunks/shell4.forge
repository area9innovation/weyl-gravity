  if(!term_0_0.ok){return PlCheck(false,term_0_0.refusal_code);}
  rel_0=pl_cadd_signed(rel_0,term_0_0,1);
  if(!rel_0.ok){return PlCheck(false,rel_0.refusal_code);}
