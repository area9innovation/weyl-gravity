fn pl_initial(y:borrow IvTaylor4Mat)->H4Result{
  if(y.rows!=12 || y.cols<3){
    return h4_result_fail(IVTAY_BAD_SHAPE);}
  let out:IvTaylor4Mat=pl_zero(40,1);
  let minor_0:PlCx=pl_minor3(y,0,1,2);
  if(!minor_0.ok){return h4_result_fail(minor_0.refusal_code);}
  let embedded_0:H4Result=pl_embed(minor_0,0);
  if(!embedded_0.ok){return embedded_0;}
  let added_0:IvTaylor4Result=ivtm4_add_checked(out,embedded_0.value);
  if(!added_0.ok){return h4_result(added_0);}
  out=ivtm4_clone(added_0.value);
  let minor_1:PlCx=pl_minor3(y,0,1,3);
  if(!minor_1.ok){return h4_result_fail(minor_1.refusal_code);}
  let embedded_1:H4Result=pl_embed(minor_1,1);
