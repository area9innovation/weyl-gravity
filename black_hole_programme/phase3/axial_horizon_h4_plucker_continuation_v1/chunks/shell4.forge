  d=qm_set(d,7,1,(big("-2/1")*(big("1/1")/rat_clone(xc))*(big("2/1")+rat_clone(xc))));
  d=qm_set(d,1,7,rat(0,1)-((big("-2/1")*(big("1/1")/rat_clone(xc))*(big("2/1")+rat_clone(xc)))));
  ivm_set(rem,7,1,gc_sym(iv_add(iv_mul(iv_abs(iv_mul(iv_mul(iv_from_rat(big("4/1")),wbox),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),iv_mul(iv_mul(iv_abs(iv_mul(iv_from_rat(big("4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),dw))));
  ivm_set(rem,1,7,gc_sym(iv_add(iv_mul(iv_abs(iv_mul(iv_mul(iv_from_rat(big("4/1")),wbox),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),iv_mul(iv_mul(iv_abs(iv_mul(iv_from_rat(big("4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),dw))));
  c=qm_set(c,7,2,(big("-2/1")*rat_clone(wc)*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc)))));
  c=qm_set(c,1,8,rat(0,1)-((big("-2/1")*rat_clone(wc)*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc))))));
  d=qm_set(d,7,2,(big("-2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc)))));
  d=qm_set(d,1,8,rat(0,1)-((big("-2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc))))));
  ivm_set(rem,7,2,gc_sym(iv_add(iv_mul(iv_abs(iv_mul(iv_mul(iv_mul(iv_mul(iv_from_rat(big("4/1")),wbox),iv_div(iv_point(1.0),iv_mul(xbox,xbox))),iv_div(iv_point(1.0),iv_mul(iv_add(iv_from_rat(big("2/1")),xbox),iv_add(iv_from_rat(big("2/1")),xbox)))),iv_add(iv_from_rat(big("1/1")),xbox))),dx),iv_mul(iv_mul(iv_abs(iv_mul(iv_mul(iv_mul(iv_from_rat(big("4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox))),iv_div(iv_point(1.0),iv_mul(iv_add(iv_from_rat(big("2/1")),xbox),iv_add(iv_from_rat(big("2/1")),xbox)))),iv_add(iv_from_rat(big("1/1")),xbox))),dx),dw))));
