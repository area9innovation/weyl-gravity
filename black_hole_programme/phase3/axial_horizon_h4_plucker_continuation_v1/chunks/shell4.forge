  ivm_set(rem,7,6,gc_sym(iv_mul(iv_abs(iv_mul(iv_mul(iv_mul(iv_from_rat(big("-4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox))),iv_div(iv_point(1.0),iv_mul(iv_mul(iv_add(iv_from_rat(big("2/1")),xbox),iv_add(iv_from_rat(big("2/1")),xbox)),iv_add(iv_from_rat(big("2/1")),xbox)))),iv_add(iv_add(iv_from_rat(big("4/1")),iv_mul(iv_from_rat(big("3/1")),iv_mul(xbox,xbox))),iv_mul(iv_from_rat(big("6/1")),xbox)))),dx)));
