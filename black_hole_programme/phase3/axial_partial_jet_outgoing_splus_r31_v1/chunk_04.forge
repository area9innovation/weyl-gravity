  out=sj_put(out,2,0,jt_mul(jt_mul(jt_const(big("1/1572864")),sj_formal_head_t4),jt_add(jt_add(jt_mul(jt_const(big("3196/1")),sj_formal_head_t0),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("32/1"))),sj_formal_head_t2)),jt_const(big("-783/1")))));
