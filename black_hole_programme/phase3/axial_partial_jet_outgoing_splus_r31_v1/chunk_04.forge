  c1=qm_set(c1,3,0,big("0"));
  c1=qm_set(c1,4,0,big("-"));
  c1=qm_set(c1,5,0,big("-"));
  c1=qm_set(c1,6,0,big("0"));
  c1=qm_set(c1,7,0,big("0"));
  c2=qm_set(c2,0,0,big(""));
  c2=qm_set(c2,1,0,big("-"));
  c2=qm_set(c2,2,0,big("0"));
  c2=qm_set(c2,3,0,big("0"));
  c2=qm_set(c2,4,0,big(""));
  c2=qm_set(c2,5,0,big("-"));
  c2=qm_set(c2,6,0,big("0"));
  c2=qm_set(c2,7,0,big("0"));
  c3=qm_set(c3,0,0,big("-"));
  c3=qm_set(c3,1,0,big(""));
  c3=qm_set(c3,2,0,big("0"));
  c3=qm_set(c3,3,0,big("0"));
  c3=qm_set(c3,4,0,big("-"));
  c3=qm_set(c3,5,0,big("-"));
  c3=qm_set(c3,6,0,big("0"));
  c3=qm_set(c3,7,0,big("0"));
  c4=qm_set(c4,0,0,big(""));
  c4=qm_set(c4,1,0,big("-"));
  c4=qm_set(c4,2,0,big("0"));
  c4=qm_set(c4,3,0,big("0"));
  c4=qm_set(c4,4,0,big(""));
  c4=qm_set(c4,5,0,big("-"));
  c4=qm_set(c4,6,0,big("0"));
  c4=qm_set(c4,7,0,big("0"));
  let rem:IvMat=ivm_zeros(8,1);
  ivm_set(rem,0,0,iv(f64_from_bits(-4580168214635430217),f64_from_bits(4643572295529458412)));
  ivm_set(rem,1,0,iv(f64_from_bits(-4610000734129300599),f64_from_bits(4613520568464888808)));
  ivm_set(rem,2,0,iv(f64_from_bits(-4623808695437235993),f64_from_bits(4599563341417539815)));
  ivm_set(rem,3,0,iv(f64_from_bits(-4627222816488917408),f64_from_bits(4596149220365858400)));
  ivm_set(rem,4,0,iv(f64_from_bits(-4579091398327176604),f64_from_bits(4644682078022021867)));
  ivm_set(rem,5,0,iv(f64_from_bits(-4604430730725042061),f64_from_bits(4616645524260720098)));
  ivm_set(rem,6,0,iv(f64_from_bits(-4623808695437236117),f64_from_bits(4599563341417539691)));
  ivm_set(rem,7,0,iv(f64_from_bits(-4627222816488917591),f64_from_bits(4596149220365858217)));
  return sj_expect(ivtm4_new(7315,c0,c1,c2,c3,c4,rem));
}

pub fn main()->i64{
  let w:IvTaylor4Mat=sj_frequency();
  let base:IvTaylor4Mat=successor_base();
  let tangent_n:IvTaylor4Mat=sc_scale(successor_tangent(),big("1/512"));
  let center:Rat=big("3991/128");
  let h:Rat=big("-1/128");
  let denominator:f64=128.0;
  let panel:i64=0;
  let max_tail:f64=0.0;
  let max_base_width:f64=sj_width(match(ivtm4_hull_checked(base)){
    some(x)=>x,none=>{trap();}});
  let max_normalized_width:f64=sj_width(match(ivtm4_hull_checked(tangent_n)){
    some(x)=>x,none=>{trap();}});
  while(panel<16){
    if(panel==16){
      center=big("3991/128");
      h=big("-1/256");
      denominator=256.0;
    }
    let models:ScModels=sc_build_models(w,sr_radius(center));
    let dual:ScModels=sc_dual_series(models.base,models.tangent,h,12);
    let base_out:IvTaylor4Mat=sj_mul(dual.base,base);
    let tangent_out:IvTaylor4Mat=sc_add(
      sj_mul(dual.tangent,base),sj_mul(dual.base,tangent_n));
    let jet:IvTaylor4Mat=sc_stack(tangent_out,base_out);
    let direct:IvTaylor4Mat=sj_mul(
      sc_series(models.direct,h,12),sc_stack(tangent_n,base));
    let mh:IvMat=match(ivtm4_hull_checked(models.direct)){
      some(x)=>x,none=>{
        println(strfmt(system_allocator(),
          "SPLUS_R31 chunk=4 status=REFUSED panel={} code=MODEL_HULL",[panel]));
        return 3;}};
    let sh:IvMat=match(ivtm4_hull_checked(sc_stack(tangent_n,base))){
      some(x)=>x,none=>{
        println(strfmt(system_allocator(),
          "SPLUS_R31 chunk=4 status=REFUSED panel={} code=SEED_HULL",[panel]));
        return 3;}};
    let alpha:f64=sc_norm(mh);let scaled:f64=alpha/denominator;
    let tail:f64=sc_tail(scaled,13)*sc_norm(sh);
    if(tail<0.0||!f64_is_finite(tail)){
      println(strfmt(system_allocator(),
        "SPLUS_R31 chunk=4 status=REFUSED panel={} code=TAIL",[panel]));
      return 3;
    }
    let jp:IvTaylor4Mat=sc_pad(jet,tail);
    let dp:IvTaylor4Mat=sc_pad(direct,tail);
    if(!sj_coefficients_equal(jp,dp)||!sc_contains_zero(jp,dp)){
      println(strfmt(system_allocator(),
        "SPLUS_R31 chunk=4 status=REFUSED panel={} code=CORRELATION",[panel]));
      return 3;
    }
    tangent_n=sc_unstack_tangent(jp);base=sc_unstack_base(jp);
    let nw:f64=sj_width(match(ivtm4_hull_checked(tangent_n)){
      some(x)=>x,none=>{trap();}});
    let bw:f64=sj_width(match(ivtm4_hull_checked(base)){
      some(x)=>x,none=>{trap();}});
    if(!f64_is_finite(nw)||!f64_is_finite(bw)){
      println(strfmt(system_allocator(),
        "SPLUS_R31 chunk=4 status=REFUSED panel={} code=WIDTH",[panel]));
      return 3;
    }
    if(nw>max_normalized_width){max_normalized_width=nw;}
    if(bw>max_base_width){max_base_width=bw;}
    if(tail>max_tail){max_tail=tail;}
    if(panel<16){center=rat_clone(center)-big("1/128");}
    panel=panel+1;
  }
  let tangent:IvTaylor4Mat=sc_scale(tangent_n,big("512"));
  let final_nw:f64=sj_width(match(ivtm4_hull_checked(tangent_n)){
    some(x)=>x,none=>{trap();}});
  let final_tw:f64=sj_width(match(ivtm4_hull_checked(tangent)){
    some(x)=>x,none=>{trap();}});
  let final_bw:f64=sj_width(match(ivtm4_hull_checked(base)){
    some(x)=>x,none=>{trap();}});
  sr_emit("CHECKPOINT_BASE",base);sr_emit("CHECKPOINT_TANGENT",tangent);
  println(strfmt(system_allocator(),
    "SPLUS_R31 chunk=4 status=PASS generator=7315 panels={} final_r=7951/256 max_tail={} max_base_width={} max_normalized_width={} final_base_width={} final_normalized_width={} final_tangent_width={}",
    [panel,max_tail,max_base_width,max_normalized_width,final_bw,final_nw,
     final_tw]));
  return 0;
}
