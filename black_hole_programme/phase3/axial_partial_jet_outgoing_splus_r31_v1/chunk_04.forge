  c0=qm_set(c0,3,0,big("0"));
  c0=qm_set(c0,4,0,big("-"));
  c0=qm_set(c0,5,0,big("-"));
  c0=qm_set(c0,6,0,big("0"));
  c0=qm_set(c0,7,0,big("0"));
