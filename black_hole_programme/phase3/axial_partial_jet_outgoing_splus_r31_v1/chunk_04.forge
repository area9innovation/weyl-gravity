  c4=qm_set(c4,2,0,big("-"));
  c4=qm_set(c4,3,0,big(""));
  c4=qm_set(c4,4,0,big("-"));
  c4=qm_set(c4,5,0,big(""));
  c4=qm_set(c4,6,0,big("-"));
  c4=qm_set(c4,7,0,big(""));
  let rem:IvMat=ivm_zeros(8,1);
  ivm_set(rem,0,0,iv(f64_from_bits(-4656244006330735262),f64_from_bits(4567415913175294859)));
  ivm_set(rem,1,0,iv(f64_from_bits(-4659692212275765439),f64_from_bits(4562997055570480459)));
  ivm_set(rem,2,0,iv(f64_from_bits(-4663291665395386002),f64_from_bits(4560135357998274831)));
  ivm_set(rem,3,0,iv(f64_from_bits(-4667380929997806144),f64_from_bits(4556014331047574852)));
  ivm_set(rem,4,0,iv(f64_from_bits(-4656243559674283990),f64_from_bits(4566993769980144253)));
  ivm_set(rem,5,0,iv(f64_from_bits(-4663419248542243807),f64_from_bits(4559637653001823453)));
  ivm_set(rem,6,0,iv(f64_from_bits(-4663214769296970530),f64_from_bits(4560241291751385666)));
  ivm_set(rem,7,0,iv(f64_from_bits(-4666210320077458600),f64_from_bits(4556920184666551193)));
  return sj_expect(ivtm4_new(7315,c0,c1,c2,c3,c4,rem));
}
fn successor_tangent()->IvTaylor4Mat{
  let c0:QMat=qm_new(8,1);
  let c1:QMat=qm_new(8,1);
  let c2:QMat=qm_new(8,1);
  let c3:QMat=qm_new(8,1);
  let c4:QMat=qm_new(8,1);
  c0=qm_set(c0,0,0,big("-"));
  c0=qm_set(c0,1,0,big(""));
