  let sc_t25:IvTaylor4Mat=jt_mul(jt_mul(jt_const(big("-1/1")),sc_t20),sc_t24);
  let sc_t26:IvTaylor4Mat=jt_pow(ivtm4_clone(r_model),3);
  let sc_t27:IvTaylor4Mat=jt_mul(sc_t21,sc_t26);
  let sc_t28:IvTaylor4Mat=jt_pow(ivtm4_clone(w_model),4);
  let sc_t29:IvTaylor4Mat=jt_mul(jt_pow(ivtm4_clone(r_model),5),sc_t28);
