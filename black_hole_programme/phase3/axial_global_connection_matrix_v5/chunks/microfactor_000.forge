fn gc_micro_0_frame_3(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_micro_0_frame_3_center(),
    gc_micro_0_frame_3_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

