fn gc_micro_0_frame_0_center() -> QMat {
  let a: QMat = qm_new(12,12);
  a=qm_set(a,0,0,big("1/1"));
  a=qm_set(a,1,1,big("1/1"));
  a=qm_set(a,2,2,big("1/1"));
  a=qm_set(a,3,3,big("1/1"));
  a=qm_set(a,4,4,big("1/1"));
  a=qm_set(a,5,5,big("1/1"));
  a=qm_set(a,6,6,big("1/1"));
  a=qm_set(a,7,7,big("1/1"));
  a=qm_set(a,8,8,big("1/1"));
  a=qm_set(a,9,9,big("1/1"));
  a=qm_set(a,10,10,big("1/1"));
  a=qm_set(a,11,11,big("1/1"));
  return a;
}

fn gc_micro_0_frame_0_derivative() -> QMat {
  let a: QMat = qm_new(12,12);
  return a;
}

fn gc_micro_0_frame_0(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_micro_0_frame_0_center(),
    gc_micro_0_frame_0_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

