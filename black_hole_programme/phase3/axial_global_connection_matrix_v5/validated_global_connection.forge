  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_8_4_center(),
    gc_hshell_frame_8_4_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

