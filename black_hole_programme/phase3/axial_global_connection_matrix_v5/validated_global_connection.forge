  a=qm_set(a,10,10,big("1/1"));
  a=qm_set(a,11,11,big("1/1"));
  return a;
}

fn gc_hshell_frame_3_0_derivative() -> QMat {
  let a: QMat = qm_new(12,12);
  return a;
}

fn gc_hshell_frame_3_0(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_3_0_center(),
    gc_hshell_frame_3_0_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

