fn gc_hshell_frame_4_5(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_4_5_center(),
    gc_hshell_frame_4_5_derivative(),ivm_zeros(12,12));
