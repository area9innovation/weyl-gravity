fn gc_hshell_frame_2_2(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_2_2_center(),
    gc_hshell_frame_2_2_derivative(),ivm_zeros(12,12));
