    true,true,true);
  if(!hf_20.ok){return Option.none;}
  let hz_20:IvAffineResult=ivlin_param_affine_apply_rect(hf_20,y);
  if(!hz_20.ok){return Option.none;}y=ivam_clone(hz_20.value);
  let hf_21:IvLinParamAffineFlow=
    ivlin_param_affine_fundamental_indexed(gc_hshell_coeff_21,
    gc_hshell_frame_dispatch_21,gc_cell(),12,
    big("1/2"),big("1/1"),
    8,2,12,8,
    true,true,true);
  if(!hf_21.ok){return Option.none;}
