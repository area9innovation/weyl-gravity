fn matrices_overlap(a: borrow IvMat, b: borrow IvMat) -> bool {
  let i: i64 = 0;
  while (i < ivm_rows(a)) {
    let j: i64 = 0;
    while (j < ivm_cols(a)) {
      match (iv_meet(ivm_at(a,i,j), ivm_at(b,i,j))) {
        some(_) => {}, none => { return false; },
      }
      j = j + 1;
    }
    i = i + 1;
  }
  return true;
}

