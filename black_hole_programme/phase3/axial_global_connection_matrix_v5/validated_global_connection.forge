fn gc_hshell_frame_17_8(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_17_8_center(),
    gc_hshell_frame_17_8_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn gc_hshell_coeff_17(panel:i64,tbox:Iv)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  let xc:Rat=big("1/32")+
    rat(2*panel+1,1)*big("1/1024");
  return gc_horizon_runtime(xc,tbox,big("1/1024"),c);
}

fn gc_hshell_frame_dispatch_17(k:i64)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  return if(k==0){gc_hshell_frame_17_0(c)} else if(k==1){gc_hshell_frame_17_1(c)} else if(k==2){gc_hshell_frame_17_2(c)} else if(k==3){gc_hshell_frame_17_3(c)} else if(k==4){gc_hshell_frame_17_4(c)} else if(k==5){gc_hshell_frame_17_5(c)} else if(k==6){gc_hshell_frame_17_6(c)} else if(k==7){gc_hshell_frame_17_7(c)} else {gc_hshell_frame_17_8(c)};
}

