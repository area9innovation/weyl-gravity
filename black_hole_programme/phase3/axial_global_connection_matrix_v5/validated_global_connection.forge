fn gc_hshell_frame_0_0_derivative() -> QMat {
  let a: QMat = qm_new(12,12);
  return a;
}

fn gc_hshell_frame_0_0(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_0_0_center(),
    gc_hshell_frame_0_0_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

