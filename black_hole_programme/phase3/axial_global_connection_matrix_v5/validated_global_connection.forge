fn gc_inward_frame_28(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_inward_frame_28_center(),
    gc_inward_frame_28_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn gc_inward_coeff(panel:i64,tbox:Iv)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  let xc:Rat=rat(2*panel+1,128);
  return gc_inward_runtime(xc,tbox,rat(1,128),c);
}

fn gc_inward_carrier_coeff(panel:i64,tv:Iv)->IvAffineMat{
  let a:IvAffineMat=gc_inward_coeff(panel,tv);
  return gc_affine_submatrix(a,0);
}

fn gc_inward_kernel_coeff(panel:i64,tv:Iv)->IvAffineMat{
  let a:IvAffineMat=gc_inward_coeff(panel,tv);
  return gc_affine_submatrix(a,1);
}

fn gc_inward_frame_full(k:i64)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  return if(k==0){gc_inward_frame_0(c)} else if(k==1){gc_inward_frame_1(c)} else if(k==2){gc_inward_frame_2(c)} else if(k==3){gc_inward_frame_3(c)} else if(k==4){gc_inward_frame_4(c)} else if(k==5){gc_inward_frame_5(c)} else if(k==6){gc_inward_frame_6(c)} else if(k==7){gc_inward_frame_7(c)} else if(k==8){gc_inward_frame_8(c)} else if(k==9){gc_inward_frame_9(c)} else if(k==10){gc_inward_frame_10(c)} else if(k==11){gc_inward_frame_11(c)} else if(k==12){gc_inward_frame_12(c)} else if(k==13){gc_inward_frame_13(c)} else if(k==14){gc_inward_frame_14(c)} else if(k==15){gc_inward_frame_15(c)} else if(k==16){gc_inward_frame_16(c)} else if(k==17){gc_inward_frame_17(c)} else if(k==18){gc_inward_frame_18(c)} else if(k==19){gc_inward_frame_19(c)} else if(k==20){gc_inward_frame_20(c)} else if(k==21){gc_inward_frame_21(c)} else if(k==22){gc_inward_frame_22(c)} else if(k==23){gc_inward_frame_23(c)} else if(k==24){gc_inward_frame_24(c)} else if(k==25){gc_inward_frame_25(c)} else if(k==26){gc_inward_frame_26(c)} else if(k==27){gc_inward_frame_27(c)} else {gc_inward_frame_28(c)};
}

fn gc_inward_frame_carrier(k:i64)->IvAffineMat{
  let a:IvAffineMat=gc_inward_frame_full(k);
  return gc_affine_submatrix(a,0);
}

fn gc_inward_frame_kernel(k:i64)->IvAffineMat{
  let a:IvAffineMat=gc_inward_frame_full(k);
  return gc_affine_submatrix(a,1);
}

fn gc_identity_frame(k:i64)->IvAffineMat{
  return ivam_identity(gc_cell().generator,12);
}

fn gc_inward_coeff_table_range(p0:i64,p1:i64)->Vec<IvAffineMat>{
  let d:ManualVec<IvAffineMat>=manual_vec_new<IvAffineMat>(system_allocator(),usize(p1-p0));
  let p:i64=p0;while(p<p1){
    let ta:Iv=iv_from_rat(rat(p,64));
    let tb:Iv=iv_from_rat(rat(p+1,64));
    let tv:Iv=iv(ta.lo,tb.hi);
    d=manual_vec_push<IvAffineMat>(d,gc_inward_coeff(p,tv));p=p+1;}
  return vec_seal(d);
}

fn gc_affine_subtable(a:borrow Vec<IvAffineMat>,kind:i64)->Vec<IvAffineMat>{
  let n:usize=len(a);let d:ManualVec<IvAffineMat>=
    manual_vec_new<IvAffineMat>(system_allocator(),n);
  let k:usize=0;while(k<n){d=manual_vec_push<IvAffineMat>(d,
    gc_affine_submatrix(vec_get_ref<IvAffineMat>(a,k),kind));k=k+1;}
  return vec_seal(d);
}

fn gc_inward_frame_table_range(kind:i64,k0:i64,k1:i64)->Vec<IvAffineMat>{
  let d:ManualVec<IvAffineMat>=manual_vec_new<IvAffineMat>(system_allocator(),usize(k1-k0));
  let k:i64=k0;while(k<k1){
    let z:IvAffineMat=if(kind==3){gc_identity_frame(k)}else{
      if(kind==0){gc_inward_frame_full(k)}else{
      if(kind==1){gc_inward_frame_carrier(k)}else{gc_inward_frame_kernel(k)}}};
    d=manual_vec_push<IvAffineMat>(d,z);k=k+1;}return vec_seal(d);
}

fn gc_horizon_runtime(xc:Rat,xbox:Iv,xhalf:Rat,cell:borrow IvAffineCell)->IvAffineMat{
  let c:QMat=qm_new(12,12);let d:QMat=qm_new(12,12);
  let rem:IvMat=ivm_zeros(12,12);
  let wc:Rat=big("257/512");
  let wlo:Iv=iv_from_rat(big("1/2"));
  let whi:Iv=iv_from_rat(big("129/256"));
  let wbox:Iv=iv(wlo.lo,whi.hi);
  let dx:Iv=iv_from_rat(xhalf);
  let dw:Iv=iv_from_rat(big("1/512"));
  c=qm_set(c,0,1,big("1/1"));
  c=qm_set(c,6,7,big("1/1"));
  c=qm_set(c,1,0,(big("2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/((big("2/1")+rat_clone(xc))*(big("2/1")+rat_clone(xc))))*(big("4/1")+(big("3/1")*rat_clone(xc)))));
  c=qm_set(c,7,6,(big("2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/((big("2/1")+rat_clone(xc))*(big("2/1")+rat_clone(xc))))*(big("4/1")+(big("3/1")*rat_clone(xc)))));
  ivm_set(rem,1,0,gc_sym(iv_mul(iv_abs(iv_mul(iv_mul(iv_mul(iv_from_rat(big("-4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox))),iv_div(iv_point(1.0),iv_mul(iv_mul(iv_add(iv_from_rat(big("2/1")),xbox),iv_add(iv_from_rat(big("2/1")),xbox)),iv_add(iv_from_rat(big("2/1")),xbox)))),iv_add(iv_add(iv_from_rat(big("4/1")),iv_mul(iv_from_rat(big("3/1")),iv_mul(xbox,xbox))),iv_mul(iv_from_rat(big("6/1")),xbox)))),dx)));
  ivm_set(rem,7,6,gc_sym(iv_mul(iv_abs(iv_mul(iv_mul(iv_mul(iv_from_rat(big("-4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox))),iv_div(iv_point(1.0),iv_mul(iv_mul(iv_add(iv_from_rat(big("2/1")),xbox),iv_add(iv_from_rat(big("2/1")),xbox)),iv_add(iv_from_rat(big("2/1")),xbox)))),iv_add(iv_add(iv_from_rat(big("4/1")),iv_mul(iv_from_rat(big("3/1")),iv_mul(xbox,xbox))),iv_mul(iv_from_rat(big("6/1")),xbox)))),dx)));
  c=qm_set(c,7,1,(big("-2/1")*rat_clone(wc)*(big("1/1")/rat_clone(xc))*(big("2/1")+rat_clone(xc))));
  c=qm_set(c,1,7,rat(0,1)-((big("-2/1")*rat_clone(wc)*(big("1/1")/rat_clone(xc))*(big("2/1")+rat_clone(xc)))));
  d=qm_set(d,7,1,(big("-2/1")*(big("1/1")/rat_clone(xc))*(big("2/1")+rat_clone(xc))));
  d=qm_set(d,1,7,rat(0,1)-((big("-2/1")*(big("1/1")/rat_clone(xc))*(big("2/1")+rat_clone(xc)))));
  ivm_set(rem,7,1,gc_sym(iv_add(iv_mul(iv_abs(iv_mul(iv_mul(iv_from_rat(big("4/1")),wbox),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),iv_mul(iv_mul(iv_abs(iv_mul(iv_from_rat(big("4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),dw))));
  ivm_set(rem,1,7,gc_sym(iv_add(iv_mul(iv_abs(iv_mul(iv_mul(iv_from_rat(big("4/1")),wbox),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),iv_mul(iv_mul(iv_abs(iv_mul(iv_from_rat(big("4/1")),iv_div(iv_point(1.0),iv_mul(xbox,xbox)))),dx),dw))));
  c=qm_set(c,7,2,(big("-2/1")*rat_clone(wc)*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc)))));
  c=qm_set(c,1,8,rat(0,1)-((big("-2/1")*rat_clone(wc)*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc))))));
  d=qm_set(d,7,2,(big("-2/1")*(big("1/1")/rat_clone(xc))*(big("1/1")/(big("2/1")+rat_clone(xc)))));
