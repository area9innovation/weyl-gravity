fn gc_hshell_frame_16_0(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_16_0_center(),
    gc_hshell_frame_16_0_derivative(),ivm_zeros(12,12));
