fn gc_hshell_frame_19_8(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_19_8_center(),
    gc_hshell_frame_19_8_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn gc_hshell_coeff_19(panel:i64,tbox:Iv)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  let xc:Rat=big("1/8")+
    rat(2*panel+1,1)*big("1/256");
  return gc_horizon_runtime(xc,tbox,big("1/256"),c);
}

fn gc_hshell_frame_dispatch_19(k:i64)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  return if(k==0){gc_hshell_frame_19_0(c)} else if(k==1){gc_hshell_frame_19_1(c)} else if(k==2){gc_hshell_frame_19_2(c)} else if(k==3){gc_hshell_frame_19_3(c)} else if(k==4){gc_hshell_frame_19_4(c)} else if(k==5){gc_hshell_frame_19_5(c)} else if(k==6){gc_hshell_frame_19_6(c)} else if(k==7){gc_hshell_frame_19_7(c)} else {gc_hshell_frame_19_8(c)};
}

