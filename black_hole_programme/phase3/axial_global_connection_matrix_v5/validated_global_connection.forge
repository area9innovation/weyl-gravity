fn gc_inward_frame_17(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_inward_frame_17_center(),
    gc_inward_frame_17_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

