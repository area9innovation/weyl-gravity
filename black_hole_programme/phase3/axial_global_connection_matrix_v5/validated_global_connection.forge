fn gc_hshell_frame_18_8(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_18_8_center(),
    gc_hshell_frame_18_8_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

fn gc_hshell_coeff_18(panel:i64,tbox:Iv)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  let xc:Rat=big("1/16")+
    rat(2*panel+1,1)*big("1/512");
  return gc_horizon_runtime(xc,tbox,big("1/512"),c);
}

fn gc_hshell_frame_dispatch_18(k:i64)->IvAffineMat{
  let c:IvAffineCell=gc_cell();
  return if(k==0){gc_hshell_frame_18_0(c)} else if(k==1){gc_hshell_frame_18_1(c)} else if(k==2){gc_hshell_frame_18_2(c)} else if(k==3){gc_hshell_frame_18_3(c)} else if(k==4){gc_hshell_frame_18_4(c)} else if(k==5){gc_hshell_frame_18_5(c)} else if(k==6){gc_hshell_frame_18_6(c)} else if(k==7){gc_hshell_frame_18_7(c)} else {gc_hshell_frame_18_8(c)};
}

