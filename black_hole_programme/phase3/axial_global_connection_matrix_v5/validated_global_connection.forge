fn gc_hshell_frame_12_5(cell: borrow IvAffineCell) -> IvAffineMat {
  let z:IvAffineResult=ivam_taylor1(cell,gc_hshell_frame_12_5_center(),
    gc_hshell_frame_12_5_derivative(),ivm_zeros(12,12));
  if(!z.ok){trap();}
  return ivam_clone(z.value);
}

