  return new DualT4(base,tangent);
}
fn build_models(w_model:borrow IvTaylor4Mat,r_model:borrow IvTaylor4Mat)->ModelTriple{
  let t0:IvTaylor4Mat=jt_inv(jt_pow(ivtm4_clone(r_model),1));
  let t1:IvTaylor4Mat=jt_mul(jt_const(big("2/1")),t0);
  let t2:IvTaylor4Mat=jt_mul(jt_mul(ivtm4_clone(w_model),t1),jt_add(ivtm4_clone(r_model),jt_const(big("2/1"))));
  let t3:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t2);
  let t4:IvTaylor4Mat=jt_pow(ivtm4_clone(r_model),2);
  let t5:IvTaylor4Mat=jt_inv(jt_pow(t4,1));
  let t6:IvTaylor4Mat=jt_inv(jt_pow(jt_add(ivtm4_clone(r_model),jt_const(big("-2/1"))),1));
  let t7:IvTaylor4Mat=jt_mul(jt_mul(jt_mul(jt_const(big("6/1")),t5),t6),jt_add(ivtm4_clone(r_model),jt_const(big("-1/1"))));
  let t8:IvTaylor4Mat=jt_mul(jt_mul(jt_const(big("-1/1")),t1),t6);
  let t9:IvTaylor4Mat=jt_mul(ivtm4_clone(w_model),t0);
  let t10:IvTaylor4Mat=jt_mul(jt_mul(jt_const(big("8/1")),t6),t9);
  let t11:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t10);
  let t12:IvTaylor4Mat=jt_pow(ivtm4_clone(w_model),2);
  let t13:IvTaylor4Mat=jt_mul(t12,t4);
  let t14:IvTaylor4Mat=jt_inv(jt_pow(jt_add(t13,jt_const(big("4/1"))),2));
  let t15:IvTaylor4Mat=jt_add(jt_mul(jt_const(big("3/1")),ivtm4_clone(r_model)),jt_const(big("-2/1")));
  let t16:IvTaylor4Mat=jt_mul(jt_mul(t14,t15),jt_add(t13,jt_const(big("8/1"))));
  let t17:IvTaylor4Mat=jt_mul(jt_mul(jt_const(big("-1/1")),t0),t16);
  let t18:IvTaylor4Mat=jt_mul(jt_pow(ivtm4_clone(r_model),3),t12);
  let t19:IvTaylor4Mat=jt_mul(jt_const(big("1/4")),t14);
  let t20:IvTaylor4Mat=jt_mul(t19,jt_add(jt_add(jt_add(jt_add(jt_mul(jt_mul(jt_const(big("3/1")),jt_pow(ivtm4_clone(w_model),4)),jt_pow(ivtm4_clone(r_model),5)),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("32/1"))),ivtm4_clone(r_model))),jt_mul(jt_const(big("8/1")),t13)),jt_mul(jt_const(big("8/1")),t18)),jt_const(big("64/1"))));
  let t21:IvTaylor4Mat=jt_mul(ivtm4_clone(w_model),t19);
  let t22:IvTaylor4Mat=jt_mul(t15,jt_add(jt_mul(jt_const(big("3/1")),t13),jt_const(big("20/1"))));
  let t23:IvTaylor4Mat=jt_mul(t21,t22);
  let t24:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t23);
  let t25:IvTaylor4Mat=jt_mul(t21,jt_add(jt_add(jt_add(jt_mul(jt_const(big("44/1")),ivtm4_clone(r_model)),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("6/1"))),t13)),jt_mul(jt_const(big("9/1")),t18)),jt_const(big("-40/1"))));
  let t26:IvTaylor4Mat=jt_mul(ivtm4_clone(r_model),t25);
  let t27:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t26);
  let t28:IvTaylor4Mat=jt_mul(t16,t5);
  let t29:IvTaylor4Mat=jt_mul(jt_mul(jt_const(big("-1/1")),t0),t20);
  let t30:IvTaylor4Mat=jt_mul(jt_mul(t19,t22),t9);
  let t31:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t30);
  let t32:IvTaylor4Mat=jt_mul(jt_const(big("-1/1")),t25);
  let base:IvTaylor4Mat=jt_zero(4,4);
  let tangent:IvTaylor4Mat=jt_zero(4,4);
  let direct:IvTaylor4Mat=jt_zero(8,8);
  base=jt_put(base,0,1,jt_const(big("1/1")));
  base=jt_put(base,0,2,t3);
  base=jt_put(base,1,0,t7);
  base=jt_put(base,1,1,t8);
  base=jt_put(base,1,3,t10);
  base=jt_put(base,2,0,t2);
  base=jt_put(base,2,3,jt_const(big("1/1")));
  base=jt_put(base,3,1,t11);
  base=jt_put(base,3,2,t7);
  base=jt_put(base,3,3,t8);
  tangent=jt_put(tangent,0,0,t17);
  tangent=jt_put(tangent,0,1,t20);
  tangent=jt_put(tangent,0,2,t24);
  tangent=jt_put(tangent,0,3,t27);
  tangent=jt_put(tangent,1,0,t28);
  tangent=jt_put(tangent,1,1,t29);
  tangent=jt_put(tangent,1,2,t30);
  tangent=jt_put(tangent,1,3,t25);
  tangent=jt_put(tangent,2,0,t23);
  tangent=jt_put(tangent,2,1,t26);
  tangent=jt_put(tangent,2,2,t17);
  tangent=jt_put(tangent,2,3,t20);
  tangent=jt_put(tangent,3,0,t31);
  tangent=jt_put(tangent,3,1,t32);
  tangent=jt_put(tangent,3,2,t28);
  tangent=jt_put(tangent,3,3,t29);
  direct=jt_put(direct,0,1,jt_const(big("1/1")));
  direct=jt_put(direct,0,2,t3);
  direct=jt_put(direct,0,4,t17);
  direct=jt_put(direct,0,5,t20);
  direct=jt_put(direct,0,6,t24);
  direct=jt_put(direct,0,7,t27);
  direct=jt_put(direct,1,0,t7);
  direct=jt_put(direct,1,1,t8);
  direct=jt_put(direct,1,3,t10);
  direct=jt_put(direct,1,4,t28);
  direct=jt_put(direct,1,5,t29);
  direct=jt_put(direct,1,6,t30);
  direct=jt_put(direct,1,7,t25);
  direct=jt_put(direct,2,0,t2);
  direct=jt_put(direct,2,3,jt_const(big("1/1")));
  direct=jt_put(direct,2,4,t23);
  direct=jt_put(direct,2,5,t26);
  direct=jt_put(direct,2,6,t17);
  direct=jt_put(direct,2,7,t20);
  direct=jt_put(direct,3,1,t11);
  direct=jt_put(direct,3,2,t7);
  direct=jt_put(direct,3,3,t8);
  direct=jt_put(direct,3,4,t31);
  direct=jt_put(direct,3,5,t32);
  direct=jt_put(direct,3,6,t28);
  direct=jt_put(direct,3,7,t29);
  direct=jt_put(direct,4,5,jt_const(big("1/1")));
  direct=jt_put(direct,4,6,t3);
  direct=jt_put(direct,5,4,t7);
  direct=jt_put(direct,5,5,t8);
  direct=jt_put(direct,5,7,t10);
  direct=jt_put(direct,6,4,t2);
  direct=jt_put(direct,6,7,jt_const(big("1/1")));
  direct=jt_put(direct,7,5,t11);
  direct=jt_put(direct,7,6,t7);
  direct=jt_put(direct,7,7,t8);
  return new ModelTriple(base,tangent,direct);
}

pub fn main()->i64{
  let w_model:IvTaylor4Mat=jt_frequency();
  let seed:DualT4=build_seed(w_model);
  let center:Rat=big("2047/64");
  let radial_step:Rat=big("1/32");
  let radius:Rat=big("1/64");
  let h:Rat=big("-1/32");
  let order:i64=12;
  let panel:i64=0;
  let max_width:f64=hull_width(stack_seed(seed));
  let max_tail:f64=0.0;
  while(panel<16){
    let r_model:IvTaylor4Mat=jt_radius_box(center,radius);
    let models:ModelTriple=build_models(w_model,r_model);
    let dual:DualT4=dual_series(models.base,models.tangent,h,order);
    let base_out:IvTaylor4Mat=jt_mul(dual.base,seed.base);
    let tangent_out:IvTaylor4Mat=jt_add(
      jt_mul(dual.tangent,seed.base),
      jt_mul(dual.base,seed.tangent));
    let jet_out:IvTaylor4Mat=stack_result(base_out,tangent_out);
    let direct_transport:IvTaylor4Mat=jt_series(models.direct,h,order);
    let direct_out:IvTaylor4Mat=jt_mul(direct_transport,stack_seed(seed));
    let hull:IvMat=match(ivtm4_hull_checked(models.direct)){
      some(x)=>x,none=>{
        println(strfmt(system_allocator(),
          "RPLUS_MULTIPANEL status=REFUSED panel={} code=COEFFICIENT_HULL",
          [panel]));return 3;}};
    let alpha:f64=sl_inf_norm_hi(hull);
    let scaled_norm:f64=rat_to_f64(radial_step)*alpha;
    let tail:f64=sl_exp_tail(scaled_norm,order+1);
    let seed_hull:IvMat=match(ivtm4_hull_checked(stack_seed(seed))){
      some(x)=>x,none=>{
        println(strfmt(system_allocator(),
          "RPLUS_MULTIPANEL status=REFUSED panel={} code=SEED_HULL",
          [panel]));return 3;}};
    let seed_norm:f64=sl_inf_norm_hi(seed_hull);
    let propagated_tail:f64=tail*seed_norm;
    if(!f64_is_finite(propagated_tail)||propagated_tail<0.0){
      println(strfmt(system_allocator(),
        "RPLUS_MULTIPANEL status=REFUSED panel={} code=TAIL alpha={} scaled_norm={}",
        [panel,alpha,scaled_norm]));return 3;}
    let jet_padded:IvTaylor4Mat=jt_pad(jet_out,propagated_tail);
    let direct_padded:IvTaylor4Mat=jt_pad(direct_out,propagated_tail);
    let exact:bool=coefficients_equal(jet_padded,direct_padded);
    let overlap:bool=difference_contains_zero(jet_padded,direct_padded);
    let width:f64=hull_width(jet_padded);
    if(!exact||!overlap||!f64_is_finite(width)||width>1.0e100){
      println(strfmt(system_allocator(),
        "RPLUS_MULTIPANEL status=REFUSED panel={} code=CORRELATION_OR_WIDTH alpha={} scaled_norm={} tail={} width={}",
        [panel,alpha,scaled_norm,propagated_tail,width]));return 3;}
    if(width>max_width){max_width=width;}
    if(propagated_tail>max_tail){max_tail=propagated_tail;}
    seed=unstack_result(jet_padded);
    center=rat_clone(center)-rat_clone(radial_step);
    panel=panel+1;
  }
  println(strfmt(system_allocator(),
    "RPLUS_MULTIPANEL status=PASS panels={} final_r=31.5 max_width={} final_width={} max_tail={}",
    [panel,max_width,hull_width(stack_seed(seed)),max_tail]));
  return 0;
}
