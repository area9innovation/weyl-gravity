  base=jt_put(base,2,0,jt_mul(jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("1/268435456"))),s4),jt_add(jt_add(jt_add(jt_mul(jt_const(big("24976152/1")),s0),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("70124928/1"))),s2)),jt_mul(jt_const(big("770048/1")),s3)),jt_const(big("-1045/1")))));
  tangent=jt_put(tangent,2,0,jt_mul(jt_mul(jt_const(big("1/268435456")),jt_inv(jt_pow(ivtm4_clone(w_model),7))),jt_add(jt_add(jt_add(jt_add(jt_add(jt_mul(jt_const(big("333672/1")),s2),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("52338048/1"))),s3)),jt_mul(jt_const(big("1738844160/1")),s5)),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("36175872/1"))),s8)),jt_mul(jt_const(big("-1/1")),s9)),jt_const(big("8/1")))));
  base=jt_put(base,3,0,jt_mul(jt_mul(jt_const(big("1/8589934592")),s4),jt_add(jt_add(jt_add(jt_add(jt_mul(jt_const(big("78447112/1")),s0),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("18764372992/1"))),s2)),jt_mul(jt_const(big("615473152/1")),s3)),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("3342336/1"))),s5)),jt_const(big("-4265/1")))));
  tangent=jt_put(tangent,3,0,jt_mul(jt_mul(jt_const(big("1/268435456")),jt_inv(jt_pow(ivtm4_clone(w_model),5))),jt_add(jt_add(jt_add(jt_add(jt_mul(jt_const(big("35452000/1")),s2),jt_mul(jt_const(big("12547447552/1")),s3)),jt_mul(jt_const(big("454115328/1")),s5)),jt_mul(jt_const(big("-1/1")),s7)),jt_const(big("31/1")))));
