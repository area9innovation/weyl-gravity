  tangent=jt_put(tangent,0,0,jt_mul(jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("1/134217728"))),s6),jt_add(jt_add(jt_add(jt_add(jt_add(jt_mul(jt_const(big("14633888/1")),s2),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("277027584/1"))),s3)),jt_mul(jt_const(big("205176832/1")),s5)),s7),jt_mul(jt_const(big("4194304/1")),s8)),jt_const(big("-31/1")))));
  base=jt_put(base,1,0,jt_mul(jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("1/3221225472"))),s1),jt_add(jt_add(jt_add(jt_mul(jt_const(big("641769184/1")),s0),jt_mul(jt_mul(jt_const(big("-1/1")),jt_const(big("1795224384/1"))),s2)),jt_mul(jt_const(big("19712000/1")),s3)),jt_const(big("-615879/1")))));
