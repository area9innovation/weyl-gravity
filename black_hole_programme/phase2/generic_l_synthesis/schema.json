{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema",
    "result_id",
    "result_token",
    "lifecycle",
    "dependency_tags",
    "declaration",
    "input_snapshot",
    "axial_phase",
    "polar_phase",
    "q21_exceptional_frequency_count",
    "joint_disposition",
    "claim_map_path",
    "does_not_establish",
    "verification"
  ],
  "properties": {
    "schema": {"const": "phase2-black-hole-generic-l-parity-disposition-v1"},
    "result_id": {"const": "PURE_WEYL_PHASE2_GENERIC_L_PARITY_DISPOSITION_V1"},
    "result_token": {"const": "BH_PHASE2_GENERIC_L_AXIAL_COUNTEREXAMPLE_POLAR_FINITE_LINE_Q21_WALL"},
    "lifecycle": {"const": "CLASSIFIED"},
    "dependency_tags": {"const": ["LOCAL-ALGEBRAIC", "REDUCED-MODE"]},
    "declaration": {"type": "object"},
    "input_snapshot": {
      "type": "object",
      "required": ["axial", "polar", "q21", "polar_wall"],
      "properties": {
        "axial": {
          "type": "object",
          "required": ["result_id", "certificate_sha256", "evidence_commit"]
        },
        "polar": {
          "type": "object",
          "required": ["result_id", "certificate_sha256", "terminal_commit", "terminal_status"]
        },
        "q21": {
          "type": "object",
          "required": ["sha256", "bidegree", "term_count"]
        },
        "polar_wall": {
          "type": "object",
          "required": ["sha256", "identity_verified"]
        }
      }
    },
    "q21_exceptional_frequency_count": {
      "type": "object",
      "required": [
        "leading_x_coefficient",
        "boundary_factorization",
        "discriminant_factorization",
        "transition_roots",
        "continuous_lambda_bands",
        "physical_triangular_harmonics",
        "legacy_fixture"
      ]
    },
    "axial_phase": {"type": "object"},
    "polar_phase": {"type": "object"},
    "joint_disposition": {"type": "object"},
    "claim_map_path": {"type": "string"},
    "does_not_establish": {"type": "array", "minItems": 1},
    "verification": {"type": "object"}
  },
  "additionalProperties": false
}
