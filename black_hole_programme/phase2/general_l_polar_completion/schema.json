{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "phase2-black-hole-general-l-polar-canonical-frontier-v1.schema.json",
  "oneOf": [
    {"$ref": "#/$defs/branch"},
    {"$ref": "#/$defs/assembly"}
  ],
  "$defs": {
    "branch": {
      "type": "object",
      "required": [
        "schema_version", "result_id", "sector", "index", "field",
        "mass_normalization", "generic_assumptions", "imported_v1",
        "carrier_state_order", "source_field_order", "metric_field_order",
        "jet_axis_order", "source_f_map", "equation_linked_variable_map",
        "actual_power_depth_mapping", "carrier_depth", "metric_depth",
        "carrier_jet", "constructed_log_degree",
        "complete_log_classification", "safe_tail_ledger",
        "metric_reconstruction", "physical_conjugation",
        "resonant_log_discrepancy", "payload_sha256",
        "payload_sha256_scope", "payload_sha256_canonicalization",
        "does_not_establish"
      ],
      "properties": {
        "schema_version": {"const": "phase2-polar-branch-artifact-v1"},
        "sector": {"enum": ["zero", "oscillatory"]},
        "index": {"type": "integer", "minimum": 0, "maximum": 2},
        "carrier_state_order": {"const": ["a", "a_prime", "b", "b_prime", "c", "c_prime"]},
        "source_field_order": {"const": ["a", "b", "c", "f"]},
        "metric_field_order": {"const": ["Ah", "Bh", "Ch", "Kh"]},
        "jet_axis_order": {"const": ["log_power", "inverse_radial_order", "field"]},
        "constructed_log_degree": {"const": 0},
        "complete_log_classification": {"const": false},
        "carrier_jet": {"type": "array", "minItems": 8},
        "metric_reconstruction": {
          "type": "object",
          "required": [
            "base", "logs", "q_counts", "final_homogeneous_parameter_count",
            "final_affine_splitting", "canonical_metric_jets",
            "per_order_affine_rank_witnesses", "pivot_denominator_factors",
            "physical_domain_pivot_classification",
            "physical_domain_exceptional_set",
            "original_seven_row_residuals_zero", "seven_original_ricci_rows",
            "seven_row_residual_intervals"
          ],
          "properties": {
            "logs": {"const": 0},
            "physical_domain_exceptional_set": {"const": []},
            "original_seven_row_residuals_zero": {"const": true},
            "seven_original_ricci_rows": {"const": ["vv", "vr", "rr", "vx", "rx", "angP", "angW"]},
            "per_order_affine_rank_witnesses": {
              "type": "array",
              "minItems": 4,
              "items": {
                "type": "object",
                "required": [
                  "q", "row_labels", "coordinate_labels",
                  "compact_augmented_matrix", "rref_augmented_matrix",
                  "pivot_columns", "variable_pivot_columns", "free_columns",
                  "equation_count", "variable_count", "rank", "nullity",
                  "particular_solution", "nullspace_basis",
                  "rref_is_exact_rank_witness"
                ]
              }
            }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "required": [
        "schema", "result_id", "lifecycle", "dependency_tags",
        "imported_v1", "method", "canonical_log_free_frontier",
        "physical_domain_pivot_disposition", "resonant_log_discrepancy",
        "first_remaining_exact_object", "unavailable_theorem_fields",
        "does_not_establish"
      ],
      "properties": {
        "schema": {"const": "phase2-black-hole-general-l-polar-canonical-log-free-frontier-v1"},
        "result_id": {"const": "PHASE2_BLACK_HOLE_GENERAL_L_POLAR_CANONICAL_LOG_FREE_FRONTIER_V1"},
        "lifecycle": {"const": "CLASSIFIED_PARTIAL"},
        "canonical_log_free_frontier": {"type": "array", "minItems": 6, "maxItems": 6},
        "unavailable_theorem_fields": {"type": "array", "minItems": 1},
        "does_not_establish": {"type": "array", "minItems": 1}
      }
    }
  }
}
