digraph UniverseBuilding {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.28, ranksep=0.58, splines=polyline, fontname="Helvetica"];
  node [style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.5, margin="0.13,0.08"];
  edge [fontname="Helvetica", fontsize=8, color="#667085", arrowsize=0.7];
  label="How the candidate universe is being built";
  labelloc=t; fontsize=22;
  legend [shape=plaintext, label="Arrows show what each result enables\nGreen = certified | amber = partial | red = obstruction | gray = open", fontsize=10];
  "gauge_complex" [shape=box, label="Spacetime and gauge\ncomplex\nexact classical equations", fillcolor="#d9f2df", color="#287a3d", tooltip="Spacetime and gauge\ncomplex\nexact classical equations"];
  "causality" [shape=box, label="Classical causality\nfuture sources do not alter\nthe past", fillcolor="#d9f2df", color="#287a3d", tooltip="Classical causality\nfuture sources do not alter\nthe past"];
  "residual" [shape=box, label="Gauge reduction and\npairing\nphysical descriptions\ncounted once", fillcolor="#d9f2df", color="#287a3d", tooltip="Gauge reduction and\npairing\nphysical descriptions\ncounted once"];
  "clock" [shape=box, label="Healthy matter clock\nrelational change; raw D\nnull in the tested linear\nsector", fillcolor="#d9f2df", color="#287a3d", tooltip="Healthy matter clock\nrelational change; raw D\nnull in the tested linear\nsector"];
  "interactions" [shape=box, label="First interaction layer\ngravity q2/q3; preserving-\ngenerator Cartan through\narity three", fillcolor="#d9f2df", color="#287a3d", tooltip="First interaction layer\ngravity q2/q3; preserving-\ngenerator Cartan through\narity three"];
  "einstein_weyl_relative" [shape=box, label="Einstein gravity inside\nWeyl gravity\naxial triangle and polar\nphysical module; global\ntriangle open", fillcolor="#fff0bf", color="#9a6a00", tooltip="Einstein gravity inside\nWeyl gravity\naxial triangle and polar\nphysical module; global\ntriangle open"];
  "light" [shape=box, label="Classical light\ncomplete local Maxwell q2;\ncausal transfer open", fillcolor="#fff0bf", color="#9a6a00", tooltip="Classical light\ncomplete local Maxwell q2;\ncausal transfer open"];
  "gravity_waves" [shape=box, label="Gravitational waves\nstandard waves; extra axial\nand polar equation modules", fillcolor="#fff0bf", color="#9a6a00", tooltip="Gravitational waves\nstandard waves; extra axial\nand polar equation modules"];
  "redshift" [shape=box, label="Relational redshift\ndynamical Maxwell frequency\nratio; localization open", fillcolor="#fff0bf", color="#9a6a00", tooltip="Relational redshift\ndynamical Maxwell frequency\nratio; localization open"];
  "detector" [shape=box, label="Wave detector response\nnext observer-level wave\ntest", fillcolor="#eceff3", color="#667085", tooltip="Wave detector response\nnext observer-level wave\ntest"];
  "hadamard" [shape=box, label="Hadamard quantum state\nlocal singularity\ncontrolled; global state\nopen", fillcolor="#fff0bf", color="#9a6a00", tooltip="Hadamard quantum state\nlocal singularity\ncontrolled; global state\nopen"];
  "anomalies" [shape=box, label="Quantum anomaly and QME\ncandidate classes known;\nrestoration open", fillcolor="#fff0bf", color="#9a6a00", tooltip="Quantum anomaly and QME\ncandidate classes known;\nrestoration open"];
  "lensing" [shape=box, label="Gravitational lensing\nlocalized observable not yet\nbuilt", fillcolor="#eceff3", color="#667085", tooltip="Gravitational lensing\nlocalized observable not yet\nbuilt"];
  "mass" [shape=box, label="Physical mass scale and\nmassive matter\nmass generation and stable\nmassive excitations open", fillcolor="#eceff3", color="#667085", tooltip="Physical mass scale and\nmassive matter\nmass generation and stable\nmassive excitations open"];
  "nonabelian_matter" [shape=box, label="Non-Abelian gauge fields\nand chiral matter\nYang--Mills groups and\nfermion spectrum open", fillcolor="#eceff3", color="#667085", tooltip="Non-Abelian gauge fields\nand chiral matter\nYang--Mills groups and\nfermion spectrum open"];
  "particles" [shape=box, label="Quantum particles\nphysical state and\nscattering interpretation\nopen", fillcolor="#eceff3", color="#667085", tooltip="Quantum particles\nphysical state and\nscattering interpretation\nopen"];
  "black_holes" [shape=box, label="Black holes\nhorizon phase space and\nstability open", fillcolor="#eceff3", color="#667085", tooltip="Black holes\nhorizon phase space and\nstability open"];
  "gut" [shape=box, label="Unified gauge--matter\nsector\nGUT candidate: group,\nanomalies, breaking and\nrecovery open", fillcolor="#eceff3", color="#667085", tooltip="Unified gauge--matter\nsector\nGUT candidate: group,\nanomalies, breaking and\nrecovery open"];
  "cosmology" [shape=box, label="Cosmology and dark\nsector\nstable observable model not\nyet built", fillcolor="#eceff3", color="#667085", tooltip="Cosmology and dark\nsector\nstable observable model not\nyet built"];
  { rank=same; "causality"; "residual"; "clock"; }
  { rank=same; "interactions"; "einstein_weyl_relative"; "light"; "gravity_waves"; }
  { rank=same; "redshift"; "detector"; "lensing"; }
  { rank=same; "hadamard"; "anomalies"; }
  { rank=same; "mass"; "nonabelian_matter"; "particles"; "black_holes"; }
  "gauge_complex" -> "causality" [tooltip="constrains propagation"];
  "gauge_complex" -> "residual" [tooltip="identifies redundancy"];
  "gauge_complex" -> "clock" [tooltip="couples matter"];
  "gauge_complex" -> "light" [tooltip="supports fields"];
  "gauge_complex" -> "gravity_waves" [tooltip="linearizes"];
  "gauge_complex" -> "einstein_weyl_relative" [tooltip="defines both complexes"];
  "einstein_weyl_relative" -> "gravity_waves" [tooltip="separates familiar and extra modes"];
  "einstein_weyl_relative" -> "interactions" [tooltip="tests nonlinear closure"];
  "residual" -> "interactions" [tooltip="defines physical transfer"];
  "causality" -> "interactions" [tooltip="limits influence"];
  "clock" -> "redshift" [tooltip="supplies readings"];
  "light" -> "redshift" [tooltip="carries frequency"];
  "interactions" -> "redshift" [tooltip="preserves observable"];
  "gravity_waves" -> "detector" [tooltip="drives tidal response"];
  "causality" -> "detector" [tooltip="retards response"];
  "light" -> "lensing" [tooltip="traces null paths"];
  "gravity_waves" -> "lensing" [tooltip="supplies curvature"];
  "causality" -> "hadamard" [tooltip="fixes commutator"];
  "residual" -> "hadamard" [tooltip="selects observables"];
  "interactions" -> "anomalies" [tooltip="feeds quantum identities"];
  "hadamard" -> "particles" [tooltip="supplies short-distance state"];
  "anomalies" -> "particles" [tooltip="restores quantum gauge identity"];
  "clock" -> "mass" [tooltip="can supply a scale"];
  "interactions" -> "mass" [tooltip="stabilizes matter"];
  "mass" -> "particles" [tooltip="creates rest excitations"];
  "gauge_complex" -> "nonabelian_matter" [tooltip="defines gauge structure"];
  "interactions" -> "nonabelian_matter" [tooltip="couples gauge and matter fields"];
  "nonabelian_matter" -> "particles" [tooltip="supplies charged species"];
  "nonabelian_matter" -> "gut" [tooltip="supplies group and representations"];
  "mass" -> "gut" [tooltip="supplies symmetry-breaking scale"];
  "anomalies" -> "gut" [tooltip="tests quantum consistency"];
  "particles" -> "gut" [tooltip="tests physical spectrum"];
  "gravity_waves" -> "black_holes" [tooltip="tests perturbations"];
  "causality" -> "black_holes" [tooltip="defines horizons"];
  "redshift" -> "cosmology" [tooltip="builds observations"];
  "lensing" -> "cosmology" [tooltip="maps matter"];
  "mass" -> "cosmology" [tooltip="supplies matter"];
  "gut" -> "cosmology" [tooltip="supplies unified matter model"];
  "black_holes" -> "cosmology" [tooltip="tests strong gravity"];
}
