digraph UniverseBuilding {
  graph [rankdir=TB, bgcolor="white", pad=0.35, nodesep=0.28, ranksep=0.58, splines=polyline, fontname="Helvetica"];
  node [style="rounded,filled", fontname="Helvetica", fontsize=11, penwidth=1.5, margin="0.13,0.08"];
  edge [fontname="Helvetica", fontsize=8, color="#667085", arrowsize=0.7];
  label="How the candidate universe is being built";
  labelloc=t; fontsize=22;
  legend [shape=plaintext, label="Arrows show what each achievement makes possible\nGreen = demonstrated | gold = working example | red = limit found | gray = next frontier", fontsize=10];
  "gauge_complex" [shape=box, label="DEMONSTRATED\nConsistent spacetime\nrules\nthe gravity equations and\ntheir built-in redundancies\nfit together exactly\nNext: test the same rules on\nmore backgrounds and\nboundaries", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nConsistent spacetime\nrules\nthe gravity equations and\ntheir built-in redundancies\nfit together exactly\nNext: test the same rules on\nmore backgrounds and\nboundaries"];
  "causality" [shape=box, label="DEMONSTRATED\nCause comes before\neffect\nsignals propagate forward in\ntime in the starting\nuniverse and broader curved\nexamples\nNext: extend the proof to more\nboundaries and less\nsymmetric spacetimes", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nCause comes before\neffect\nsignals propagate forward in\ntime in the starting\nuniverse and broader curved\nexamples\nNext: extend the proof to more\nboundaries and less\nsymmetric spacetimes"];
  "residual" [shape=box, label="DEMONSTRATED\nEquivalent descriptions\ncounted once\ncoordinate and scale choices\nare removed without losing\nthe surviving information\nNext: repeat the reduction\nafter boundaries and\nquantum effects are added", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nEquivalent descriptions\ncounted once\ncoordinate and scale choices\nare removed without losing\nthe surviving information\nNext: repeat the reduction\nafter boundaries and\nquantum effects are added"];
  "clock" [shape=box, label="DEMONSTRATED\nA clock inside the\nuniverse\nhealthy matter records\nchange while the total time\nshift remains redundant in\nthe tested sector\nNext: test broader clocks and\nfully backreacted\nmeasuring devices", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nA clock inside the\nuniverse\nhealthy matter records\nchange while the total time\nshift remains redundant in\nthe tested sector\nNext: test broader clocks and\nfully backreacted\nmeasuring devices"];
  "interactions" [shape=box, label="DEMONSTRATED\nGravity and light\ninteract\nthe first nonlinear\ninteraction laws close\nexactly\nNext: decide whether the\nremaining interaction\nsurvives the next\nderivative order", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nGravity and light\ninteract\nthe first nonlinear\ninteraction laws close\nexactly\nNext: decide whether the\nremaining interaction\nsurvives the next\nderivative order"];
  "berger_branch_carrier" [shape=box, label="WORKING EXAMPLE\nFamiliar and extra\ngravity waves\nboth kinds are identified,\nbut the attempted local\nseparation has an exact\nobstruction\nNext: find a larger or\ndifferently organized\ndescription", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nFamiliar and extra\ngravity waves\nboth kinds are identified,\nbut the attempted local\nseparation has an exact\nobstruction\nNext: find a larger or\ndifferently organized\ndescription"];
  "branch_mixing" [shape=box, label="WORKING EXAMPLE\nCan interactions switch\nwave types?\nthe interaction can be\nremoved at the first tested\nderivative levels\nNext: complete the decisive\nnext-order calculation", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nCan interactions switch\nwave types?\nthe interaction can be\nremoved at the first tested\nderivative levels\nNext: complete the decisive\nnext-order calculation"];
  "taub_selection" [shape=box, label="WORKING EXAMPLE\nWhich waves survive\nnonlinear consistency?\nbroad balanced families\ncontinue, while exceptional\nresonances fail\nNext: classify the remaining\nexceptional and infinite-\nwave cases", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nWhich waves survive\nnonlinear consistency?\nbroad balanced families\ncontinue, while exceptional\nresonances fail\nNext: classify the remaining\nexceptional and infinite-\nwave cases"];
  "einstein_weyl_relative" [shape=box, label="WORKING EXAMPLE\nOrdinary relativity\ninside the model\nEinstein-like solutions and\ntheir extra companions are\nseparated at the linear\nlevel\nNext: prove which sector\nremains closed under full\nevolution", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nOrdinary relativity\ninside the model\nEinstein-like solutions and\ntheir extra companions are\nseparated at the linear\nlevel\nNext: prove which sector\nremains closed under full\nevolution"];
  "light" [shape=box, label="WORKING EXAMPLE\nLight signals\nelectromagnetic signals\npropagate causally from\nlocalized sources\nNext: control the complete\ninfinite set of spatial\nwave patterns", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nLight signals\nelectromagnetic signals\npropagate causally from\nlocalized sources\nNext: control the complete\ninfinite set of spatial\nwave patterns"];
  "gravity_waves" [shape=box, label="WORKING EXAMPLE\nGravitational waves\nfamiliar waves and\nadditional fourth-order\nwaves both exist and carry\nmeasurable currents\nNext: test radiation at\ninfinity, stability and\nrealistic detectors", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nGravitational waves\nfamiliar waves and\nadditional fourth-order\nwaves both exist and carry\nmeasurable currents\nNext: test radiation at\ninfinity, stability and\nrealistic detectors"];
  "redshift" [shape=box, label="WORKING EXAMPLE\nClocks measure redshift\nan exact retarded example\ngives 1+z=2 and now feeds\nlocalized records\nNext: complete a fully local\nfrequency comparison\nincluding recoil", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nClocks measure redshift\nan exact retarded example\ngives 1+z=2 and now feeds\nlocalized records\nNext: complete a fully local\nfrequency comparison\nincluding recoil"];
  "detector" [shape=box, label="DEMONSTRATED\nLocal emitters and\ndetectors\ntwo dynamical sources create\ntwo distinct persistent\nrecords\nNext: complete detector recoil\nand infinite-wave control", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nLocal emitters and\ndetectors\ntwo dynamical sources create\ntwo distinct persistent\nrecords\nNext: complete detector recoil\nand infinite-wave control"];
  "quantum_observables" [shape=box, label="DEMONSTRATED\nQuantum observables\ncausal commutators for free\ncurvature measurements are\ndefined exactly\nNext: construct a physical\nquantum state and prove\npositivity", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nQuantum observables\ncausal commutators for free\ncurvature measurements are\ndefined exactly\nNext: construct a physical\nquantum state and prove\npositivity"];
  "hadamard" [shape=box, label="WORKING EXAMPLE\nA physical quantum\nvacuum\nthe required short-distance\nform is known locally, but\nno global state exists\nNext: construct a global state\ncompatible with all gauge\nrules", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nA physical quantum\nvacuum\nthe required short-distance\nform is known locally, but\nno global state exists\nNext: construct a global state\ncompatible with all gauge\nrules"];
  "anomalies" [shape=box, label="WORKING EXAMPLE\nDo quantum effects break\nthe rules?\nall local failure types are\nclassified and one\ngravitational coefficient is\nmatched\nNext: compute the actual\nbreaking and decide\nwhether it can be\nrepaired", fillcolor="#fff0bf", color="#9a6a00", tooltip="WORKING EXAMPLE\nDo quantum effects break\nthe rules?\nall local failure types are\nclassified and one\ngravitational coefficient is\nmatched\nNext: compute the actual\nbreaking and decide\nwhether it can be\nrepaired"];
  "lensing" [shape=box, label="NEXT FRONTIER\nGravitational lensing\nno complete local light-\nbending observable has been\nbuilt yet\nNext: trace localized light\nthrough dynamical\ncurvature", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nGravitational lensing\nno complete local light-\nbending observable has been\nbuilt yet\nNext: trace localized light\nthrough dynamical\ncurvature"];
  "mass" [shape=box, label="NEXT FRONTIER\nWhere particle masses\ncome from\nmassive apparatus fields can\nbe used, but the universe\ndoes not generate its own\nmass scale\nNext: build a stable mechanism\nthat creates physical\nmasses", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nWhere particle masses\ncome from\nmassive apparatus fields can\nbe used, but the universe\ndoes not generate its own\nmass scale\nNext: build a stable mechanism\nthat creates physical\nmasses"];
  "nonabelian_matter" [shape=box, label="NEXT FRONTIER\nThe other forces and\nmatter\nelectromagnetism is present;\nstrong, weak and chiral\nmatter sectors are not\nNext: add strong-force, weak-\nforce and fermion fields", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nThe other forces and\nmatter\nelectromagnetism is present;\nstrong, weak and chiral\nmatter sectors are not\nNext: add strong-force, weak-\nforce and fermion fields"];
  "particles" [shape=box, label="NEXT FRONTIER\nQuantum particles and\nscattering\na free observable algebra\nexists, but no physical\nparticle state or scattering\ntheory\nNext: add a quantum state,\npositivity and\ninteractions", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nQuantum particles and\nscattering\na free observable algebra\nexists, but no physical\nparticle state or scattering\ntheory\nNext: add a quantum state,\npositivity and\ninteractions"];
  "black_hole_static" [shape=box, label="DEMONSTRATED\nBlack holes at rest\na static family has regular\nhorizons, energy, entropy\nand an exact first law\nNext: allow time-dependent\nwaves and horizon flux", fillcolor="#d9f2df", color="#287a3d", tooltip="DEMONSTRATED\nBlack holes at rest\na static family has regular\nhorizons, energy, entropy\nand an exact first law\nNext: allow time-dependent\nwaves and horizon flux"];
  "black_holes" [shape=box, label="NEXT FRONTIER\nBlack holes in motion\ntime-dependent horizon\nphysics, ringdown and\nstability are not built yet\nNext: construct the exterior\nphase space and\nperturbation equations", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nBlack holes in motion\ntime-dependent horizon\nphysics, ringdown and\nstability are not built yet\nNext: construct the exterior\nphase space and\nperturbation equations"];
  "gut" [shape=box, label="NEXT FRONTIER\nOne theory for the\nmatter forces\nno unified group or matter\nfamily has been selected\nNext: unify strong, weak and\nelectromagnetic matter\nconsistently", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nOne theory for the\nmatter forces\nno unified group or matter\nfamily has been selected\nNext: unify strong, weak and\nelectromagnetic matter\nconsistently"];
  "cosmology" [shape=box, label="NEXT FRONTIER\nGalaxies and cosmic\nexpansion\nno stable observational\ncosmology or dark sector has\nbeen built yet\nNext: build expanding\nsolutions, lensing and\nmatter phenomenology", fillcolor="#eceff3", color="#667085", tooltip="NEXT FRONTIER\nGalaxies and cosmic\nexpansion\nno stable observational\ncosmology or dark sector has\nbeen built yet\nNext: build expanding\nsolutions, lensing and\nmatter phenomenology"];
  { rank=same; "causality"; "residual"; "clock"; }
  { rank=same; "interactions"; "berger_branch_carrier"; "einstein_weyl_relative"; "light"; "gravity_waves"; }
  { rank=same; "branch_mixing"; "taub_selection"; }
  { rank=same; "redshift"; "detector"; "lensing"; }
  { rank=same; "hadamard"; "anomalies"; }
  { rank=same; "mass"; "nonabelian_matter"; "particles"; "black_holes"; }
  "gauge_complex" -> "causality" [tooltip="makes propagation testable"];
  "gauge_complex" -> "residual" [tooltip="identifies equivalent descriptions"];
  "gauge_complex" -> "clock" [tooltip="allows matter clocks"];
  "gauge_complex" -> "light" [tooltip="supports electromagnetic fields"];
  "gauge_complex" -> "gravity_waves" [tooltip="supports gravitational waves"];
  "gauge_complex" -> "einstein_weyl_relative" [tooltip="allows comparison with ordinary relativity"];
  "gauge_complex" -> "berger_branch_carrier" [tooltip="reveals familiar and extra waves"];
  "gauge_complex" -> "black_hole_static" [tooltip="supports static strong-gravity solutions"];
  "einstein_weyl_relative" -> "gravity_waves" [tooltip="separates familiar and extra patterns"];
  "einstein_weyl_relative" -> "interactions" [tooltip="tests whether ordinary gravity stays closed"];
  "residual" -> "interactions" [tooltip="removes redundant interaction directions"];
  "residual" -> "berger_branch_carrier" [tooltip="defines the surviving wave information"];
  "causality" -> "interactions" [tooltip="limits influence to the causal future"];
  "interactions" -> "branch_mixing" [tooltip="tests whether wave types mix"];
  "berger_branch_carrier" -> "branch_mixing" [tooltip="requires a different exact separation"];
  "gravity_waves" -> "taub_selection" [tooltip="supplies candidate waves"];
  "interactions" -> "taub_selection" [tooltip="tests whether waves continue nonlinearly"];
  "clock" -> "redshift" [tooltip="supplies readings"];
  "light" -> "redshift" [tooltip="carries timing information"];
  "interactions" -> "redshift" [tooltip="tests the measurement after backreaction"];
  "clock" -> "detector" [tooltip="labels local records"];
  "light" -> "detector" [tooltip="drives detector response"];
  "gravity_waves" -> "detector" [tooltip="can drive future tidal detectors"];
  "causality" -> "detector" [tooltip="ensures records follow sources"];
  "light" -> "lensing" [tooltip="traces light paths"];
  "gravity_waves" -> "lensing" [tooltip="supplies curved spacetime"];
  "causality" -> "quantum_observables" [tooltip="fixes causal commutators"];
  "residual" -> "quantum_observables" [tooltip="removes redundant measurements"];
  "quantum_observables" -> "hadamard" [tooltip="provides the algebra that needs a state"];
  "interactions" -> "anomalies" [tooltip="tests quantum consistency"];
  "branch_mixing" -> "anomalies" [tooltip="tracks interacting quantum channels"];
  "hadamard" -> "particles" [tooltip="supplies a physical quantum state"];
  "anomalies" -> "particles" [tooltip="checks whether quantum rules survive"];
  "taub_selection" -> "particles" [tooltip="restricts nonlinear candidates"];
  "clock" -> "mass" [tooltip="may supply a physical scale"];
  "interactions" -> "mass" [tooltip="must stabilize massive matter"];
  "mass" -> "particles" [tooltip="creates rest excitations"];
  "gauge_complex" -> "nonabelian_matter" [tooltip="provides room for additional forces"];
  "interactions" -> "nonabelian_matter" [tooltip="couples forces and matter"];
  "nonabelian_matter" -> "particles" [tooltip="supplies charged species"];
  "nonabelian_matter" -> "gut" [tooltip="supplies forces and matter families"];
  "mass" -> "gut" [tooltip="supplies a symmetry-breaking scale"];
  "anomalies" -> "gut" [tooltip="tests consistency"];
  "particles" -> "gut" [tooltip="tests the physical spectrum"];
  "black_hole_static" -> "black_holes" [tooltip="adds motion, waves and flux"];
  "gravity_waves" -> "black_holes" [tooltip="drives ringdown"];
  "causality" -> "black_holes" [tooltip="defines horizon evolution"];
  "redshift" -> "cosmology" [tooltip="builds observations"];
  "lensing" -> "cosmology" [tooltip="maps matter"];
  "mass" -> "cosmology" [tooltip="supplies matter"];
  "gut" -> "cosmology" [tooltip="supplies a unified matter model"];
  "black_holes" -> "cosmology" [tooltip="tests strong gravity"];
}
