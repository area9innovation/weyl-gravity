T COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Homogeneous motion balanced by twist</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Ordinary Einstein-Maxwell gravitational waves</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Twist-balanced exceptional dipole</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FBE1E3" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#8B1E2D" POINT-SIZE="10"><B>Limit found</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR></TABLE>>];
  panel_berger_clock [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#CBD5E1" BGCOLOR="white"><TR><TD COLSPAN="6" ALIGN="LEFT" BGCOLOR="#172B4D" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>Berger clock universe</B></FONT><BR/><FONT COLOR="#DCE6F2" POINT-SIZE="9">Light, clocks, emitters and detectors on the rotating squashed-sphere laboratory.</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Inhabitant</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Causal travel</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Classical pairing</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Nonlinear survival</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Observer response</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Quantum status</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Detector response after nonlinear restrictions</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Localized light-emitter preparations</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Relational light and redshift signal</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#DDF3E4" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#14532D" POINT-SIZE="10"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Two independent detector responses</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#ECEFF3" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#475467" POINT-SIZE="10"><B>Not part of this test</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#FFF1C7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#7A4B00" POINT-SIZE="10"><B>Next frontier</B></FONT></TD></TR></TABLE>>];
  panel_bridges [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" COLOR="#CBD5E1" BGCOLOR="white"><TR><TD COLSPAN="6" ALIGN="LEFT" BGCOLOR="#172B4D" CELLPADDING="9"><FONT COLOR="white" POINT-SIZE="14"><B>Bridges between universes</B></FONT><BR/><FONT COLOR="#DCE6F2" POINT-SIZE="9">Only explicit carrier maps may identify inhabitants defined on different backgrounds.</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Inhabitant</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Causal travel</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Classical pairing</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Nonlinear survival</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Observer response</B></FONT></TD><TD BGCOLOR="#E8EEF5" CELLPADDING="6"><FONT COLOR="#172B4D" POINT-SIZE="8"><B>Quantum status</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Can a compact-universe obstruction reach the Berger detector?</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#F8FAFC" CELLPADDING="7"><FONT COLOR="#172B4D" POINT-SIZE="10"><B>Compact gravitational waves carried to other universes</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD><TD BGCOLOR="#DDEAF7" COLOR="#FFFFFF" CELLPADDING="7"><FONT COLOR="#184E77" POINT-SIZE="10"><B>Bridge not built</B></FONT></TD></TR></TABLE>>];
  { rank=same; panel_compact_product; panel_berger_clock; }
  panel_compact_product -> panel_berger_clock [style=invis, weight=20];
  { rank=same; panel_bridges; }
  legend [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="5"><TR><TD BGCOLOR="#DDF3E4" CELLPADDING="6"><FONT COLOR="#14532D" POINT-SIZE="9"><B>Demonstrated</B></FONT></TD><TD BGCOLOR="#FBE1E3" CELLPADDING="6"><FONT COLOR="#8B1E2D" POINT-SIZE="9"><B>Limit found</B></FONT></TD><TD BGCOLOR="#FFF1C7" CELLPADDING="6"><FONT COLOR="#7A4B00" POINT-SIZE="9"><B>Next frontier</B></FONT></TD><TD BGCOLOR="#ECEFF3" CELLPADDING="6"><FONT COLOR="#475467" POINT-SIZE="9"><B>Not part of this test</B></FONT></TD><TD BGCOLOR="#DDEAF7" CELLPADDING="6"><FONT COLOR="#184E77" POINT-SIZE="9"><B>Bridge not built</B></FONT></TD></TR><TR><TD COLSPAN="5"><FONT COLOR="#667085" POINT-SIZE="9">Each verdict is restricted to its declared background, carrier, boundaries and charge sector.</FONT></TD></TR></TABLE>>];
  panel_compact_product -> panel_bridges [style=invis, weight=10];
  panel_bridges -> legend [style=invis, weight=5];
}
